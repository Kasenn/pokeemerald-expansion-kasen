script SecretShopScript{
    message("What're you buyin?")
    waitmessage
    setflag(FLAG_FREE_MART)
    pokemart(SecretShopScript_Mart)
    msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
    clearflag(FLAG_FREE_MART)
	release
	end
}

mart SecretShopScript_Mart{
    ITEM_RARE_CANDY
    ITEM_EXP_CANDY_XL
    ITEM_MASTER_BALL
    ITEM_ABILITY_CAPSULE
    ITEM_ABILITY_PATCH
    ITEM_PP_MAX
    ITEM_FRESH_START_MOCHI
    ITEM_HP_UP
    ITEM_PROTEIN
    ITEM_IRON
    ITEM_CALCIUM
    ITEM_ZINC
    ITEM_CARBOS
    ITEM_NONE
}


