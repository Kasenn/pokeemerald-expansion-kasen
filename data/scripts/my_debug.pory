text WantToSkipMultiple{
    "You've chosen to skip {STR_VAR_2}.\p"
    "All story content up to this area\n"
    "will be completed, as well as any\l"
    "additional content selected.\p"
    "Would you also like to complete any\n"
    "selected content from the previous\l"
    "areas as well?"
}
text ContentHasBeenSkipped{
    "Content has been skipped.\p"
    "It is recommended to check your bag\n"
    "for any new items.\p"
    "Note that this doesn't automatically\n"
    "catch any Pokémon for you."
}

script SkipContentEnd{
    msgbox(ContentHasBeenSkipped)
    release
    end
}

script ContentSkipper_SkipContent_Route1{
    //stuff
    if(flag(FLAG_SKIP_MULTIPLE)){
        call(CompleteAllAreas)
    }
    else{
        call(CompleteArea_Route_1)
    }
    return
}
