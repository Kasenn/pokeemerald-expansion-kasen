text MixupWithTMs{
    "There has been a mix-up with some\n"
    "TM rewards.\p"
    "Fixing the mix-up now."
}
text NewUpdate{
    "A new update has been applied."
}

script UpdateGuy{
    faceplayer
    msgbox(UpdateGuy_Text1)
    if(!flag(FLAG_SYS_POKEDEX_GET)){
        msgbox(UpdateGuy_Text2)
        release
        end
    }
    message(WhatWouldYouLikeToDo)
    waitmessage
    if(var(VAR_DEBUG) < 5){
        dynmultipush("Update Game", 0)
    }
    dynmultipush("Set Team Level", 1)
    dynmultipush("Skip Content", 2)
    dynmultipush("Enter Code", 3)
    if(flag(FLAG_OBTAINED_MEGA_RING)){
        dynmultipush("Obtain Mega Mon", 4)
    }
    if(flag(FLAG_ENABLE_SECRET_SHOP)){
        dynmultipush("Secret Shop", 5)
    }
    dynmultipush("Nevermind", 6)
    dynmultistack(23, 0, FALSE, 6, FALSE, 0, 0)
    switch(var(VAR_RESULT)){
        case 0:
            goto(UpdateGame)
        case 1:
            goto(Debug_Script_1)
        case 2:
            goto(SkipContent)
        case 3:
            goto(Debug_Script_81)
        case 4:
            goto(TestMegaMon)
        case 5:
            goto(SecretShopScript)
        case 6:
        case MULTI_B_PRESSED:
            msgbox("Goodbye.", MSGBOX_AUTOCLOSE)
    }
}

text UpdateGuy_Text1{
    "Hello, I am a debug guy.\p"
    "I offer many services that can help\n"
    "you with testing this game."
}
text UpdateGuy_Text2{
    "Before I can offer you my services,\n"
    "you must acquire a Pokédex."
}
text WhatWouldYouLikeToDo{
    "What would you like to do?"
}
text GameIsUpToDate{
    "Your game is now up-to-date.\p"
    "If you need anything else,\n"
    "let me know."
}
text GrottoUpdate{
    "Any Pokémon you have acquired from\n"
    "a grotto has been updated, and will\l"
    "now have its hidden ability."
}

script UpdateGame{
    if(var(VAR_DEBUG) == 2){
        call(Update3)
    }
    if(var(VAR_DEBUG) == 3){
        call(Update4)
    }
    if(var(VAR_DEBUG) == 4){
        setflag(FLAG_SYS_B_DASH)
        setflag(FLAG_SYS_JOURNAL_GET)
        callnative(ClearAllContestWinnerPics)
        setvar(VAR_DEBUG, 5)
    }
    msgbox(GameIsUpToDate)
    release
}

script TestMegaMon{
    message(WhichMonWouldYouTest)
    waitmessage
    setvar(VAR_0x8008, 40)
    if(flag(FLAG_BADGE05_GET)){
        setvar(VAR_0x8008, 45)
    }
    if(flag(FLAG_BADGE06_GET)){
        setvar(VAR_0x8008, 53)
    }
    dynmultichoice(23, 0, FALSE, 5, 0, 0, "Decidueye", "Empoleon", "Chesnaught", "Incineroar", "Porygon-Z", "Ariados", "Nevermind")
    switch(var(VAR_RESULT)){
        case 0:
            givemon(SPECIES_DECIDUEYE, VAR_0x8008, ITEM_DECIDUEITE)
            bufferspeciesname(STR_VAR_1, SPECIES_DECIDUEYE)
            setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_DECIDUEYE)
            goto(ReceiveMegaStarter)
        case 1:
            givemon(SPECIES_EMPOLEON, VAR_0x8008, ITEM_EMPOLEONITE)
            bufferspeciesname(STR_VAR_1, SPECIES_EMPOLEON)
            setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_EMPOLEON)
            goto(ReceiveMegaStarter)
        case 2:
            givemon(SPECIES_CHESNAUGHT, VAR_0x8008, ITEM_CHESNAUGHTITE)
            bufferspeciesname(STR_VAR_1, SPECIES_CHESNAUGHT)
            setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_CHESNAUGHT)
            goto(ReceiveMegaStarter)
        case 3:
            givemon(SPECIES_INCINEROAR, VAR_0x8008, ITEM_INCINEROARITE)
            bufferspeciesname(STR_VAR_1, SPECIES_INCINEROAR)
            setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_INCINEROAR)
            goto(ReceiveMegaStarter)
        case 4:
            givemon(SPECIES_PORYGON_Z, VAR_0x8008, ITEM_PROCESSOR)
            bufferspeciesname(STR_VAR_1, SPECIES_PORYGON_Z)
            setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_PORYGON_Z)
            goto(ReceiveMegaStarter)
        case 5:
            givemon(SPECIES_ARIADOS, VAR_0x8008, ITEM_ARIADOSITE)
            bufferspeciesname(STR_VAR_1, SPECIES_ARIADOS)
            setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_ARIADOS)
            goto(ReceiveMegaStarter)
        case 6:
        case MULTI_B_PRESSED:
            msgbox("Goodbye", MSGBOX_AUTOCLOSE)
            release
            end
    }
}

script UnstuckPlayer{
    if(msgbox(UnstuckPlayer_Text, MSGBOX_YESNO) == FALSE){
        release
        end
    }
    warp(MAP_PEARLWOOD_POINT, 14, 24)
    waitstate
    release
    end
}

text UnstuckPlayer_Text{
    "This unstuck feature is meant to\n"
    "avoid softlocking in the overworld.\p"
    "Would you like to warp home?"
}

