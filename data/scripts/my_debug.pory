        if(!flag(FLAG_HIDDEN_ITEM_ROUTE2_HARDSTONE)){
            setflag(FLAG_HIDDEN_ITEM_ROUTE2_HARDSTONE)
            additem(ITEM_HARD_STONE)
        }
        if(!flag(FLAG_WW_WATERSTONE)){
            setflag(FLAG_WW_WATERSTONE)
            additem(ITEM_WATER_STONE)
        }
        if(!flag(FLAG_OBTAINED_PIDGEOTITE)){
            setflag(FLAG_OBTAINED_PIDGEOTITE)
            additem(ITEM_PIDGEOTITE)
        }
        if(!flag(FLAG_ROUTE3_ITEM1)){
            setflag(FLAG_ROUTE3_ITEM1)
            additem(ITEM_PP_UP)
        }
        if(!flag(FLAG_ROUTE5_ITEM4)){
            setflag(FLAG_ROUTE5_ITEM4)
            additem(ITEM_NUGGET)
        }
        if(!flag(FLAG_ROUTE7_WHITE_HERB)){
            setflag(FLAG_ROUTE7_WHITE_HERB)
            additem(ITEM_WHITE_HERB)
        }
        if(!flag(FLAG_ROUTE8_ITEM4)){
            setflag(FLAG_ROUTE8_ITEM4)
            additem(ITEM_HP_UP)
        }
        if(!flag(FLAG_SHORESLATE_ITEM2)){
            setflag(FLAG_SHORESLATE_ITEM2)
            additem(ITEM_ELIXIR)
        }
        if(!flag(FLAG_ROUTE7_ITEM6)){
            setflag(FLAG_ROUTE7_ITEM6)
            additem(ITEM_MAX_ETHER)
        }
        if(!flag(FLAG_MARIGORGE_ITEM3)){
            setflag(FLAG_MARIGORGE_ITEM3)
            additem(ITEM_PP_UP)
        }
        if(!flag(FLAG_MARIGORGE_ITEM1)){
            setflag(FLAG_MARIGORGE_ITEM1)
            additem(ITEM_SUN_STONE)
        }
        if(!flag(FLAG_OBTAINED_AGGRONITE)){
            setflag(FLAG_OBTAINED_AGGRONITE)
            additem(ITEM_AGGRONITE)
        }
        if(!flag(FLAG_ROCKLIFFE_ITEM3)){
            setflag(FLAG_ROCKLIFFE_ITEM3)
            additem(ITEM_RARE_CANDY)
        }
        if(!flag(FLAG_FLOODEDCAVE_FOSSIL)){
            setflag(FLAG_FLOODEDCAVE_FOSSIL)
            call(DebugFossil)
        }
        if(!flag(FLAG_R14_ITEM5)){
            setflag(FLAG_R14_ITEM5)
            additem(ITEM_TM_HIDDEN_POWER)
        }
        if(!flag(FLAG_R14_ITEM6)){
            setflag(FLAG_R14_ITEM6)
            additem(ITEM_MAX_ETHER)
        }
    }
    if(flag(FLAG_EVENTS)){
        if(var(VAR_KAOLISLE_BIRDS) < 131){
            setvar(VAR_KAOLISLE_BIRDS, 131)
            additem(ITEM_TM_BULLET_SEED)
            if(flag(FLAG_Q28_KAOLISLE_LOSTBIRDS_START)){
                completequest(FLAG_Q28_KAOLISLE_LOSTBIRDS_COMPLETE)
            }
        }
    }
    return
}

script TryLootingStrangeSeed{
    if(var(VAR_RESULT) == FALSE){
        return
    }
    trystrangeseed
    if(var(VAR_0x8004) >= 60){
        additem(ITEM_STRANGE_SEED)
    }
    return
}
script TryCuttingStrangeSeedTree{
    trystrangeseed
    if(var(VAR_0x8004) >= 80){
        additem(ITEM_STRANGE_SEED)
    }
}
script GenerateRelic{
    random(100)
    if(var(VAR_RESULT) <= 65){
        additem(ITEM_RELIC_COPPER)
    }
    elif(var(VAR_RESULT) >= 94){
        additem(ITEM_RELIC_GOLD)
    }
    else{
        additem(ITEM_RELIC_SILVER)
    }
    return
}

script DebugFossil{
    random(11)
    switch(var(VAR_RESULT)){
        case 0:
            goto(LootHelix2)
        case 1:
            goto(LootDome2)
         case 2:
            goto(LootOldAmber2)
        case 3:
            goto(LootRoot2)
        case 4:
            goto(LootClaw2)
        case 5:
            goto(LootSkull2)
        case 6:
            goto(LootArmor2)
        case 7:
            goto(LootCover2)
        case 8:
            goto(LootPlume2)
        case 9:
            goto(LootJaw2)
        case 10:
            goto(LootSail2)
    }
    return
}

script LootHelix2{
    if(flag(FLAG_OBTAINED_HELIX_FOSSIL)){
        goto(DebugFossil)
    }
    additem(ITEM_HELIX_FOSSIL)
    setflag(FLAG_OBTAINED_HELIX_FOSSIL)
    return
}
