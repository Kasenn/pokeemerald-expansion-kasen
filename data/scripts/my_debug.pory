script Update3{
    if(flag(FLAG_RECEIVED_TM_FLING)){
        msgbox(MixupWithTMs)
        removeitem(ITEM_TM_TORMENT, 1)
        giveitem(ITEM_TM_FLING)
        checkitemquant(ITEM_TM_FLING)
        if(flag(FLAG_ITEM_ROUTE_11_TORMENT))
        {
            if(var(VAR_0x8005) == 0){
                additem(ITEM_TM_TORMENT)
            }
        }
        checkitemquant(ITEM_TM_FLING)
        if(var(VAR_0x8005) > 1){
            removeitem(ITEM_TM_FLING)
        }
        closemessage
    }
    setflag(FLAG_SYS_JOURNAL_GET)
    setvar(VAR_DEBUG, 3)
    release
}
