text SkipContent_Text{
    "This feature allows you to skip\n"
    "certain content or mark certain\l"
    "things as completed.\p"
    "Any story content up to the selected\n"
    "area will be automatically completed.\p"
    "You can also choose to automatically\n"
    "complete other content, like looting\l"
    "items, defeating trainers, and\l"
    "completing other events in the area.\p"
    "Do note that skipping story content\n"
    "will also skip the story of all areas\l"
    "before it.\p"
    "Also, any event with a static\n"
    "encounter (legendaries, waking up\l"
    "Sudowoodo, etc.) will not be completed."
}
text ChooseContentToSkip{
    "Choose the area you'd like to skip."
}

script SkipContent_BufferChoices{
    bufferstring(STR_VAR_1, "{COLOR LIGHT_GRAY}{SHADOW LIGHT_GRAY}")
    if(flag(FLAG_ITEMS)){
        dynmultipush("{STR_VAR_1}Items", 0)
    }
    else{
        dynmultipush("Items", 0)
    }
    ///
    if(flag(FLAG_TRAINERS)){
        dynmultipush("{STR_VAR_1}Trainers", 1)
    }
    else{
        dynmultipush("Trainers", 1)
    }
    ///
    if(flag(FLAG_EVENTS)){
        dynmultipush("{STR_VAR_1}Events", 2)
    }
    else{
        dynmultipush("Events", 2)
    }
    ///
    
    dynmultipush("All", 3)
    dynmultipush("Confirm", 4)
    dynmultipush("Back", 5)
    if(flag(FLAG_MULTICHOICE)){
        message("Anything else?")
    }
    else{
        message("Please choose the content you\nwant to complete.")
    }
    waitmessage
    dynmultistack(23, 0, FALSE, 6, FALSE, 0, 0)
    setflag(FLAG_MULTICHOICE)
    switch(var(VAR_RESULT)){
        case 0:
            goto(BufferChoices0)
        case 1:
            goto(BufferChoices1)
        case 2:
            goto(BufferChoices2)
        case 3:
            goto(BufferChoices4)
        case 5:
        case MULTI_B_PRESSED:
            goto(SkipContent)
    }
    return
}

script BufferChoices0{
    if(!flag(FLAG_ITEMS)){
        setflag(FLAG_ITEMS)
    }
    else{
        clearflag(FLAG_ITEMS)
    }
    goto(SkipContent_BufferChoices)
}
script BufferChoices1{
    if(!flag(FLAG_TRAINERS)){
        setflag(FLAG_TRAINERS)
    }
    else{
        clearflag(FLAG_TRAINERS)
    }
    goto(SkipContent_BufferChoices)
}
script BufferChoices2{
    if(!flag(FLAG_EVENTS)){
        setflag(FLAG_EVENTS)
    }
    else{
        clearflag(FLAG_EVENTS)
    }
    goto(SkipContent_BufferChoices)
}
script BufferChoices4{
    if(!flag(FLAG_ITEMS) || !flag(FLAG_TRAINERS) || !flag(FLAG_EVENTS)){
        setflag(FLAG_ITEMS)
        setflag(FLAG_TRAINERS)
        setflag(FLAG_EVENTS)
    }
    else{
        clearflag(FLAG_ITEMS)
        clearflag(FLAG_TRAINERS)
        clearflag(FLAG_EVENTS)
    }
    goto(SkipContent_BufferChoices)
}

script SkipContent_Route1{
    bufferstring(STR_VAR_2, "Route 1")
    call(SkipContent_BufferChoices)
    if(var(VAR_RESULT) == 4){
        if(msgbox(WantToSkipMultiple, MSGBOX_YESNO) == TRUE){
            setflag(FLAG_SKIP_MULTIPLE)
        }
    }
    call(ContentSkipper_SkipContent_Route1)
    goto(SkipContentEnd)
}
