// Starting from here, these movements are considered
// 'safe' (won't put follower into a Pokeball)
movement(global) Common_Movement_FollowerSafeStart{}
movement(global) Common_Movement_QuestionMark{
	emote_question_mark
}

movement(global) Common_Movement_ExclamationMark{
	emote_exclamation_mark
}

movement(global) Common_Movement_Delay48{
	delay_16 * 3
}

movement(global) Common_Movement_FacePlayer{
	face_player
}

movement(global) Common_Movement_FaceAwayPlayer{
	face_away_player
}

movement(global) Common_Movement_FaceOriginalDirection{
	face_original_direction
}

movement(global) Common_Movement_WalkInPlaceFasterLeft{
	walk_in_place_faster_left
}

movement(global) Common_Movement_WalkInPlaceFasterUp{
	walk_in_place_faster_up
}

movement(global) Common_Movement_WalkInPlaceFasterRight{
	walk_in_place_faster_right
}

movement(global) Common_Movement_WalkInPlaceFasterDown{
	walk_in_place_faster_down
}

movement(global) Common_Movement_FaceRight{
	face_right
}

movement(global) Common_Movement_FaceLeft{
	face_left
}

movement(global) Common_Movement_FaceDown{
	face_down
}

movement(global) Common_Movement_FaceUp{
	face_up
}

movement(global) Common_Movement_WalkInPlaceDown{
	walk_in_place_down
}

movement(global) Common_Movement_WalkInPlaceLeft{
	walk_in_place_left
}

movement(global) Common_Movement_WalkInPlaceRight{
	walk_in_place_right
}

// End of follower-safe movements
movement(global) Common_Movement_FollowerSafeEnd{}

movement(global) Common_Movement_WalkUp6{
	walk_up * 6
}

movement(global) Common_Movement_WalkUp4{
	walk_up * 4
}

movement(global) Common_Movement_Delay32{
	delay_16 * 2
}

movement(global) Common_Movement_WalkUp{
	walk_up
}

// Unused
movement(global) Common_Movement_WalkUp2{
	walk_up * 2
}

