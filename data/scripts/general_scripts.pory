    additem(ITEM_SUPER_POTION)
    setflag(FLAG_BASEMENT_SUPERPOTION)
    additem(ITEM_QUICK_BALL)
    setflag(FLAG_DEVONCORP_BASEMENT_BALL)
    setflag(FLAG_DEVON_UNDER_ATTACK)
    setflag(FLAG_HELPED_DEVON_CORP)
    clearflag(FLAG_HIDE_SHORESLATE_BOAT)
    additem(ITEM_HM05)
    setflag(FLAG_RECEIVED_BIKE)
	additem(ITEM_ACRO_BIKE)
    return
}

script Pearlwood_Debug{
    if(flag(FLAG_BADGE01_GET)){
        msgbox("Oops, I should no longer be here.\pBye!")
        removeobject(7)
        release
        end
    }
    if(!flag(FLAG_SYS_POKEDEX_GET)){
        msgbox("Come back after obtaining\nthe Pokédex.")
        release
        end
    }
    msgbox("Hello, I am here to help you skip\na bunch of stuff you've already done.")
    call(SkipToShoreslate)
    msgbox("All items, trainers, and story events\nup to Shoreslate have been completed.\pYou will have to catch your own\nPokémon though.\pWould you like me to fly you\nsomewhere?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == TRUE){
        setflag(FLAG_OPENED_MAP_FROM_SIGN)
        fadescreen(FADE_TO_BLACK)
        callnative(OpenFlyMapFromSign)
    }
    else{
        msgbox("Okay then.\nBye!")
        removeobject(7)
    }
    release
    end
}