script RapidsTooStrong{
    msgbox(RapidsTooStrong_Text, MSGBOX_NPC)
}
text RapidsTooStrong_Text{
    "These rapids are simply too strong\n"
    "to surf against.\p"
    "I'm sure they'll die down once the\n"
    "game dev finishes the upcoming area!"
}
//
// Debug related scripts
//
script UpdateItemCheck{
    checkitem(ITEM_TM_ECHOED_VOICE, 2)
    if(var(VAR_RESULT) == TRUE){
        removeitem(ITEM_TM_ECHOED_VOICE, 1)
        giveitem(ITEM_TM_ROCK_SLIDE)
    }
    checkitem(ITEM_TM_CASE)
    if(var(VAR_RESULT) == FALSE){
        giveitem(ITEM_TM_CASE)
    }
    checkitem(ITEM_TM_GIGA_DRAIN)
    if(var(VAR_RESULT) == TRUE){
        msgbox(ReplacedGrassKnot)
        removeitem(ITEM_TM_GIGA_DRAIN)
        additem(ITEM_TM_GRASS_KNOT)
    }}
text ReplacedFlute{
    "Your White Flute has been replaced\n"
    "with a Black Flute."}
text ReplacedGrassKnot{
    "Your TM for Giga Drain has been\n"
    "replaced with a TM for Grass Knot."}
text WantToSetRivalFight{
    "This option will change an upcoming\n"
    "rival event based on whether the rival\l"
    "was fought in the Coralgrove elevator.\p"
    "Would you like to switch the event?"}
text RivalNotFought{
    "Rival set to NOT FOUGHT.\n"
    "Removed the Itemfinder."}
text RivalFought{
    "Rival set to FOUGHT.\n"
    "Added the Itemfinder."}
text LevelSetIntro{
    "This option will set the level of your\n"
    "entire team to the specified level.\p"
    "This is meant for testing purposes so\n"
    "I'd prefer you didn't exploit this for\l"
    "no reason.\p"
    "Do note that this does NOT\n"
    "evolve/de-evolve your Pokémon,\l"
    "nor does it add or remove moves.\p"
    "The team's stats will be recalculated.\n"
    "EVs earned will remain unchanged."}
text WhichLevelToSet{
    "Which level would you like to set\n"
    "your team?"}
text FlagsAndVarsUpdated2{
    "Flags and Vars updated.\p"
    "Would you like to warp to Coralgrove?\n"
    "(Choose YES if current area is bugged)"}
text RenameBrother{
    "Would you like to rename your brother?\n"
    "(Yes if haven't seen this before!)"}

