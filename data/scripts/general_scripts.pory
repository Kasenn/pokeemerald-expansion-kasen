// This file is meant for general scripts that have no other place to go, as well as debug scripts

//
// General stuff
//
script CheckForTentSpecialPrize{
    if(var(VAR_TENT_SPECIAL_PRIZE) != 3){
        addvar(VAR_TENT_SPECIAL_PRIZE, 1)
    }
    switch(var(VAR_TENT_SPECIAL_PRIZE)){
        case 1:
            msgbox(GainedASpecialTicket)
        case 2:
            msgbox(NowHaveTwoTickets)
        case 3:
            msgbox(TentGrandPrize)
            giveitem(ITEM_FRESH_START_MOCHI)
            if(var(VAR_RESULT) == FALSE){
                goto(SlateportCity_BattleTentLobby_EventScript_NoRoomForPrize)
            }
            setvar(VAR_TENT_SPECIAL_PRIZE, 0)
    }
    goto(SlateportCity_BattleTentLobby_EventScript_EndGivePrize)
}
text GainedASpecialTicket{
    "Due to your victory, you have\n"
    "earned a special victory ticket.\p"
    "Earn two more victory tickets, and\n"
    "you will get a special extra prize!"
}
text NowHaveTwoTickets{
    "You now have two victory tickets.\p"
    "Earn one more ticket for a special\n"
    "extra prize!"
}
text TentGrandPrize{
    "You just earned your third victory\n"
    "ticket.\p"
    "This means you are eligible for a\n"
    "special reward, a Fresh Start Mochi!"
}
script TradeSeedsForFertilizer{
    lock
    faceplayer
    if(flag(FLAG_MET_STRANGE_SEED_TRADER)){
        if(checkitem(ITEM_STRANGE_SEED) == TRUE){
            if(msgbox(HereToTradeMoreSeeds, MSGBOX_YESNO) == TRUE){
                goto(TradeSeedsMain)
            }
        }
        goto(TradeSeedsGoodbye)
    }
    msgbox(SeenAnyStrangeSeeds)
    if (checkitem(ITEM_STRANGE_SEED) == TRUE){
        playse(SE_PIN)
        safefollow
        applymovement(4, ExclamationMark)
        waitmovement(0)
        delay(48)
        setflag(FLAG_MET_STRANGE_SEED_TRADER)
        if(msgbox(CareToTradeSeeds, MSGBOX_YESNO) == TRUE){
            goto(TradeSeedsMain)
        }
        else{
            goto(TradeSeedsGoodbye)
        }
    }}
script TradeSeedsMain{
    checkitemquant(ITEM_STRANGE_SEED)
    if(msgbox(TradeHowManySeeds, MSGBOX_HOWMANY) == 0){
        goto(TradeSeedsGoodbye)
    }
    else{
        copyvar(VAR_TEMP_2, VAR_RESULT)
        buffernumberstring(STR_VAR_1, VAR_TEMP_2)
        while(var(VAR_RESULT) != 0){
            subvar(VAR_RESULT, 1)
            addvar(VAR_TEMP_1, 2)
        }
        buffernumberstring(STR_VAR_2, VAR_TEMP_1)
        if(var(VAR_TEMP_2) == 1){
            if(msgbox(TradeSeedsForFertilizer_Text_Single, MSGBOX_YESNO) == TRUE){
                if(checkitemspace(ITEM_FERTILIZER, VAR_TEMP_1) == FALSE){
                    setvar(VAR_TEMP_1, 0)
                    setvar(VAR_TEMP_2, 0)
                    goto(ZeBagIsFull)
                }
                giveitem(ITEM_FERTILIZER, VAR_TEMP_1)
                removeitem(ITEM_STRANGE_SEED, VAR_TEMP_2)
            }
        }
        else{
            if(msgbox(TradeSeedsForFertilizer_Text_Multiple, MSGBOX_YESNO) == TRUE){
                if(checkitemspace(ITEM_FERTILIZER, VAR_TEMP_1) == FALSE){
                    setvar(VAR_TEMP_1, 0)
                    setvar(VAR_TEMP_2, 0)
                    goto(ZeBagIsFull)
                }
                giveitem(ITEM_FERTILIZER, VAR_TEMP_1)
                removeitem(ITEM_STRANGE_SEED, VAR_TEMP_2)
            }
        }
        goto(TradeSeedsGoodbye)
    }}
script TradeSeedsGoodbye{
    setvar(VAR_TEMP_1, 0)
    setvar(VAR_TEMP_2, 0)
    msgbox(ComeTradeWhenGetMoreSeeds, MSGBOX_NPC)
    end}
text SeenAnyStrangeSeeds{
    "I've been hearing some rumors about\n"
    "Pokémon hiding strange seeds in trees."}
text CareToTradeSeeds{
    "Ah, those seeds seem to match\n"
    "the description!\p"
    "I have this special plant fertilizer\n"
    "that can greatly improve the growth\l"
    "rate of berry trees.\p"
    "If you'd like, I can trade you\n"
    "two batches of the fertilizer\l"
    "for a single strange seed."}
text ComeTradeWhenGetMoreSeeds{
    "If you find any strange seeds, I'll\n"
    "gladly trade them for some fertilizer."}
text HereToTradeMoreSeeds{
    "Here to trade some strange seeds?"}
text TradeHowManySeeds{
    "How many seeds would you\n"
    "like to trade?"}
text TradeSeedsForFertilizer_Text_Single{
    "One seed for two batches\n"
    "of fertilizer.\p"
    "Is that trade okay?"}
text TradeSeedsForFertilizer_Text_Multiple{
    "{STR_VAR_1} seeds for {STR_VAR_2} batches\n"
    "of fertilizer.\p"
    "Is that trade okay?"}


script ZeBagIsFull{
    msgbox(gText_TooBadBagIsFull, MSGBOX_NPC)
    end}
script BerryTree_ItemUseFertilizer{
    special(ObjectEventInteractionGetBerryName)
	message(BerryTree_Text_FertilizedTheBerry)
	waitmessage
	special(ObjectEventInteractionWaterBerryTree)
    fertilizeberry
	special(DoFertilizingBerryTreeAnim)
	waitstate
	message(BerryTree_Text_PlantIsDelighted)
	waitmessage
	waitbuttonpress
	releaseall
    dotimebasedevents
    if(var(VAR_0x800A) == TRUE){
        delay(210)
    }
	end}
script TryDropStrangeSeed_Tree{
    trystrangeseed
    if(var(VAR_0x8004) >= 80 &&
    checkitemspace(ITEM_STRANGE_SEED) == TRUE){
        waitse
        playse(SE_PIN)
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
        waitmovement(0)
        delay(48)
        msgbox(StrangeSeedDroppedTree)
        additem(ITEM_STRANGE_SEED)
        message(BerryTree_Text_PickedTheSeed)
	    playfanfare(MUS_OBTAIN_BERRY)
	    waitmessage
	    waitfanfare
	    waitbuttonpress
        message(BerryTree_Text_PutAwaySeed)
        waitmessage
	    waitbuttonpress
    }
    return}
script TryDropStrangeSeed_BerryPlant{
    trystrangeseed
    if(var(VAR_0x8004) >= 60
    && checkitemspace(ITEM_STRANGE_SEED) == TRUE){
        closemessage
        waitse
        playse(SE_PIN)
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
        waitmovement(0)
        delay(48)
        msgbox(StrangeSeedDroppedBerry)
        additem(ITEM_STRANGE_SEED)
        message(BerryTree_Text_PickedTheSeed)
	    playfanfare(MUS_OBTAIN_BERRY)
	    waitmessage
	    waitfanfare
	    waitbuttonpress
        message(BerryTree_Text_PutAwayBerryAndSeed)
    }
    else{
        message(BerryTree_Text_PutAwayBerry)
    }
    return}
text BerryTree_Text_FertilizedTheBerry{
    "{PLAYER} applied the Fertilizer to\n"
    "the {STR_VAR_1} plant."}
text StrangeSeedDroppedBerry{
    "A Strange Seed dropped from the\n"
    "berry tree."}
text StrangeSeedDroppedTree{
    "A Strange Seed dropped from the tree."}
text BerryTree_Text_PickedTheSeed{
	"{PLAYER} picked up the Strange Seed."}
text BerryTree_Text_PutAwaySeed{
	"{PLAYER} put away the Strange\n"
	"Seed in the Items pocket."}
text BerryTree_Text_PutAwayBerryAndSeed{
	"{PLAYER} put away the {STR_VAR_1}\n"
	"in the bag's berries pocket\l"
    "and the Strange Seed in the\l"
    "Items pocket.\p"
	"The soil returned to its soft and\n"
	"loamy state."}
script ZygardeCell{
    lock
	waitse
    playfanfare(MUS_OBTAIN_ITEM)
    removeobject(VAR_LAST_TALKED)
	message(PlayerFoundZygardeCell)
	waitfanfare
	waitmessage
	msgbox(gText_PutZygardeCellInCube)
    addvar(VAR_ZYGARDE_CELLS, 1)
	release
	end}
text PlayerFoundZygardeCell{
    "{PLAYER} found a Zygarde Cell!"}
text gText_PutZygardeCellInCube{
    "{PLAYER} stored the Zygarde Cell\n"
    "in the Zygarde Cube."}
script ZygardeCore{
    lock
	waitse
    playfanfare(MUS_OBTAIN_ITEM)
    removeobject(VAR_LAST_TALKED)
	message(PlayerFoundZygardeCore)
	waitfanfare
	waitmessage
