script RopeBridgeScript{
    playse(SE_LEDGE)
    applymovement(0xFF, moves(lock_anim, lock_facing_direction, jump_right, unlock_anim, unlock_facing_direction))
    waitmovement(0)
    release
}
script Script_SinkOrRisePlayer{
    playersinkinsnow
    release
}

