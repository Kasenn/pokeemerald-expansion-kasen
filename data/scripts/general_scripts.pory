script AutomaticUpdate{
    setvar(VAR_DEBUG, 9)
    clearflag(FLAG_SERPENTCAVE_DRAGONFANG)
    clearflag(FLAG_OBTAINED_TYRANITARITE)
    clearflag(FLAG_OBTAINED_BLUNDER_POLICY)
    callnative(DefaultFollower)
    closemessage
    release
    end}
