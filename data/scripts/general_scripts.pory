movement FacePlayer{
    face_player
}

script Common_EventScript_FindItem{
    callnative(GetObjectEventTrainerRangeFromTemplate)
	finditem(VAR_RESULT)
	end
}

script SetupRivalGfxId{
    if(checkplayergender == MALE){
        if(flag(FLAG_RIVAL_COSTUME_CHANGE)){
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_MAY_ORAS_NORMAL)
        }
        else{
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_RIVAL_MAY_NORMAL)
        }
    }
    else{
        if(flag(FLAG_RIVAL_COSTUME_CHANGE)){
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_BRENDAN_ORAS_NORMAL)
        }
        else{
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_RIVAL_BRENDAN_NORMAL)
        }
    }
}

script CountGymBadges{
    if(flag(FLAG_BADGE08_GET)){
        setvar(VAR_RESULT, 8)
    }
    elif(flag(FLAG_BADGE07_GET)){
        setvar(VAR_RESULT, 7)
    }
    elif(flag(FLAG_BADGE06_GET)){
        setvar(VAR_RESULT, 6)
    }
    elif(flag(FLAG_BADGE05_GET)){
        setvar(VAR_RESULT, 5)
    }
    elif(flag(FLAG_BADGE04_GET)){
        setvar(VAR_RESULT, 4)
    }
    elif(flag(FLAG_BADGE03_GET)){
        setvar(VAR_RESULT, 3)
    }
    elif(flag(FLAG_BADGE02_GET)){
        setvar(VAR_RESULT, 2)
    }
    elif(flag(FLAG_BADGE01_GET)){
        setvar(VAR_RESULT, 1)
    }
    else{
        setvar(VAR_RESULT, 0)
    }
    return
}
script EventScript_UseRockClimb{
	lockall
	checkpartymove (MOVE_ROCK_CLIMB)
	goto_if_eq (VAR_RESULT, PARTY_SIZE, EventScript_CantRockClimb)
	bufferpartymonnick (STR_VAR_1, VAR_RESULT)
	setfieldeffectargument (0, VAR_RESULT)
    if(var(VAR_ROCK_CLIMB_USED) < 2){
        msgbox (Text_WantToRockClimb, MSGBOX_YESNO)
	    goto_if_eq (VAR_RESULT, NO, EventScript_EndRockClimb)
        addvar(VAR_ROCK_CLIMB_USED, 1)
    }
	msgbox (Text_MonUsedRockClimb, MSGBOX_DEFAULT)
	// call (FollowerIntoPlayerScript)
    // callnative (HideFollower)
	applymovement (OBJ_EVENT_ID_FOLLOWER, EnterPokeballMovement)
	waitmovement (0)
	dofieldeffect (FLDEFF_USE_ROCK_CLIMB)
	goto (EventScript_EndRockClimb)
}

script EventScript_IceSmash{
	lockall
    if(!flag(FLAG_BADGE03_GET)){
        goto(EventScript_CantSmashRock)
    }
	checkpartymove (MOVE_ROCK_SMASH)
	goto_if_eq (VAR_RESULT, PARTY_SIZE, EventScript_CantSmashRock)
	setfieldeffectargument (0, VAR_RESULT)
	bufferpartymonnick (STR_VAR_1, VAR_RESULT)
	buffermovename (STR_VAR_2, MOVE_ROCK_SMASH)
	msgbox ("This block of ice appears to be fragile.\nWould you like to use Rock Smash?", MSGBOX_YESNO)
	goto_if_eq (VAR_RESULT, NO, EventScript_CancelSmash)
	msgbox (Text_MonUsedFieldMove, MSGBOX_DEFAULT)
	closemessage
    goto(EventScript_RockSmashCommon)
}

script FollowerSpottedAnItemNearby{
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_FOLLOWER, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(48)
    setflag(FLAG_FOLLOWER_FINDER_INTRO)
    bufferlivemonnickname(0)
    msgbox(FollowerSpottedAnItemNearby_Text, MSGBOX_SIGN)
    end
}
text FollowerSpottedAnItemNearby_Text{
    "{STR_VAR_1} seems to have spotted\n"
    "something interesting nearby!"
}
script FollowerAfterFindingItem{
    bufferlivemonnickname(0)
    msgbox(FollowerSpottedAnItemNearby_Text, MSGBOX_NPC)
}
script CheckForTentSpecialPrize{
    if(var(VAR_TENT_SPECIAL_PRIZE) != 3){
        addvar(VAR_TENT_SPECIAL_PRIZE, 1)
    }
    switch(var(VAR_TENT_SPECIAL_PRIZE)){
        case 1:
            msgbox(GainedASpecialTicket)
        case 2:
            msgbox(NowHaveTwoTickets)
        case 3:
            msgbox(TentGrandPrize)
            giveitem(ITEM_FRESH_START_MOCHI)
            if(var(VAR_RESULT) == FALSE){
                goto(SlateportCity_BattleTentLobby_EventScript_NoRoomForPrize)
            }
            setvar(VAR_TENT_SPECIAL_PRIZE, 0)
    }
    goto(SlateportCity_BattleTentLobby_EventScript_EndGivePrize)
}
text GainedASpecialTicket{
    "Due to your victory, you have\n"
    "earned a special victory ticket.\p"
    "Earn two more victory tickets, and\n"
    "you will get a special extra prize!"
}
text NowHaveTwoTickets{
    "You now have two victory tickets.\p"
    "Earn one more ticket for a special\n"
    "extra prize!"
}
text TentGrandPrize{
    "You just earned your third victory\n"
    "ticket.\p"
    "This means you are eligible for a\n"
    "special reward, a Fresh Start Mochi!"
}
script TradeSeedsForFertilizer{
    lock
    faceplayer
    if(flag(FLAG_MET_STRANGE_SEED_TRADER)){
        if(checkitem(ITEM_STRANGE_SEED) == TRUE){
            if(msgbox(HereToTradeMoreSeeds, MSGBOX_YESNO) == TRUE){
                goto(TradeSeedsMain)
            }
        }
        goto(TradeSeedsGoodbye)
    }
    msgbox(SeenAnyStrangeSeeds, MSGBOX_NPC)
    if (checkitem(ITEM_STRANGE_SEED) == TRUE){
        playse(SE_PIN)
        safefollow
        exclamationmark(4)
        setflag(FLAG_MET_STRANGE_SEED_TRADER)
        if(msgbox(CareToTradeSeeds, MSGBOX_YESNO) == TRUE){
            goto(TradeSeedsMain)
        }
        else{
            goto(TradeSeedsGoodbye)
        }
    }
    if(!flag(FLAG_Q12_FLOWERSHOP_STRANGESEED_START)){
        startquest(FLAG_Q12_FLOWERSHOP_STRANGESEED_START)
        special(ShowJournalPopupAdd)
    }
    end
}
script TradeSeedsMain{
    checkitemquant(ITEM_STRANGE_SEED)
    if(msgbox(TradeHowManySeeds, MSGBOX_HOWMANY) == 0){
        goto(TradeSeedsGoodbye)
    }
    else{
        copyvar(VAR_TEMP_2, VAR_RESULT)
        buffernumberstring(STR_VAR_1, VAR_TEMP_2)
        while(var(VAR_RESULT) != 0){
            subvar(VAR_RESULT, 1)
            addvar(VAR_TEMP_1, 2)
        }
        buffernumberstring(STR_VAR_2, VAR_TEMP_1)
        if(var(VAR_TEMP_2) == 1){
            if(msgbox(TradeSeedsForFertilizer_Text_Single, MSGBOX_YESNO) == TRUE){
                if(checkitemspace(ITEM_FERTILIZER, VAR_TEMP_1) == FALSE){
                    setvar(VAR_TEMP_1, 0)
                    setvar(VAR_TEMP_2, 0)
                    goto(ZeBagIsFull)
                }
                giveitem(ITEM_FERTILIZER, VAR_TEMP_1)
                removeitem(ITEM_STRANGE_SEED, VAR_TEMP_2)
            }
        }
        else{
            if(msgbox(TradeSeedsForFertilizer_Text_Multiple, MSGBOX_YESNO) == TRUE){
                if(checkitemspace(ITEM_FERTILIZER, VAR_TEMP_1) == FALSE){
                    setvar(VAR_TEMP_1, 0)
                    setvar(VAR_TEMP_2, 0)
                    goto(ZeBagIsFull)
                }
                giveitem(ITEM_FERTILIZER, VAR_TEMP_1)
                removeitem(ITEM_STRANGE_SEED, VAR_TEMP_2)
            }
        }
        goto(TradeSeedsGoodbye)
    }}
script TradeSeedsGoodbye{
    setvar(VAR_TEMP_1, 0)
    setvar(VAR_TEMP_2, 0)
    msgbox(ComeTradeWhenGetMoreSeeds, MSGBOX_NPC)
    if(flag(FLAG_Q12_FLOWERSHOP_STRANGESEED_START) && !flag(FLAG_Q12_FLOWERSHOP_STRANGESEED_COMPLETE)){
        completequest(FLAG_Q12_FLOWERSHOP_STRANGESEED_COMPLETE)
        special(ShowJournalPopupRemove)
    }
    end}
text SeenAnyStrangeSeeds{
    "I've been hearing some rumors about\n"
    "Pokémon hiding strange seeds in trees."}
text CareToTradeSeeds{
    "Ah, those seeds seem to match\n"
    "the description!\p"
    "I have this special plant fertilizer\n"
    "that can greatly improve the growth\l"
    "rate of berry trees.\p"
    "If you'd like, I can trade you\n"
    "two batches of the fertilizer\l"
    "for a single strange seed."}
text ComeTradeWhenGetMoreSeeds{
    "If you find any strange seeds, I'll\n"
    "gladly trade them for some fertilizer."}
text HereToTradeMoreSeeds{
    "Here to trade some strange seeds?"}
text TradeHowManySeeds{
    "How many seeds would you\n"
    "like to trade?"}
text TradeSeedsForFertilizer_Text_Single{
    "One seed for two batches\n"
    "of fertilizer.\p"
    "Is that trade okay?"}
text TradeSeedsForFertilizer_Text_Multiple{
    "{STR_VAR_1} seeds for {STR_VAR_2} batches\n"
    "of fertilizer.\p"
    "Is that trade okay?"}


