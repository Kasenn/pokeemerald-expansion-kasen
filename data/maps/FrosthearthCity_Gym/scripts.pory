script FrostGym_Tr10_RangerF2 {
    if(!defeated(TRAINER_FROSTGYM_TR10_RANGER_F2)){
        call(CheckForLiveMons)
    }
    lock
    playbgm(MUS_ENCOUNTER_COOL, FALSE)
    applymovement(OBJ_RANGER_F, ExclamationMark)
    waitmovement(0)
    delay(48)
    turnobject(0xFF, DIR_SOUTH)
    goto(FrostGym_Tr10_RangerF2_Main)
}
script FrostGym_Tr10_RangerF2_Interact{
    if(defeated(TRAINER_FROSTGYM_TR10_RANGER_F2)){
        msgbox(FrostGymTr10_PostBattle, MSGBOX_NPC)
        end
    }
    special(HasEnoughMonsForDoubleBattle)
    if(var(VAR_RESULT) != PLAYER_HAS_TWO_USABLE_MONS){
        msgbox(FrostGymTr10_NotEnoughMons, MSGBOX_NPC)
        end
    }
    lock
    faceplayer
    playbgm(MUS_ENCOUNTER_COOL, FALSE)
    goto(FrostGym_Tr10_RangerF2_Main)
}
script FrostGym_Tr10_RangerF2_Main{
    msgbox(FrostGymTr10_Intro)
    trainerbattle_two_trainers(TRAINER_FROSTGYM_TR10_RANGER_F2, FrostGymTr10_Lose, TRAINER_FROSTGYM_TR9_KINDLER2, FrostGymTr9_Lose)
    delay(30)
    applymovement(OBJ_KINDLER2, moves(lock_facing_direction, walk_down))
    applymovement(OBJ_RANGER_F, moves(lock_facing_direction, walk_down))
    waitmovement(0)
    setobjectxyperm(OBJ_KINDLER2, 33, 31)
    setobjectxyperm(OBJ_RANGER_F, 34, 31)
    settrainerflag(TRAINER_FROSTGYM_TR9_KINDLER2)
    settrainerflag(TRAINER_FROSTGYM_TR10_RANGER_F2)
    release
}
text FrostGymTr10_Intro {
    "I'm Pryce's most talented student.\n"
    "You have no chance against me!"
}
text FrostGymTr10_Lose {
    "Good job beating up a mere\n"
    "student.\p"
    "Now let's see if you can take\n"
    "on the teacher!"
}
text FrostGymTr10_PostBattle {
    "Just beyond here lies the\n"
    "Gym Leaders' chamber.\p"
    "I hope you're prepared for the\n"
    "challenge ahead."
}
text FrostGymTr10_NotEnoughMons{
    "I'm sorry, but we only battle\n"
    "in pairs.\p"
    "If you want to battle us, make sure\n"
    "you have at least two Pokémon first."
}
