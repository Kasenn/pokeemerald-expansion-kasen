script Frosthearth_Gym_Statue{
    if(flag(FLAG_BADGE06_GET)){
        msgbox(Frosthearth_Gym_Statue_Post, MSGBOX_NPC)
    }
    else{
        msgbox(Frosthearth_Gym_Statue_Text, MSGBOX_NPC)
    }
}
text Frosthearth_Gym_Statue_Text{
    "Frosthearth City Pokémon Gym\p"
	"Pryce and Blaine's certified\n"
    "trainers:\l"
    "{BROTHER}"
}
text Frosthearth_Gym_Statue_Post{
    "Frosthearth City Pokémon Gym\p"
	"Pryce and Blaine's certified\n"
    "trainers:\l"
    "{BROTHER}\l"
	"{PLAYER}"
}
script Frosthearth_Gym_Guide{
    if(flag(FLAG_BADGE06_GET)){
        msgbox(Frosthearth_Gym_Guide_Post, MSGBOX_NPC)
    }
    else{
        msgbox(Frosthearth_Gym_Guide_Text, MSGBOX_NPC)
    }
}
text Frosthearth_Gym_Guide_Text{
    "Yo, champ in the making!\p"
    "Don't let the looks of the gym\n"
    "deceive you!\p"
    "The gym may look like it's all\n"
    "frozen over, but the passion\l"
    "of the trainers here burns bright!\p"
    "Our Gym Leaders Pryce and Blaine\n"
    "specialize in Ice- and Fire-type\l"
    "Pokémon, so you best prepare\l"
    "accordingly!\p"
    "If you're feeling lost and can't\n"
    "seem to find a way forward,\l"
    "try battling some of the trainers\l"
    "you see here.\p"
    "Maybe they'll give you a\n"
    "helping hand!\p"
    "Anyway, that's enough from me.\n"
    "Go get 'em, Champ!"
}
text Frosthearth_Gym_Guide_Post{
    "Way to go, Champ!\p"
    "Going against a Gym Leader\n"
    "can be tough, but here you are,\l"
    "having beaten two at the same time!\p"
    "Keep pushing forward, and you'll\n"
    "be challenging the Pokémon League\l"
    "in no time!"
}

script FrosthearthGym_LeaderTrigger{
    special(HasEnoughMonsForDoubleBattle)
    if(var(VAR_RESULT) != PLAYER_HAS_TWO_USABLE_MONS){
        release
        end
    }
    setvar(VAR_TEMP_0, 5)
    call(GymStartingMovement)
    msgbox(BlainePryceIntro)
    msgbox(BlainePryceIntro2)
    msgbox(BlainePryceIntro3)
    trainerbattle_two_trainers(TRAINER_LEADER_BLAINE, BlaineLoseText, TRAINER_LEADER_PRYCE, PryceLoseText)

    goto(FrosthearthGym_PosBatEvent)
}

script FrosthearthGym_PosBatEvent{
	call(GymMovementAfter)
    msgbox(Pryce_AfterDefeat)
	message(FrosthearthGym_ReceiveBadge)
	waitmessage
	call(Common_EventScript_PlayGymBadgeFanfare)
	msgbox(Pryce_ExplainBadge)
    closemessage
	setflag(FLAG_BADGE06_GET)
    applymovement(13, moves(walk_left, walk_in_place_fast_up))
    applymovement(0xFF, moves(delay_16, walk_in_place_fast_down))
    waitmovement(0)
    msgbox(BlaineTakeThisTM)
	giveitem(ITEM_TM_ICE_BURN)
	msgbox (Blaine_ExplainIceBurn)
    call(SetFrosthearthGymTrainerFlags)
    closemessage
    special(RemoveCameraObject)
	release
	end
}
script SetFrosthearthGymTrainerFlags{
    settrainerflag(TRAINER_LEADER_PRYCE)
    settrainerflag(TRAINER_LEADER_BLAINE)
    settrainerflag(TRAINER_FROSTGYM_TR1_HIKER1)
    settrainerflag(TRAINER_FROSTGYM_TR2_KINDLER1)
    settrainerflag(TRAINER_FROSTGYM_TR3_SENIOR)
    settrainerflag(TRAINER_FROSTGYM_TR4_JUNIOR)
    settrainerflag(TRAINER_FROSTGYM_TR5_RANGER_M)
    settrainerflag(TRAINER_FROSTGYM_TR6_RANGER_F)
    settrainerflag(TRAINER_FROSTGYM_TR7_MANIAC)
    settrainerflag(TRAINER_FROSTGYM_TR8_COLLECTOR)
    settrainerflag(TRAINER_FROSTGYM_TR9_KINDLER2)
    settrainerflag(TRAINER_FROSTGYM_TR10_RANGER_F2)
    return
}

text Pryce_AfterDefeat{
    "Pryce: You've surpassed my\n"
    "expectations.\p"
    "As one of the Gym Leaders of\n"
    "this gym, I am authorized to\l"
    "give you this."
}
text FrosthearthGym_ReceiveBadge{
    "{PLAYER} received the Frostburn Badge\n"
	"from Pryce!"
}
text Pryce_ExplainBadge{
    "With the Frostburn Badge in your\n"
    "possession, any traded Pokémon\l"
    "up to level 80 should unquestionably\l"
    "follow all of your commands."
}
text BlaineTakeThisTM{
    "Blaine: Wait up, kiddo!\p"
    "Here, you can have this,\n"
    "too!"
}
text Blaine_ExplainIceBurn{
    "That TM contains the move\n"
    "Ice Burn.\p"
    "It's a really powerful Ice-type\n"
    "attack that can leave the opponent\l"
    "with a very nasty burn.\p"
    "Do be careful though!\p"
    "It takes a while to charge up\n"
    "the move, leaving your Pokémon\l"
    "vulnerable to attacks!"
}
text BlainePryceIntro{
    "Pryce: Welcome, challenger.\p"
    "I'm surprised to see you again\n"
    "so soon."
}
text BlainePryceIntro2{
    "Blaine: So this is the kid you\n"
    "were talking about?\p"
    "Interesting…\p"
    "I'm curious to see if they'll\n"
    "measure up to your praises."
}
text BlainePryceIntro3{
    "Blaine: In any case…\p"
    "Yes, welcome, challenger!\n"
    "I am Blaine!\p"
    "Pryce: And I am Pryce!\p"
    "Blaine: Together we are the Gym\n"
    "Leaders of the Frosthearth\l"
    "Pokémon Gym!\p"
    "I hope you are well prepared\n"
    "for both ends of the extremes,\l"
    "for our Pokémon will incinerate,\l"
    "Pryce: And freeze any challengers!"
}
text BlaineLoseText{
    "What?! Our combination\n"
    "was shattered!\p"
    "This was not the outcome\n"
    "I expected to see!"
}
text PryceLoseText{
    "Hmph…\p"
    "When I first laid my eyes on you,\n"
    "I knew one day you would surpass me.\p"
    "I just didn't imagine that day\n"
    "to be so soon…"
}

script FrosthearthGym_PryceTalk{
    if(flag(FLAG_BADGE06_GET)){
        msgbox(FrosthearthGym_PrycePosBat, MSGBOX_NPC)
    }
	else{
        special(HasEnoughMonsForDoubleBattle)
        if(var(VAR_RESULT) != PLAYER_HAS_TWO_USABLE_MONS){
            msgbox(PryceNotEnoughMons, MSGBOX_NPC)
        }
		else{
            msgbox(PryceGoStandInArena, MSGBOX_NPC)
        }
		turnobject(12, DIR_WEST)
    }
}

script FrosthearthGym_BlaineTalk{
    if(flag(FLAG_BADGE06_GET)){
        msgbox(FrosthearthGym_BlainePosBat, MSGBOX_NPC)
    }
	else{
        special(HasEnoughMonsForDoubleBattle)
        if(var(VAR_RESULT) != PLAYER_HAS_TWO_USABLE_MONS){
            msgbox(BlaineNotEnoughMons, MSGBOX_NPC)
        }
		else{
            msgbox(BlaineGoStandInArena, MSGBOX_NPC)
        }
		turnobject(13, DIR_WEST)
    }
}

text FrosthearthGym_PrycePosBat{
    "Make sure to always keep your\n"
    "head cool, and you'll end up\l"
    "doing great things.\p"
    "I'm sure of it!"
}
text PryceNotEnoughMons{
    "Ah, my savior has arrived.\p"
    "I had a feeling we'd be meeting\n"
    "again sooner or later.\p"
    "Before we begin, do make sure\n"
    "you have at least two Pokémon\l"
    "that are ready to battle.\p"
    "Once ready, take your place on\n"
    "the other side of the arena."
}
text PryceGoStandInArena{
    "Ah, my savior has arrived.\p"
    "I had a feeling we'd be meeting\n"
    "again sooner or later.\p"
    "Go on, take your place on the other\n"
    "side of the arena and we may begin."
}
text FrosthearthGym_BlainePosBat{
    "I can see the fire burning in\n"
    "your heart.\p"
    "You're gonna go far, kid!"
}
text BlaineNotEnoughMons{
    "Ah, a new challenger has arrived.\p"
    "Oh, but you seem to be running low\n"
    "on Pokémon.\p"
    "Make sure you have at least two\n"
    "Pokémon that are ready to battle.\p"
    "Once you've done that, go ahead and\n"
    "stand right over there on the other\l"
    "side of the arena, and we may begin."
}
text BlaineGoStandInArena{
    "Ah, a new challenger has arrived.\p"
    "If you're ready, go ahead and\n"
    "stand right over there on the other\l"
    "side of the arena, and we may begin."
}
