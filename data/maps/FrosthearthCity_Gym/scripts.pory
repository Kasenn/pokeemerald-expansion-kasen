const OBJ_KINDLER1 = 1
const OBJ_HIKER = 2
const OBJ_SENIOR = 3
const OBJ_JUNIOR = 4
const OBJ_RANGER_F1 = 5
const OBJ_RANGER_M = 6
const OBJ_MANIAC = 7
const OBJ_COLLECTOR = 8
const OBJ_KINDLER2 = 9
const OBJ_RANGER_F = 10

mapscripts FrosthearthCity_Gym_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        setflag(FLAG_TEMP_HIDE_FOLLOWER)
        if(defeated(TRAINER_FROSTGYM_TR1_HIKER1) || defeated(TRAINER_FROSTGYM_TR2_KINDLER1))
        {
            setobjectxyperm(OBJ_HIKER, 7, 40)
            setobjectxyperm(OBJ_KINDLER1, 7, 39)
        }
        if(defeated(TRAINER_FROSTGYM_TR3_SENIOR))
        {
            setobjectxyperm(OBJ_SENIOR, 14, 23)
            setobjectxyperm(OBJ_JUNIOR, 14, 24)
        }
        if(defeated(TRAINER_FROSTGYM_TR5_RANGER_M) || defeated(TRAINER_FROSTGYM_TR6_RANGER_F))
        {
            setobjectxyperm(OBJ_RANGER_F1, 19, 37)
            setobjectxyperm(OBJ_RANGER_M, 19, 38)
        }
        if(defeated(TRAINER_FROSTGYM_TR7_MANIAC) || defeated(TRAINER_FROSTGYM_TR8_COLLECTOR))
        {
            setobjectxyperm(OBJ_MANIAC, 26, 25)
            setobjectxyperm(OBJ_COLLECTOR, 26, 24)
        }
        if(defeated(TRAINER_FROSTGYM_TR9_KINDLER2) || defeated(TRAINER_FROSTGYM_TR10_RANGER_F2))
        {
            setobjectxyperm(OBJ_KINDLER2, 33, 31)
            setobjectxyperm(OBJ_RANGER_F, 34, 31)
        }
    }
    MAP_SCRIPT_ON_RESUME{
        setstepcallback(STEP_CB_ICY_GYM_FLOOR)
    }
}

script CheckForLiveMons{
    special(HasEnoughMonsForDoubleBattle)
    if(var(VAR_RESULT) != PLAYER_HAS_TWO_USABLE_MONS){
        release
        end
    }
    else{
        return
    }
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////
script FrostGym_Tr1_Hiker1{
    if(!defeated(TRAINER_FROSTGYM_TR1_HIKER1)){
        call(CheckForLiveMons)
    }
    lock
    playbgm(MUS_ENCOUNTER_HIKER, FALSE)
    applymovement(OBJ_HIKER, ExclamationMark)
    waitmovement(0)
    delay(48)
    goto(FrostGym_Tr1_Hiker1_Main)
}
script FrostGym_Tr1_Hiker1_Interact{
    if(defeated(TRAINER_FROSTGYM_TR1_HIKER1)){
        msgbox(FrostGymTr1_PostBattle, MSGBOX_NPC)
        end
    }
    special(HasEnoughMonsForDoubleBattle)
    if(var(VAR_RESULT) != PLAYER_HAS_TWO_USABLE_MONS){
        msgbox(FrostGymTr1_NotEnoughMons, MSGBOX_NPC)
        end
    }
    lock
    faceplayer
    playbgm(MUS_ENCOUNTER_HIKER, FALSE)
    goto(FrostGym_Tr1_Hiker1_Main)
}
script FrostGym_Tr1_Hiker1_Main{
    msgbox(FrostGymTr1_Intro)
    trainerbattle_two_trainers(TRAINER_FROSTGYM_TR1_HIKER1, FrostGymTr1_Lose, TRAINER_FROSTGYM_TR2_KINDLER1, FrostGymTr2_Lose)
    delay(30)
    applymovement(OBJ_HIKER, moves(lock_facing_direction, walk_left))
    applymovement(OBJ_KINDLER1, moves(lock_facing_direction, walk_left))
    waitmovement(0)
    setobjectxyperm(OBJ_HIKER, 7, 40)
    setobjectxyperm(OBJ_KINDLER1, 7, 39)
    settrainerflag(TRAINER_FROSTGYM_TR1_HIKER1)
    settrainerflag(TRAINER_FROSTGYM_TR2_KINDLER1)
    release
}
text FrostGymTr1_Intro {
    "Having trouble figuring out\n"
    "the way?\p"
    "Defeat us, and maybe the way\n"
    "will become clear!"
}
text FrostGymTr1_Lose {
    "Looks like we lost.\n"
    "Best we step aside…"
}
text FrostGymTr1_PostBattle {
    "In this gym, defeating other\n"
    "trainers is your road to success!"
}
text FrostGymTr1_NotEnoughMons{
    "You're going to need more Pokémon\n"
    "if you want to battle us!"
}
