}

script Route10_Tr1_AceSwimmer {
    if(defeated(TRAINER_R10_TR1_ACESWIMMER)){
        goto(R10_Ace_PostBattle)
    }
    elif(defeated(TRAINER_R10_TR2_SWIMMER_F1)
      && defeated(TRAINER_R10_TR4_SWIMMER_M1)
      && defeated(TRAINER_R10_TR7_SWIMMER_F2)
      && defeated(TRAINER_R10_TR8_SWIMMER_M2))
    {
        goto(R10_Ace_EligibleForBattle)
    }
    else{
        msgbox(R10_Ace_NotEligible, MSGBOX_NPC)
        end
    }
}
script R10_Ace_EligibleForBattle{
    lockall
    faceplayer
    if(!flag(FLAG_TEMP_5)){
        setflag(FLAG_TEMP_5)
        msgbox(R10_Ace_ReadyForBattle, MSGBOX_YESNO)
    }
    else{
        msgbox(R10_Ace_ReadyForBattleShort, MSGBOX_YESNO)
    }
    if(var(VAR_RESULT) == TRUE){
        msgbox(R10_Ace_BeginBattle, MSGBOX_DEFAULT)
        trainerbattle_no_intro(TRAINER_R10_TR1_ACESWIMMER, R10_Ace_Lose)
        goto(R10_Ace_PostBattle)
    }
    msgbox(R10_Ace_DeclineBattle, MSGBOX_NPC)
    end
}

script R10_Ace_PostBattle{
    lock
    faceplayer
    if(flag(FLAG_OBTAINED_BLUNDER_POLICY)){
        msgbox(R10_Ace_PostBattle_Text, MSGBOX_NPC)
        end
    }
    msgbox(R10_Ace_Reward, MSGBOX_DEFAULT)
    if(checkitemspace(ITEM_BLUNDER_POLICY) == FALSE){
        goto(ZeBagIsFull)
    }
    giveitem(ITEM_BLUNDER_POLICY)
    waitfanfare
    msgbox(R10_Ace_ExplainReward)
    setflag(FLAG_OBTAINED_BLUNDER_POLICY)
    setvar(VAR_0x8004, 30)
    call(RewardBP)
    release
    end
}

text R10_Ace_NotEligible{
    "I met some rude swimmers here\n"
    "not too long ago.\p"
    "I wish I could've put them in their\n"
    "place, but my slow Pokémon just\l"
    "couldn't catch up to them.\p"
    "Why don't you see if you can take\n"
    "them on?\p"
    "And once you've done that, come back\n"
    "to me if you want a real challenge."
}
text R10_Ace_ReadyForBattle{
    "I saw how you handled those rude\n"
    "swimmers.\p"
    "You're pretty good.\p"
    "But are you good enough to handle\n"
    "my Pokémon?"
}
text R10_Ace_ReadyForBattleShort{
    "Think you're good enough to handle\n"
    "my Pokémon?"
}
text R10_Ace_BeginBattle{
    "The game's on!"
}
text R10_Ace_Lose{
    "Oh wow, I sure got put in my place."
}
text R10_Ace_DeclineBattle{
    "Aww… And here I was getting my\n"
    "hopes up…"
}
text R10_Ace_PostBattle_Text{
    "I should be sad for losing, but\n"
    "seeing you beat those rude swimmers\l"
    "really made my day."
}
text R10_Ace_Reward{
    "Oh wow, you're way stronger\n"
    "than I expected.\p"
    "I thought I had my strategy perfected\n"
    "to a tee, but I guess I still need\l"
    "some more practice.\p"
    "Maybe you can put this item to\n"
    "better use?"
}
text R10_Ace_ExplainReward{
    "That there Blunder Policy massively\n"
    "boosts a Pokémon's speed when it\l"
    "misses with a move.\p"
    "Use it in combination with strong-\n"
    "hitting, low-accuracy moves, and\l"
    "watch how your Pokémon turns into\l"
    "an unstoppable force!\p"
    "Oh, and before I forget,\n"
    "take these as well."
}