mapscripts WW_Grotto_MapScripts{
    MAP_SCRIPT_ON_TRANSITION: WW_Grotto_SetObject
    MAP_SCRIPT_ON_RESUME: RemoveStaticEncounter
}
script WW_Grotto_SetObject{
    if (var(VAR_HIDDEN_GROTTO_INTRO) == STORY_HIDDEN_GROTTO_TALKED_TO_AIDE){
        if (var(VAR_GROTTO_1) <= 39){
            setvar(VAR_GROTTO_1, 79)
        }
        setvar(VAR_HIDDEN_GROTTO_INTRO, STORY_HIDDEN_GROTTO_ENTERED_HIDDEN_GROTTO)
    }
    call(SetHiddenGrottoGfx)
}