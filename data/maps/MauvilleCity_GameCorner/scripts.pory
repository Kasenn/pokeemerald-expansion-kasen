script Amberock_GameCorner_PrizeMegaStones{
    lock
	msgbox(AmberockTown_GameCorner_ExchangeCoinsForPrizes)
    if(checkitem(ITEM_COIN_CASE) == TRUE){
        message(AmberockTown_GameCorner_WhichPrize)
	    waitmessage
	    setvar(VAR_TEMP_1, 0)
	    showcoinsbox(1, 1)
	    goto(Amberock_GameCorner_ChooseMegaStone)
    }
    release
}

script Amberock_GameCorner_ChooseMegaStone{
    dynmultipush("Absolite{CLEAR_TO 0x48}2,000 coins", 0)
	dynmultipush("Alakazite{CLEAR_TO 0x48}2,000 coins", 1)
	dynmultipush("Audinite{CLEAR_TO 0x48}2,000 coins", 2)
    dynmultipush("Lopunnite{CLEAR_TO 0x48}2,000 coins", 3)
    dynmultipush("Manectite{CLEAR_TO 0x48}2,000 coins", 4)
    dynmultipush("Exit", 5)
    dynmultistack(23, 0, FALSE, 3, FALSE, 0, NULL)
	switch(var(VAR_RESULT)){
		case 0:
	        setvar(VAR_0x8004, ITEM_ABSOLITE)
		case 1:
	        setvar(VAR_0x8004, ITEM_ALAKAZITE)
        case 2:
	        setvar(VAR_0x8004, ITEM_AUDINITE)
        case 3:
	        setvar(VAR_0x8004, ITEM_LOPUNNITE)
        case 4:
	        setvar(VAR_0x8004, ITEM_MANECTITE)
		case 5:
			goto(AmberockTown_GameCorner_CancelRewardSelect)
		case MULTI_B_PRESSED:
			goto(AmberockTown_GameCorner_CancelRewardSelect)
	}
    goto(Amberock_GameCorner_ConfirmMegaStone)
}

script Amberock_GameCorner_NotEnoughCoins{
    msgbox("I'm sorry, but you don't have\nenough coins.")
	hidecoinsbox(0, 0)
	release
	end
}

script Amberock_GameCorner_ConfirmMegaStone{
    bufferitemname(STR_VAR_1, VAR_0x8004)
    if(msgbox(AmberockTown_GameCorner_SoYourChoiceIsTheTMX, MSGBOX_YESNO) == FALSE){
        goto(AmberockTown_GameCorner_CancelRewardSelect)
    }
    if(checkcoins(VAR_TEMP_2) < MEGA_STONE_COINS){
        goto(Amberock_GameCorner_NotEnoughCoins)
    }
    if(checkitemspace(VAR_0x8004) == FALSE){
		call(Common_EventScript_BagIsFull)
		message(AmberockTown_GameCorner_WhichPrize)
		waitmessage
		goto(Amberock_GameCorner_ChooseMegaStone)
    }
    removecoins(MEGA_STONE_COINS)
    additem(VAR_0x8004)
    updatecoinsbox(1, 1)
    playse(SE_SHOP)
    msgbox(AmberockTown_GameCorner_HereYouGo)
    goto(Amberock_GameCorner_ChooseMegaStone)
}

script Amberock_GameCorner_PrizePokemon{
    lock
	msgbox(AmberockTown_GameCorner_ExchangeCoinsForPrizes)
    if(checkitem(ITEM_COIN_CASE) == TRUE){
        message(AmberockTown_GameCorner_WhichPrize)
	    waitmessage
	    setvar(VAR_TEMP_1, 0)
	    showcoinsbox(1, 1)
	    goto(Amberock_GameCorner_ChoosePokemon)
    }
    release
}

script Amberock_GameCorner_ChoosePokemon{
    dynmultipush("Abra{CLEAR_TO 0x48}700 coins", 0)
	dynmultipush("Stufful{CLEAR_TO 0x48}1,400 coins", 1)
    dynmultipush("Honedge{CLEAR_TO 0x48}2,100 coins", 2)
    dynmultipush("Bagon{CLEAR_TO 0x48}2,800 coins", 3)
    dynmultipush("Exit", 4)
    dynmultistack(23, 0, FALSE, 3, FALSE, 0, NULL)
	switch(var(VAR_RESULT)){
		case 0:
	        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_ABRA)
            setvar(VAR_TEMP_3, ABRA_COINS)
		case 1:
	        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_STUFFUL)
            setvar(VAR_TEMP_3, STUFFUL_COINS)
        case 2:
	        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_HONEDGE)
            setvar(VAR_TEMP_3, HONEDGE_COINS)
        case 3:
	        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_BAGON)
            setvar(VAR_TEMP_3, BAGON_COINS)
		case 4:
			goto(AmberockTown_GameCorner_CancelRewardSelect)
		case MULTI_B_PRESSED:
			goto(AmberockTown_GameCorner_CancelRewardSelect)
	}
    goto(Amberock_GameCorner_ConfirmPokemon)
}

script Amberock_GameCorner_ConfirmPokemon{
    bufferspeciesname(STR_VAR_1, VAR_TEMP_TRANSFERRED_SPECIES)
    if(msgbox(AmberockTown_GameCorner_SoYourChoiceIsTheTMX, MSGBOX_YESNO) == FALSE){
        goto(AmberockTown_GameCorner_CancelRewardSelect)
    }
    if(checkcoins(VAR_TEMP_2) < VAR_TEMP_3){
        goto(Amberock_GameCorner_NotEnoughCoins)
    }
    givemon(VAR_TEMP_TRANSFERRED_SPECIES, 10)
    if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY){
        removecoins(VAR_TEMP_3)
        updatecoinsbox(1, 1)
        playse(SE_SHOP)
        msgbox(AmberockTown_GameCorner_HereYouGo)
        call(Amberock_GameCorner_ReceivedMonFanfare)
        if(msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO) == FALSE){
            goto(Amberock_GameCorner_EndScript)
        }
        call(Common_EventScript_GetGiftMonPartySlot)
	    call(Common_EventScript_NameReceivedPartyMon)
        goto(Amberock_GameCorner_EndScript)
    }
    elif(var(VAR_RESULT) == MON_GIVEN_TO_PC){
        removecoins(VAR_TEMP_3)
        updatecoinsbox(1, 1)
        playse(SE_SHOP)
        msgbox(AmberockTown_GameCorner_HereYouGo)
        call(Amberock_GameCorner_ReceivedMonFanfare)
        if(msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO) == FALSE){
            call(Common_EventScript_TransferredToPC)
            goto(Amberock_GameCorner_EndScript)
        }
        call(Common_EventScript_NameReceivedBoxMon)
        call(Common_EventScript_TransferredToPC)
        goto(Amberock_GameCorner_EndScript)
    }
    else{
        msgbox(gText_NoMoreRoomForPokemon)
        goto(Amberock_GameCorner_EndScript)
    }
}

script Amberock_GameCorner_EndScript{
    hidecoinsbox(0, 0)
	release
	end
}

script Amberock_GameCorner_ReceivedMonFanfare{
    bufferspeciesname(STR_VAR_1, VAR_TEMP_TRANSFERRED_SPECIES)
    bufferspeciesname(STR_VAR_2, VAR_TEMP_TRANSFERRED_SPECIES)
    playfanfare(MUS_OBTAIN_ITEM)
    message("{PLAYER} obtained the {STR_VAR_2}.")
    waitmessage
    waitfanfare
    return
}

script AmberockTown_GameCorner_CancelRewardSelect{
	msgbox(AmberockTown_GameCorner_OhIsThatSo)
	hidecoinsbox(0, 0)
	release
	end
}