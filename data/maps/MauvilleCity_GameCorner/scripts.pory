
mapscripts MauvilleCity_GameCorner_MapScripts{}

    // Game Corner prices
    const ABRA_COINS = 700
    const STUFFUL_COINS = 1400
    const HONEDGE_COINS = 2100
    const BAGON_COINS = 2800

	const MEGA_STONE_COINS = 2000

	const COINS_PRICE_25 =  1000
	const COINS_PRICE_250 = 10000
	const COINS_PRICE_1000 = 40000

script AmberockTown_GameCorner_NPCReturnToSlots{
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}
script AmberockTown_GameCorner_Woman2{
	msgbox(AmberockTown_GameCorner_CoinsAreNeededToPlay, MSGBOX_NPC)
}
text AmberockTown_GameCorner_CoinsAreNeededToPlay{
	"Coins are needed to play here\n"
	"in the Game Corner."
}
script AmberockTown_GameCorner_Gentleman{
	msgbox(AmberockTown_GameCorner_RouletteOnlyLuck, MSGBOX_NPC)
}
text AmberockTown_GameCorner_RouletteOnlyLuck{
	"This roulette thing…\n"
	"It's rather demanding.\p"
	"Win or lose, it's only by luck."
}
script AmberockTown_GameCorner_OldMan{
	msgbox(AmberockTown_GameCorner_RouletteTablesDifferentRates, MSGBOX_NPC)
	goto(AmberockTown_GameCorner_NPCReturnToSlots)
}
