	"It's ¥1000 for 25 coins.\n"
	"Would you like some?"
}

text AmberockTown_GameCorner_ThankYouHereAreYourCoins{
	"Thank you very much!\n"
	"Here are your coins!"
}

text AmberockTown_GameCorner_DontHaveEnoughMoney{
	"Um… You don't appear to have\n"
	"enough money…"
}

