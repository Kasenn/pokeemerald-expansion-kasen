}
script AmberockTown_GameCorner_Woman{
	msgbox(AmberockTown_GameCorner_HeresSomeSlotsInfo, MSGBOX_NPC)
	goto(AmberockTown_GameCorner_NPCReturnToSlots)
}
text AmberockTown_GameCorner_HeresSomeSlotsInfo{
	"Here's some information for you\n"
	"about the slots.\p"
	"The more lightning bolts you stock,\n"
	"the more reel time chances you get.\p"
	"In a game with the maximum five\n"
	"reel time chances…\p"
	"It is possible to receive four regular\n"
	"bonuses, then a big bonus.\p"
	"That would total 660 coins, but it's\n"
	"very difficult to get."
}
script AmberockTown_GameCorner_PokefanM{
	if(checkitem(ITEM_COIN_CASE) == FALSE){
		msgbox(AmberockTown_GameCorner_NeedCoinCaseGoFindOne, MSGBOX_NPC)
		goto(AmberockTown_GameCorner_NPCReturnToSlots)
	}
	checkcoins(VAR_TEMP_1)
	if(var(VAR_TEMP_1) >= 1 || flag(FLAG_RECEIVED_20_COINS)){
		msgbox(AmberockTown_GameCorner_GoBigOrGoHome, MSGBOX_NPC)
		goto(AmberockTown_GameCorner_NPCReturnToSlots)
	}
	lock
	faceplayer
	setflag(FLAG_RECEIVED_20_COINS)
	addcoins(20)
	msgbox(AmberockTown_GameCorner_LuckOnlyLastSoLongTakeCoins)
	playse(SE_SHOP)
	msgbox(AmberockTown_GameCorner_GoBigOrGoHome, MSGBOX_NPC)
	goto(AmberockTown_GameCorner_NPCReturnToSlots)
}
text AmberockTown_GameCorner_NeedCoinCaseGoFindOne{
	"Hey, kid, if you want to play here,\n"
	"you need a Coin Case.\p"
	"Maybe someone in town might\n"
	"have one?"
}
text AmberockTown_GameCorner_LuckOnlyLastSoLongTakeCoins{
	"My luck can only last so long.\n"
	"This is too much for me.\l"
	"Here, take some coins!"
}
text AmberockTown_GameCorner_GoBigOrGoHome{
	"Go big or go home!"
}



script AmberockTown_GameCorner_CoinsClerk{
	lock
	faceplayer
	msgbox(AmberockTown_GameCorner_ThisIsMauvilleGameCorner)
	if(checkitem(ITEM_COIN_CASE) == FALSE){
		msgbox(AmberockTown_GameCorner_NeedCoinCaseForCoins, MSGBOX_AUTOCLOSE)
		end
	}
	message(AmberockTown_GameCorner_WereYouLookingForCoins)
	waitmessage
	showmoneybox(0, 0)
	showcoinsbox(1, 6)
	dynmultipush("    25 coins    ¥1,000", 0)
	dynmultipush("  250 coins  ¥10,000", 1)
	dynmultipush("1000 coins  ¥40,000", 2)
    dynmultipush("Exit", 3)
    dynmultistack(23, 0, FALSE, 4, FALSE, 0, NULL)
	checkcoins(VAR_TEMP_1)
	switch(var(VAR_RESULT)){
		case 0:
			goto(AmberockTown_GameCorner_Buy25Coins)
		case 1:
			goto(AmberockTown_GameCorner_Buy250Coins)
		case 2:
			goto(AmberockTown_GameCorner_Buy1000Coins)
		default:
			goto(AmberockTown_GameCorner_CancelBuyCoins)
	}
}

script AmberockTown_GameCorner_Buy25Coins{
	if(var(VAR_TEMP_1) >= MAX_COINS + 1 - 25){
		goto(AmberockTown_GameCorner_NoRoomForCoins)
	}
	if(checkmoney(COINS_PRICE_25) == FALSE){
		goto(AmberockTown_GameCorner_NotEnoughMoney)
	}
	addcoins(25)
	removemoney(COINS_PRICE_25)
	goto(AmberockTown_GameCorner_BuyCoinsEnd)
}

script AmberockTown_GameCorner_Buy250Coins{
	if(var(VAR_TEMP_1) >= MAX_COINS + 1 - 250){
		goto(AmberockTown_GameCorner_NoRoomForCoins)
	}
	if(checkmoney(COINS_PRICE_250) == FALSE){
		goto(AmberockTown_GameCorner_NotEnoughMoney)
	}
	addcoins(250)
	removemoney(COINS_PRICE_250)
	goto(AmberockTown_GameCorner_BuyCoinsEnd)
}

script AmberockTown_GameCorner_Buy1000Coins{
	if(var(VAR_TEMP_1) >= MAX_COINS + 1 - 1000){
		goto(AmberockTown_GameCorner_NoRoomForCoins)
	}
	if(checkmoney(COINS_PRICE_1000) == FALSE){
		goto(AmberockTown_GameCorner_NotEnoughMoney)
	}
	addcoins(1000)
	removemoney(COINS_PRICE_1000)
	goto(AmberockTown_GameCorner_BuyCoinsEnd)
}

script AmberockTown_GameCorner_BuyCoinsEnd{
	updatemoneybox
	updatecoinsbox(1, 6)
	playse(SE_SHOP)
	msgbox(AmberockTown_GameCorner_ThankYouHereAreYourCoins)
	hidemoneybox
	hidecoinsbox(0, 5)
	release
	end
}

script AmberockTown_GameCorner_NotEnoughMoney{
	msgbox(AmberockTown_GameCorner_DontHaveEnoughMoney)
	goto(AmberockTown_GameCorner_HideMoneyBox)
}

script AmberockTown_GameCorner_CancelBuyCoins{
	msgbox(AmberockTown_GameCorner_DontNeedCoinsThen)
	goto(AmberockTown_GameCorner_HideMoneyBox)
}

script AmberockTown_GameCorner_NoRoomForCoins{
	msgbox(AmberockTown_GameCorner_CoinCaseIsFull)
	goto(AmberockTown_GameCorner_HideMoneyBox)
}

script AmberockTown_GameCorner_HideMoneyBox{
	hidemoneybox
	hidecoinsbox(0, 5)
	release
	end
}

script AmberockTown_GameCorner_SlotMachine{
	lock
	if(checkitem(ITEM_COIN_CASE) == FALSE){
		msgbox(AmberockTown_GameCorner_CantPlayWithNoCoinCase, MSGBOX_AUTOCLOSE)
		end
	}
	specialvar(VAR_RESULT, GetSlotMachineId)
	playslotmachine(VAR_RESULT)
	releaseall
	end
}

