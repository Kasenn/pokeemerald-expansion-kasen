mapscripts DesertCliffs_MapScripts {
    MAP_SCRIPT_ON_RESUME{
        if(flag(FLAG_SYS_CTRL_OBJ_DELETE)){
            specialvar(VAR_RESULT, GetBattleOutcome)
            if(var(VAR_RESULT) == B_OUTCOME_CAUGHT){
                removeobject(VAR_LAST_TALKED)
            }
        }
    }
    MAP_SCRIPT_ON_TRANSITION{
        setescapewarp(MAP_DESERT_CLIFFS, 15, 79)
        if(checkitem(ITEM_ESCAPE_ROPE) == TRUE){
            setflag(FLAG_TEMP_A)
        }
        setflag(FLAG_HIDE_TERRAKION)
        if(var(VAR_SPHERES_FOUND) >= 4){
            if(!flag(FLAG_DEFEATED_TERRAKION)){
                clearflag(FLAG_HIDE_TERRAKION)
            }
        }
    }
}

script DesertCliffs_Terrakion{
    lock
	faceplayer
	waitse
	playmoncry(SPECIES_TERRAKION, CRY_MODE_ENCOUNTER)
	delay(40)
	waitmoncry
	setwildbattle(SPECIES_TERRAKION, 50)
	setflag(FLAG_SYS_CTRL_OBJ_DELETE)
	special(BattleSetup_StartLegendaryBattle)
	waitstate
	clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    specialvar(VAR_RESULT, GetBattleOutcome)
	if(var(VAR_RESULT) == B_OUTCOME_WON){
        setflag(FLAG_DEFEATED_TERRAKION)
	    fadescreenswapbuffers(FADE_TO_BLACK)
	    removeobject (VAR_LAST_TALKED)
	    fadescreenswapbuffers(FADE_FROM_BLACK)
	    release
	    end
    } 
	if(var(VAR_RESULT) == B_OUTCOME_RAN){
        setvar(VAR_0x8004, SPECIES_TERRAKION)
	    goto(Common_EventScript_LegendaryRanAway)
    } 
	if(var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED){
        setvar(VAR_0x8004, SPECIES_TERRAKION)
	    goto(Common_EventScript_LegendaryRanAway)
    } 
	setflag(FLAG_DEFEATED_TERRAKION)
	release
	end
}

script DesertCliff_Sign{
    msgbox(DesertCliff_Sign_Text, MSGBOX_SIGN)
}
text DesertCliff_Sign_Text{
    ""
}