script Route19_Tr4_SwimmerCoupleM{
	trainerbattle_double(TRAINER_R19_TR4_SWIMMER_COUPLE, Route19_Tr4_SwimmerCoupleM_Intro, Route19_Tr4_SwimmerCoupleM_Defeat, Route19_Tr4_SwimmerCoupleM_NotEnoughMons)
	msgbox(Route19_Tr4_SwimmerCoupleM_PostBattle, MSGBOX_AUTOCLOSE)
	end
}
text Route19_Tr4_SwimmerCoupleM_Intro{
    "Jesse: We've been honing our Pokémon\n"
    "to their limit. You cannot win!"
}
text Route19_Tr4_SwimmerCoupleM_Defeat{
    "Jesse: I was sure we had it…"
}
text Route19_Tr4_SwimmerCoupleM_NotEnoughMons{
    "Jesse: You're going to need more\n"
    "Pokémon if you want to challenge us!"
}
text Route19_Tr4_SwimmerCoupleM_PostBattle{
    "Jesse: To excel in double battles,\n"
    "you need to think about the synergy\l"
    "between your Pokémon."
}

