    lock
    msgbox(SandstoneCity_BunearyGirl_Text)
    release
}
text SandstoneCity_BunearyGirl_Text{
    "I know you don't like going to\n"
    "the Pokémon Center, but we really\l"
    "need to get that injury healed."
}