script SteppedOffofSwitchGlobal{
    special(DrawWholeMapView)
    if(var(SWITCH_4) == 100 && var(SWITCH_5) == 100 && var(SWITCH_6) == 100 && var(SWITCH_7) == 100){
        setmetatile(36, 17, METATILE_LatiIsles_LI_BarrierUp, TRUE)
        setmetatile(36, 18, METATILE_LatiIsles_LI_BarrierUp, TRUE)
        special(DrawWholeMapView)
        playse(SE_M_STRENGTH)
        waitse
    }
    else{
        playse(SE_SWITCH)
        waitse
    }
    return
}

script LatiasIsland_ReturnToSkyloch{
    msgbox(LatiasIsland_ReturnToSkyloch_Text, MSGBOX_YESNO)
    if(var(VAR_RESULT) == FALSE){
        release
        end
    }
    closemessage
    checkpartymon(SPECIES_LATIAS, FALSE)
    bufferpartymonnick(STR_VAR_1, VAR_0x8000)
    if(var(VAR_0x800A) == TRUE){
        setvar(LATI_BODY, LOCALID_LATIASISLAND_LATIAS_SHINY)
        setvar(LATI_HEAD, LOCALID_LATIASISLAND_LATIAS_SHINY_HEAD)
    }
    else{
        setvar(LATI_BODY, LOCALID_LATIASISLAND_LATIAS)
        setvar(LATI_HEAD, LOCALID_LATIASISLAND_LATIAS_HEAD)
    }
        setflag(FLAG_OVERRIDE_FOLLOWER_DIRECTION)
        setvar(VAR_FACING, DIR_SOUTH)
        waitmove(LOCALID_LATIASISLAND_LATIBALL, moves(set_visible, delay_1 * 3, lati_ball))
        showobjectat(LATI_BODY, MAP_LATIAS_ISLAND)
        showobjectat(LATI_HEAD, MAP_LATIAS_ISLAND)
        removeobject(LOCALID_LATIASISLAND_LATIBALL)
        delay(16)
        addobject(LOCALID_FAKE_PLAYER)
        setobjectsubpriority(LOCALID_FAKE_PLAYER, MAP_LATIAS_ISLAND, 0)
        hideobjectat(LOCALID_PLAYER, MAP_LATIAS_ISLAND)
        setobjectsubpriority(LATI_HEAD, MAP_LATIAS_ISLAND, 0)
        waitmove(LOCALID_FAKE_PLAYER, moves(jump_2_down, lock_anim))
        call(SetSittingPlayerModel)
        removeobject(LOCALID_FAKE_PLAYER)
        setobjectxyperm(LOCALID_FAKE_PLAYER, 15, 68)
        addobject(LOCALID_FAKE_PLAYER)
        setobjectsubpriority(LOCALID_FAKE_PLAYER, MAP_LATIAS_ISLAND, 1)
        delay(16)
        applymovement(LATI_BODY, PlayerAndLatiasLeave)
        applymovement(LATI_HEAD, PlayerAndLatiasLeave)
        applymovement(LOCALID_FAKE_PLAYER, moves(lock_anim, walk_slow_down, walk_down * 2, walk_faster_down * 4))
        waitmovement(0)
        clearflag(FLAG_STOP_GROUND_EFFECTS)
        clearflag(FLAG_OVERRIDE_FOLLOWER_DIRECTION)
        setvar(VAR_0x8004, 2)
        callnative(LatisWarp)
        special(LatiRide)
        waitstate








    // closemessage
    // waitmove(LOCALID_LATIAS, SpawnFollower)
    // playmoncry(SPECIES_LATIAS, CRY_MODE_NORMAL)
    // waitmoncry
    // clearflag(FLAG_PLAYER)
    // addobject(LOCALID_FAKE_PLAYER)
    // hideobjectat(LOCALID_PLAYER, MAP_LATIAS_ISLAND)
    // turnobject(LOCALID_LATIAS, DIR_SOUTH)
    // waitmove(LOCALID_FAKE_PLAYER, moves(jump_special_down, delay_16, lock_anim))
    // applymovement(LOCALID_LATIAS, PlayerAndLatiasLeave)
    // applymovement(LOCALID_FAKE_PLAYER, moves(lock_anim, walk_slow_down, walk_down * 2, walk_faster_down * 3))
    // waitmovement(0)
    // warpsilent(MAP_LATIAS_ISLAND, 4)
    // waitstate
}

text LatiasIsland_ReturnToSkyloch_Text{
    "Send out Latias and return\n"
    "back to Skyloch Village?"
}

movement SpawnFollower{
    set_visible
    exit_pokeball
}
movement PlayerAndLatiasLeave{
    walk_slow_down
    walk_down * 2
    walk_faster_down * 4
}
movement PlayerAndLatiasLeave2{
    walk_slow_up
    walk_up * 2
    walk_faster_up * 5
}