script SteppedOffofSwitchGlobal{
    special(DrawWholeMapView)
    if(var(SWITCH_4) == 100 && var(SWITCH_5) == 100 && var(SWITCH_6) == 100 && var(SWITCH_7) == 100){
        setmetatile(40, 38, METATILE_LatiIsles_LI_BarrierUp, TRUE)
        setmetatile(41, 38, METATILE_LatiIsles_LI_BarrierUp, TRUE)
        special(DrawWholeMapView)
        playse(SE_M_STRENGTH)
        waitse
    }
    else{
        playse(SE_SWITCH)
        waitse
    }
    return
}