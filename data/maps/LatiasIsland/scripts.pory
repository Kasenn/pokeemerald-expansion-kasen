script LatiIsle_LowerLastPuzzleBarriers{
    if(var(SWITCH_4) == 100 && var(SWITCH_5) == 100 && var(SWITCH_6) == 100 && var(SWITCH_7) == 100){
        setmetatile(36, 17, METATILE_LatiIsles_LI_BarrierDown, 0)
        setmetatile(36, 18, METATILE_LatiIsles_LI_BarrierDown, 0)
        playse(SE_M_STRENGTH)
        waitse
    }
    elif(flag(FLAG_SWITCH_4) && flag(FLAG_SWITCH_5) && flag(FLAG_SWITCH_6) && flag(FLAG_SWITCH_7)){
        setmetatile(36, 17, METATILE_LatiIsles_LI_BarrierDown, 0)
        setmetatile(36, 18, METATILE_LatiIsles_LI_BarrierDown, 0)
        playse(SE_M_STRENGTH)
        waitse
    }
    else{
        playse(SE_SWITCH)
        waitse
    }
    return
}

