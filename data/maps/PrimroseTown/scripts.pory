mapscripts PrimroseTown_MapScripts{
    MAP_SCRIPT_ON_TRANSITION{
        setflag(FLAG_VISITED_PRIMROSE_TOWN)
    }
}

script PrimroseTown_Sign{
    msgbox(PrimroseSign, MSGBOX_SIGN)
}

text PrimroseSign{
    "PRIMROSE TOWN\n“The town where sweet nectar flows.”\p{UP_ARROW} Route 2\n{RIGHT_ARROW} PRIMROSE MEADOW"
}

script Primrose_FlowerGirl{
    msgbox("Look at all those pretty flowers!\pI'd like to pick a few of them but\nI'm scared I might get attacked\lby a bug Pokémon…", MSGBOX_NPC)
}

script Primrose_FlowerBoy{
    msgbox("Sometimes Pokémon that live within\nclose proximity to people will become\lmuch more skittish than those living\lin the wilds.\pIf you disturb them too much,\nthey might even attempt to flee!", MSGBOX_NPC)
}

script Primrose_FatMan{
	msgbox("This place is real pretty.\pWould be a real shame to be allergic\nto all this pollen though…\p…\psniff…", MSGBOX_NPC)
}

script Primrose_Hiker{
    msgbox("I don't like the look of that storm…", MSGBOX_AUTOCLOSE)
}

script PrimroseBlocked{
    lock
    safefollow
    turnobject(3, DIR_EAST)
    playse(SE_PIN)
    exclamationmark(3)
    turnobject(LOCALID_PLAYER, DIR_WEST)
    msgbox(Primrose_Storm, MSGBOX_AUTOCLOSE)
    waitmove(LOCALID_PLAYER, Walk1Down)
    turnobject(3, DIR_NORTH)
    release
}

text Primrose_Storm{
    "There's a massive storm raging\nabove the next island.\pIt's too dangerous to cross\nthe bridge at this moment."
}