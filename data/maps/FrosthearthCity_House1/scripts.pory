script Hypertrain_Stat_MainBody{
    bufferpartymonnick(STR_VAR_1, VAR_MON_SLOT)
    if(msgbox(Hypertrain_Stat_Text, MSGBOX_YESNO) == FALSE){
        goto(HyperTrainingNormalBottleCap)
    }
    call(Hypertraining_Start)
    return
}

script Hypertraining_Start{
    msgbox(LetsHyperTrain)
    closemessage
    fadescreen(FADE_TO_BLACK)
    playse(SE_EXP)
    waitse
    playfanfare(MUS_LEVEL_UP)
    waitfanfare
    delay(60)
    fadescreen(FADE_FROM_BLACK)
    return
}

script HyperTrainingGoldBottleCap{
    bufferpartymonnick(STR_VAR_1, VAR_MON_SLOT)
    if(msgbox(WillCostGoldCap, MSGBOX_YESNO) == FALSE){
        goto(SelectHyperTraining)
    }
    call(Hypertraining_Start)
    if(canhypertrain(STAT_HP, VAR_MON_SLOT)){
        hypertrain(STAT_HP, VAR_MON_SLOT)
    }
    if(canhypertrain(STAT_ATK, VAR_MON_SLOT)){
        hypertrain(STAT_ATK, VAR_MON_SLOT)
    }
    if(canhypertrain(STAT_DEF, VAR_MON_SLOT)){
        hypertrain(STAT_DEF, VAR_MON_SLOT)
    }
    if(canhypertrain(STAT_SPEED, VAR_MON_SLOT)){
        hypertrain(STAT_SPEED, VAR_MON_SLOT)
    }
    if(canhypertrain(STAT_SPATK, VAR_MON_SLOT)){
        hypertrain(STAT_SPATK, VAR_MON_SLOT)
    }
    if(canhypertrain(STAT_SPDEF, VAR_MON_SLOT)){
        hypertrain(STAT_SPDEF, VAR_MON_SLOT)
    }
    msgbox(MonHasBeenHyperTrained)
    removeitem(ITEM_GOLD_BOTTLE_CAP, 1)
    msgbox(ComeBackForMoreHyperTraining)
    release
    end
}

text ChooseMonForHyperTraining{
    "Which one of your Pokémon do you\n"
    "want to do some Hyper Training on?"
}
text SelectedMonNotHighEnoughForHyperTraining{
    "Oh no… No, no, no!\p"
    "That Pokémon hasn't leveled up\n"
    "enough to be ready for my amazing\l"
    "Hyper Training!\l"
    "Only Pokémon that have reached\l"
    "Lv. 50 can handle the hype!"
}
text MonFullyHyperTrained{
    "But that Pokémon is already so awesome\n"
    "that it doesn't need any training!"
}
text UseWhichBottleCaps{
    "So will it be a Bottle Cap or\n"
    "a Gold Bottle Cap?\p"
    "See how many you've got and\n"
    "let me know."
}
text LetsHyperTrain{
    "Then get hype!\p"
    "I'm about to do some real Hyper\n"
    "Training on {STR_VAR_1} here!"
}
text SelectedMonIsEgg{
    "An Egg?!\p"
    "I understand why you're hyped to\n"
    "have one, but I can't train\l"
    "that thing yet!"
}
text ComeBackForMoreHyperTraining{
    "Come back any time you want to\n"
    "hype up any of your Pokémon!"
}
text WillCostGoldCap{
    "So you want me to get all of\n"
    "{STR_VAR_1}'s stats hyped up?"
}
text CantHypertrainThatStat{
    "But that Pokémon is already so awesome\n"
    "that it doesn't need any training\l"
    "in that stat!"
}
text WhichStatToTrain{
    "Which one of {STR_VAR_1}'s stats do\n"
    "you want to do some Hyper Training on?"
}
text Hypertrain_Stat_Text{
    "So you want to have your Pokémon\n"
    "Hyper Trained in {STR_VAR_2}?"
}
text MonHasBeenHyperTrained{
    "All right! {STR_VAR_1} got even\n"
    "stronger thanks to my Hyper Training!"
}

text HyperTrainingIntro_Text{
    "The name's Mr. Hyper!\p"
    "You want to know why I'm so hyper?\p"
    "Because I can help Pokémon do\n"
    "Hyper Training!\p"
    "Allow me to explain!\p"
    "Hyper Training is a way to help\n"
    "Pokémon that have reached Lv. 50\l"
    "become even stronger!\p"
    "This special training can help them\n"
    "increase their strength and HP and\l"
    "other stats!\p"
    "If you want me to train up your\n"
    "Pokémon, bring me some Bottle Caps.\l"
    "I collect them.\p"
    "A regular Bottle Cap will get you\n"
    "training for a single stat.\p"
    "But bring me a rare Gold Bottle Cap,\n"
    "and I'll train up all your Pokémon's\l"
    "stats to the max at once!"
}

text InterestedInHyperTraining{
    "Want to try some of my Hyper Training\n"
    "to boost your Pokémon's stats?"
}
text NotInterestedInHyperTraining{
    "Not interested in Hyper Training\n"
    "at this time?\p"
    "Then come back anytime!\p"
    "Mr. Hyper will always be hyped up\n"
    "to see you!"
}
text NoBottleCaps{
    "Oh no… No, no, no!\p"
    "You don't have a Bottle Cap or a\n"
    "Gold Bottle Cap! Not even one!"
}

script Frosthearth_TypeChecker{
    if(var(VAR_FROSTHEARTH_TYPE_CHECK) == TYPE_ELECTRIC || var(VAR_FROSTHEARTH_TYPE_CHECK) == TYPE_ICE){
        bufferstring(STR_VAR_2, "an")
    }
    else{
        bufferstring(STR_VAR_2, "a")
    }
    buffertypename(STR_VAR_1, VAR_FROSTHEARTH_TYPE_CHECK)
    lock
    faceplayer
    if(flag(FLAG_DAILY_FROSTHEARTH_TYPE_CHECK)){
        msgbox(TypeCheckerComeBackTomorrow, MSGBOX_AUTOCLOSE)
        end
    }
    msgbox(LookingForType)
    copyvar(VAR_0x8004, VAR_FROSTHEARTH_TYPE_CHECK)
    special(IsTypeInParty)
    if(var(VAR_RESULT) == FALSE){
        release
        if(!flag(FLAG_Q41_FROSTHEARTH_TYPEMON_START)){
            startquest(FLAG_Q41_FROSTHEARTH_TYPEMON_START)
            special(ShowJournalPopupAdd)
        }
        end
    }
    msgbox(YouHaveTypeInParty)
    switch(var(VAR_FROSTHEARTH_TYPE_CHECK)){
        case TYPE_NORMAL:
            giveitem(ITEM_NORMAL_GEM)
        case TYPE_FIGHTING:
            giveitem(ITEM_FIGHTING_GEM)
        case TYPE_FLYING:
            giveitem(ITEM_FLYING_GEM)
        case TYPE_POISON:
            giveitem(ITEM_POISON_GEM)
        case TYPE_GROUND:
            giveitem(ITEM_GROUND_GEM)
        case TYPE_ROCK:
            giveitem(ITEM_ROCK_GEM)
        case TYPE_BUG:
            giveitem(ITEM_BUG_GEM)
        case TYPE_GHOST:
            giveitem(ITEM_GHOST_GEM)
        case TYPE_STEEL:
            giveitem(ITEM_STEEL_GEM)
        case TYPE_FIRE:
            giveitem(ITEM_FIRE_GEM)
        case TYPE_WATER:
            giveitem(ITEM_WATER_GEM)
        case TYPE_GRASS:
            giveitem(ITEM_GRASS_GEM)
        case TYPE_ELECTRIC:
            giveitem(ITEM_ELECTRIC_GEM)
        case TYPE_PSYCHIC:
            giveitem(ITEM_PSYCHIC_GEM)
        case TYPE_ICE:
            giveitem(ITEM_ICE_GEM)
        case TYPE_DRAGON:
            giveitem(ITEM_DRAGON_GEM)
        case TYPE_DARK:
            giveitem(ITEM_DARK_GEM)
        case TYPE_FAIRY:
            giveitem(ITEM_FAIRY_GEM)
    }
    if(var(VAR_RESULT) == FALSE){
        goto(ZeBagIsFull)
    }
    setflag(FLAG_DAILY_FROSTHEARTH_TYPE_CHECK)
    release
    if(flag(FLAG_Q41_FROSTHEARTH_TYPEMON_START) && !flag(FLAG_Q41_FROSTHEARTH_TYPEMON_COMPLETE)){
        completequest(FLAG_Q41_FROSTHEARTH_TYPEMON_COMPLETE)
        special(ShowJournalPopupRemove)
    }
    end
}

text TypeCheckerComeBackTomorrow{
    "That was a fun little sport.\p"
    "Come back tomorrow, and I might\n"
    "have something new to give."
}
text LookingForType{
    "You know what?\p"
    "Today, I would really fancy seeing\n"
    "{STR_VAR_2} {STR_VAR_1}-type Pokémon.\p"
    "If you can show me one,\n"
    "I'll give you something nice."
}
text YouHaveTypeInParty{
    "Oh, but you do have\n"
    "{STR_VAR_2} {STR_VAR_1}-type Pokémon!\p"
    "Well, a promise's a promise.\n"
    "Here you go!"
}

