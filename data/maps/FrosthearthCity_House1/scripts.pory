mapscripts FrosthearthCity_House1_MapScripts {
    
}

const VAR_MON_SLOT = VAR_0x8004
const VAR_NUMBER_OF_STATS_TRAINED = VAR_TEMP_0

script Frosthearth_HyperTraining_Guru{
    if(!flag(FLAG_INTRODUCTION_TO_HYPER_TRAINING)){
        setflag(FLAG_INTRODUCTION_TO_HYPER_TRAINING)
        msgbox(HyperTrainingIntro_Text, MSGBOX_NPC)
        end
    }
    lock
    faceplayer
    if(msgbox(InterestedInHyperTraining, MSGBOX_YESNO) == FALSE){
        msgbox(NotInterestedInHyperTraining, MSGBOX_AUTOCLOSE)
        end
    }
    if(checkitem(ITEM_BOTTLE_CAP) == FALSE){
        if(checkitem(ITEM_GOLD_BOTTLE_CAP) == FALSE){
            msgbox(NoBottleCaps, MSGBOX_AUTOCLOSE)
            end
        }
    }
    msgbox(ChooseMonForHyperTraining)
    special(ChoosePartyMon)
    waitstate
    if(var(VAR_MON_SLOT) == PARTY_NOTHING_CHOSEN){
        msgbox(NotInterestedInHyperTraining, MSGBOX_AUTOCLOSE)
        end
    }
    checkhypertraininglevel(50)
    if(var(VAR_RESULT) == FALSE){
        bufferpartymonnick(STR_VAR_1, VAR_MON_SLOT)
        msgbox(SelectedMonNotHighEnoughForHyperTraining, MSGBOX_AUTOCLOSE)
        end
    }
    if(canhypertrain(STAT_HP, VAR_MON_SLOT) == TRUE){
        addvar(VAR_NUMBER_OF_STATS_TRAINED, 1)
    }
    if(canhypertrain(STAT_ATK, VAR_MON_SLOT) == FALSE){
        addvar(VAR_NUMBER_OF_STATS_TRAINED, 1)
    }
    if(canhypertrain(STAT_DEF, VAR_MON_SLOT) == FALSE){
        addvar(VAR_NUMBER_OF_STATS_TRAINED, 1)
    }
    if(canhypertrain(STAT_SPEED, VAR_MON_SLOT) == FALSE){
        addvar(VAR_NUMBER_OF_STATS_TRAINED, 1)
    }
    if(canhypertrain(STAT_SPATK, VAR_MON_SLOT) == FALSE){
        addvar(VAR_NUMBER_OF_STATS_TRAINED, 1)
    }
    if(canhypertrain(STAT_SPDEF, VAR_MON_SLOT) == FALSE){
        addvar(VAR_NUMBER_OF_STATS_TRAINED, 1)              
    }
    if(var(VAR_NUMBER_OF_STATS_TRAINED) == 6){
        msgbox(MonFullyHyperTrained, MSGBOX_AUTOCLOSE)
        end
    }
    goto(SelectHyperTraining)
}
script SelectHyperTraining{
    message(UseWhichBottleCaps)
    waitmessage
    if(checkitem(ITEM_BOTTLE_CAP) == TRUE){
        checkitemquant(ITEM_BOTTLE_CAP)
        buffernumberstring(STR_VAR_1, VAR_0x8005)
        dynmultipush("Bottle Caps (Have {STR_VAR_1})", 0)
    }
    if(checkitem(ITEM_GOLD_BOTTLE_CAP) == TRUE){
        checkitemquant(ITEM_GOLD_BOTTLE_CAP)
        buffernumberstring(STR_VAR_2, VAR_0x8005)
        dynmultipush("Gold Bottle Caps (Have {STR_VAR_2})", 1)
    }
    dynmultipush("Never mind", 2)
    dynmultistack(23, 0, FALSE, 4, FALSE, 0, 0)
    switch(var(VAR_RESULT)){
        case 0: // use normal cap
            goto(HyperTrainingNormalBottleCap)
        case 1: // use gold cap
            goto(HyperTrainingGoldBottleCap)
        case 2: // cancel
        case MULTI_B_PRESSED:
            msgbox(NotInterestedInHyperTraining, MSGBOX_AUTOCLOSE)
            end
    }
}
script HyperTrainingNormalBottleCap{
    message(WhichStatToTrain)
    waitmessage
    // HP
    if(canhypertrain(STAT_HP, VAR_MON_SLOT)){
        dynmultipush("HP", 0)
    }
    else{
        dynmultipush("{COLOR LIGHT_GRAY}{SHADOW LIGHT_GRAY}HP", 0)
    }
    // Atk
    if(canhypertrain(STAT_ATK, VAR_MON_SLOT)){
        dynmultipush("Attack", 1)
    }
    else{
        dynmultipush("{COLOR LIGHT_GRAY}{SHADOW LIGHT_GRAY}Attack", 1)
    }
    // Def
    if(canhypertrain(STAT_DEF, VAR_MON_SLOT)){
        dynmultipush("Defense", 2)
    }
    else{
        dynmultipush("{COLOR LIGHT_GRAY}{SHADOW LIGHT_GRAY}Defense", 2)
    }
    // Sp. Atk
    if(canhypertrain(STAT_SPATK, VAR_MON_SLOT)){
        dynmultipush("Sp. Atk", 3)
    }
    else{
        dynmultipush("{COLOR LIGHT_GRAY}{SHADOW LIGHT_GRAY}Sp. Atk", 3)
    }
    // Sp. Def
    if(canhypertrain(STAT_SPDEF, VAR_MON_SLOT)){
        dynmultipush("Sp. Def", 4)
    }
    else{
        dynmultipush("{COLOR LIGHT_GRAY}{SHADOW LIGHT_GRAY}Sp. Def", 4)
    }
    // Speed
    if(canhypertrain(STAT_SPEED, VAR_MON_SLOT)){
        dynmultipush("Speed", 5)
    }
    else{
        dynmultipush("{COLOR LIGHT_GRAY}{SHADOW LIGHT_GRAY}Speed", 5)
    }
    dynmultipush("Back", 6)

    dynmultistack(23, 0, FALSE, 7, FALSE, 0, 0)
    switch(var(VAR_RESULT)){
        case 0:
            if(canhypertrain(STAT_HP, VAR_MON_SLOT) == FALSE){
                goto(HyperTrainingCapped)
            }
            goto(Hypertrain_Hp)
        case 1:
            if(canhypertrain(STAT_ATK, VAR_MON_SLOT) == FALSE){
                goto(HyperTrainingCapped)
            }
            goto(Hypertrain_Atk)
        case 2:
            if(canhypertrain(STAT_DEF, VAR_MON_SLOT) == FALSE){
                goto(HyperTrainingCapped)
            }
            goto(Hypertrain_Def)
        case 3:
            if(canhypertrain(STAT_SPATK, VAR_MON_SLOT) == FALSE){
                goto(HyperTrainingCapped)
            }
            goto(Hypertrain_SpAtk)
        case 4:
            if(canhypertrain(STAT_SPDEF, VAR_MON_SLOT) == FALSE){
                goto(HyperTrainingCapped)
            }
            goto(Hypertrain_SpDef)
        case 5:
            if(canhypertrain(STAT_SPEED, VAR_MON_SLOT) == FALSE){
                goto(HyperTrainingCapped)
            }
            goto(Hypertrain_Speed)
        case 6:
        case MULTI_B_PRESSED:
            goto(SelectHyperTraining)
    }
}
script HyperTrainingCapped{
    msgbox(CantHypertrainThatStat)
    goto(HyperTrainingNormalBottleCap)
}
script Hypertrain_Hp{
    if(msgbox(Hypertrain_Hp_Text, MSGBOX_YESNO) == FALSE){
        goto(HyperTrainingNormalBottleCap)
    }
    call(Hypertraining_Start)
    hypertrain(STAT_HP, VAR_MON_SLOT)
    msgbox(MonHasBeenHyperTrainedInHp)
    removeitem(ITEM_BOTTLE_CAP, 1)
    msgbox(ComeBackForMoreHyperTraining)
    release
    end
}
