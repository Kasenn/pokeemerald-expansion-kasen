    "This city has something for everyone!"
}

script FrosthearthHarbor_Attendant{
    lock
    faceplayer
    if(msgbox(Frosthearth_Text_GetAboard, MSGBOX_YESNO) == FALSE){
        goto(Harbor_ComeAgain)
    }
    message("Where would you like to sail?")
    waitmessage
    dynmultichoice(23, 0, FALSE, 4, 0, 0, "Coralgrove City", "Azuretide Town", "Shoreslate City", "Kaolisle City", "Rockliffe Town", "Never mind")
    switch(var(VAR_RESULT)){
        case 0:
            call(Harbor_BoardFerryGoingEast)     // make sure the attendant is id 3 and boat is id 4
	        warp(MAP_CORALGROVE_HARVOR_INTERIOR, 7, 10)
        case 1:
            call(Harbor_BoardFerryGoingEast)
	        warp(MAP_COAST_TOWN_HARBOR, 16, 10)
        case 2:
            call(Harbor_BoardFerryGoingEast)
	        warp(MAP_SHORESLATE_HARBOR, 16, 10)
        case 3:
            call(Harbor_BoardFerryGoingEast)
	        warp(MAP_KAOLISLE_HARBOR, 7, 10)
        case 4:
            call(Harbor_BoardFerryGoingEast)
	        warp(MAP_ROCKLIFFE_HARBOR, 8, 3)
        case 5:
        case MULTI_B_PRESSED:
            goto(Harbor_ComeAgain)
    }
	waitstate
	release
	end
}

text Frosthearth_Text_GetAboard{
    "The ferry is about to leave\n"
    "the port soon.\p"
	"Would you like to board the ferry?"
}
