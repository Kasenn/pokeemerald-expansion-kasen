const FLAG_MOM = FLAG_TEMP_1

mapscripts PlayerHouse2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        setflag(FLAG_MOM)
        if(checkplayergender == FEMALE){
            setmaplayoutindex(LAYOUT_PLAYER_HOUSE2F_MAY)
        }
        if(var(VAR_PEARLWOOD_TOWN_STATE) >= STORY_PEARLWOOD_MEGA_RING_OBTAINED
        && flag(FLAG_HIDE_PLAYERS_HOUSE_DAD)
        && !flag(FLAG_RECEIVED_CAPSULE)){
            setflag(FLAG_RECEIVED_CAPSULE)
            clearflag(FLAG_DAD_GIFT)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_INTRO: PlayerHouse2F_Intro
    ]
    MAP_SCRIPT_ON_LOAD{
        if(flag(FLAG_SYS_B_DASH)){
            setmetatile(5, 7, 0x295, FALSE)
        }
    }
}

script PlayerHouse2F_Intro{
    delay(60)
    addobject(LOCALID_PLAYERROOM_MOM)
    delay(60)
    waitmove(LOCALID_PLAYERROOM_MOM, Walk1Down)
    turnobject(LOCALID_PLAYERROOM_MOM, DIR_WEST)
    delay(10)
    msgbox(PlayerHouse2F_Intro_Text, MSGBOX_AUTOCLOSE)
    delay(30)
    waitmove(LOCALID_PLAYERROOM_MOM, Walk1Up)
    removeobject(LOCALID_PLAYERROOM_MOM)
    delay(30)
    waitmove(OBJ_EVENT_ID_PLAYER, Walk1Right)
    setvar(VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_INTRO_COMPLETED)
    setrespawn(HEAL_LOCATION_PLAYER_HOUSE2F)
    release
}
text PlayerHouse2F_Intro_Text{
    "Mom: Rise and shine,\n"
    "{PLAYER}!\p"
    "Today's a very special day so\n"
    "when you're ready, grab your shoes,\l"
    "and come on downstairs.\p"
    "Oh but first, don't forget to\n"
    "set your new clock!"
}

script PlayerHouse2F_ClockReminder{
    lock
    msgbox(PlayerHouse2F_ClockReminder_Text, MSGBOX_AUTOCLOSE)
    waitmove(OBJ_EVENT_ID_PLAYER, Walk1Left)
    release
}

text PlayerHouse2F_ClockReminder_Text{
    "Better set the clock before\n"
    "heading downstairs."
}

script PlayerHouse2F_ShoesReminder{
    lock
    msgbox(PlayerHouse2F_ShoesReminder_Text, MSGBOX_AUTOCLOSE)
    waitmove(OBJ_EVENT_ID_PLAYER, Walk1Left)
    release
}

text PlayerHouse2F_ShoesReminder_Text{
    "Better put on the shoes before\n"
    "heading downstairs."
}

script Player2FSetClock{
    if(checkplayergender == MALE){
        setvar(VAR_0x8004, MALE)
    }
    else{
        setvar(VAR_0x8004, FEMALE)
    }
    if(flag(FLAG_SYS_CLOCK_SET)){
        goto(Player2FCheckClock)
    }
	msgbox(PlayersHouse_2F_Text_ClockIsStopped, MSGBOX_DEFAULT)
    fadescreen(FADE_TO_BLACK)
	special(StartWallClock)
	waitstate
	release
}

script Player2FCheckClock{
	incrementgamestat(GAME_STAT_CHECKED_CLOCK)
	fadescreen(FADE_TO_BLACK)
	special(Special_ViewWallClock)
	waitstate
	release
}

script PlayerHouse_ItemCapsule{
    finditem(ITEM_ABILITY_CAPSULE)
    if(var(VAR_PEARLWOOD_TOWN_STATE) >= STORY_PEARLWOOD_MEGA_STONE_OBTAINED){
        setvar(VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_MEGA_EVENT_COMPLETED)
    }
}

script PlayerWardrobe{
    lock
    msgbox(ChangeOutfit2, MSGBOX_YESNO)
    if(var(VAR_RESULT) == FALSE){
        closemessage
        release
        end
    }
    closemessage
    message("Choose an outfit to wear.")
    waitmessage
    if(checkplayergender == MALE){
        dynmultipush("Option 1", SPECIES_BRENDAN_RUBY)
        dynmultipush("Option 2", SPECIES_BRENDAN_EMERALD)
        if(flag(FLAG_PURCHASED_OUTFIT)){
            dynmultipush("Option 3", SPECIES_BRENDAN_ORAS)
        }
        dynmultipush("Exit", SPECIES_EMPTY)
        dynmultistack(23, 0, FALSE, 5, FALSE, 98, DYN_MULTICHOICE_CB_SHOW_MON)
        switch(var(VAR_RESULT)){
            case SPECIES_BRENDAN_RUBY:
                setvar(VAR_CHOSEN_OUTFIT, 0)
                goto(ChangePlayerOutfit)
            case SPECIES_BRENDAN_EMERALD:
                setvar(VAR_CHOSEN_OUTFIT, 1)
                goto(ChangePlayerOutfit)
            case SPECIES_BRENDAN_ORAS:
                setvar(VAR_CHOSEN_OUTFIT, 2)
                goto(ChangePlayerOutfit)
            case SPECIES_EMPTY:
            case MULTI_B_PRESSED:
                release
                end
        }
    }
    else{
        dynmultipush("Option 1", SPECIES_MAY_RUBY)
        dynmultipush("Option 2", SPECIES_MAY_EMERALD)
        if(flag(FLAG_PURCHASED_OUTFIT)){
            dynmultipush("Option 3", SPECIES_MAY_ORAS)
        }
        dynmultipush("Exit", SPECIES_EMPTY)
        dynmultistack(23, 0, FALSE, 5, FALSE, 98, DYN_MULTICHOICE_CB_SHOW_MON)
	    switch(var(VAR_RESULT)){
            case SPECIES_MAY_RUBY:
                setvar(VAR_CHOSEN_OUTFIT, 0)
                goto(ChangePlayerOutfit)
            case SPECIES_MAY_EMERALD:
                setvar(VAR_CHOSEN_OUTFIT, 1)
                goto(ChangePlayerOutfit)
            case SPECIES_MAY_ORAS:
                setvar(VAR_CHOSEN_OUTFIT, 2)
                goto(ChangePlayerOutfit)
            case SPECIES_EMPTY:
            case MULTI_B_PRESSED:
                release
                end
        }
    }
}

text ChangeOutfit2{
    "It's a clothes rack used for\n"
    "storing outfits.\p"
    "Would you like to change your outfit?"
}
text SteppedAway{
    "{PLAYER} stepped away from the\n"
    "clothes rack."
}

script ChangePlayerOutfit{
    closemessage
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    warpsilent(MAP_PLAYER_HOUSE2F, VAR_TEMP_1, VAR_TEMP_2)
    waitstate
    end
}

script PlayerHouse_Shoes{
    lock
	waitse
    playfanfare(MUS_OBTAIN_ITEM)
    removeobject(VAR_LAST_TALKED)
    setmetatile(5, 7, 0x295, FALSE)
    special(DrawWholeMapView)
	message(PlayerFoundShoes)
	waitfanfare
	waitmessage
	msgbox(ShoesIntroText, MSGBOX_AUTOCLOSE)
	end
}

text PlayerFoundShoes{
    "{PLAYER} obtained the running shoes!"}
text ShoesIntroText{
    "{COLOR RED}{SHADOW LIGHT_RED}Press the B Button while wearing these\n"
    "running shoes to run extra-fast!"
}
