const VAR_X = VAR_TEMP_0
const VAR_Y = VAR_TEMP_1
const VAR_MACHOP_INTRO = VAR_TEMP_2
const VAR_WATEREGG = VAR_TEMP_3
const VAR_SLOPE = VAR_TEMP_4
const VAR_TRIGGER = VAR_TEMP_5

const VAR_EGGS = VAR_0x8001

mapscripts EggIsland_Exterior_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        getplayerxy(VAR_X, VAR_Y)
        if (var(VAR_X) == 50 && var(VAR_Y) == 54){ call(SetUpAreaOne) }
        elif (var(VAR_X) == 19 && var(VAR_Y) == 57){ call(SetUpAreaTwo) }
        elif (var(VAR_X) == 61 && var(VAR_Y) == 30){ call(SetUpAreaTwo) }
        elif (var(VAR_X) == 50 && var(VAR_Y) == 20){ call(SetUpAreaFinal) }
        else { call(SetUpAreaOne) }

        if(hasmonitem(0, ITEM_STRENGTH_GLOVES)){
            setflag(FLAG_SYS_USE_STRENGTH)
        }
        if(var(VAR_OUTSIDEBOULDER_X) != 0){
            setobjectxyperm(LOCALID_OUTSIDEBOULDER, VAR_OUTSIDEBOULDER_X, VAR_OUTSIDEBOULDER_Y)
        }
        call(SetupMushroom)
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[
        VAR_STORY, 0 {
            hideobjectat(8, MAP_EGG_ISLAND_EXTERIOR)
            hideobjectat(10, MAP_EGG_ISLAND_EXTERIOR)
            hideplayer
            setvar(VAR_STORY, 1)
        }
    ]
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_STORY, 1: IntroSequence
    ]
    MAP_SCRIPT_ON_LOAD{
        if(flag(FLAG_EGGBRIDGE_CREATED)){
            setmetatile(26, 37, 0x238, FALSE)
            setmetatile(26, 36, 0x238, FALSE)
            setmetatile(26, 35, 0x238, FALSE)
            setmetatile(26, 34, 0x238, FALSE)
            setmetatile(26, 33, 0x239, FALSE)
        }
        if(var(VAR_BERRYBRIDGE_X) != 0){
            setmetatile(VAR_BERRYBRIDGE_X, 54, 0x238, FALSE)
            setmetatile(VAR_BERRYBRIDGE_X, 53, 0x239, FALSE)
        }
    }
}

script SetUpAreaOne{
    setvar(VAR_ENCOUNTER_TABLE, 0)
    setvar(VAR_AI_FLAGS, 0)
    setvar(VAR_MUSHROOM_LOCATION, 0)
}
script SetUpAreaTwo{
    setvar(VAR_ENCOUNTER_TABLE, 2)
    setvar(VAR_AI_FLAGS, 1)
    setvar(VAR_MUSHROOM_LOCATION, 2)
}
script SetUpAreaFinal{
    setobjectxyperm(LOCALID_KAMEK, 40, 8)
    setobjectmovementtype(LOCALID_KAMEK, MOVEMENT_TYPE_FACE_DOWN)
    setvar(VAR_AI_FLAGS, 2)
    setvar(VAR_MUSHROOM_LOCATION, 0)
}

script IntroSequence{
    // Kamek's scene
    setflag(FLAG_DISABLE_GROUND_EFFECTS)
    delay(30)
    playse(SE_M_TELEPORT)
    applymovement(8, moves(init_affine_anim, set_visible, walk_down_start_affine, delay_16 * 10))
    delay(160)
    addobject(LOCALID_KAMEK)
    applymovement(LOCALID_KAMEK, (moves(lock_anim, lock_facing_direction, walk_faster_down * 3, unlock_anim, unlock_facing_direction)))
    waitmovement(0)
    setvar(VAR_0x8004, 1)
	setvar(VAR_0x8005, 2)
	setvar(VAR_0x8006, 8)
	setvar(VAR_0x8007, 5)
	special(ShakeCamera)
    delay(10)
    setflag(FLAG_FIRST_ANIM_OVER)
    waitmovement(8)
    playse(SE_M_MINIMIZE)
    applymovement(8, moves(walk_down_affine, delay_16 * 5))
    setflag(FLAG_SECOND_ANIM_OVER)
    waitmovement(8)
    removeobject(8)
    delay(30)

    // Start Panning Away
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down * 12))
    delay(90)
    fadescreenspeed(FADE_TO_BLACK, 2)
    waitmovement(0)
    setobjectxy(LOCALID_PLAYER, 17, 74)
    teleportcamera(17, 77)
    turnobject(LOCALID_PLAYER, DIR_SOUTH)
    hideobjectat(10, MAP_EGG_ISLAND_EXTERIOR)
    special(SpawnCameraObject)
    clearflag(FLAG_FIRST_ANIM_OVER)
    clearflag(FLAG_SECOND_ANIM_OVER)
    fadescreenspeed(FADE_FROM_BLACK, 2)

    // Player Scene
    playse(SE_M_TELEPORT)
    setmetatile(17, 74, 0x317, FALSE)
    setmetatile(17, 75, 0x317, FALSE)
    setmetatile(17, 76, 0x317, FALSE)
    setmetatile(17, 77, 0x317, FALSE)
    applymovement(10, moves(init_affine_anim, set_visible, walk_down_start_affine, delay_16 * 10))
    clearflag(FLAG_DISABLE_GROUND_EFFECTS)
    delay(160)
    showplayer
    applymovement(OBJ_EVENT_ID_PLAYER, (moves(lock_anim, lock_facing_direction, walk_faster_down * 3, unlock_anim, unlock_facing_direction)))
    waitmovement(0)
    setvar(VAR_0x8004, 1)
	setvar(VAR_0x8005, 2)
	setvar(VAR_0x8006, 8)
	setvar(VAR_0x8007, 5)
	special(ShakeCamera)
    delay(10)
    setflag(FLAG_FIRST_ANIM_OVER)
    waitmovement(10)
    playse(SE_M_MINIMIZE)
    applymovement(10, moves(walk_down_affine, delay_16 * 5))
    setflag(FLAG_SECOND_ANIM_OVER)
    setmetatile(17, 74, 0x311, FALSE)
    setmetatile(17, 75, 0x311, FALSE)
    setmetatile(17, 76, 0x311, FALSE)
    setmetatile(17, 77, 0x311, FALSE)
    waitmovement(10)
    removeobject(10)
    delay(30)
    special(RemoveCameraObject)
    setvar(VAR_STORY, 2)
    clearflag(FLAG_FIRST_ANIM_OVER)
    clearflag(FLAG_SECOND_ANIM_OVER)
    playbgm(MUS_YOSHI1, TRUE)
    release
    releaseall
    clearflag(FLAG_HIDE_HONCHKROW)
    callnative(DoInitialSave)
}

script MachopIntro1{
    setvar(VAR_MACHOP_INTRO, 1)
    goto(MachopIntroMain)}
script MachopIntro2{
    setvar(VAR_MACHOP_INTRO, 2)
    goto(MachopIntroMain)}
script MachopIntro3{
    setvar(VAR_MACHOP_INTRO, 3)
    goto(MachopIntroMain)}
script MachopIntro4{
    setvar(VAR_MACHOP_INTRO, 4)
    goto(MachopIntroMain)}

script MachopIntroMain{
    playbgm(MUS_HELP, FALSE)
    setspeaker("Lean Man")
    msgbox("You there! You've come\nat the perfect time!\pCome help me deal with\nthis scoundrel!", MSGBOX_AUTOCLOSE)
    delay(10)
    if(var(VAR_MACHOP_INTRO) == 1)
    {
        turnobject(LOCALID_INTRO_MURKROW, DIR_WEST)
    }
    else
    {
        turnobject(LOCALID_INTRO_MURKROW, DIR_EAST)
    }
    playse(SE_PIN)
    applymovement(LOCALID_INTRO_MURKROW, Common_Movement_ExclamationMark)
    waitmovement(0)
    setspeaker("Dark Bird")
    msgbox("Reinforcements!?\nI'm out of here!", MSGBOX_AUTOCLOSE)
    switch(var(VAR_MACHOP_INTRO)){
        case 1:
            applymovement(LOCALID_INTRO_MURKROW, moves(walk_fast_right * 2, walk_fast_down, walk_fast_right * 5))
            delay(16)
            turnobject(LOCALID_PLAYER, DIR_EAST)
        case 2:
            applymovement(LOCALID_INTRO_MURKROW, moves(walk_fast_right * 13))
            delay(24)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            delay(8)
            turnobject(LOCALID_PLAYER, DIR_EAST)
        case 3:
            applymovement(LOCALID_INTRO_MURKROW, moves(walk_fast_right * 13))
            delay(32)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            delay(8)
            turnobject(LOCALID_PLAYER, DIR_EAST)
        case 4:
            applymovement(LOCALID_INTRO_MURKROW, moves(walk_fast_right * 2, walk_fast_down, walk_fast_right * 13))
            delay(48)
            turnobject(LOCALID_PLAYER, DIR_SOUTH)
            delay(8)
            turnobject(LOCALID_PLAYER, DIR_EAST)
    }
    waitmovement(LOCALID_INTRO_MURKROW)
    fadedefaultbgm
    removeobject(LOCALID_INTRO_MURKROW)
    setobjectmovementtype(LOCALID_MACHOP1, MOVEMENT_TYPE_LOOK_AROUND)
    setvar(VAR_STORY, 3)
    callnative(DoInitialSave)
}

script MachopScript1{
    faceplayer
    setspeaker("Lean Man")
    msgbox(MachopScript1_Text1)
    setspeaker("Macho")
    msgbox(MachopScript1_Text2, MSGBOX_AUTOCLOSE)
    if(var(VAR_FACING) == DIR_WEST){
        applymovement(LOCALID_MACHOP1, moves(walk_down, walk_right * 2, walk_down, walk_right * 8))
    }
    else{
        applymovement(LOCALID_MACHOP1, moves(walk_right * 2, walk_down * 2, walk_right * 6))
    }
    waitmovement(LOCALID_MACHOP1)
    removeobject(LOCALID_MACHOP1)
    msgbox(MachopScript1_Text3)
    clearflag(FLAG_DISABLE_ENCOUNTERS)
    clearflag(FLAG_STOP_EXP)
    setflag(FLAG_MUSHROOMS_UNLOCKED)
    callnative(RandomizeMushroomScript)
    setobjectxyperm(LOCALID_SUPER_MUSHROOM, VAR_MUSHROOM_X, VAR_MUSHROOM_Y)
    clearflag(FLAG_MUSHROOM_PICKED_UP)
    call(SetYoshiMoves)
    special(HealPlayerParty)
    callnative(DoInitialSave)
    release
}

text MachopScript1_Text1{
    "Thank you stranger.\n"
    "I'm not sure I could've beaten\l"
    "that Murkrow without your\l"
    "intervention.\p"
    "I must say, they've been\n"
    "getting rowdy as of late…"
}
text MachopScript1_Text2{
    "I am Macho the Machop.\n"
    "And you are… Yoshi?\p"
    "Hm, can't say I've met one\n"
    "like yourself before.\l"
    "And you say you're looking\l"
    "for something called a Kamek?\l"
    "Yet another weird name I've not\l"
    "heard of.\p"
    "Anyway Yoshi, If you want to\n"
    "survive here, you need to\l"
    "be able to defend yourself.\p"
    "Your form doesn't really strike\n"
    "me as someone physical…\p"
    "I know! This island is known as\n"
    "the “Egg Island” due to the\l"
    "overabundance of eggs\l"
    "everywhere.\p"
    "Why don't you try grabbing\n"
    "some of those eggs and\l"
    "chucking them at your foes?\p"
    "Once you've grabbed a few eggs,\n"
    "see if you can get across that\l"
    "river to the east."
}
text MachopScript1_Text3{
    "{COLOR LIGHT_RED}{SHADOW LIGHT_RED}Yoshi can now collect eggs\n"
    "to help it on its journey!\p"
    "Look for eggs in the tall grass,\n"
    "deep sand, or rocky patches.\l"
    "Some eggs are going to\l"
    "hurt more than others,\l"
    "and some may have special\l"
    "attributes when thrown.\p"
    "But beware, as these areas are\n"
    "also inhabited by Pokémon!"
}

script MurkrowBattle{
	trainerbattle_single(TRAINER_ALLEN, "This is our turf! Leave!", "N/A", RemoveMurkrow)
	end
}

script RemoveMurkrow{
    cleartrainerflag(TRAINER_ALLEN)
    clearflag(FLAG_NO_RUNNING)
    applymovement(VAR_LAST_TALKED, Movement_ObjectDisappears)
    waitmovement(0)
    removeobject(VAR_LAST_TALKED)
    release
    releaseall
}

script GeodudeBattle{
	trainerbattle_single(TRAINER_TIMMY, "The underground belongs to us!\nOff with you!", "N/A", RemoveMurkrow)
	end
}

script RemoveGeodude{
    cleartrainerflag(TRAINER_TIMMY)
    clearflag(FLAG_NO_RUNNING)
    applymovement(VAR_LAST_TALKED, Movement_ObjectDisappears)
    waitmovement(0)
    removeobject(VAR_LAST_TALKED)
    release
    releaseall
}

movement Movement_ObjectDisappears{
	set_invisible
	delay_4
	set_visible
	delay_4
	set_invisible
	delay_4
	set_visible
	delay_4
	set_invisible
	delay_8
	set_visible
	delay_8
	set_invisible
	delay_8
	set_visible
	delay_8
	set_invisible
	delay_16
	set_visible
	delay_16
	set_invisible
}

script SkarmoryTrigger1{
    setvar(VAR_TRIGGER, 1)
    goto(SkarmoryTriggerMain)
}
script SkarmoryTrigger2{
    setvar(VAR_TRIGGER, 2)
    goto(SkarmoryTriggerMain)
}
script SkarmoryTriggerMain{
    counteggs
    if(var(VAR_EGGS) < 2){
        release
        end
    }
    playmoncry(SPECIES_SKARMORY, CRY_MODE_ENCOUNTER)
    delay(15)
    applymovement(LOCALID_PLAYER, Common_Movement_QuestionMark)
    waitmovement(0)
    waitmoncry
    addobject(LOCALID_SKARMORY)
    if(var(VAR_TRIGGER) == 1){
        applymovement(LOCALID_SKARMORY, moves(walk_down * 5))
    }
    else{
        applymovement(LOCALID_SKARMORY, moves(walk_down * 6))
    }
    delay(48)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    waitmovement(LOCALID_SKARMORY)
    delay(10)
    callnative(CreateStrongMon)
    createmon(1, 0, SPECIES_SKARMORY, VAR_0x8000)
    playbgm(MUS_ENCOUNTER_INTENSE, FALSE)
    setflag(FLAG_NO_RUNNING)
    setspeaker("Skarmory")
    msgbox("What delicious lookings eggs\nyou have there.\lHand them over!", MSGBOX_AUTOCLOSE)
    special(StartSpecialBattle)
    setflag(FLAG_SKARMORY_DEFEATED)
    applymovement(LOCALID_SKARMORY, Movement_ObjectDisappears)
    waitmovement(0)
    removeobject(LOCALID_SKARMORY)
}

script SuperMushroomUpgrade{
    playfanfare(MUS_OBTAIN_ITEM)
	message("Yoshi obtained the\nSuper Mushroom Upgrade!")
	delay(10)
	waitfanfare
    waitmessage
    removeobject(LOCALID_SUPERMUSHROOMUPGRADE)
	msgbox("Super Mushrooms now recover\nup to 50% more HP.")
    release
}

script TongueUpgrade{
    playfanfare(MUS_OBTAIN_ITEM)
	message("Yoshi obtained the\nTongue Upgrade!")
	delay(10)
	waitfanfare
    waitmessage
    removeobject(VAR_LAST_TALKED)
	msgbox("Tongue Attack's Power\nis greatly increased.")
    release
}

script SleepingSnorlax{
    msgbox("It looks to be\na sleeping Snorlax.")
    if(!flag(FLAG_PICKED_UP_CHESTO_BERRY)){
        release
        end
    }
    if(msgbox(SleepingSnorlax_Text, MSGBOX_YESNO) == FALSE){
        release
        end
    }
    fadescreen(FADE_TO_BLACK)
    delay(16)
    playfanfare(MUS_HEAL)
    waitfanfare
    msgbox(SleepingSnorlax_Text2, MSGBOX_AUTOCLOSE)
    removeobject(LOCALID_SLEEPING_SNORLAX)
    delay(16)
    fadescreen(FADE_FROM_BLACK)
    delay(10)
    release
}

text SleepingSnorlax_Text{
    "The sleeping Snorlax's nose\n"
    "starts to twitch as it smells\l"
    "the Chesto berries on you.\p"
    "Feed the Chesto berries\n"
    "to the Snorlax?"
}

text SleepingSnorlax_Text2{
    "The Snorlax wakes up and rushes out\n"
    "in search of more berries."
}

script SleepingSnorlaxIntro{
    setflag(FLAG_SLEEPING_SNORLAX_INTRO)
    release
}

script ChestoBerryTree{
    if(!flag(FLAG_SLEEPING_SNORLAX_INTRO)){
        msgbox("It's a tree full of\nChesto berries.")
        release
        end
    }
    elif(flag(FLAG_SLEEPING_SNORLAX)){
        msgbox("It's a tree full of\nChesto berries.\pYou don't really like\nhow dry they are.")
        release
        end
    }
    elif(flag(FLAG_PICKED_UP_CHESTO_BERRY)){
        msgbox("It's a tree full of\nChesto berries.\pYou are already carrying\na handful of them.")
        release
        end
    }
    elif(!flag(FLAG_PICKED_UP_CHESTO_BERRY)){
        playfanfare(MUS_OBTAIN_ITEM)
        message("Picked up a handful of\nChesto berries!")
        delay(10)
        waitfanfare
        waitmessage
        setflag(FLAG_PICKED_UP_CHESTO_BERRY)
        release
    }
}

script Script_AwakeSnorlax{
    msgbox(Script_AwakeSnorlax_Text, MSGBOX_SIGN)
}
text Script_AwakeSnorlax_Text{
    "The Snorlax is too busy chowing\n"
    "down Chesto berries to notice you."
}

script StrGloves_ItemSparkle{
    if(!flag(FLAG_PRIMEAPE_DEFEATED)){
        goto(PrimeapeEncounter)
    }
    if(hasmonitem(0, ITEM_GRIP_GLOVES)){
        if(msgbox(StrGlovesOnGround, MSGBOX_YESNO) == FALSE){
            release
            end
        }
        playfanfare(MUS_OBTAIN_ITEM)
        message("Switched the Grip Gloves to\nStrength Gloves!")
        delay(10)
        waitfanfare
        waitmessage
        msgbox("The Strength gloves increase\nthe power of your moves,\land allows you to push around\lheavy boulders.")
        setflag(FLAG_SYS_USE_STRENGTH)
        callnative(EquipStrGloves)
    }
    else{
        if(msgbox(GripGlovesOnGround, MSGBOX_YESNO) == FALSE){
            release
            end
        }
        playfanfare(MUS_OBTAIN_ITEM)
        message("Switched the Strength Gloves to\nGrip Gloves!")
        delay(10)
        waitfanfare
        waitmessage
        msgbox(GripGlovesDescription)
        clearflag(FLAG_SYS_USE_STRENGTH)
        callnative(EquipGripGloves)
    }
    release
}

text GripGlovesDescription{
    "The Grip Gloves boosts\n"
    "the likelihood of added effects\l"
    "appearing when attacking,\l"
    "increases your speed,\l"
    "and allows you to climb up\l"
    "muddy slopes."
}

text StrGlovesOnGround{
    "There seems to be a pair of\n"
    "gloves on the ground.\l"
    "Switch out your Grip Gloves?"
}

text GripGlovesOnGround{
    "There seems to be a pair of\n"
    "gloves on the ground.\l"
    "Switch out your Strength Gloves?"
}

script PrimeapeEncounter{
    setspeaker("???")
    msgbox("MY SPARKLY!", MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_PLAYER, Common_Movement_QuestionMark)
    waitmovement(0)
    addobject(LOCALID_PRIMEAPE)
    switch(var(VAR_FACING)){
        case DIR_NORTH:
            applymovement(LOCALID_PRIMEAPE, moves(walk_left, walk_down * 2, jump_down, delay_8, jump_down, delay_8, jump_down, delay_8))
            delay(48)
            playse(SE_LEDGE)
            delay(16)
            playse(SE_LEDGE)
            delay(16)
            playse(SE_LEDGE)
        case DIR_EAST:
            applymovement(LOCALID_PRIMEAPE, moves(walk_down * 3, jump_down, delay_8, jump_down, delay_8, jump_down, delay_8, face_left))
            delay(48)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            playse(SE_LEDGE)
            delay(16)
            playse(SE_LEDGE)
            delay(16)
            playse(SE_LEDGE)
        case DIR_WEST:
            applymovement(LOCALID_PRIMEAPE, moves(walk_down * 3, jump_down, delay_8, jump_down, delay_8))
            delay(48)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            playse(SE_LEDGE)
            delay(16)
            playse(SE_LEDGE)
    }
    waitmovement(0)
    waitse
    delay(10)
    callnative(CreateStrongMon)
    createmon(1, 0, SPECIES_PRIMEAPE, VAR_0x8000)
    playbgm(MUS_ENCOUNTER_INTENSE, FALSE)
    setflag(FLAG_NO_RUNNING)
    setspeaker("Primeape")
    msgbox("I SAW IT FIRST!\nGET BACK!", MSGBOX_AUTOCLOSE)
    special(StartSpecialBattle)
    setflag(FLAG_PRIMEAPE_DEFEATED)
    applymovement(LOCALID_PRIMEAPE, Movement_ObjectDisappears)
    waitmovement(0)
    removeobject(LOCALID_PRIMEAPE)
}

script HonchkrowScript{
    playbgm(MUS_ENCOUNTER_INTENSE, FALSE)
    setspeaker("Honchkrow")
    callnative(CreateStrongMon)
    createmon(1, 0, SPECIES_HONCHKROW, VAR_0x8000)
    msgbox("The new boss man says to\nnot let anybody through!", MSGBOX_AUTOCLOSE)
    settotemboost(B_POSITION_OPPONENT_LEFT, 1, 1, 1, 1, 1)
    setflag(FLAG_NO_RUNNING)
    special(StartSpecialBattle)
    applymovement(LOCALID_HONCHKROW, Movement_ObjectDisappears)
    waitmovement(0)
    removeobject(LOCALID_HONCHKROW)
}

script FinaleTrigger{
    delay(16)
    turnobject(LOCALID_KAMEK, DIR_SOUTH)
    playse(SE_PIN)
    applymovement(LOCALID_KAMEK, Common_Movement_ExclamationMark)
    waitse
    waitmovement(0)
    playbgm(MUS_KAMEK, TRUE)
    delay(16)
    setspeaker("Kamek")

    setflag(FLAG_DISABLE_KO_ANIM)
    callnative(CreateExtraStrongMon)
    createmon(1, 0, SPECIES_KAMEK, VAR_0x8000)
    msgbox(KamekBattleIntro, MSGBOX_AUTOCLOSE)
    //remove portal here
    settotemboost(B_POSITION_OPPONENT_LEFT, 2, 2, 2, 2, 2)
	special(StartRegiBattle)
    //wip
}

text KamekBattleIntro{
    "Yoshi?!\n"
    "How did you get here?!\p"
    "I gave those birdbrains clear\n"
    "instructions to not let anyone\l"
    "through while I channel my spell!"
}

text KamekBattleIntro2{
    "…Oh, great! Now I lost my\n"
    "concentration and need to start\l"
    "from the beginning!\p"
    "THAT'S IT!\p"
    "You've been meddling in my\n"
    "business for far too long!\p"
    "Once I'm done with you,\n"
    "I can leave you and this\l"
    "weird world behind, and\l"
    "return back to the young\l"
    "master's side!"
}