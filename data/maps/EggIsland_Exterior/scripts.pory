const VAR_X = VAR_TEMP_0
const VAR_Y = VAR_TEMP_1
const VAR_MACHOP_INTRO = VAR_TEMP_2
const VAR_WATEREGG_1 = VAR_TEMP_3

const VAR_EGGS = VAR_0x8001

mapscripts EggIsland_Exterior_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        getplayerxy(VAR_X, VAR_Y)
        if (var(VAR_X) == 50 && var(VAR_Y) == 54){ call(SetUpAreaOne) }
        elif (var(VAR_X) == 19 && var(VAR_Y) == 57){ call(SetUpAreaTwo) }
        elif (var(VAR_X) == 61 && var(VAR_Y) == 30){ call(SetUpAreaTwo) }
        elif (var(VAR_X) == 19 && var(VAR_Y) == 57){ call(SetUpAreaFinal) }
        else { call(SetUpAreaOne) }

        call(SetupMushroom)
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[
        VAR_STORY, 0 {
            hideobjectat(8, MAP_EGG_ISLAND_EXTERIOR)
            hideobjectat(10, MAP_EGG_ISLAND_EXTERIOR)
            hideplayer
            setvar(VAR_STORY, 1)
        }
    ]
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_STORY, 1: IntroSequence
    ]
}

script IntroSequence{
    setmetatile(40, 15, 0x273, FALSE)
    setmetatile(40, 16, 0x273, FALSE)
    setmetatile(40, 19, 0x273, FALSE)
    setmetatile(40, 20, 0x273, FALSE)
    setmetatile(40, 21, 0x273, FALSE)
    setmetatile(40, 22, 0x273, FALSE)
    setflag(FLAG_DISABLE_GROUND_EFFECTS)
    delay(30)
    playse(SE_M_TELEPORT)
    applymovement(8, moves(init_affine_anim, set_visible, walk_down_start_affine, delay_16 * 10))
    // waitmovement(0)
    delay(160)
    addobject(9)
    applymovement(9, (moves(lock_anim, lock_facing_direction, walk_faster_down * 3, unlock_anim, unlock_facing_direction)))
    waitmovement(0)
    setvar(VAR_0x8004, 1)
	setvar(VAR_0x8005, 2)
	setvar(VAR_0x8006, 8)
	setvar(VAR_0x8007, 5)
	special(ShakeCamera)
    delay(10)
    setflag(FLAG_FIRST_ANIM_OVER)
    waitmovement(8)
    playse(SE_M_MINIMIZE)
    applymovement(8, moves(walk_down_affine, delay_16 * 5))
    setflag(FLAG_SECOND_ANIM_OVER)
    waitmovement(8)
    removeobject(8)
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down * 12))
    delay(90)
    fadescreenspeed(FADE_TO_BLACK, 2)
    waitmovement(0)
    setobjectxy(LOCALID_PLAYER, 17, 74)
    teleportcamera(17, 74)
    turnobject(LOCALID_PLAYER, DIR_SOUTH)
    // applymovement(OBJ_EVENT_ID_PLAYER, moves(player_run_left * 9, player_run_down * 34))
    // waitmovement(0)
    hideobjectat(10, MAP_EGG_ISLAND_EXTERIOR)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(player_run_down * 3))
    waitmovement(0)
    clearflag(FLAG_FIRST_ANIM_OVER)
    clearflag(FLAG_SECOND_ANIM_OVER)
    fadescreenspeed(FADE_FROM_BLACK, 2)

    playse(SE_M_TELEPORT)
    setmetatile(17, 74, 0x317, FALSE)
    setmetatile(17, 75, 0x317, FALSE)
    setmetatile(17, 76, 0x317, FALSE)
    setmetatile(17, 77, 0x317, FALSE)
    applymovement(10, moves(init_affine_anim, set_visible, walk_down_start_affine, delay_16 * 10))
    // waitmovement(10)
    clearflag(FLAG_DISABLE_GROUND_EFFECTS)

    delay(160)
    showplayer
    applymovement(OBJ_EVENT_ID_PLAYER, (moves(lock_anim, lock_facing_direction, walk_faster_down * 3, unlock_anim, unlock_facing_direction)))
    
    waitmovement(0)
    setvar(VAR_0x8004, 1)
	setvar(VAR_0x8005, 2)
	setvar(VAR_0x8006, 8)
	setvar(VAR_0x8007, 5)
	special(ShakeCamera)
    delay(10)
    setflag(FLAG_FIRST_ANIM_OVER)
    waitmovement(10)
    playse(SE_M_MINIMIZE)
    applymovement(10, moves(walk_down_affine, delay_16 * 5))
    setflag(FLAG_SECOND_ANIM_OVER)
    setmetatile(17, 74, 0x311, FALSE)
    setmetatile(17, 75, 0x311, FALSE)
    setmetatile(17, 76, 0x311, FALSE)
    setmetatile(17, 77, 0x311, FALSE)
    waitmovement(10)
    removeobject(10)
    delay(30)
    special(RemoveCameraObject)
    setvar(VAR_STORY, 2)
    clearflag(FLAG_FIRST_ANIM_OVER)
    clearflag(FLAG_SECOND_ANIM_OVER)
    playbgm(MUS_YOSHI1, TRUE)
    release
    releaseall
    callnative(DoInitialSave)
}

script SetUpAreaOne{
    setvar(VAR_AI_FLAGS, 0)
    setvar(VAR_MUSHROOM_LOCATION, 0)
}
script SetUpAreaTwo{
    setvar(VAR_AI_FLAGS, 2)
    setvar(VAR_MUSHROOM_LOCATION, 2)
}
script SetUpAreaFinal{
    setvar(VAR_AI_FLAGS, 4)
    setvar(VAR_MUSHROOM_LOCATION, 0)
}

script SetupMushroom{
    if(!flag(FLAG_MUSHROOMS_UNLOCKED)){
        return
    }
    callnative(RandomizeMushroomOnSpawn)
    setobjectxyperm(LOCALID_SUPER_MUSHROOM, VAR_MUSHROOM_X, VAR_MUSHROOM_Y)
    clearflag(FLAG_MUSHROOM_PICKED_UP) 
}

script EventScript_LootMushroom{
    if(var(VAR_MUSHROOM_COUNT) >= 10){
        release
        end
    }
    playmoncry(SPECIES_IRON_CROWN, 0)
    removeobject(LOCALID_SUPER_MUSHROOM)
    callnative(RandomizeMushroomScript)
    setobjectxyperm(LOCALID_SUPER_MUSHROOM, VAR_MUSHROOM_X, VAR_MUSHROOM_Y)
    clearflag(FLAG_MUSHROOM_PICKED_UP)
    if(!flag(FLAG_INTRODUCTION_TO_MUSHROOMS)){
        waitmoncry
        setflag(FLAG_INTRODUCTION_TO_MUSHROOMS)
        msgbox(EventScript_LootMushroom_Text, MSGBOX_AUTOCLOSE)
    }
    if(var(VAR_MUSHROOM_COUNT) < 10){
        addvar(VAR_MUSHROOM_COUNT, 1)
    }
    callnative(UpdateMushroomPP)
    release
}

text EventScript_LootMushroom_Text{
    "Yoshi picked up a Super\n"
    "Mushroom!\p"
    "Use the move “Super Mushroom”\n"
    "to consume a Super Mushroom\l"
    "and recover some health."
}

script EventScript_FollowerEgg{
    msgbox("It's a Pokémon egg.", MSGBOX_AUTOCLOSE)
}

script Script_StartMenuRest{
    call(Common_EventScript_OutOfCenterPartyHeal)
    callnative(UpdateEggPP)
    msgbox("Your party has been fully healed.")
    release
    end
}

script Script_RetreatWithDiglett{
    msgbox(RetreatWithDiglett_Text, MSGBOX_YESNO)
    if(var(VAR_RESULT) == FALSE){
        release
        end
    }
    setfieldeffectargument(0, 0xFF)
    goto(EventScript_DigCommon)
}

text RetreatWithDiglett_Text{
    "Call out for Diglett and\n"
    "return back to latest save point?"
}

script Script_TryLootEgg{
    lock
    callnative(GeneratePokemonForEgg)
    clearflag(FLAG_FORCE_ENCOUNTERRATE)
    if(var(VAR_EGGS) < 5)
    {
        playse(SE_ITEMFINDER)
        message("Yoshi found an egg!")
        waitse
	    waitmessage
        giveegg(VAR_0x8000)
        special(CalculatePlayerPartyCount)
        callnative(UpdateEggPP)
        callnative(UpdateFollowingPokemon)
    }
    else{
        setflag(FLAG_EGGPIC)
        showmonpic(VAR_0x8000, 10, 3)
        callnative(BufferEggTextBasedOnType)
        msgbox(TooManyEggs, MSGBOX_YESNO)
        hidemonpic
        clearflag(FLAG_EGGPIC)
        if (var(VAR_RESULT) == FALSE)
        {
            release
            end
        }
        msgbox("Choose an egg to toss away.")
        special(SavePlayerParty)
        callnative(ReplaceChanseyWithEgg)
        special(ChoosePartyMon)
        if(var(VAR_0x8004) >= PARTY_SIZE || var(VAR_0x8004) == 0)
        {
            special(LoadPlayerParty)
            msgbox("Yoshi left the egg where it was.")
            release
            end
        }
        special(LoadPlayerParty)
        callnative(ReplaceEggInParty)
        msgbox("Yoshi replaced an older egg\nwith the new one.")
    }
    release
}

text TooManyEggs{
    "Yoshi found an egg, but it\n"
    "cannot carry any more.\p"
    "{STR_VAR_1}\p"
    "Replace an old egg with\n"
    "the new one?"
}

script DebugScript1{
    buffernumberstring(STR_VAR_1, VAR_ROCKPLATE_1)
    buffernumberstring(STR_VAR_2, VAR_ROCKPLATE_2)
    msgbox("{STR_VAR_1}\n{STR_VAR_2}")
}

script MachopIntro1{
    setvar(VAR_MACHOP_INTRO, 1)
    goto(MachopIntroMain)
}

script MachopIntro2{
    setvar(VAR_MACHOP_INTRO, 2)
    goto(MachopIntroMain)
}

script MachopIntro3{
    setvar(VAR_MACHOP_INTRO, 3)
    goto(MachopIntroMain)
}

script MachopIntro4{
    setvar(VAR_MACHOP_INTRO, 4)
    goto(MachopIntroMain)
}

script MachopIntroMain{
    playbgm(MUS_HELP, FALSE)
    setspeaker("Lean Man")
    msgbox("You there!\nYou've come at the perfect time!\pCome help me deal with\nthis scoundrel!", MSGBOX_AUTOCLOSE)
    delay(10)
    if(var(VAR_MACHOP_INTRO) == 1)
    {
        turnobject(LOCALID_INTRO_MURKROW, DIR_WEST)
    }
    else
    {
        turnobject(LOCALID_INTRO_MURKROW, DIR_EAST)
    }
    playse(SE_PIN)
    applymovement(LOCALID_INTRO_MURKROW, Common_Movement_ExclamationMark)
    waitmovement(0)
    setspeaker("Dark Bird")
    msgbox("Reinforcements!?\nI'm out of here!", MSGBOX_AUTOCLOSE)
    switch(var(VAR_MACHOP_INTRO)){
        case 1:
            applymovement(LOCALID_INTRO_MURKROW, moves(walk_fast_right * 2, walk_fast_down, walk_fast_right * 5))
            delay(16)
            turnobject(LOCALID_PLAYER, DIR_EAST)
        case 2:
            applymovement(LOCALID_INTRO_MURKROW, moves(walk_fast_right * 13))
            delay(24)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            delay(8)
            turnobject(LOCALID_PLAYER, DIR_EAST)
        case 3:
            applymovement(LOCALID_INTRO_MURKROW, moves(walk_fast_right * 13))
            delay(32)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
            delay(8)
            turnobject(LOCALID_PLAYER, DIR_EAST)
        case 4:
            applymovement(LOCALID_INTRO_MURKROW, moves(walk_fast_right * 2, walk_fast_down, walk_fast_right * 13))
            delay(48)
            turnobject(LOCALID_PLAYER, DIR_SOUTH)
            delay(8)
            turnobject(LOCALID_PLAYER, DIR_EAST)
    }
    waitmovement(LOCALID_INTRO_MURKROW)
    fadedefaultbgm
    removeobject(LOCALID_INTRO_MURKROW)
    setobjectmovementtype(LOCALID_MACHOP1, MOVEMENT_TYPE_LOOK_AROUND)
    setvar(VAR_STORY, 3)
    callnative(DoInitialSave)
}

script MachopScript1{
    faceplayer
    setspeaker("Lean Man")
    msgbox(MachopScript1_Text1)
    setspeaker("Macho")
    msgbox(MachopScript1_Text2, MSGBOX_AUTOCLOSE)
    if(var(VAR_FACING) == DIR_WEST){
        applymovement(LOCALID_MACHOP1, moves(walk_down, walk_right * 2, walk_down, walk_right * 8))
    }
    else{
        applymovement(LOCALID_MACHOP1, moves(walk_right * 2, walk_down * 2, walk_right * 6))
    }
    waitmovement(LOCALID_MACHOP1)
    removeobject(LOCALID_MACHOP1)
    msgbox(MachopScript1_Text3)
    clearflag(FLAG_DISABLE_ENCOUNTERS)
    clearflag(FLAG_STOP_EXP)
    setmonmove(0, 0, MOVE_CHUCK_EGG)
    setmonmove(0, 1, MOVE_LICK_BERRY)
    special(HealPlayerParty)
    callnative(DoInitialSave)
    release
}

text MachopScript1_Text1{
    "Thank you stranger.\n"
    "I'm not sure I could've beaten\l"
    "that Murkrow without your\l"
    "intervention.\p"
    "I must say, they've been\n"
    "getting rowdy as of late…"
}
text MachopScript1_Text2{
    "I am Macho the Machop.\n"
    "And you are… Yoshi?\p"
    "Hm, can't say I've met one\n"
    "like yourself before.\l"
    "And you say you're looking\l"
    "for something called a Kamek?\l"
    "Yet another weird name I've not\l"
    "heard of.\p"
    "Anyway Yoshi, If you want to\n"
    "survive here, you need to\l"
    "be able to defend yourself.\p"
    "Your form doesn't really strike\n"
    "me as someone physical…\p"
    "I know! This island is known as\n"
    "the “Egg Island” due to the\l"
    "overabundance of eggs\l"
    "everywhere.\p"
    "Why don't you try grabbing\n"
    "some of those eggs and\l"
    "chucking them at your foes?\p"
    "Once you've grabbed a few eggs,\n"
    "see if you can get across that\l"
    "river to the east."
}
text MachopScript1_Text3{
    "{COLOR LIGHT_RED}{SHADOW LIGHT_RED}Yoshi can now collect eggs\n"
    "to help it on its journey!\p"
    "Look for eggs in the tall grass,\n"
    "deep sand, or rocky patches.\l"
    "Some eggs are going to\l"
    "hurt more than others,\l"
    "and some may have special\l"
    "attributes when thrown.\p"
    "But beware, as these areas are\n"
    "also inhabited by Pokémon!"
}

script RiverCrossing1{
    getplayerxy(VAR_X, VAR_Y)
    counteggs
    if(var(VAR_EGGS) < 1){
        msgbox(CantCrossRiver, MSGBOX_AUTOCLOSE)
        end
    }
    msgbox(TryCrossingTheRiver, MSGBOX_YESNO)
    if(var(VAR_RESULT) == FALSE)
    {
        release
        end
    }
    msgbox("Choose an egg to toss.")
    special(ChoosePartyEgg)
    if(var(VAR_0x8004) >= PARTY_SIZE || var(VAR_0x8004) == 0)
    {
        release
        end
    }
    removeegg(VAR_0x8004)
    if(var(VAR_FACING) == DIR_EAST){
        setvar(VAR_WATEREGG_1, LOCALID_WATEREGG_LEFT_1)
    }
    else{
        setvar(VAR_WATEREGG_1, LOCALID_WATEREGG_RIGHT_1)
    }
    call(DoWaterEggMovement)
    delay(32)
    playse(SE_LEDGE)
    if(var(VAR_FACING) == DIR_EAST){
        applymovement(LOCALID_PLAYER, moves(disable_jump_landing_ground_effect, jump_2_right, delay_16, enable_jump_landing_ground_effect, jump_2_right))
    }
    else{
        applymovement(LOCALID_PLAYER, moves(disable_jump_landing_ground_effect, jump_2_left, delay_16, enable_jump_landing_ground_effect, jump_2_left))
    }
    delay(48)
    playse(SE_LEDGE)
    waitmovement(0)
    delay(30)
    applymovement(VAR_WATEREGG_1, MoveWaterEggAway)
    waitmovement(0)
    hideobjectat(VAR_WATEREGG_1, MAP_EGG_ISLAND_EXTERIOR)
    setobjectxy(VAR_WATEREGG_1, 36, 66)
    special(CalculatePlayerPartyCount)
    callnative(UpdateEggPP)
    callnative(ForceResetFollowers)
    // callnative(UpdateFollowingPokemon)
}

movement MoveWaterEggAway{
    lock_anim
    lock_facing_direction
    walk_fast_down * 7
    unlock_anim
    unlock_facing_direction
}

script DoWaterEggMovement{
    delay(16)
    addobject(VAR_WATEREGG_1)
    setobjectxy(VAR_WATEREGG_1, VAR_X, VAR_Y)
    playse(SE_M_JUMP_KICK)
    if(var(VAR_WATEREGG_1) == LOCALID_WATEREGG_LEFT_1){
        applymovement(VAR_WATEREGG_1, moves(set_visible, jump_2_right, nurse_joy_bow))
    }
    else{
        applymovement(VAR_WATEREGG_1, moves(set_visible, jump_2_left, nurse_joy_bow))
    }
    delay(32)
    playse(SE_M_DIVE)
    waitmovement(0)
}

text CantCrossRiver{
    "It's a rapidly flowing river.\p"
    "Maybe there's something that\n"
    "could be used as a temporary\l"
    "stepping stone."
}

text TryCrossingTheRiver{
    "It's a rapidly flowing river.\p"
    "Toss an egg to make\n"
    "a temporary stepping stone?"
}