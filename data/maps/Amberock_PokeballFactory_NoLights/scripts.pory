script FactoryEmployee_3{
    msgbox(FactoryEmployee_3_Text, MSGBOX_NPC)
}
text FactoryEmployee_1_Text{
    "Boy, I sure hope we have\n"
    "a good insurance policy…"
}
text FactoryEmployee_2_Text{
    "Not only did we lose a lot of\n"
    "inventory, just look at this\l"
    "mess they made…"
}
text FactoryEmployee_3_Text{
    "Thankfully all the machinery\n"
    "is intact.\p"
    "As soon as we get the generator\n"
    "back to full power and clean this\l"
    "place up a bit, we'll be back\l"
    "in business."
}