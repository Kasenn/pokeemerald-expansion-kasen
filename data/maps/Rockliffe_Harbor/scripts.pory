mapscripts Rockliffe_Harbor_MapScripts{}

script RockliffeHarbor_FerryScript{
    msgbox(PleaseBoardFerry_Text, MSGBOX_DEFAULT)
	closemessage
	applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterDown)
	waitmovement(0)
	delay(30)
	hideobjectat(1, MAP_ROCKLIFFE_HARBOR)
	setvar(VAR_0x8004, 2)
	call(Common_EventScript_FerryDepartIsland)
}

script RockliffeHarbor_Attendant{
    lock
    faceplayer
    call(ExpandedBoatNetwork)
    if(flag(FLAG_EXPANDED_BOAT_NETWORK)){
        goto(RockliffeHarbor_TakeAFerry)
    }
	msgbox(RockliffeHarbor_Text_GetAboard, MSGBOX_YESNO)
	goto_if_eq(VAR_RESULT, NO, Harbor_ComeAgain)
    message("Where would you like to sail?")
    waitmessage
    multichoice(23, 0, MULTI_BOATFROMROCKLIFFE, 0)
    switch(var(VAR_RESULT)){
        case 0:
            call(RockliffeHarbor_FerryScript)
	        warp(MAP_SHORESLATE_HARBOR, 16, 10)
        case 1:
            call(RockliffeHarbor_FerryScript)
	        warp(MAP_KAOLISLE_HARBOR, 7, 10)
        case 2:
            goto(Harbor_ComeAgain)
        case MULTI_B_PRESSED:
            goto(Harbor_ComeAgain)
    }
	waitstate
	release
	end
}

script RockliffeHarbor_TakeAFerry{
    call(InitBoatMultichoice)
    dynmultipush("Coralgrove City", 0)
    dynmultipush("Azuretide Town", 1)
    dynmultipush("Shoreslate City", 2)
    dynmultipush("Kaolisle City", 3)
    if(flag(FLAG_VISITED_FROSTFIRE)){
        dynmultipush("Frosthearth City", 4)
    }
    dynmultipush("Nevermind", 5)
    dynmultistack(23, 0, FALSE, 4, FALSE, 0, 0)
    switch(var(VAR_RESULT)){
        case 0:
            call(RockliffeHarbor_FerryScript)     // make sure the attendant is id 3 and boat is id 4
            warp(MAP_CORALGROVE_HARVOR_INTERIOR, 7, 10)
        case 1:
            call(RockliffeHarbor_FerryScript)
            warp(MAP_COAST_TOWN_HARBOR, 16, 10)
        case 2:
            call(RockliffeHarbor_FerryScript)
	        warp(MAP_SHORESLATE_HARBOR, 16, 10)
        case 3:
            call(RockliffeHarbor_FerryScript)
	        warp(MAP_KAOLISLE_HARBOR, 7, 10)
        case 4:
            call(RockliffeHarbor_FerryScript)
	        warp(MAP_FROSTHEARTH_CITY_HARBOR, 7, 10)
        case 5:
        case MULTI_B_PRESSED:
            goto(Harbor_ComeAgain)
    }
	waitstate
	release
	end
}

text RockliffeHarbor_Text_GetAboard{
    "This ferry travels to Shoreslate City\n"
    "and Kaolisle City.\p"
	"Would you like to board the ferry?"
}