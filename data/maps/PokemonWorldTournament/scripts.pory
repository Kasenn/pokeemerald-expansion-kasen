mapscripts PokemonWorldTournament_MapScripts {}

raw`@hasMoveTutor` // if P_LEARNSET_HELPER_TEACHABLE is set to TRUE, adding this line makes the python script recognize the file and
                   // add any moves found in this file automatically.

script BP_Mart_MoveTutor{
    lock
    faceplayer
    message(BP_Mart_Greetings)
    waitmessage
    bpmart(BP_Mart_Moves, TRUE)     // TRUE for move tutor, FALSE for item shop
    if(var(VAR_RESULT) == FALSE){   // VAR_RESULT is set to TRUE if successfully teaching a move to a mon, FALSE otherwise
        msgbox(PleaseSaveSomeBp)
    }
    else{
        msgbox(IllTakeYourBPNow)
    }
    release
}

text IllTakeYourBPNow{
    "I'll be taking your BP now."
}

text BP_Mart_Greetings{
    "Hello!\p"
	"Welcome to the\n"
	"Exchange Service Corner!\p"
	"Would you like to trade in your BP\n"
	"for some exquisite moves?"
}

text BP_Mart_Greetings2{
    "Hello!\p"
	"Welcome to the\n"
	"Exchange Service Corner!\p"
	"Would you like to trade in your BP\n"
	"for some exquisite items?"
}

text PleaseSaveSomeBp{
    "Please save some BP\n"
    "and come see us again."
}

mart BP_Mart_Moves{
    MOVE_SPITE
    MOVE_AFTER_YOU
    MOVE_ALLY_SWITCH
    MOVE_GRAVITY
    MOVE_TELEKINESIS
    MOVE_ROLE_PLAY
    MOVE_WONDER_ROOM
    MOVE_AQUA_TAIL
    MOVE_GASTRO_ACID
    MOVE_SEED_BOMB
    MOVE_LASER_FOCUS
    MOVE_SUPER_FANG
    MOVE_DUAL_CHOP
    MOVE_NONE
}

script BP_Mart_ItemShop{
    lock
    faceplayer
    message(BP_Mart_Greetings2)
    waitmessage
    bpmart(BP_Mart_Items, FALSE)    // TRUE for move tutor, FALSE for item shop
    msgbox(PleaseSaveSomeBp)
    release
}

mart BP_Mart_Items{
    ITEM_WHITE_HERB
    ITEM_POWER_HERB
    ITEM_ABSORB_BULB
    ITEM_CELL_BATTERY
    ITEM_LUMINOUS_MOSS
    ITEM_SNOWBALL
    ITEM_RED_CARD
    ITEM_EJECT_BUTTON
    ITEM_RARE_CANDY
    ITEM_ABILITY_CAPSULE
    ITEM_NONE
}

script BP_Mart_ItemShop2{
    lock
    faceplayer
    message(BP_Mart_Greetings2)
    waitmessage
    if(flag(FLAG_LATIAS_ROAMING) || flag(FLAG_LATIOS_ROAMING)){
        bpmart(BP_Mart_Items2LegendaryOn, FALSE)    // TRUE for move tutor, FALSE for item shop
    }
    else{
        bpmart(BP_Mart_Items2, FALSE)    // TRUE for move tutor, FALSE for item shop
    }
    msgbox(PleaseSaveSomeBp)
    release
}

mart BP_Mart_Items2{
    ITEM_VENUSAURITE
    ITEM_CHARIZARDITE_X
    ITEM_CHARIZARDITE_Y
    ITEM_BLASTOISINITE
    ITEM_GARDEVOIRITE
    ITEM_GALLADITE
    ITEM_SABLENITE
    ITEM_BANETTITE
    ITEM_NONE
}
mart BP_Mart_Items2LegendaryOn{
    ITEM_VENUSAURITE
    ITEM_CHARIZARDITE_X
    ITEM_CHARIZARDITE_Y
    ITEM_BLASTOISINITE
    ITEM_GARDEVOIRITE
    ITEM_GALLADITE
    ITEM_SABLENITE
    ITEM_BANETTITE
    ITEM_LATIASITE
    ITEM_LATIOSITE
    ITEM_NONE
}

script FeatureNotReady{
    msgbox(FeatureNotReady_Text, MSGBOX_NPC)
}
text FeatureNotReady_Text{
    "This feature is not currently\n"
    "available.\p"
    "We apologize for the inconvenience."
}

