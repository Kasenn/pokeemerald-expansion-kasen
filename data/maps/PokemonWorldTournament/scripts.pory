text PWT_NotEnoughValidMons{
    "My dear challenger!\p"
	"You do not have the {STR_VAR_2} Pokémon\n"
	"required for entry.\p"
    "Please note that certain Legendary\n"
    "Pokémon may be ineligible to enter.\p"
	"Eggs{STR_VAR_1} ineligible.\p"
	"When you have made your preparations,\n"
	"please do return."
}

