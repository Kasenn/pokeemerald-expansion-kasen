script StaticTongueUpgrade{
    playfanfare(MUS_OBTAIN_ITEM)
    message("Yoshi obtained the\nStatic Tongue Upgrade!")
    delay(10)
    removeobject(VAR_LAST_TALKED)
    waitfanfare
    waitmessage
    msgbox(StaticTongueUpgrade_Text)
    call(SetYoshiMoves)
    release
}

text StaticTongueUpgrade_Text{
    "Yoshi's “Tongue Attack” now has\n"
    "a chance to paralyze the target."
}

script GripGloves{
    playfanfare(MUS_OBTAIN_ITEM)
    message("Yoshi found the Grip Gloves!")
    delay(10)
    removeobject(VAR_LAST_TALKED)
    waitfanfare
    waitmessage
    msgbox(GripGlovesDescription)
    callnative(EquipGripGloves)
    release
}

script TriggerHelpDiglett{
    playbgm(MUS_HELP, TRUE)
    turnobject(LOCALID_DIGLETT, DIR_WEST)
    playse(SE_PIN)
    applymovement(LOCALID_DIGLETT, Common_Movement_ExclamationMark)
    waitse
    waitmovement(0)
    turnobject(LOCALID_PLAYER, DIR_EAST)
    delay(16)
    setspeaker("Diglett")
    msgbox("You there, please help!\pI am getting bullied by\nthese two shrews!", MSGBOX_AUTOCLOSE)
    turnobject(LOCALID_DIGLETT, DIR_SOUTH)
    setflag(FLAG_NO_RUNNING)
    setflag(FLAG_DISABLE_ENCOUNTERS)
    setvar(VAR_STORY, 4)
}

script DontLeaveDiglett{
    setspeaker("Diglett")
    msgbox("Please don't leave me here\nwith these two!", MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_PLAYER, moves(walk_up))
    waitmovement(0)
    release
}

script Sandshrew1{
    faceplayer
    setspeaker("Sandshrew")
	msgbox (Sandshrew1_LetsBattle, MSGBOX_DEFAULT)
    callnative(ZeroEnemyPartyMons)
    callnative(CreateMildMon)
    createmon(1, 0, SPECIES_SANDSHREW, VAR_0x8000, move1=MOVE_MAGNITUDE, move2=MOVE_SWIFT, move3=MOVE_ROLLOUT, move4=MOVE_RAPID_SPIN)
    dowildbattle
	goto(Sandshrew2Attacks)
}

script Sandshrew2{
    faceplayer
    setspeaker("Sandshrew")
	msgbox (Sandshrew2_LetsBattle, MSGBOX_DEFAULT)
    callnative(ZeroEnemyPartyMons)
    callnative(CreateMildMon)
    createmon(1, 0, SPECIES_SANDSHREW, VAR_0x8000, move1=MOVE_MAGNITUDE, move2=MOVE_SWIFT, move3=MOVE_ROLLOUT, move4=MOVE_RAPID_SPIN)
    dowildbattle
	goto(Sandshrew1Attacks)
}
text Sandshrew1_LetsBattle{
    "Who are you? Get lost!"
}
text Sandshrew2_LetsBattle{
    "Don't butt in!"
}

script Sandshrew1Attacks{
    delay(16)
    applymovement(LOCALID_SANDSHREW2, Movement_ObjectDisappears)
    waitmovement(0)
    removeobject(LOCALID_SANDSHREW2)
    playse(SE_PIN)
    applymovement(LOCALID_SANDSHREW1, Common_Movement_ExclamationMark)
    waitse
    waitmovement(0)
    delay(48)
    applymovement(LOCALID_SANDSHREW1, moves(walk_left, walk_down))
    waitmovement(0)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    delay(8)
    callnative(ZeroEnemyPartyMons)
    setspeaker("Sandshrew")
    msgbox("Now you've done it!")
    callnative(CreateStrongMon)
    createmon(1, 0, SPECIES_SANDSHREW, VAR_0x8000, move1=MOVE_MAGNITUDE, move2=MOVE_SLASH, move3=MOVE_ROLLOUT, move4=MOVE_GYRO_BALL)
    dowildbattle
    applymovement(LOCALID_SANDSHREW1, Movement_ObjectDisappears)
    savebgm(MUS_DUMMY)
	fadedefaultbgm
    waitmovement(0)
    removeobject(LOCALID_SANDSHREW1)
    goto(SandshrewFinale)
}
script Sandshrew2Attacks{
    delay(16)
    applymovement(LOCALID_SANDSHREW1, Movement_ObjectDisappears)
    waitmovement(0)
    removeobject(LOCALID_SANDSHREW1)
    playse(SE_PIN)
    applymovement(LOCALID_SANDSHREW2, Common_Movement_ExclamationMark)
    waitse
    waitmovement(0)
    delay(48)
    applymovement(LOCALID_SANDSHREW2, moves(walk_left, walk_up))
    waitmovement(0)
    turnobject(LOCALID_PLAYER, DIR_SOUTH)
    delay(8)
    callnative(ZeroEnemyPartyMons)
    setspeaker("Sandshrew")
    msgbox("Now you've done it!")
    callnative(CreateStrongMon)
    createmon(1, 0, SPECIES_SANDSHREW, VAR_0x8000, move1=MOVE_MAGNITUDE, move2=MOVE_SLASH, move3=MOVE_ROLLOUT, move4=MOVE_GYRO_BALL)
    dowildbattle
    applymovement(LOCALID_SANDSHREW2, Movement_ObjectDisappears)
    savebgm(MUS_DUMMY)
	fadedefaultbgm
    waitmovement(0)
    removeobject(LOCALID_SANDSHREW2)
    goto(SandshrewFinale)
}

script SandshrewFinale{
    getplayerxy(VAR_X, VAR_Y)
    delay(32)
    if(var(VAR_Y) == 53){
        applymovement(LOCALID_PLAYER, moves(walk_down, walk_in_place_fast_right))
    }
    else{
        applymovement(LOCALID_PLAYER, moves(walk_up, walk_in_place_fast_right))
    }
    waitmovement(0)
    delay(16)
    turnobject(LOCALID_DIGLETT, DIR_WEST)
    delay(8)
    setspeaker("Diglett")
    msgbox(SandshrewFinale_Text, MSGBOX_AUTOCLOSE)
    delay(8)
    turnobject(LOCALID_DIGLETT, DIR_SOUTH)
    delay(16)
    applymovement(LOCALID_DIGLETT, moves(nurse_joy_bow))
    waitmovement(0)
    clearflag(FLAG_DISABLE_ENCOUNTERS)
    clearflag(FLAG_NO_RUNNING)
    removeobject(LOCALID_DIGLETT)
    delay(16)
    setvar(VAR_STORY, 5)
    setescapewarp(MAP_EGG_ISLAND_INTERIOR, 32, 72)
    call(SetYoshiMoves)
    msgbox(SandshrewFinale_Text2)
    release
}

text SandshrewFinale_Text{
    "Thank you for saving me,\n"
    "friend!\p"
    "The two of them together was\n"
    "just too much for my feeble\l"
    "defenses.\p"
    "I am in your debt, friend.\n"
    "Whenever you are in a pinch,\l"
    "call for me, and I will come\l"
    "bursting out of the ground!"
}
text SandshrewFinale_Text2{
    "{COLOR LIGHT_RED}{SHADOW LIGHT_RED}You can now use the “Retreat”\n"
    "option in the Start Menu to\l"
    "return to the latest discovered\l"
    "save point.\p"
    "You can also use the move\n"
    "“Call Diglett” once every battle\l"
    "to summon Diglett to fiercely\l"
    "strike your foes."
}

script DiglettScript{
    setspeaker("Diglett")
    msgbox(DiglettScript_Text, MSGBOX_NPC)
    turnobject(LOCALID_DIGLETT, DIR_SOUTH)
}
text DiglettScript_Text{
    "Please help me!"
}

script EggHatchScene{
	lockall
    setflag(FLAG_EXP_SHARE)
	msgbox (Text_EggHatchHuh, MSGBOX_DEFAULT)
	special (EggHatch)
	releaseall
	end
}

script EggHatchScene2{
    lockall
    delay(16)
    turnobject(LOCALID_PLAYER, DIR_EAST)
    turnobject(OBJ_EVENT_ID_FOLLOWER1, DIR_WEST)
    delay(8)
    bufferpartymonnickname(STR_VAR_1, 1)
    setspeaker("{STR_VAR_1}")
    msgbox(EggHatchScene_Text)
    call(SetYoshiMoves)
    setspeaker(SP_NAME_NONE)
    msgbox(EggHatchScene_Text2)
    if(flag(FLAG_INTRODUCTION_TO_MUSHROOMS)){
        msgbox(EggHatchScene_Text3)
    }
    setvar(VAR_STORY, 7)
    releaseall
    end
}

text EggHatchScene_Text{
    "This hot sand must've\n"
    "accelerated our growth.\p"
    "But don't worry, Yoshi!\p"
    "Even if our form has changed,\n"
    "we will still aid you\l"
    "the best we can!\p"
    "Now, let's go find that\n"
    "Kamek guy!"
}

text EggHatchScene_Text2{
    "{COLOR LIGHT_RED}{SHADOW LIGHT_RED}Yoshi's “Toss Egg” has been\n"
    "replaced with “Helping Hand”."
}

text EggHatchScene_Text3{
    "{COLOR LIGHT_RED}{SHADOW LIGHT_RED}When not in battle,\n"
    "“Super Mushroom” can be used\l"
    "to revive fallen companions."
}

script TurboBoostEncounters{
    counteggs
    if (var(VAR_EGGS) == 5){
        release
        end
    }
    setflag(FLAG_TURBOBOOST_ENCOUNTERS)
    release
}

script TurboBoostEncountersOff{
    clearflag(FLAG_TURBOBOOST_ENCOUNTERS)
    release
}