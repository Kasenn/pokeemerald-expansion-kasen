script SteppedOffofSwitchMain{
    playse(SE_M_STRENGTH)
	special(DrawWholeMapView)
	waitse
	setcustomvar(0)
    if((var(VAR_ROCKPLATE_1) == 0
    || var(VAR_ROCKPLATE_2) == 0
    || var(VAR_ROCKPLATE_3) == 0
    || var(VAR_ROCKPLATE_4) == 0
    || var(VAR_ROCKPLATE_5) == 0
    || var(VAR_ROCKPLATE_6) == 0
    || var(VAR_ROCKPLATE_8) == 0)
    && flag(FLAG_DOOR_OPEN)){
        goto(BlockMainGate)
    }
	release
    end
}

script BlockMainGate{
    setmetatile(FINAL_BLOCK_1_X, FINAL_BLOCK_1_Y,   BARRIER_UP,   TRUE)
    setmetatile(FINAL_BLOCK_2_X, FINAL_BLOCK_2_Y,   BARRIER_UP,   TRUE)
    playse(SE_M_STRENGTH)
	special(DrawWholeMapView)
	waitse
    clearflag(FLAG_DOOR_OPEN)
    release
    end
}

script SetEggOnPedestal{
    if(msgbox(SetEggOnPedestal_Text, MSGBOX_YESNO) == FALSE){
        release
        end
    }
    msgbox(SetEggOnPedestal_Text2, MSGBOX_AUTOCLOSE)
    special(ChoosePartyEgg)
    if(var(VAR_0x8004) >= PARTY_SIZE || var(VAR_0x8004) == 0)
    {
        release
        end
    }
    removeegg(VAR_0x8004)
    call(HideEggs)
    copyvartocustomvar(VAR_0x800A)
    // callnative(ForceResetFollowers)
    clearflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
    switch(var(VAR_FACING)){
        case DIR_NORTH: applymovement(LOCALID_PLAYER, moves(walk_in_place_up))
        case DIR_WEST: applymovement(LOCALID_PLAYER, moves(walk_in_place_left))
        case DIR_EAST: applymovement(LOCALID_PLAYER, moves(walk_in_place_right))
        case DIR_SOUTH: applymovement(LOCALID_PLAYER, moves(walk_in_place_down))
    }
    delay(8)
    if(var(VAR_X) == SWITCH_1_X && var(VAR_Y) == SWITCH_1_Y){
        clearflag(FLAG_GROUNDEGG_1)
        setobjectxyperm(LOCALID_EGG_1, VAR_X, VAR_Y)
        addobject(LOCALID_EGG_1)
    }
    if(var(VAR_X) == SWITCH_2_X && var(VAR_Y) == SWITCH_2_Y){
        clearflag(FLAG_GROUNDEGG_2)
        setobjectxyperm(LOCALID_EGG_2, VAR_X, VAR_Y)
        addobject(LOCALID_EGG_2)
    }
    if(var(VAR_X) == SWITCH_3_X && var(VAR_Y) == SWITCH_3_Y){
        clearflag(FLAG_GROUNDEGG_3)
        setobjectxyperm(LOCALID_EGG_3, VAR_X, VAR_Y)
        addobject(LOCALID_EGG_3)
    }
    if(var(VAR_X) == SWITCH_4_X && var(VAR_Y) == SWITCH_4_Y){
        clearflag(FLAG_GROUNDEGG_4)
        setobjectxyperm(LOCALID_EGG_4, VAR_X, VAR_Y)
        addobject(LOCALID_EGG_4)
    }
    if(var(VAR_X) == SWITCH_5_X && var(VAR_Y) == SWITCH_5_Y){
        clearflag(FLAG_GROUNDEGG_5)
        setobjectxyperm(LOCALID_EGG_5, VAR_X, VAR_Y)
        addobject(LOCALID_EGG_5)
    }
    if(var(VAR_X) == SWITCH_6_X && var(VAR_Y) == SWITCH_6_Y){
        clearflag(FLAG_GROUNDEGG_6)
        setobjectxyperm(LOCALID_EGG_6, VAR_X, VAR_Y)
        addobject(LOCALID_EGG_6)
    }
    if(var(VAR_X) == SWITCH_7_X && var(VAR_Y) == SWITCH_7_Y){
        clearflag(FLAG_GROUNDEGG_7)
        setobjectxyperm(LOCALID_EGG_7, VAR_X, VAR_Y)
        addobject(LOCALID_EGG_7)
    }
    if(var(VAR_X) == SWITCH_8_X && var(VAR_Y) == SWITCH_8_Y){
        clearflag(FLAG_GROUNDEGG_8)
        setobjectxyperm(LOCALID_EGG_8, VAR_X, VAR_Y)
        addobject(LOCALID_EGG_8)
    }
    if(var(VAR_X) == SWITCH_9_X && var(VAR_Y) == SWITCH_9_Y){
        clearflag(FLAG_GROUNDEGG_9)
        setobjectxyperm(LOCALID_EGG_9, VAR_X, VAR_Y)
        addobject(LOCALID_EGG_9)
    }
    if(var(VAR_X) == SWITCH_10_X && var(VAR_Y) == SWITCH_10_Y){
        clearflag(FLAG_GROUNDEGG_10)
        setobjectxyperm(LOCALID_EGG_10, VAR_X, VAR_Y)
        addobject(LOCALID_EGG_10)
    }
    if(var(VAR_X) == SWITCH_11_X && var(VAR_Y) == SWITCH_11_Y){
        clearflag(FLAG_GROUNDEGG_11)
        setobjectxyperm(LOCALID_EGG_11, VAR_X, VAR_Y)
        addobject(LOCALID_EGG_11)
    }
    waitmovement(0)
    msgbox(SetEggOnPedestal_Text3)
    special(CalculatePlayerPartyCount)
    callnative(UpdateEggPP)
    // callnative(ForceResetFollowers)
    release
    end
}
text SetEggOnPedestal_Text{
    "There seems to be a weighted\n"
    "pressure plate under this egg.\l"
    "Leave an egg on the plate?"
}
text SetEggOnPedestal_Text2{
    "Choose an egg to leave\n"
    "on the plate."
}
text SetEggOnPedestal_Text3{
    "Yoshi left an egg\n"
    "on the plate."
}

