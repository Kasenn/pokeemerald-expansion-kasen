    goto(MainPlateScript4)
}

script MainPlateScript{
    getcustomvar
    if(var(VAR_RESULT) == 0xFFFF){
        release
        end
    }
	return
}
script MainPlateScript2{
    playse(SE_M_STRENGTH)
	special(DrawWholeMapView)
	waitse
	setcustomvar(0xFFFF)
    if(var(VAR_ROCKPLATE_1) != 0
    && var(VAR_ROCKPLATE_2) != 0
    && var(VAR_ROCKPLATE_3) != 0
    && var(VAR_ROCKPLATE_4) != 0
    && var(VAR_ROCKPLATE_5) != 0
    && var(VAR_ROCKPLATE_6) != 0
    && var(VAR_ROCKPLATE_8) != 0){
        goto(TriggerMainGate)
    }
    release
    end
}
script MainPlateScript3{
    playse(SE_M_STRENGTH)
	special(DrawWholeMapView)
	waitse
	setcustomvar(0xFFFF)
    release
    end
}

script MainPlateScript4{
    playse(SE_M_STRENGTH)
	special(DrawWholeMapView)
	waitse
    getobjectxy(LOCALID_PUZZLE_BOULDER, CURRENT_POSITION, VAR_X, VAR_Y)
    if (var(VAR_X) == SWITCH_11_X && var(VAR_Y) == SWITCH_11_Y){
        setflag(FLAG_FINAL_BOULDER_IN_PLACE)
        setobjectxyperm(LOCALID_PUZZLE_BOULDER, SWITCH_11_X, SWITCH_11_Y)
    }
	setcustomvar(0xFFFF)
    release
    end
}

script TriggerMainGate{
    setmetatile(FINAL_BLOCK_1_X, FINAL_BLOCK_1_Y,   BARRIER_DOWN,   FALSE)
    setmetatile(FINAL_BLOCK_2_X, FINAL_BLOCK_2_Y,   BARRIER_DOWN,   FALSE)
    playse(SE_M_STRENGTH)
	special(DrawWholeMapView)
	waitse
    setflag(FLAG_DOOR_OPEN)
    release
    end
}

