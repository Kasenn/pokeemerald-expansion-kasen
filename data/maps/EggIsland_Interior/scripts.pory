script SteppedOffofSwitch1{
    delay(16)
    setvarid(VAR_ROCKPLATE_1)
    setmetatile(SWITCH_1_BLOCK_1_X, SWITCH_1_BLOCK_1_Y, BARRIER_UP,   TRUE)
    setmetatile(SWITCH_1_BLOCK_2_X, SWITCH_1_BLOCK_2_Y, BARRIER_UP,   TRUE)
    setmetatile(SWITCH_1_X,         SWITCH_1_Y,         SWITCH_UP,    FALSE)
    goto(SteppedOffofSwitchMain)
}
