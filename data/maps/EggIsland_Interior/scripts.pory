const SWITCH_1_X = 47           const SWITCH_1_Y = 62
const SWITCH_1_BLOCK_1_X = 45   const SWITCH_1_BLOCK_1_Y = 68
const SWITCH_1_BLOCK_2_X = 46   const SWITCH_1_BLOCK_2_Y = 68

const SWITCH_2_X = 34           const SWITCH_2_Y = 80
const SWITCH_3_X = 26           const SWITCH_3_Y = 80
const SWITCH_4_X = 30           const SWITCH_4_Y = 83

const SWITCH_5_X = 22           const SWITCH_5_Y = 66
const SWITCH_5_BLOCK_1_X = 29   const SWITCH_5_BLOCK_1_Y = 66

const SWITCH_6_X = 36           const SWITCH_6_Y = 69
const SWITCH_6_BLOCK_1_X = 33   const SWITCH_6_BLOCK_1_Y = 61
const SWITCH_6_BLOCK_2_X = 34   const SWITCH_6_BLOCK_2_Y = 61

const SWITCH_7_X = 18           const SWITCH_7_Y = 48
const SWITCH_7_BLOCK_1_X = 29   const SWITCH_7_BLOCK_1_Y = 52
const SWITCH_7_BLOCK_2_X = 29   const SWITCH_7_BLOCK_2_Y = 53

const SWITCH_8_X = 35           const SWITCH_8_Y = 51
const SWITCH_8_BLOCK_1_X = 42   const SWITCH_8_BLOCK_1_Y = 51
const SWITCH_8_BLOCK_2_X = 42   const SWITCH_8_BLOCK_2_Y = 52
const SWITCH_8_BLOCK_3_X = 42   const SWITCH_8_BLOCK_3_Y = 53

const SWITCH_9_X = 33           const SWITCH_9_Y = 42
const SWITCH_9_BLOCK_1_X = 31   const SWITCH_9_BLOCK_1_Y = 48
const SWITCH_9_BLOCK_2_X = 32   const SWITCH_9_BLOCK_2_Y = 48

const SWITCH_10_X = 36          const SWITCH_10_Y = 30
const SWITCH_10_BLOCK_1_X = 68  const SWITCH_10_BLOCK_1_Y = 22

const SWITCH_11_X = 75          const SWITCH_11_Y = 31
const SWITCH_11_BLOCK_1_X = 42  const SWITCH_11_BLOCK_1_Y = 32

const FINAL_BLOCK_1_X = 17      const FINAL_BLOCK_1_Y = 71
const FINAL_BLOCK_2_X = 17      const FINAL_BLOCK_2_Y = 72

const BARRIER_UP =   0x378
const BARRIER_DOWN = 0x379
const SWITCH_UP =    0x37A
const SWITCH_DOWN =  0x37B

const VAR_X = VAR_TEMP_0
const VAR_Y = VAR_TEMP_1
const VAR_MACHOP_INTRO = VAR_TEMP_2
const VAR_WATEREGG = VAR_TEMP_3
const VAR_SLOPE = VAR_TEMP_4
const VAR_TRIGGER = VAR_TEMP_5
const VAR_GROUND_EGG = VAR_TEMP_6

const VAR_EGGS = VAR_0x8001

mapscripts EggIsland_Interior_MapScripts {
    MAP_SCRIPT_ON_RESUME{ setstepcallback(STEP_CB_EGG_ISLAND_INTERIOR) }
    MAP_SCRIPT_ON_TRANSITION{
        if(!flag(FLAG_GEODUDES_AWAKENED)){
            setflag(FLAG_TEMP_1)
            setflag(FLAG_TEMP_2)
            setflag(FLAG_TEMP_3)
            setflag(FLAG_TEMP_4)
        }
        setflag(FLAG_SYS_USE_FLASH)
        getplayerxy(VAR_X, VAR_Y)
        if (var(VAR_X) == 50 && var(VAR_Y) == 52){ call(SetUpInteriorAreaOne) }
        elif (var(VAR_X) == 19 && var(VAR_Y) == 55){ call(SetUpInteriorAreaOne) }
        elif (var(VAR_X) == 61 && var(VAR_Y) == 28){ call(SetUpInteriorAreaTwo) }
        elif (var(VAR_X) == 50 && var(VAR_Y) == 18){ call(SetUpInteriorAreaTwo) }
        else { call(SetUpInteriorAreaOne) }

        if(flag(FLAG_FINAL_BOULDER_IN_PLACE)){ setobjectxyperm(LOCALID_PUZZLE_BOULDER, SWITCH_11_X, SWITCH_11_Y) }

        if(hasmonitem(0, ITEM_STRENGTH_GLOVES)){
            setflag(FLAG_SYS_USE_STRENGTH)
        }
        call(SetupMushroomInterior)
        call(SetEggs)
    }
    MAP_SCRIPT_ON_LOAD: SetSwitches
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_STORY, 6: EggHatchScene2
    ]
}
script SetUpInteriorAreaOne{
    setvar(VAR_AI_FLAGS, 0)
    setvar(VAR_ENCOUNTER_TABLE, 1)
}
script SetUpInteriorAreaTwo{
    setvar(VAR_AI_FLAGS, 1)
    setvar(VAR_ENCOUNTER_TABLE, 3)
}

script SetEggs{
    if (var(VAR_ROCKPLATE_1) == 0xFFFF){ setvar(VAR_ROCKPLATE_1, 0) }
    if (var(VAR_ROCKPLATE_2) == 0xFFFF){ setvar(VAR_ROCKPLATE_2, 0) }
    if (var(VAR_ROCKPLATE_3) == 0xFFFF){ setvar(VAR_ROCKPLATE_3, 0) }
    if (var(VAR_ROCKPLATE_4) == 0xFFFF){ setvar(VAR_ROCKPLATE_4, 0) }
    if (var(VAR_ROCKPLATE_5) == 0xFFFF){ setvar(VAR_ROCKPLATE_5, 0) }
    if (var(VAR_ROCKPLATE_6) == 0xFFFF){ setvar(VAR_ROCKPLATE_6, 0) }
    if (var(VAR_ROCKPLATE_7) == 0xFFFF){ setvar(VAR_ROCKPLATE_7, 0) }
    if (var(VAR_ROCKPLATE_8) == 0xFFFF){ setvar(VAR_ROCKPLATE_8, 0) }
    if (var(VAR_ROCKPLATE_9) == 0xFFFF){ setvar(VAR_ROCKPLATE_9, 0) }
    if (var(VAR_ROCKPLATE_10) == 0xFFFF){ setvar(VAR_ROCKPLATE_10, 0) }
    if (var(VAR_ROCKPLATE_11) == 0xFFFF){ setvar(VAR_ROCKPLATE_11, 0) }

    if (var(VAR_ROCKPLATE_1) != 0){ setobjectxyperm(LOCALID_EGG_1, SWITCH_1_X, SWITCH_1_Y) }
    if (var(VAR_ROCKPLATE_2) != 0){ setobjectxyperm(LOCALID_EGG_2, SWITCH_2_X, SWITCH_2_Y) }
    if (var(VAR_ROCKPLATE_3) != 0){ setobjectxyperm(LOCALID_EGG_3, SWITCH_3_X, SWITCH_3_Y) }
    if (var(VAR_ROCKPLATE_4) != 0){ setobjectxyperm(LOCALID_EGG_4, SWITCH_4_X, SWITCH_4_Y) }
    if (var(VAR_ROCKPLATE_5) != 0){ setobjectxyperm(LOCALID_EGG_5, SWITCH_5_X, SWITCH_5_Y) }
    if (var(VAR_ROCKPLATE_6) != 0){ setobjectxyperm(LOCALID_EGG_6, SWITCH_6_X, SWITCH_6_Y) }
    if (var(VAR_ROCKPLATE_7) != 0){ setobjectxyperm(LOCALID_EGG_7, SWITCH_7_X, SWITCH_7_Y) }
    if (var(VAR_ROCKPLATE_8) != 0){ setobjectxyperm(LOCALID_EGG_8, SWITCH_8_X, SWITCH_8_Y) }
    if (var(VAR_ROCKPLATE_9) != 0){ setobjectxyperm(LOCALID_EGG_9, SWITCH_9_X, SWITCH_9_Y) }
    if (var(VAR_ROCKPLATE_10) != 0){ setobjectxyperm(LOCALID_EGG_10, SWITCH_10_X, SWITCH_10_Y) }
    if (var(VAR_ROCKPLATE_11) != 0){ setobjectxyperm(LOCALID_EGG_11, SWITCH_11_X, SWITCH_11_Y) }
}

script SetSwitches{
    if (var(VAR_ROCKPLATE_1) != 0){
        setmetatile(SWITCH_1_BLOCK_1_X, SWITCH_1_BLOCK_1_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_1_BLOCK_2_X, SWITCH_1_BLOCK_2_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_1_X,         SWITCH_1_Y,         SWITCH_DOWN,    FALSE)
    }
    if (var(VAR_ROCKPLATE_2) != 0){
        setmetatile(SWITCH_2_X,         SWITCH_2_Y,         SWITCH_DOWN,    FALSE)
    }
    if (var(VAR_ROCKPLATE_3) != 0){
        setmetatile(SWITCH_3_X,         SWITCH_3_Y,         SWITCH_DOWN,    FALSE)
    }
    if (var(VAR_ROCKPLATE_4) != 0){
        setmetatile(SWITCH_4_X,         SWITCH_4_Y,         SWITCH_DOWN,    FALSE)
    }
    if (var(VAR_ROCKPLATE_5) != 0){
        setmetatile(SWITCH_5_BLOCK_1_X, SWITCH_5_BLOCK_1_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_5_X,         SWITCH_5_Y,         SWITCH_DOWN,    FALSE)
    }
    if (var(VAR_ROCKPLATE_6) != 0){
        setmetatile(SWITCH_6_BLOCK_1_X, SWITCH_6_BLOCK_1_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_6_BLOCK_2_X, SWITCH_6_BLOCK_2_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_6_X,         SWITCH_6_Y,         SWITCH_DOWN,    FALSE)
    }
    if (var(VAR_ROCKPLATE_7) != 0){
        setmetatile(SWITCH_7_BLOCK_1_X, SWITCH_7_BLOCK_1_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_7_BLOCK_2_X, SWITCH_7_BLOCK_2_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_7_X,         SWITCH_7_Y,         SWITCH_DOWN,    FALSE)
    }
    if (var(VAR_ROCKPLATE_8) != 0){
        setmetatile(SWITCH_8_BLOCK_1_X, SWITCH_8_BLOCK_1_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_8_BLOCK_2_X, SWITCH_8_BLOCK_2_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_8_BLOCK_3_X, SWITCH_8_BLOCK_3_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_8_X,         SWITCH_8_Y,         SWITCH_DOWN,    FALSE)
    }
    if (var(VAR_ROCKPLATE_9) != 0){
        setmetatile(SWITCH_9_BLOCK_1_X, SWITCH_9_BLOCK_1_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_9_BLOCK_2_X, SWITCH_9_BLOCK_2_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_9_X,         SWITCH_9_Y,         SWITCH_DOWN,    FALSE)
    }
    if (var(VAR_ROCKPLATE_10) != 0){
        setmetatile(SWITCH_10_BLOCK_1_X, SWITCH_10_BLOCK_1_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_10_X,         SWITCH_10_Y,         SWITCH_DOWN,    FALSE)
    }
    if (var(VAR_ROCKPLATE_11) != 0){
        setmetatile(SWITCH_11_BLOCK_1_X, SWITCH_11_BLOCK_1_Y, BARRIER_DOWN,   FALSE)
        setmetatile(SWITCH_11_X,         SWITCH_11_Y,         SWITCH_DOWN,    FALSE)
    }

    if(var(VAR_ROCKPLATE_1) != 0
    && var(VAR_ROCKPLATE_2) != 0
    && var(VAR_ROCKPLATE_3) != 0
    && var(VAR_ROCKPLATE_4) != 0
    && var(VAR_ROCKPLATE_5) != 0
    && var(VAR_ROCKPLATE_6) != 0
    && var(VAR_ROCKPLATE_8) != 0){
        setmetatile(FINAL_BLOCK_1_X, FINAL_BLOCK_1_Y,   BARRIER_DOWN,   FALSE)
        setmetatile(FINAL_BLOCK_2_X, FINAL_BLOCK_2_Y,   BARRIER_DOWN,   FALSE)
    }
}

script SetupMushroomInterior{
    if(!flag(FLAG_MUSHROOMS_UNLOCKED)){
        return
    }
    setvar(VAR_MUSHROOM_LOCATION, 1)
    callnative(RandomizeMushroomOnSpawn)
    setobjectxyperm(LOCALID_SUPER_MUSHROOM_INTERIOR, VAR_MUSHROOM_X, VAR_MUSHROOM_Y)
    setvar(VAR_MUSHROOM_LOCATION, 3)
    callnative(RandomizeMushroomOnSpawn)
    setobjectxyperm(LOCALID_SUPER_MUSHROOM_INTERIOR_2, VAR_MUSHROOM2_X, VAR_MUSHROOM2_Y)
    getplayerxy(VAR_X, VAR_Y)
    if(var(VAR_Y) == 55 || var(VAR_Y) == 52){
        setvar(VAR_MUSHROOM_LOCATION, 1)
    }
    clearflag(FLAG_MUSHROOM_PICKED_UP) 
    clearflag(FLAG_MUSHROOM_PICKED_UP2)
}

script PlateTrigger1{
    setvarid(VAR_ROCKPLATE_1)
    call(MainPlateScript)
    setmetatile(SWITCH_1_BLOCK_1_X, SWITCH_1_BLOCK_1_Y, BARRIER_DOWN,   FALSE)
    setmetatile(SWITCH_1_BLOCK_2_X, SWITCH_1_BLOCK_2_Y, BARRIER_DOWN,   FALSE)
    setmetatile(SWITCH_1_X,         SWITCH_1_Y,         SWITCH_DOWN,    FALSE)
    goto(MainPlateScript2)
}

script PlateTrigger2{
        if(!flag(FLAG_GEODUDES_AWAKENED)){
        setflag(FLAG_GEODUDES_AWAKENED)
        clearflag(FLAG_TEMP_1)
        clearflag(FLAG_TEMP_2)
        clearflag(FLAG_TEMP_3)
        clearflag(FLAG_TEMP_4)
    }

    setvarid(VAR_ROCKPLATE_2)
    call(MainPlateScript)
    setmetatile(SWITCH_2_X,         SWITCH_2_Y,         SWITCH_DOWN,    FALSE)
    goto(MainPlateScript2)
}

