script GroundEggMain{
    counteggs
    if(var(VAR_EGGS) >= 5){
        msgbox(GroundEggMain_Text1, MSGBOX_AUTOCLOSE)
        end
    }
    if(msgbox(GroundEggMain_Text2, MSGBOX_YESNO) == FALSE){
        release
        end
    }
    msgbox("Yoshi picked up the egg.", MSGBOX_AUTOCLOSE)
    getcustomvar
    giveegg(VAR_RESULT)
    special(CalculatePlayerPartyCount)
    callnative(UpdateEggPP)
    callnative(UpdateFollowingPokemon)
    removeobject(VAR_LAST_TALKED)
    switch(var(VAR_GROUND_EGG)){
        case LOCALID_EGG_1: goto(SteppedOffofSwitch1)
        case LOCALID_EGG_2: goto(SteppedOffofSwitch2)
        case LOCALID_EGG_3: goto(SteppedOffofSwitch3)
        case LOCALID_EGG_4: goto(SteppedOffofSwitch4)
        case LOCALID_EGG_5: goto(SteppedOffofSwitch5)
        case LOCALID_EGG_6: goto(SteppedOffofSwitch6)
        case LOCALID_EGG_7: goto(SteppedOffofSwitch7)
        case LOCALID_EGG_8: goto(SteppedOffofSwitch8)
        case LOCALID_EGG_9: goto(SteppedOffofSwitch9)
        case LOCALID_EGG_10: goto(SteppedOffofSwitch10)
        case LOCALID_EGG_11: goto(SteppedOffofSwitch11)
    }
}

text GroundEggMain_Text1{
    "It's an egg, holding down\n"
    "a weighted pressure plate."
}
text GroundEggMain_Text2{
    "It's an egg, holding down\n"
    "a weighted pressure plate.\l"
    "Do you want to pick it up?"
}

script AITrigger0{
