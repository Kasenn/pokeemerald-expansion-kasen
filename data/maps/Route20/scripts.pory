const FLAG_BROTHER = FLAG_TEMP_1
const FLAG_RACEBOY = FLAG_TEMP_2
const VAR_BROTHER_STEPS = VAR_TEMP_0
const VAR_X = VAR_TEMP_1
const VAR_Y = VAR_TEMP_2
const VAR_AUTOPLAY = VAR_TEMP_3

const RACE_1_FAIL = 1
const RACE_1_SUCCESS = 2
const RACE_2_FAIL = 3
const RACE_2_SUCCESS = 4

const OBJ_BROTHER = 2

mapscripts Route20_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        if(defeated(TRAINER_BROTHER_6_ROUTE20)){
            setflag(FLAG_BROTHER)
        }
        if(!flag(FLAG_GOGOAT_RACE_REWARD_1)){
            setflag(FLAG_RACEBOY)
        }
        getplayerxy(VAR_X, VAR_Y)
        if(var(VAR_X) == 41 && var(VAR_Y) == 17){
            if(var(VAR_GOGOAT_RACE) == STORY_RACE_1_COMPLETE || var(VAR_GOGOAT_RACE) == STORY_RACE_1_COMPLETE_AGAIN){
                setvar(VAR_AUTOPLAY, RACE_1_SUCCESS)
            }
            else{
                setvar(VAR_AUTOPLAY, RACE_1_FAIL)
            }
            setobjectmovementtype(5, MOVEMENT_TYPE_FACE_RIGHT)
        }
        elif(var(VAR_X) == 37 && var(VAR_Y) == 27){
            if(var(VAR_GOGOAT_RACE) == STORY_RACE_2_COMPLETE || var(VAR_GOGOAT_RACE) == STORY_RACE_2_COMPLETE_AGAIN){
                setvar(VAR_AUTOPLAY, RACE_2_SUCCESS)
            }
            else{
                setvar(VAR_AUTOPLAY, RACE_2_FAIL)
            }
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_AUTOPLAY, RACE_1_FAIL: GogoatRace1Failed
        VAR_AUTOPLAY, RACE_1_SUCCESS: GogoatRace1RewardCeremony
        VAR_AUTOPLAY, RACE_2_FAIL: GogoatRace2Failed
        VAR_AUTOPLAY, RACE_2_SUCCESS: GogoatRace2RewardCeremony
        VAR_TEMP_4, 0 {
            msgbox(EndOfBetaNotice, MSGBOX_AUTOCLOSE)
            setvar(VAR_TEMP_4, 1)
        }
    ]
}

script GogoatRace1Failed{
    setvar(VAR_AUTOPLAY, 0)
    msgbox(GogoatRace1Failed_Text, MSGBOX_AUTOCLOSE)
}
text GogoatRace1Failed_Text{
    "I hope you enjoyed your time\n"
    "Gogoat racing.\p"
    "Let me know if you'd like to\n"
    "give it another go!"
}
script GogoatRace1RewardCeremony{
    setvar(VAR_AUTOPLAY, 0)
    callnative(BufferGogoatRecordTime)
    if(var(VAR_GOGOAT_RACE) == STORY_RACE_1_COMPLETE_AGAIN){
        msgbox(GogoatRace1RewardCeremony_Reward_Again)
        giveitem(ITEM_LEMONADE)
        if(var(VAR_RESULT) == FALSE){
            goto(ZeBagIsFull)
        }
        setvar(VAR_GOGOAT_RACE, STORY_RACE_1_INTRO_COMPLETE)
        clearflag(FLAG_RACEBOY)
    }
    else{
        msgbox(GogoatRace1RewardCeremony_Reward)
        giveitem(ITEM_PP_UP)
        if(var(VAR_RESULT) == FALSE){
            goto(ZeBagIsFull)
        }
        setflag(FLAG_GOGOAT_RACE_REWARD_1)
        clearflag(FLAG_RACEBOY)
        setvar(VAR_GOGOAT_RACE, STORY_RACE_2_FIRST_TALK)
    }
    msgbox(GogoatRace1RewardCeremony_WelcomeBackAnyTime, MSGBOX_AUTOCLOSE)
}
text GogoatRace1RewardCeremony_Reward{
    "We have a new winner!\p"
    "With a record time of {STR_VAR_2} seconds,\n"
    "you are our new record holder!\p"
    "As a reward, I want you to have this."
}
text GogoatRace1RewardCeremony_Reward_Again{
    "We have a winner!\p"
    "With a record time of {STR_VAR_2} seconds,\n"
    "you are still our new record holder!\p"
    "Unfortunately you already received\n"
    "the grand prize, so all I've got to offer\l"
    "is this consolation prize."
}
text GogoatRace1RewardCeremony_WelcomeBackAnyTime{
    "If you'd like to try and improve\n"
    "your record, come talk to me!"
}
script GogoatRace2Failed{
    setvar(VAR_AUTOPLAY, 0)
    msgbox(GogoatRace2Failed_Text, MSGBOX_AUTOCLOSE)
}
script GogoatRace2RewardCeremony{
    setvar(VAR_AUTOPLAY, 0)
    msgbox(GogoatRace2RewardCeremony_Reward)
    giveitem(ITEM_BOND_ANKLET)
    if(var(VAR_RESULT) == FALSE){
        goto(ZeBagIsFull)
    }
    setflag(FLAG_GOGOAT_RACE_REWARD_2)
    setvar(VAR_GOGOAT_RACE, STORY_RACE_2_INTRO)
    msgbox(GogoatRace2RewardCeremony_WelcomeBackAnyTime, MSGBOX_AUTOCLOSE)

}
text GogoatRace2Failed_Text{
    "Let me know if you'd like to\n"
    "try the race again."
}

script Route20_BrotherTrigger1{
    setvar(VAR_BROTHER_STEPS, 1)
    goto(Route20_BrotherTriggerMain)
}
script Route20_BrotherTrigger2{
    setvar(VAR_BROTHER_STEPS, 2)
    goto(Route20_BrotherTriggerMain)
}
script Route20_BrotherTrigger3{
    setvar(VAR_BROTHER_STEPS, 3)
    goto(Route20_BrotherTriggerMain)
}
script Route20_BrotherTrigger4{
    setvar(VAR_BROTHER_STEPS, 4)
    goto(Route20_BrotherTriggerMain)
}
script Route20_BrotherTrigger5{
    setvar(VAR_BROTHER_STEPS, 5)
    goto(Route20_BrotherTriggerMain)
}
script Route20_BrotherTrigger6{
    setvar(VAR_BROTHER_STEPS, 6)
    goto(Route20_BrotherTriggerMain)
}

script Route20_BrotherTriggerMain{
    lockall
    safefollow
    playbgm(MUS_ENCOUNTER_BRENDAN, TRUE)
    switch(var(VAR_BROTHER_STEPS)){
        case 1:
        case 2:
            applymovement(OBJ_BROTHER, moves(walk_in_place_faster_left, emote_exclamation_mark, delay_16 * 3))
        case 3:
        case 4:
        case 5:
            applymovement(OBJ_BROTHER, moves(walk_in_place_faster_up, emote_exclamation_mark, delay_16 * 3))
        case 6:
            applymovement(OBJ_BROTHER, moves(walk_in_place_faster_right, emote_exclamation_mark, delay_16 * 3))
    }
    waitmovement(0)
    delay(30)
        switch(var(VAR_BROTHER_STEPS)){
        case 1:
            applymovement(OBJ_BROTHER, moves(walk_left))
        case 2:
            applymovement(OBJ_BROTHER, moves(walk_left, walk_up, walk_in_place_faster_left))
        case 3:
            applymovement(OBJ_BROTHER, moves(walk_up, walk_left, walk_in_place_faster_up))
        case 4:
            applymovement(OBJ_BROTHER, moves(walk_up))
        case 5:
            applymovement(OBJ_BROTHER, moves(walk_up, walk_right, walk_in_place_faster_up))
        case 6:
            applymovement(OBJ_BROTHER, moves(walk_right * 2, walk_up))
    }
    waitmovement(0)
    msgbox(Route20_BrotherIntro)
    trainerbattle_no_intro(TRAINER_BROTHER_6_ROUTE20, Route20_BrotherLost)
    msgbox(Route20_BrotherPostBat, MSGBOX_AUTOCLOSE)
    switch(var(VAR_BROTHER_STEPS)){
        case 1:
        case 2:
        case 3:
            applymovement(OBJ_BROTHER, moves(walk_right * 2, walk_down * 7))
        case 4:
            applymovement(OBJ_BROTHER, moves(walk_right, walk_down * 7))
        case 5:
        case 6:
            applymovement(OBJ_BROTHER, moves(walk_down * 7))
    }
    waitmovement(0)
    removeobject(OBJ_BROTHER)
    savebgm(MUS_DUMMY)
	fadedefaultbgm
    release
}

text Route20_BrotherIntro{
    "{BROTHER}: Yo, {PLAYER}!\n"
    "Long time no see!\p"
    "I hope you've been seeing lots of\n"
    "new Pokémon, because I certainly have.\p"
    "How about we have a quick battle?\p"
    "I've rearranged my team a bit and\n"
    "I'd like to see how well these\l"
    "new guys actually perform."
}
text Route20_BrotherLost{
    "I really thought I'd be able to\n"
    "break through this time.\l"
    "Where did I go wrong?"
}
text Route20_BrotherPostBat{
    "{BROTHER}: I don't know how you\n"
    "do it, but your team is\l"
    "just simply too much.\l"
    "I may need to do some soul searching\l"
    "to figure out what I'm doing wrong.\p"
    "I assume you're heading east towards\n"
    "Iceperch City and the Pokémon League?\p"
    "Well, don't be in too much of a hurry.\n"
    "These battles will be no fun if you\l"
    "grow too powerful.\p"
    "In fact, I think you should stop by\n"
    "in the next town and take part in a\l"
    "Pokémon Contest.\l"
    "I think I saw {RIVAL} heading there\l"
    "not too long ago.\p"
    "Anyways, I'm going back to training.\n"
    "See ya later!"
}

script Route20_Gogoat{
    lock
	waitse
	playmoncry(SPECIES_GOGOAT, CRY_MODE_NORMAL)
	waitmoncry
	release
}

script Route20_Sign{
    msgbox(Route20_Sign_Text, MSGBOX_SIGN)
}
text Route20_Sign_Text{
    "{LEFT_ARROW} Route 19\n"
    "{DOWN_ARROW} Crystalpine Town"
}

script Route20_Race1_NPC{
    faceplayer
    release
    callnative(BufferGogoatRecordTime)
    switch(var(VAR_GOGOAT_RACE))
    {
        case STORY_RACE_1_FIRST_TALK:
            msgbox(GogoatRaceIntro)
            setvar(VAR_GOGOAT_RACE, STORY_RACE_1_INTRO_COMPLETE)
            callnative(ResetGogoatRaceRecords)
            goto(WannaGogoatRace1)
        case STORY_RACE_2_INTRO:
        case STORY_RACE_2_FAILED:
        case STORY_RACE_1_FAILED:
        case STORY_RACE_1_INTRO_COMPLETE:
        case STORY_RACE_2_FIRST_TALK:
            goto(WannaGogoatRace1)
        case STORY_RACE_1_COMPLETE:
            goto(GogoatRace1_RewardCeremony)
        case STORY_RACE_1_COMPLETE_AGAIN:
            goto(GogoatRace1_RewardCeremony2)
        case STORY_RACE_1_REWARD_UNCLAIMED_AGAIN:
            goto(GogoatRace1_UnclaimedReward)
        case STORY_RACE_2_COMPLETE_AGAIN:
        case STORY_RACE_2_COMPLETE:
        case STORY_RACE_2_REWARD_UNCLAIMED_AGAIN:
            goto(GogoatRace1_GoMeetSon)
        case STORY_RACE_1_IN_PROGRESS:
        case STORY_RACE_2_IN_PROGRESS:
        default:
            buffernumberstring(STR_VAR_3, VAR_GOGOAT_RACE)
            msgbox("Error {STR_VAR_3}:\nPlease inform the romhack creator.")
            release
            end
    }
}

script GogoatRace1_GoMeetSon{
    msgbox(GogoatRace1_GoMeetSon_Text, MSGBOX_AUTOCLOSE)
    end
}
text GogoatRace1_GoMeetSon_Text{
    "I think my son is trying to get\n"
    "your attention.\l"
    "He's right there outside the gate."
}

script GogoatRace1_UnclaimedReward{
    msgbox("Unfortunately you already received\nthe grand prize, so all I've got to offer\lis this consolation prize.")
    giveitem(ITEM_LEMONADE)
    if(var(VAR_RESULT) == FALSE){
        goto(ZeBagIsFull)
    }
    setvar(VAR_GOGOAT_RACE, STORY_RACE_1_INTRO_COMPLETE)
    clearflag(FLAG_RACEBOY)
    msgbox(GogoatRace1RewardCeremony_WelcomeBackAnyTime, MSGBOX_AUTOCLOSE)
    end
}

script GogoatRace1_RewardCeremony2{
    msgbox(GogoatRace1RewardCeremony_Reward_Again)
    giveitem(ITEM_LEMONADE)
    if(var(VAR_RESULT) == FALSE){
        goto(ZeBagIsFull)
    }
    setvar(VAR_GOGOAT_RACE, STORY_RACE_1_INTRO_COMPLETE)
    clearflag(FLAG_RACEBOY)
    msgbox(GogoatRace1RewardCeremony_WelcomeBackAnyTime, MSGBOX_AUTOCLOSE)
    end
}

script GogoatRace1_RewardCeremony{
    msgbox(GogoatRace1RewardCeremony_Reward)
    giveitem(ITEM_PP_UP)
    if(var(VAR_RESULT) == FALSE){
        goto(ZeBagIsFull)
    }
    setflag(FLAG_GOGOAT_RACE_REWARD_1)
    setvar(VAR_GOGOAT_RACE, STORY_RACE_2_FIRST_TALK)
    clearflag(FLAG_RACEBOY)
    msgbox(GogoatRace1RewardCeremony_WelcomeBackAnyTime, MSGBOX_AUTOCLOSE)
    end
}

script WannaGogoatRace1{
    message(WannaGogoatRace)
    waitmessage
    dynmultichoice(23, 0, FALSE, 4, 0, 0, "Count me in!", "Explain rules", "No thanks")
    switch(var(VAR_RESULT))
    {
        case 0:
            msgbox(LetsGetGogoatRacing)
            setvar(VAR_GOGOAT_RACE, STORY_RACE_1_IN_PROGRESS)
            warp(MAP_ROUTE20_RANCH_RACE, 0)
            callnative(TurnBikeToGogoat)
            waitstate
        case 1:
            msgbox(GogoatRaceRulesText)
            goto(WannaGogoatRace1)
        case 2:
        case MULTI_B_PRESSED:
            msgbox(ThatsAShame)
            release
            end
    }
}

script Route20_Race2_NPC{
    lock
    faceplayer
    callnative(BufferGogoatRecordTime)
    switch(var(VAR_GOGOAT_RACE))
    {
        case STORY_RACE_1_FIRST_TALK:
        case STORY_RACE_1_INTRO_COMPLETE:
        case STORY_RACE_1_IN_PROGRESS:
        case STORY_RACE_1_FAILED:
        case STORY_RACE_2_IN_PROGRESS:
        case STORY_RACE_2_INTRO:
        case STORY_RACE_2_FAILED:
            goto(WannaGogoatRace2)
        case STORY_RACE_1_COMPLETE:
        case STORY_RACE_1_COMPLETE_AGAIN:
        case STORY_RACE_1_REWARD_UNCLAIMED_AGAIN:
            msgbox("I think my dad was looking for you.\pYou can find him near the middle of\nthe field just north of here.", MSGBOX_AUTOCLOSE)
            end
        case STORY_RACE_2_FIRST_TALK:
            msgbox(GogoatRace2Intro)
            setvar(VAR_GOGOAT_RACE, STORY_RACE_2_INTRO)
            goto(WannaGogoatRace2)
        case STORY_RACE_2_COMPLETE:
            msgbox(GogoatRace2RewardCeremony_Reward)
            giveitem(ITEM_BOND_ANKLET)
            if(var(VAR_RESULT) == FALSE){
                goto(ZeBagIsFull)
            }
            setflag(FLAG_GOGOAT_RACE_REWARD_2)
            setvar(VAR_GOGOAT_RACE, STORY_RACE_2_INTRO)
            msgbox(GogoatRace2RewardCeremony_WelcomeBackAnyTime, MSGBOX_AUTOCLOSE)
            end
        case STORY_RACE_2_COMPLETE_AGAIN:
        case STORY_RACE_2_REWARD_UNCLAIMED_AGAIN:
            msgbox(GogoatRace2_NoRewardToGive, MSGBOX_AUTOCLOSE)
            setvar(VAR_GOGOAT_RACE, STORY_RACE_2_INTRO)
            end
    }
}

script WannaGogoatRace2{
    if(flag(FLAG_GOGOAT_RACE_REWARD_2))
    {
        message(WannaGogoatRace2Again)
    }
    else{
        message(WannaGogoat2Race)
    }
    waitmessage
    dynmultichoice(23, 0, FALSE, 4, 0, 0, "Count me in!", "Explain rules", "No thanks")
    switch(var(VAR_RESULT)){
        case 0:
            msgbox(LetsGetGogoatRacing2)
            setvar(VAR_GOGOAT_RACE, STORY_RACE_2_IN_PROGRESS)
            warp(MAP_ROUTE20_RACE_COURSE, 0)
            callnative(TurnBikeToGogoat)
            waitstate
        case 1:
            msgbox(GogoatRaceRulesText2)
            goto(WannaGogoatRace2)
        case 2:
        case MULTI_B_PRESSED:
            msgbox(ThatsAShame)
            release
            end
    }
}

text GogoatRace2RewardCeremony_Reward{
    "I really didn't expect anyone to\n"
    "come around and beat the record.\p"
    "For that feat, I want to reward\n"
    "you with this."
}
text GogoatRace2RewardCeremony_WelcomeBackAnyTime{
    "I have no other rewards to give you,\n"
    "but you're free to try and beat\l"
    "your old record any time you want."
}
text GogoatRace2Intro{
    "I saw how you raced around the track.\n"
    "Very impressive.\p"
    "However, if you want a true challenge,\n"
    "I have just what you need."
}
text WannaGogoatRace2Again{
