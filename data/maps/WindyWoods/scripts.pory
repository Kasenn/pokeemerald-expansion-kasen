mapscripts WindyWoods_MapScripts{
    MAP_SCRIPT_ON_TRANSITION{
        if(var(VAR_WINDYWOODS_STATE) != STORY_WINDY_WOODS_ROCKET_DEFEATED){
            setflag(FLAG_TEMP_1)
        }
        if(var(VAR_WINDYWOODS_STATE) == STORY_WINDY_WOODS_EVENT_COMPLETED){
            setflag(FLAG_TEMP_2)
            setflag(FLAG_TEMP_3)
        }
        if(var(VAR_WINDYWOODS_STATE) >= STORY_WINDY_WOODS_TALKED_TO_GIRL
        && var(VAR_WINDYWOODS_STATE) <= STORY_WINDY_WOODS_2ND_STEP_TAKEN){
            setvar(VAR_WINDYWOODS_STATE, STORY_WINDY_WOODS_TALKED_TO_GIRL)
        }
        if(var(VAR_HIDDEN_GROTTO_INTRO) == STORY_HIDDEN_GROTTO_DIDNT_ENTER){
            setvar(VAR_HIDDEN_GROTTO_INTRO, STORY_HIDDEN_GROTTO_COMPLETE)
        }
        if(var(VAR_HIDDEN_GROTTO_INTRO) == STORY_HIDDEN_GROTTO_TALKED_TO_AIDE || var(VAR_HIDDEN_GROTTO_INTRO) == STORY_HIDDEN_GROTTO_ENTERED_HIDDEN_GROTTO){
            setobjectxyperm(LOCALID_WW_SCIENTIST, 51, 4)
            setobjectmovementtype(LOCALID_WW_SCIENTIST, MOVEMENT_TYPE_FACE_RIGHT)
        }
        if(var(VAR_HIDDEN_GROTTO_INTRO) == STORY_HIDDEN_GROTTO_COMPLETE){
            setflag(FLAG_TEMP_4)
        }
        getplayerxy(VAR_TEMP_5, VAR_TEMP_6)
        if(var(VAR_HIDDEN_GROTTO_INTRO) == STORY_HIDDEN_GROTTO_ENTERED_HIDDEN_GROTTO && var(VAR_TEMP_5) == 52 && var(VAR_TEMP_6) == 4){
            setvar(VAR_TEMP_7, 1)
        }
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[VAR_WINDYWOODS_STATE, STORY_WINDY_WOODS_ROCKET_DEFEATED{turnobject(LOCALID_PLAYER, DIR_WEST)}]
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_WINDYWOODS_STATE, STORY_WINDY_WOODS_ROCKET_DEFEATED: WW_BridgeScene2
        VAR_TEMP_7, 1: WW_HiddenGrottoExitIntro
    ]
}

script WindyWoods_Bugcatcher1{
	trainerbattle_single(TRAINER_WW_BUGCATCHER, WindyWoods_Bugcatcher1Intro, WindyWoods_Bugcatcher1Defeated)
	msgbox(WindyWoods_Bugcatcher1PostBattle, MSGBOX_AUTOCLOSE)
	end
}
