mapscripts WindyWoods_MapScripts{
    MAP_SCRIPT_ON_TRANSITION{
        setflag(FLAG_LANDMARK_WINDY_WOODS)
        if(var(VAR_WINDYWOODS_STATE) != STORY_WINDY_WOODS_ROCKET_DEFEATED){
            setflag(FLAG_TEMP_1)
        }
        if(var(VAR_WINDYWOODS_STATE) == STORY_WINDY_WOODS_EVENT_COMPLETED){
            setflag(FLAG_TEMP_2)
            setflag(FLAG_TEMP_3)
        }
        if(var(VAR_WINDYWOODS_STATE) >= STORY_WINDY_WOODS_TALKED_TO_GIRL
        && var(VAR_WINDYWOODS_STATE) <= STORY_WINDY_WOODS_2ND_STEP_TAKEN){
            setvar(VAR_WINDYWOODS_STATE, STORY_WINDY_WOODS_TALKED_TO_GIRL)
        }
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[VAR_WINDYWOODS_STATE, 4{turnobject(OBJ_EVENT_ID_PLAYER, DIR_EAST)}]
    MAP_SCRIPT_ON_FRAME_TABLE[VAR_WINDYWOODS_STATE, 4: WW_BridgeScene2]
}

script WindyWoods_Bugcatcher1{
	trainerbattle_single(TRAINER_WW_BUGCATCHER, WindyWoods_Bugcatcher1Intro, WindyWoods_Bugcatcher1Defeated)
	msgbox(WindyWoods_Bugcatcher1PostBattle, MSGBOX_AUTOCLOSE)
	end
}
text WindyWoods_Bugcatcher1Intro{
    "This place is a bug catcher's dream!"
}
text WindyWoods_Bugcatcher1Defeated{
    "Should've waited for my\nPokémon to evolve…"
}
text WindyWoods_Bugcatcher1PostBattle{
    "You got lucky I didn't have time\nto fully evolve my Pokémon."
}

