script WW_CoolTrainer{
    if(defeated(TRAINER_WW_ACE_TRAINER)){
        if(flag(FLAG_WW_COOLTRAINERREWARD)){
            msgbox("Simply spectacular.", MSGBOX_NPC)
            end
        }
        else{
            goto(WW_CoolTrainerPostBattle)
        }
    }
    if(defeated(TRAINER_WW_BUGCATCHER)
    && defeated(TRAINER_WW_LADY)
    && defeated(TRAINER_WW_BUGCATCHER_2)
    && defeated(TRAINER_WW_CAMPER)
    && defeated(TRAINER_WW_LASS)
    && defeated(TRAINER_WW_YOUNGSTER)){
        goto(WW_CoolTrainerEligible)
    }
    else{
        msgbox("All I see are weaklings.\pProve to me that you're not\na weakling and we'll talk.", MSGBOX_NPC)
    }
}

script WW_CoolTrainerEligible{
    lock
    faceplayer
    if(flag(FLAG_TEMP_4)){
        msgbox(WW_CoolTrainer_Intro_Short, MSGBOX_YESNO)
    }
    else{
        msgbox(WW_CoolTrainer_Intro, MSGBOX_YESNO)
    }
    if(var(VAR_RESULT) == TRUE){
        msgbox("Good.")
        trainerbattle_no_intro(TRAINER_WW_ACE_TRAINER, WW_Text_CoolTrainerDefeated)
        goto(WW_CoolTrainerPostBattle)
    }
    else{
        setflag(FLAG_TEMP_4)
        msgbox("Then stop wasting my time.", MSGBOX_NPC)
    }
}

text WW_CoolTrainer_Intro_Short{
    "Are you ready for a duel?"
}
text WW_CoolTrainer_Intro{
    "I see you're not a completely\n"
    "lost cause.\p"
    "That means you are worthy of my time.\p"
    "Care for a Pokémon Battle?\p"
    "I warn you, I'm no weakling."
}

text WW_Text_CoolTrainerDefeated{
    "Maybe it was I who wasn't worth\n"
    "your time…"
}

script WW_CoolTrainerPostBattle{
    msgbox(WW_CoolTrainerReward)
    switch(var(VAR_STARTER_MON)){
        case SPECIES_ROWLET:
            setvar(VAR_TEMP_0, ITEM_MIRACLE_SEED)
        case SPECIES_TORCHIC:
            setvar(VAR_TEMP_0, ITEM_CHARCOAL)
        case SPECIES_PIPLUP:
            setvar(VAR_TEMP_0, ITEM_MYSTIC_WATER)
    }
    if(checkitemspace(VAR_TEMP_0) == FALSE){
        goto(ZeBagIsFull)
    }
    giveitem(VAR_TEMP_0)
    setflag(FLAG_WW_COOLTRAINERREWARD)
    msgbox("Give that item to your Pokémon to\nboost the power of their attacks.\pTake these as well.")
    addbp(10)
    call(BpReward)
    release
}

text WW_CoolTrainerReward{
    "Well, looks like I got humbled there.\nHere, you deserve this."
}

const LITTLE_GIRL = 5
const ROCKET = 8
const STOLEN_DOG = 11
const DEVON_DAD = 12
const DOG_RETURNED = 14

script WW_HelpGirl{
    lock
    safefollow
    turnobject(LITTLE_GIRL, DIR_SOUTH)
    playse(SE_PIN)
    exclamationmark(LITTLE_GIRL)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    clearflag(FLAG_TEMP_2)
    setvar(VAR_WINDYWOODS_STATE, STORY_WINDY_WOODS_TALKED_TO_GIRL)
    msgbox(WW_Help, MSGBOX_AUTOCLOSE)
}

script WW_LittleGirl{
    if(var(VAR_WINDYWOODS_STATE) == STORY_WINDY_WOODS_NOT_STARTED){
        setvar(VAR_WINDYWOODS_STATE, STORY_WINDY_WOODS_TALKED_TO_GIRL)
        clearflag(FLAG_TEMP_2)
        msgbox(WW_Help, MSGBOX_NPC)
    }
    else{
        msgbox(WW_Help2, MSGBOX_NPC)
    }
}
text WW_Help{
    "Please help!\p"
    "I was taking my daddy's Poochyena for\n"
    "a walk when some mean guy stole it!\p"
    "He ran somewhere across this bridge\n"
    "but I have no other Pokémon so\l"
    "I'm too scared to follow…"
}
text WW_Help2{
    "Please help…"
}

script WW_RocketStop1{
    lock
    turnobject(LOCALID_PLAYER, DIR_EAST)
    setvar(VAR_WINDYWOODS_STATE, STORY_WINDY_WOODS_1ST_STEP_TAKEN)
    msgbox("That's far enough, pal.", MSGBOX_SIGN)
}
script WW_RocketStop2{
    lock
    setvar(VAR_WINDYWOODS_STATE, STORY_WINDY_WOODS_2ND_STEP_TAKEN)
    msgbox("I'm warning you!", MSGBOX_SIGN)
}
script WW_RocketStop3{
    lock
    msgbox("Okay, now you're asking for trouble!")
    trainerbattle_no_intro(TRAINER_WW_ROCKET, WW_Text_RocketDefeated)
    goto(WW_RockPostBattle)
}
text WW_Text_RocketDefeated{
    "Tch…!"
}
script WW_RockPostBattle{
    lock
    msgbox(WW_RocketReward, MSGBOX_AUTOCLOSE)
    setvar(VAR_WINDYWOODS_STATE, STORY_WINDY_WOODS_ROCKET_DEFEATED)
    warp(MAP_WINDY_WOODS, 40, 13)
    waitstate
    release
}
script WW_BridgeScene2{
    delay(25)
    msgbox(WW_LittleGirlReward, MSGBOX_AUTOCLOSE)
    delay(40)
    applymovement(DEVON_DAD, WW_DevonEnters)
    waitmovement(0)
    turnobject(LITTLE_GIRL, DIR_SOUTH)
    msgbox(DevonTalk1)
    turnobject(LITTLE_GIRL, DIR_EAST)
    turnobject(DEVON_DAD, DIR_EAST)
    if(checkplayergender == MALE){
        msgbox("Little girl: This brave boy saved me!")
    }
    else{
        msgbox("Little girl: This brave girl saved me!")
    }
    msgbox(WW_DevonReward)
    giveitem(ITEM_LETTER)
    msgbox(WW_DevonTalk2, MSGBOX_AUTOCLOSE)
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(25)
    removeobjectbyflag(FLAG_TEMP_1)
    removeobjectbyflag(FLAG_TEMP_2)
    removeobjectbyflag(FLAG_TEMP_3)
    setvar(VAR_WINDYWOODS_STATE, STORY_WINDY_WOODS_EVENT_COMPLETED)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    delay(25)
    release
	end
}
text WW_RocketReward{
    "You want the Poochyena?\nFine, take it.\pIt was too weak for me\nto care about it anyway."
}

text WW_LittleGirlReward{
    "Little girl: Thank you for getting\nPoochie back!\pI wasn't sure if I would\never see him again…"
}
movement WW_DevonEnters{
    walk_left * 9
    face_up
}

text DevonTalk1{
    "Father: Thank god you're safe, honey!"
}
text WW_DevonReward{
    "Father: Thank you for helping my\ndaughter and saving our family pet.\pI don't have much to offer you\nbut here, take this."
}
text WW_DevonTalk2{
    "I work for the Devon Corp.\pShow that letter to the receptionist\nat our offices in Shoreslate City and\lI'm sure they'll reward you.\pThank you again for taking care\nof the situation.\pAlthough, I am a bit concerned about\nthis person clad in dark.\pThe way you described him sounded like\nhe could be a Team Rocket member.\pHowever, Team Rocket was disbanded\nyears ago…\pAnyway, we should head back home."
}

script WW_Grotto_Entrance{
    lock
    msgbox(GoInsideGrotto, MSGBOX_YESNO)
    if(var(VAR_RESULT) == FALSE){
        release
        end
    }
    warp(MAP_WW_GROTTO, 6, 19)
    waitstate
    release
}
text GoInsideGrotto{
    "There looks to be a narrow path\n"
    "between the trees!\p"
    "Follow the path?"
}

script WindyWoodsNurse{
    if(defeated(TRAINER_WW_NURSE)){
        faceplayer
        msgbox("Your Pokémon seem a bit worn out.\nHere, let me see to them.", MSGBOX_AUTOCLOSE)
        call(Common_EventScript_OutOfCenterPartyHeal)
        msgbox("Be careful out there.", MSGBOX_AUTOCLOSE)
        end
    }
    playbgm(MUS_ENCOUNTER_GIRL, FALSE)
    faceplayer
    msgbox("I'm studying to one day\nbe a full-fledged nurse.\pI'll heal up your Pokémon if you\ncan defeat me in battle. ")
    trainerbattle_no_intro(TRAINER_WW_NURSE, "So strong!")
    goto(WindyWoodsNurse)
}

script HiddenGrottoIntro1{
    setvar(VAR_TEMP_0, 1)
    goto(HiddenGrottoIntroMain)
}
script HiddenGrottoIntro2{
    setvar(VAR_TEMP_0, 2)
    goto(HiddenGrottoIntroMain)
}
script HiddenGrottoIntroScientist{
    if(var(VAR_HIDDEN_GROTTO_INTRO) == STORY_HIDDEN_GROTTO_TALKED_TO_AIDE){
        msgbox(HiddenGrottoIntroScientist_Text, MSGBOX_NPC)
        end
    }
    elif(var(STORY_HIDDEN_GROTTO_ENTERED_HIDDEN_GROTTO)){
        goto(WW_HiddenGrottoExitIntro)
    }
    setvar(VAR_TEMP_0, 3)
    goto(HiddenGrottoIntroMain)
}

text HiddenGrottoIntroScientist_Text{
    "Go on, see if you can find\n"
    "a Pokémon in there."
}

script HiddenGrottoIntroMain{
    switch(var(VAR_TEMP_0)){
        case 1:
            playse(SE_PIN)
            turnobject(LOCALID_WW_SCIENTIST, DIR_NORTH)
            exclamationmark(LOCALID_WW_SCIENTIST)
            turnobject(LOCALID_PLAYER, DIR_SOUTH)
        case 2:
            playse(SE_PIN)
            turnobject(LOCALID_WW_SCIENTIST, DIR_SOUTH)
            exclamationmark(LOCALID_WW_SCIENTIST)
            turnobject(LOCALID_PLAYER, DIR_NORTH)
    }
    msgbox(HiddenGrottoIntro_Text, MSGBOX_AUTOCLOSE)
    playbgm(MUS_FOLLOW_ME, FALSE)
    applymovement(LOCALID_WW_SCIENTIST, WWScientistMove)
    switch(var(VAR_TEMP_0)){
        case 1: applymovement(LOCALID_PLAYER, moves(walk_down, walk_left, walk_up, walk_left * 3, walk_up * 2, walk_left * 8))
        case 2: applymovement(LOCALID_PLAYER, moves(walk_up, walk_left, walk_up, walk_left * 3, walk_up * 2, walk_left * 8))
        case 3: applymovement(LOCALID_PLAYER, moves(walk_left * 2, walk_up, walk_left * 3, walk_up * 2, walk_left * 8))
    }
    waitmovementall
    msgbox(HiddenGrottoIntro_Text2, MSGBOX_AUTOCLOSE)
    setvar(VAR_HIDDEN_GROTTO_INTRO, STORY_HIDDEN_GROTTO_TALKED_TO_AIDE)
    setobjectxyperm(LOCALID_WW_SCIENTIST, 51, 4)
    setobjectmovementtype(LOCALID_WW_SCIENTIST, MOVEMENT_TYPE_FACE_RIGHT)
    fadedefaultbgm
    release
}

text HiddenGrottoIntro_Text{
    "Hello, I'm one of Prof. Birch's\n"
    "aides.\p"
    "I'm here to study hidden grottos and\n"
    "the Pokémon found in them.\p"
    "I bet a trainer such as yourself must\n"
    "be curious about this phenomenon\l"
    "as well!\p"
    "Here, let me show you."
}

text HiddenGrottoIntro_Text2{
    "Look here, there's a patch of\n"
    "grass between these trees.\p"
    "If you crawl in this small space,\n"
    "you should be able to find a small\l"
    "hidden grotto inhabited by a Pokémon.\p"
    "I already finished recording this\n"
    "hidden grotto, so don't feel bad about\l"
    "capturing the Pokémon within."
}

movement WWScientistMove {
    walk_left
    walk_up
    walk_left * 3
    walk_up * 2
    walk_left * 9
    walk_in_place_fast_right
}

script WW_HiddenGrottoExitIntro{
    setvar(VAR_TEMP_7, 0)
    delay(16)
    turnobject(LOCALID_PLAYER, DIR_WEST)
    delay(8)
    msgbox(WW_HiddenGrottoExitIntro_Text)
    msgbox(WW_HiddenGrottoExitIntro_Text2, MSGBOX_AUTOCLOSE)
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(25)
    removeobject(LOCALID_WW_SCIENTIST)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    setvar(VAR_HIDDEN_GROTTO_INTRO, STORY_HIDDEN_GROTTO_COMPLETE)
    release
    end
}

text WW_HiddenGrottoExitIntro_Text{
    "You're back! Did you manage to\n"
    "find a Pokémon in there?\p"
    "While many of the Pokémon you\n"
    "can find in the grottos are\l"
    "commonly found elsewhere,\l"
    "what makes these Pokémon special is\l"
    "that many of them come with\l"
    "special abilities that can't be\l"
    "found in the wild."
}

text WW_HiddenGrottoExitIntro_Text2{
    "Anyway, I am off to find more\n"
    "hidden grottos so I may study\l"
    "the Pokémon found in them.\p"
    "Do keep an eye out for them\n"
    "as well.\p"
    "While hidden grottos are\n"
    "generally found inbetween trees,\l"
    "some may be harder to spot than\l"
    "others."
}