mapscripts Route16_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        setflag(FLAG_TEMP_6)
        if(checkitem(ITEM_ZYGARDE_CUBE) == TRUE){
            setmaplayoutindex(LAYOUT_ROUTE16_NO_CURRENTS)
            setflag(FLAG_TEMP_1)
            clearflag(FLAG_TEMP_6)
        }
        getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
        if(var(VAR_TEMP_0) == 0){
            setvar(VAR_HOUR_OVERRIDE, 12)
        }
    }
    MAP_SCRIPT_ON_RESUME{
        // setstepcallback(STEP_CB_ASH)
        setstepcallback(STEP_CB_ROUTE_16)
    }
}

script RapidsTooStrong{
    msgbox(RapidsTooStrong_Text, MSGBOX_NPC)
}
text RapidsTooStrong_Text{
    "The waves here can be really\n"
    "unpredictable.\p"
    "No choice but to wait for\n"
    "them to die down."
}

script Route16_Fisher {
    msgbox(Route16_Tr3_Fisher_Text, MSGBOX_NPC)
}
text Route16_Tr3_Fisher_Text {
    "The volcanic activity up north is\n"
    "keeping these waters warm.\p"
    "The warmer the water, the more\n"
    "energetic the fish."
}

script Route16_SwimmerM {
    msgbox(Route16_Tr4_SwimmerM_Text, MSGBOX_NPC)
}
text Route16_Tr4_SwimmerM_Text {
    "I'm trying to get to Basalek Town,\n"
    "but I think I took a wrong turn…"
}

script Route16_Tr1_SwimmerM {
    trainerbattle_single(TRAINER_R16_TR1_SWIMMER_M, R16Tr1_Intro, R16Tr1_Lose)
    msgbox(R16Tr1_PostBattle, MSGBOX_AUTOCLOSE)
    end
}
text R16Tr1_Intro {
    "My Pokémon are at the top of\n"
    "their game!"
}
text R16Tr1_Lose {
    "Clearly we need to train more!"
}
text R16Tr1_PostBattle {
    "Maybe a short break is in order…"
}

script Route16_Tr2_SwimmerF {
    trainerbattle_single(TRAINER_R16_TR2_SWIMMER_F, R16Tr2_Intro, R16Tr2_Lose)
    msgbox(R16Tr2_PostBattle, MSGBOX_AUTOCLOSE)
    end
}
text R16Tr2_Intro {
    "I'm the greatest swimmer in the world!\n"
    "Think you can keep up?"
}
text R16Tr2_Lose {
    "Being a good swimmer doesn't make\n"
    "me any better as a trainer…"
}
text R16Tr2_PostBattle {
    "I want to be with my Water Pokémon.\n"
    "That's why I swim."
}

script Route16_Tr5_SwimmerF {
    trainerbattle_single(TRAINER_R16_TR5_SWIMMER_F, R16Tr5_Intro, R16Tr5_Lose)
    msgbox(R16Tr5_PostBattle, MSGBOX_AUTOCLOSE)
    end
}
text R16Tr5_Intro {
    "I was starting to get bored\n"
    "of swimming.\l"
    "Glad you showed up!"
}
text R16Tr5_Lose {
    "Now I wish you had not showed up…"
}
text R16Tr5_PostBattle {
    "There's not much room to navigate\n"
    "between these rocks.\p"
    "Careful you don't smash against\n"
    "a rock!"
}

script Route16_Tr6_SwimmerF {
    trainerbattle_single(TRAINER_R16_TR6_SWIMMER_F, R16Tr6_Intro, R16Tr6_Lose)
    msgbox(R16Tr6_PostBattle, MSGBOX_AUTOCLOSE)
    end
}
text R16Tr6_Intro {
    "You heading to Basalek Town?\n"
    "Not without battling me first!"
}
text R16Tr6_Lose {
    "Okay, you may proceed."
}
text R16Tr6_PostBattle {
    "The route to Basalek town can be\n"
    "a bit overwhelming.\p"
    "Be sure to hydrate!"
}

