script Amberock_AcerolaEvent{
    setflag(FLAG_ACEROLA)
    setflag(FLAG_SCIENTIST)
    if(var(VAR_ROUTE14_ROCKET_EVENT) >= 6){
        setflag(FLAG_ESCAPING_ROCKET)
        setflag(FLAG_PAPERS)
    }
    if(flag(FLAG_BADGE05_GET) && !flag(FLAG_RECEIVED_HM_SURF)){
        setobjectxyperm(1, 63, 11)
        clearflag(FLAG_SCIENTIST)
    }
    return
}
script Amberock_SetPlayerModel{
    if(checkplayergender == MALE){
        switch(var(VAR_CHOSEN_OUTFIT)){
            case 0:
                setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_BRENDAN_NORMAL_RS)
            case 1:
                setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_RIVAL_BRENDAN_NORMAL)
            case 2:
                setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_BRENDAN_NORMAL_ORAS)
        }
    }
    else{
        switch(var(VAR_CHOSEN_OUTFIT)){
            case 0:
                setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_MAY_NORMAL_RS)
            case 1:
                setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_RIVAL_MAY_NORMAL)
            case 2:
                setvar(VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_MAY_NORMAL_ORAS)
        }
    }
    return
}

script SetPlayerKrokorokModel{
    if(flag(FLAG_DISGUISED_AS_KROKOROK)){
        setkrokorokdisguise
    }
    setvar(VAR_TEMP_3, 1)
}