mapscripts AmberockTown_MapScripts{
    MAP_SCRIPT_ON_TRANSITION: Amberock_FlagControl
    MAP_SCRIPT_ON_LOAD: Amberock_PaperVisibility
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[
        VAR_TEMP_3, 0: SetPlayerKrokorokModel
    ]
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_AMBEROCK_STORY, STORY_AMBEROCK_CUT_ELECTRICITY: Amberock_GroupGoesToGate
    ]
}

const X = VAR_TEMP_1
const Y = VAR_TEMP_2
const FLAG_PAPERS = FLAG_TEMP_1
const FLAG_SCIENTIST = FLAG_TEMP_2
const FLAG_ACEROLA = FLAG_TEMP_3
const FLAG_ESCAPING_ROCKET = FLAG_TEMP_4
const FLAG_FAKE_PLAYER = FLAG_TEMP_5
const FLAG_KROKOROK = FLAG_TEMP_6
const FLAG_CLAY = FLAG_TEMP_7
const FLAG_ROCKET_BOUNCERS = FLAG_TEMP_8
const FLAG_GIOVANNI = FLAG_TEMP_9
const FLAG_TEAM_ROCKET = FLAG_TEMP_A
const FLAG_BOAT = FLAG_TEMP_B
const FLAG_HIKER = FLAG_TEMP_C
const FLAG_GATE_NINJA = FLAG_TEMP_D
const PLAYER = OBJ_EVENT_ID_PLAYER
const NPC_KROKOROK = 9
const NPC_CLAY = 10
const NPC_PLAYER = 11
const NPC_VOLKNER = 22

script Amberock_GateEvent1{
    setvar(VAR_TEMP_3, 1)
    goto(AmberockGateEventMain)
}
script Amberock_GateEvent2{
    setvar(VAR_TEMP_3, 2)
    goto(AmberockGateEventMain)
}
script Amberock_GateEvent3{
    setvar(VAR_TEMP_3, 3)
    goto(AmberockGateEventMain)
}
script Amberock_GateEvent4{
    setvar(VAR_TEMP_3, 4)
    goto(AmberockGateEventMain)
}
script AmberockGateEventMain{
    lock
    safefollow
    switch(var(VAR_TEMP_3)){
        case 1:
            applymovement(PLAYER, GateMovement1)
        case 2:
            applymovement(PLAYER, GateMovement2)
        case 3:
            applymovement(PLAYER, GateMovement3)
        case 4:
            applymovement(PLAYER, GateMovement4)
    }
    waitmovement(0)
    turnobject(NPC_CLAY, DIR_SOUTH)
    delay(8)
    msgbox(VolknerTakePrisoners, MSGBOX_AUTOCLOSE)
    applymovement(7, Amberock_LeftRocketLeaves)
    applymovement(8, Amberock_RightRocketLeaves)
    delay(48)
    applymovement(NPC_VOLKNER, Amberock_VolknerLeaves)
    delay(16)
    turnobject(PLAYER, DIR_EAST)
    turnobject(NPC_CLAY, DIR_EAST)
    waitmovement(0)
    delay(16)
    turnobject(PLAYER, DIR_NORTH)
    turnobject(NPC_CLAY, DIR_SOUTH)
    msgbox(ClayGoAfterGiovanni, MSGBOX_AUTOCLOSE)
    delay(8)
    applymovement(NPC_CLAY, Walk1Up)
    waitmovement(0)
    delay(16)
    applymovement(27, MoveGateLeft)
    applymovement(28, MoveGateRight)
    waitmovement(0)
    delay(8)
    applymovement(NPC_CLAY, ClayGoesToFactory)
    waitmovement(0)
    setvar(VAR_AMBEROCK_STORY, STORY_AMBEROCK_BEAT_GUARDS)
    removeobject(NPC_CLAY)
    removeobject(NPC_VOLKNER)
    removeobject(7)
    removeobject(8)
    setobjectxyperm(27, 41, 20)
    setobjectxyperm(28, 44, 20)
    release
}
movement MoveGateLeft{
    lock_facing_direction
    lock_anim
    walk_left
    unlock_anim
}
movement MoveGateRight{
    lock_facing_direction
    lock_anim
    walk_right
    unlock_anim
}
text VolknerTakePrisoners{
    "Clay: These guards barely put up\n"
    "a fight.\p"
    "Volkner will deliver them to\n"
    "the police, while we will head\l"
    "inside and put a stop to this."
}
text ClayGoAfterGiovanni{
    "I'll head directly to the pier.\p"
    "You go grab those papers,\n"
    "and once you're ready,\l"
    "come assist me at the pier."
}
movement Amberock_LeftRocketLeaves{
    walk_right * 2
    walk_down
    walk_right * 3
    walk_up
    walk_right * 2
    walk_up
    walk_right * 2
}
movement Amberock_RightRocketLeaves{
    walk_right
    walk_down
    walk_right * 3
    walk_up
    walk_right * 2
    walk_up
    walk_right * 2
}
movement Amberock_VolknerLeaves{
    walk_right * 4
    walk_up
    walk_right * 2
    walk_up
    walk_right * 2
}
movement ClayGoesToFactory{
    walk_up * 3
    walk_left * 7
    walk_up * 2
}
movement GateMovement1{
    walk_right * 2
    walk_up
}
movement GateMovement2{
    walk_down
    walk_left * 3
    walk_in_place_fast_up
}
movement GateMovement3{
    walk_left * 3
    walk_in_place_fast_up
}
movement GateMovement4{
    walk_left * 3
    walk_up
}

script Amberock_GroupGoesToGate{
    delay(15)
    turnobject(NPC_CLAY, DIR_SOUTH)
    msgbox(LetsGoToGate, MSGBOX_AUTOCLOSE)
    turnobject(NPC_CLAY, DIR_EAST)
    delay(15)
    applymovement(NPC_KROKOROK, moves(enter_pokeball set_invisible))
    waitmovement(0)
    removeobject(NPC_KROKOROK)
    if(flag(FLAG_FACTORY_ITEM_1) || flag(FLAG_FACTORY_ITEM_2) || flag(FLAG_FACTORY_ITEM_3)){
        playse(SE_PIN)
        applymovement(NPC_CLAY, ExclamationMark)
        waitmovement(0)
        delay(48)
        turnobject(NPC_CLAY, DIR_SOUTH)
        delay(15)
        msgbox(KrokorokWasCarryingSomething, MSGBOX_AUTOCLOSE)
        closemessage
        turnobject(NPC_CLAY, DIR_EAST)
        delay(15)
        if(flag(FLAG_FACTORY_ITEM_1)){
            clearflag(FLAG_FACTORY_ITEM_1_OUTSIDE)
            addobject(24)
        }
        if(flag(FLAG_FACTORY_ITEM_2)){
            clearflag(FLAG_FACTORY_ITEM_2_OUTSIDE)
            addobject(25)
        }
        if(flag(FLAG_FACTORY_ITEM_3)){
            clearflag(FLAG_FACTORY_ITEM_3_OUTSIDE)
            addobject(26)
        }
        delay(60)
    }
    applymovement(NPC_CLAY, ClayMovesToGate)
    applymovement(NPC_VOLKNER, VolknerMovesToGate)
    waitmovement(NPC_CLAY)
    setobjectxy(NPC_CLAY, 42, 22)
    setobjectxyperm(NPC_CLAY, 42, 22)
    setobjectxy(NPC_VOLKNER, 43, 22)
    setobjectxyperm(NPC_VOLKNER, 43, 22)
    turnobject(NPC_CLAY, DIR_NORTH)
    turnobject(NPC_VOLKNER, DIR_NORTH)
    setobjectmovementtype(NPC_CLAY, MOVEMENT_TYPE_FACE_UP)
    setobjectmovementtype(NPC_VOLKNER, MOVEMENT_TYPE_FACE_UP)
    setvar(VAR_AMBEROCK_STORY, STORY_AMBEROCK_GROUP_WAITING_AT_GATE)
    release
}
text LetsGoToGate{
    "Clay: With the facility plunged\n"
    "into darkness, we can rush\l"
    "the gates without raising an alarm.\p"
    "Let's go!"
}
text KrokorokWasCarryingSomething{
    "Clay: It looks like the Krokorok\n"
    "was carrying something.\p"
    "Most of this stuff belonged to\n"
    "Team Rocket, so no need to feel bad\l"
    "for taking it.\p"
    "Once you're ready,\n"
    "meet us at the gates."
}
movement ClayMovesToGate{
    walk_down * 2
    walk_right *2
    walk_down * 4
    walk_right * 8
}
movement VolknerMovesToGate{
    walk_down * 6
    walk_right * 8
}
script SetFactoryWarp2{
    if(var(VAR_AMBEROCK_STORY) < STORY_AMBEROCK_CUT_ELECTRICITY){
        setdynamicwarp(MAP_AMBEROCK_POKEBALL_FACTORY, 1)
    }
    else{
        setdynamicwarp(MAP_AMBEROCK_POKEBALL_FACTORY_NO_LIGHTS, 1)
    }
    release
}
script SetFactoryWarp1{
    if(var(VAR_AMBEROCK_STORY) < STORY_AMBEROCK_CUT_ELECTRICITY){
        setdynamicwarp(MAP_AMBEROCK_POKEBALL_FACTORY, 0)
    }
    else{
        setdynamicwarp(MAP_AMBEROCK_POKEBALL_FACTORY_NO_LIGHTS, 0)
    }
    release
}

script Amberock_FlagControl{
    if(var(VAR_AMBEROCK_STORY) >= STORY_AMBEROCK_GIOVANNI_ESCAPED){
        setflag(FLAG_TEAM_ROCKET)
        setflag(FLAG_REPAIR_AMBEROCK_BRIDGE)
    }
    if(var(VAR_AMBEROCK_STORY) >= STORY_AMBEROCK_CUT_ELECTRICITY){
        setflag(FLAG_GATE_NINJA)
    }
    if(var(VAR_AMBEROCK_STORY) == STORY_AMBEROCK_GROUP_WAITING_AT_GATE){
        setflag(FLAG_KROKOROK)
        setobjectmovementtype(NPC_CLAY, MOVEMENT_TYPE_FACE_UP)
        setobjectmovementtype(NPC_VOLKNER, MOVEMENT_TYPE_FACE_UP)
        setobjectxyperm(NPC_CLAY, 42, 22)
        setobjectxyperm(NPC_VOLKNER, 43, 22)
    }
    if(var(VAR_AMBEROCK_STORY) >= STORY_AMBEROCK_BEAT_GUARDS){
        setflag(FLAG_CLAY)
        setflag(FLAG_KROKOROK)
        setflag(FLAG_ROCKET_BOUNCERS)
        setobjectxyperm(27, 41, 20)
        setobjectxyperm(28, 44, 20)
    }
    if(!flag(FLAG_DISGUISED_AS_KROKOROK)){
        setflag(FLAG_FAKE_PLAYER)
    }
    else{
        setflag(FLAG_TEMP_HIDE_FOLLOWER)
        setflag(FLAG_KROKOROK)
    }
    ///
    if(flag(FLAG_REPAIR_AMBEROCK_BRIDGE)){
        setmaplayoutindex(LAYOUT_AMBEROCK_TEST)
    }
    else{
        setflag(FLAG_HIKER)
    }
    call(Amberock_AcerolaEvent)
    call(Amberock_SetPlayerModel)
}

script Amberock_KrokorokIntro{
    lock
    safefollow
    delay(15)
    playse(SE_PIN)
    turnobject(NPC_CLAY, DIR_SOUTH)
    turnobject(NPC_VOLKNER, DIR_SOUTH)
    applymovement(NPC_CLAY, ExclamationMark)
    applymovement(NPC_VOLKNER, ExclamationMark)
    waitmovement(0)
    delay(64)
    dismountplayer
    applymovement(PLAYER, Walk2Up)
    waitmovement(0)
    unlockfollowermovement
    msgbox(VolknerGreetsPlayer)
    turnobject(NPC_VOLKNER, DIR_WEST)
    turnobject(PLAYER, DIR_WEST)
    turnobject(NPC_CLAY, DIR_EAST)
    msgbox(ClayHelped)
    turnobject(NPC_VOLKNER, DIR_SOUTH)
    turnobject(PLAYER, DIR_NORTH)
    msgbox(VolknerControlKrokorok)
    turnobject(NPC_VOLKNER, DIR_WEST)
    turnobject(PLAYER, DIR_WEST)
    turnobject(NPC_CLAY, DIR_EAST)
    msgbox(ClayTip)
    setvar(VAR_AMBEROCK_STORY, STORY_AMBEROCK_SPOKE_WITH_CLAY)
    release
}

text VolknerGreetsPlayer{
    "Volkner: Oh, it's you.\n"
    "{PLAYER}, right?\p"
    "You're here after Team Rocket\n"
    "as well? Perfect timing.\p"
    "Busting through the main gate would\n"
    "most likely sound an alarm, so we\l"
    "came up with a different way in."
}
text ClayHelped{
    "Interrogating the grunt we caught\n"
    "at the Pokémon Ranch, we learned\l"
    "about where Team Rocket might\l"
    "attack next.\p"
    "So, I contacted Mr. Clay,\n"
    "who was willing to train a Krokorok\l"
    "we can order around and use to\l"
    "spy on their operations."
}
text VolknerControlKrokorok{
    "This Krokorok is wearing a hidden\n"
    "ear piece and a camera, allowing\l"
    "us to order it around remotely.\p"
    "I've seen how good you are with\n"
    "Pokémon.\p"
    "Maybe you'd like to command\n"
    "the Krokorok?\p"
    "The objective is simple: find out who\n"
    "is in charge, what their plans are,\l"
    "and sabotage the facility's generator\l"
    "so that we can sneak in while they are\l"
    "trying to figure out what happened."
}

script Amberock_Clay{
    msgbox(Amberock_Clay_Text, MSGBOX_NPC)
}
text Amberock_Clay_Text{
    "Team Rocket ain't known for\n"
    "their kindness, so they might not\l"
    "like it if they spot a Krokorok\l"
    "wandering around aimlessly.\p"
    "Try to avoid their sight\n"
    "the best ye can."
}
text ClayTip{
    "Clay: Team Rocket ain't known for\n"
    "their kindness, so they might not\l"
    "like it if they spot a Krokorok\l"
    "wandering around aimlessly.\p"
    "Try to avoid their sight\n"
    "the best ye can."
}

script Amberock_Volkner{
    msgbox(Amberock_Volkner_Text, MSGBOX_NPC)
}
text Amberock_Volkner_Text{
    "The objective is simple: find out who\n"
    "is in charge, what their plans are,\l"
    "and sabotage the facility's generator\l"
    "so that we can sneak in while they are\l"
    "trying to figure out what happened."
}

script Amberock_KrokorokScript{
    msgbox(SwitchToKrokorok, MSGBOX_YESNO)
    if(var(VAR_RESULT) == FALSE){
        release
        end
    }
    closemessage
    delay(15)

    clearflag(FLAG_FAKE_PLAYER)
    addobject(NPC_PLAYER)

    applymovement(PLAYER, MovePlayerToKrokorokNorth)
    waitmovement(0)
    setkrokorokdisguise
    applymovement(PLAYER, SetObjectVisible)
    waitmovement(0)
    setflag(FLAG_DISGUISED_AS_KROKOROK)
    setflag(FLAG_TEMP_HIDE_FOLLOWER)
    callnative(UpdateFollowingPokemon)
    setflag(FLAG_SYS_USE_STRENGTH)
    removeobject(NPC_KROKOROK)
    clearflag(FLAG_SYS_B_DASH)
    delay(15)
    applymovement(PLAYER, KrokorokGoesNorthThroughFence)
    delay(8)
    playse(SE_LEDGE)
    delay(32)
    playse(SE_M_DIG)
    waitse
    playse(SE_M_DIG)
    waitse
    playse(SE_M_DIG)
    waitse
    playse(SE_M_DIG)
    waitse
    fadenewbgm(MUS_AQUA_MAGMA_HIDEOUT)
    delay(32)
    playse(SE_M_SAND_ATTACK)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    release
}

script Amberock_KrokorokGiovanniCutScene{
    lock
    delay(15)
    msgbox(GiovanniWeAreOnSchedule)
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left * 2, walk_up, walk_left, walk_in_place_fast_down))
    waitmovement(0)
    msgbox(ClayLetsBail)
    msgbox(ClayLetsBailPart2)
    msgbox(ClayLetsBailPart3)
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Walk2Right)
    waitmovement(0)
    msgbox(ClayLetsBail2)
    setvar(VAR_AMBEROCK_STORY, STORY_AMBEROCK_FOUND_GIOVANNI)
    release
}
text GiovanniWeAreOnSchedule{
    "Clay: Is that who I think it is?\n"
    "Get us a bit closer, will ya?"
}
text ClayLetsBail{
    "Proton: We've finished grabbing\n"
    "the Poké Balls from the assembly\l"
    "lines, and are now scouring through\l"
    "the crates.\p"
    "It will take a while to grab\n"
    "everything, but we should be able to\l"
    "finish before we are discovered."
}
text ClayLetsBailPart2{
    "???: Excellent. And what about\n"
    "the research?"
}
text ClayLetsBailPart3{
    "Proton: Everything is going exactly\n"
    "as planned.\p"
    "Some of the smartest people I know\n"
    "are on the case."
}

text ClayLetsBail2{
    "Clay: It's just as we feared.\p"
    "This ain't some small\n"
    "remnant force.\p"
    "That's Giovanni, the actual leader\n"
    "of the syndicate.\p"
    "Quick, we must cut the power NOW.\p"
    "We need to get inside this facility\n"
    "and put an end to this!"
}

script Amberock_RecallKrokorok{
    if(msgbox(TellKrokorokToRetreat, MSGBOX_YESNO) == FALSE){
        release
        end
    }
    closemessage
    delay(15)
    applymovement(PLAYER, KrokorokGoesSouthThroughFence)
    delay(8)
    playse(SE_LEDGE)
    delay(32)
    playse(SE_M_DIG)
    waitse
    playse(SE_M_DIG)
    waitse
    playse(SE_M_DIG)
    waitse
    playse(SE_M_DIG)
    waitse
    fadenewbgm(MUS_RUSTBORO)
    delay(32)
    playse(SE_M_SAND_ATTACK)
    playse(SE_BIKE_HOP)
    waitmovement(0)
    clearflag(FLAG_KROKOROK)
    addobject(NPC_KROKOROK)
    applymovement(PLAYER, MovePlayerFromKrokorokSouth)
    waitmovement(0)
    setkrokorokdisguise
    applymovement(PLAYER, SetObjectVisible)
    waitmovement(0)
    clearflag(FLAG_DISGUISED_AS_KROKOROK)
    clearflag(FLAG_TEMP_HIDE_FOLLOWER)
    callnative(UpdateFollowingPokemon)
    removeobject(NPC_PLAYER)
    setflag(FLAG_SYS_B_DASH)
}

script PokeFactory_Packer{
    msgbox(PokeFactory_Packer_Text)
    release
}
text PokeFactory_Packer_Text{
    "The grunt is too busy packing the\n"
    "crates to notice the Krokorok."
}

text TellKrokorokToRetreat{
    "Order the Krokorok to return back\n"
    "to the group?"
}

movement KrokorokGoesNorthThroughFence{
    walk_in_place_fast_up
    jump_in_place_up
    set_invisible
    delay_16
    walk_slow_up * 2
    delay_16 * 3
    set_visible
    jump_in_place_up
}
movement KrokorokGoesSouthThroughFence{
    walk_in_place_fast_down
    jump_in_place_down
    set_invisible
    delay_16
    walk_slow_down * 2
    delay_16 * 3
    set_visible
    jump_in_place_down
}

script DiscoverAmberock{
    setflag(FLAG_VISITED_AMBEROCK)
    release
}

script Amberock_RetreatKrokorok{
    if(msgbox(CallKrokorokBack, MSGBOX_YESNO) == TRUE){
        clearflag(FLAG_DISGUISED_AS_KROKOROK)
        setflag(FLAG_SYS_B_DASH)
        // setkrokorokdisguise
        warp(MAP_AMBEROCK_TOWN, 30, 21)
        waitstate
    }
    release
}

text CallKrokorokBack{
    "Order the Krokorok to return back\n"
    "to the group?"
}

script Amberock_PaperVisibility{
    if((var(VAR_ROUTE14_ROCKET_EVENT) >= 6)
    && !flag(FLAG_REPAIR_AMBEROCK_BRIDGE)){
        setmetatile(27 + 30, 10, 0x128, FALSE)
        setmetatile(27 + 30, 12, 0x189, FALSE)
        setmetatile(26 + 30, 12, 0x189, FALSE)
        setmetatile(25 + 30, 13, 0x170, FALSE)
        setmetatile(24 + 30, 13, 0x170, FALSE)
        setmetatile(23 + 30, 13, 0x170, FALSE)
        setmetatile(23 + 30, 14, 0x170, FALSE)
        setmetatile(24 + 30, 14, 0x170, FALSE)
        setmetatile(25 + 30, 14, 0x170, FALSE)
        setmetatile(24 + 30, 15, 0x170, FALSE)
        setmetatile(25 + 30, 15, 0x170, FALSE)
        setmetatile(26 + 30, 15, 0x170, FALSE)
        setmetatile(26 + 30, 16, 0x170, FALSE)
        setmetatile(27 + 30, 16, 0x170, FALSE)
        setmetatile(28 + 30, 16, 0x170, FALSE)
    }
}
script Amberock_SurfScientist{
    lock
    faceplayer
    msgbox(HereIsSurfHM)
    giveitem(ITEM_HM03)
    msgbox(GoGetBackPapers)
    closemessage
    safefollow
    if(var(VAR_FACING) == DIR_SOUTH){
        getfollowerxy(X, Y)
        if(var(X) == 64 && var(Y) == 10){
            clearflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
        }
        applymovement(1, ScientistLeavesDetour)
    }
    else{
        applymovement(1, ScientistLeavesStraight)
    }
    waitmovement(0)
    removeobject(1)
    setflag(FLAG_RECEIVED_HM_SURF)
    release
}
text HereIsSurfHM{
    "Ah, perfect timing!\p"
    "I was able to get my hands on the\n"
    "perfect Hidden Machine for this job.\p"
    "Here, you should take it."
}
text GoGetBackPapers{
    "As much as I would like to help you on\n"
    "this, I'm just a scientist after all.\p"
    "I mean, I don't even have my own\n"
    "Pokémon!\p"
    "I know this is a lot to ask from\n"
    "someone you barely even know,\l"
    "but please, recover our research\l"
    "material from Team Rocket!\p"
    "I had a talk with my colleagues and we\n"
    "have unanimously decided that if you\l"
    "do this, we'll reward you with\l"
    "something special.\p"
    "With that said, I need to get back to\n"
    "my research.\p"
    "When you're done, come meet me back at\n"
    "the research center on Route 14."
}

movement ScientistLeavesDetour{
    walk_right
    walk_up * 4
    walk_left
    walk_up * 2
    walk_left * 5
    walk_up * 2
}
movement ScientistLeavesStraight{
    walk_up * 5
    walk_left * 5
    walk_up * 2
}

script Amberock_Papers{
    lock
    safefollow
    msgbox(PapersOnGround)
    removeobject(3)
    setmetatile(57, 10, 0x128, FALSE)
    special(DrawWholeMapView)
    closemessage
    clearflag(FLAG_SCIENTIST)
    clearflag(FLAG_ACEROLA)
    addobject(1)
    addobject(2)
    getfollowerxy(X, Y)
    if(!defeated(TRAINER_R15_TR18_BERRYROCKET)){
        call(AmberockAlternativeCutscene)
    }
    delay(60)
    switch(var(VAR_FACING)){
        case DIR_SOUTH:
            if(var(X) == 57 && var(Y) == 8){
                clearflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
            }
            applymovement(1, MoveScientist2)
        case DIR_WEST:
            if(var(X) == 58 && var(Y) == 9){
                clearflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
            }
            setobjectxy(31, 28, 4)
            applymovement(1, Walk6Down)
        case DIR_EAST:
            if(var(X) == 56 && var(Y) == 9){
                clearflag(FLAG_SAFE_FOLLOWER_MOVEMENT)
            }
            setobjectxy(31, 28, 4)
            applymovement(1, MoveScientist1)
    }
    waitmovement(0)
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)
    delay(24)
    if(flag(FLAG_TEMP_A)){
        msgbox(OurPapersAlternative)
    }
    else{
        msgbox(OurPapers)
    }
    closemessage
    switch(var(VAR_FACING)){
        case DIR_SOUTH:
            applymovement(1, ScientistLeave2)
        case DIR_WEST:
            applymovement(1, Walk5Up)
        case DIR_EAST:
            applymovement(1, ScientistLeave1)
    }
    waitmovement(0)
    delay(60)
    switch(var(VAR_FACING)){
        case DIR_SOUTH:
            applymovement(2, MoveScientist2)
        case DIR_WEST:
            setobjectxy(32, 28, 4)
            applymovement(2, Walk6Down)
        case DIR_EAST:
            setobjectxy(32, 28, 4)
            applymovement(2, MoveScientist1)
    }
    waitmovement(0)
    delay(15)
    checkplayergender
    if(var(VAR_RESULT) == MALE){
        bufferstring(STR_VAR_1, "mister")
    }
    else{
        bufferstring(STR_VAR_1, "miss")
    }
    if(flag(FLAG_ACEROLA_TALKED_TO)){
        msgbox(AcerolaVisitGym)
    }
    else{
        msgbox(AcerolaVisitGymAlternative)
    }
    closemessage
    switch(var(VAR_FACING)){
        case DIR_SOUTH:
            applymovement(2, ScientistLeave2)
        case DIR_WEST:
            applymovement(2, Walk5Up)
        case DIR_EAST:
            applymovement(2, ScientistLeave1)
    }
    waitmovement(0)
    setvar(VAR_ROUTE14_ROCKET_EVENT, 6)
    removeobject(1)
    removeobject(2)
    delay(15)
    release
}
text PapersOnGround{
    "There seems to be some papers on\n"
    "the ground here.\p"
    "{PLAYER} picked up the papers."
}
text OurPapers{
    "Can I see those papers?\p"
    "{PLAYER} handed the papers to the\n"
    "scientist.\p"
    "… … … …\p"
    "Yes, these are definitely some of\n"
    "the papers that were stolen.\p"
    "The culprit must have fled to Amberock\n"
    "Town and cut the bridge behind him,\l"
    "giving him ample time to hide.\p"
    "That scoundrel!\p"
    "It would take too long to wait for\n"
    "the bridge to be repaired.\p"
    "You should prepare your team for\n"
    "what lies ahead.\p"
    "In the meantime, I'll try to get my\n"
    "hands on a Hidden Machine that can\l"
    "teach your Pokémon how to carry\l"
    "people across water.\p"
    "I'll meet you back here once we're\n"
    "both ready."
}
