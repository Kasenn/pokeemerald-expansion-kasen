script Amberock_OldMan{
    lock
    if(checkitem(ITEM_COIN_CASE) == TRUE){
        msgbox(Amberock_OldMan_Text2)
        release
        end
    }
    faceplayer
    msgbox(Amberock_OldMan_Text)
    giveitem(ITEM_COIN_CASE)
    release
    turnobject(16, DIR_SOUTH)
    end
}
