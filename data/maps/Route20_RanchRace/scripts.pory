    goto(Race1_Flag_Main)}
script RanchRace_Flag9{
    removeobject(LOCALID_FLAG_9)
    goto(Race1_Flag_Main)}
script RanchRace_Flag10{
    removeobject(LOCALID_FLAG_10)
    goto(Race1_Flag_Main)}
script Race1_Flag_Main{
    addvar(VAR_RACE_FLAGS, 1)
    if(var(VAR_RACE_FLAGS) == 10){
        playse(SE_SUCCESS)
    }
    else{
        playse(SE_PIN)
    }
    release
}

script Race1_FinishNorth{
    setvar(VAR_RACE_DIRECTION, DIR_NORTH)
    goto(Race1_FinishMain)}
script Race1_FinishEast{
    setvar(VAR_RACE_DIRECTION, DIR_EAST)
    goto(Race1_FinishMain)}
script Race1_FinishSouth{
    setvar(VAR_RACE_DIRECTION, DIR_SOUTH)
    goto(Race1_FinishMain)}
script Race1_FinishWest{
    setvar(VAR_RACE_DIRECTION, DIR_WEST)
    goto(Race1_FinishMain)}


script Race1_FinishMain{
    lock
    callnative(FinishGogoatRace)
    switch(var(VAR_RACE_DIRECTION)){
        case DIR_NORTH: turnobject(1, DIR_SOUTH)
        case DIR_EAST:  turnobject(1, DIR_WEST)
        case DIR_WEST:  turnobject(1, DIR_EAST)
        case DIR_SOUTH: turnobject(1, DIR_NORTH)
    }
    playse(SE_PIN)
    exclamationmark(1)
    switch(var(VAR_RACE_DIRECTION)){
        case DIR_NORTH: turnobject(LOCALID_PLAYER, DIR_SOUTH)
        case DIR_EAST:  turnobject(LOCALID_PLAYER, DIR_WEST)
        case DIR_WEST:  turnobject(LOCALID_PLAYER, DIR_EAST)
        case DIR_SOUTH: turnobject(LOCALID_PLAYER, DIR_NORTH)
    }
    msgbox(FinishRace1_CalculateScore)

    // have finished the race before //
    if(var(VAR_GOGOAT_RACE) >= STORY_GOGOAT_RACE_1_REWARD_EARNED){ 
        if(flag(FLAG_TEMP_D)){ // broke personal record
            msgbox(Race1_YouWonAgain)
            clearflag(FLAG_GOGOAT_RIDING)
            setvar(VAR_RACE_START, 1)
            warp(MAP_ROUTE20, 1)
            waitstate
        }
        else{ // did not break personal record, thus no record was broken
            msgbox(Race1_FailedToImprove)
            if(msgbox(Race1_TryAgain, MSGBOX_YESNO) == FALSE){
                msgbox(Race1_LetsGetYouOff)
                warp(MAP_ROUTE20, 1)
                clearflag(FLAG_GOGOAT_RIDING)
                waitstate
                release
                end
            }
            else{
                msgbox(LetsGetGogoatRacing)
                warp(MAP_ROUTE20_RANCH_RACE, 0)
                setflag(FLAG_GOGOAT_RIDING)
                waitstate
            }
        }
    }

    // have not finished the race before //
    else{
        if(flag(FLAG_TEMP_C)){ // finished in time and made a new record
            setvar(VAR_GOGOAT_RACE, STORY_GOGOAT_RACE_1_COMPLETE)
            msgbox(Race1_YouWon)
            clearflag(FLAG_GOGOAT_RIDING)
            setvar(VAR_RACE_START, 1)
            warp(MAP_ROUTE20, 1)
            waitstate
        }
        else{ // did not finish in time
            msgbox(Race1_YouLost)
            if(msgbox(Race1_TryAgain, MSGBOX_YESNO) == FALSE){
                msgbox(Race1_LetsGetYouOff)
                if(var(VAR_GOGOAT_RACE) == STORY_GOGOAT_RACE_1_IN_PROGRESS){ setvar(VAR_GOGOAT_RACE, STORY_GOGOAT_RACE_1_FAILED) }
                warp(MAP_ROUTE20, 1)
                clearflag(FLAG_GOGOAT_RIDING)
                waitstate
                release
                end
            }
            else{
                msgbox(LetsGetGogoatRacing)
                setvar(VAR_GOGOAT_RACE, STORY_GOGOAT_RACE_1_IN_PROGRESS)
                warp(MAP_ROUTE20_RANCH_RACE, 0)
                setflag(FLAG_GOGOAT_RIDING)
                waitstate
            }
        }
    }
}

