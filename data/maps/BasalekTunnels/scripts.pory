script BasaltTunnel_Tr11_Hiker3 {
    trainerbattle_single(TRAINER_BASALTUNNEL_TR11_HIKER3, BasaltTr11_Intro, BasaltTr11_Lose)
    msgbox(BasaltTr11_PostBattle, MSGBOX_AUTOCLOSE)
    end
}
text BasaltTr11_Intro {
    "We will rock you!"
}
text BasaltTr11_Lose {
    "What a big disgrace we are."
}
text BasaltTr11_PostBattle {
    "You're gonna be a big man someday,\n"
    "I can tell."
}

script BasaltTunnel_Tr12_Brock {
    if(checkitem(ITEM_HM08)){
        msgbox(BasaltTr12_PostBattle, MSGBOX_NPC)
        end
    }
    lock
    faceplayer
    msgbox(BasaltTr12_Intro, MSGBOX_YESNO)
    if(var(VAR_RESULT) == FALSE){
        msgbox(BasaltTr12_IntroNo)
    }
    else{
        msgbox(BasaltTr12_IntroYes)
    }
    trainerbattle_no_intro(TRAINER_BASALTUNNEL_TR12_BROCK, BasaltTr12_Lose)
    msgbox(BrockPostBat)
    closemessage
    giveitem(ITEM_HM_ROCK_CLIMB)
    waitfanfare
    msgbox(ExplainRockClimb)
    msgbox(BasaltTr12_PostBattle)
    release
}
text BasaltTr12_Intro {
    "Welcome, challenger.\n"
    "My name is Brock.\p"
    "Some people call me the reigning\n"
    "champion of Basalek Tunnels, but\l"
    "I'm not really one for titles.\p"
    "All I care about is challenging\n"
    "strong trainers in order to better\l"
    "myself and my Pokémon.\p"
    "Tell me, do you believe yourself\n"
    "to be a strong trainer?"
}
text BasaltTr12_IntroNo{
    "So humble.\p"
    "You're going to challenge me,\n"
    "knowing that you'll lose?\p"
    "That's the trainer's honor that\n"
    "compels you to challenge me.\p"
    "Fine, then!\n"
    "Show me your best!"
}
text BasaltTr12_IntroYes{
    "So confident.\p"
    "You think you're going to\n"
    "trounce over me, is that it?\p"
    "Fine, then!\n"
    "Let's see what you got!"
}
text BasaltTr12_Lose {
    "I took you for granted,\n"
    "and so I lost."
}
text BasaltTr12_PostBattle {
    "I must get back to my training.\p"
    "Once my training is complete,\n"
    "maybe we can have another battle."
}
text BrockPostBat{
    "I'm honored to have battled\n"
    "such a strong trainer.\p"
    "For your great performance,\n"
    "I want you to have this."
}
text ExplainRockClimb{
    "That Hidden Machine contains\n"
    "the move Rock Climb.\p"
    "Rock Climb will clear most hazards\n"
    "from the battlefield, as well as\l"
    "increase the speed of the Pokémon\l"
    "using the move.\p"
    "It will also allow you to climb\n"
    "certain rocky walls."
}

script BasalekTunnelGreeter{
    if(defeated(TRAINER_BASALTUNNEL_TR12_BROCK)){
        msgbox(BasalekTunnelGreeter_Victory, MSGBOX_NPC)
    }
    else{
        msgbox(BasalekTunnelGreeter_Guide, MSGBOX_NPC)
    }
}

text BasalekTunnelGreeter_Guide{
    "Welcome to Basalek Tunnels.\p"
    "In this high pressure tunnel network,\n"
    "only the strongest may survive.\p"
    "If you feel up to the challenge, why\n"
    "don't you try finding and defeating\l"
    "the reigning champion?\p"
    "Be careful though!\p"
    "The ground here can be very rough,\n"
    "and heavily favors Rock-type Pokémon.\p"
    "All grounded Pokémon using Rock-type\n"
    "moves will pack an extra punch,\l"
    "but be warned, for if your Pokémon\l"
    "isn't of Rock, Ground, or Steel type,\l"
    "the sharp rocks might actually cause\l"
    "more harm than good.\p"
    "Also, due to the heat rising from the\n"
    "ground, many Water-type moves will be\l"
    "highly ineffective.\p"
    "With that out of the way,\n"
    "go get 'em, champ!"
}
text BasalekTunnelGreeter_Victory{
    "Beat the reigning champion, did you?\n"
    "Way to go!\p"
    "However, I better not catch you\n"
    "sitting on your laurels!\p"
    "Knowing the champion, I'm sure\n"
    "he's started to train even harder\l"
    "than before.\p"
    "The next time you meet, you may be\n"
    "in for a big surprise!"
}