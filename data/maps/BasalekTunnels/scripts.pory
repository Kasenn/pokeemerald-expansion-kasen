mapscripts BasalekTunnels_MapScripts {
    
}

script BasaltTunnel_Tr1_Hiker1 {
    trainerbattle_single(TRAINER_BASALTUNNEL_TR1_HIKER1, BasaltTr1_Intro, BasaltTr1_Lose)
    msgbox(BasaltTr1_PostBattle, MSGBOX_AUTOCLOSE)
    end
}
text BasaltTr1_Intro {
    "Think you're tough enough\n"
    "to train here?"
}
text BasaltTr1_Lose {
    "Ghahaha!\p"
    "Welcome to the Basalek Tunnels!\n"
    "I think you'll fit right in!"
}
text BasaltTr1_PostBattle {
    "These tunnels can be rough,\n"
    "but I'm sure you'll do fine!"
}

