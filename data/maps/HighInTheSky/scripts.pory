const VAR_X = VAR_TEMP_0
const VAR_Y = VAR_TEMP_1
const VAR_DIRECTION = VAR_TEMP_2

mapscripts HighInTheSky_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        setflag(FLAG_DONT_FADE)
        getplayerxy(VAR_X, VAR_Y)
        if(var(VAR_X) == 12){
            setvar(VAR_DIRECTION, DIR_WEST)
        }
        else{
            setvar(VAR_DIRECTION, DIR_EAST)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_DIRECTION, DIR_WEST: MoveDrifballoonLeftToRight
        VAR_DIRECTION, DIR_EAST: MoveDrifballoonRightToLeft
    ]
    MAP_SCRIPT_ON_RESUME{
        if(flag(FLAG_SYS_CTRL_OBJ_DELETE)){
            removeobject(5)
        }
    }
}

script MoveDrifballoonLeftToRight{
    clearflag(FLAG_DONT_FADE)
    setflag(FLAG_DONT_DESPAWN_OBJECTS)
    special(SpawnCameraObject)
    addobject(2)
    addobject(4)
    setobjectxy(LOCALID_PLAYER, 3, 10)
    setobjectsubpriority(LOCALID_PLAYER, MAP_HIGH_IN_THE_SKY, 0)
    applymovement(LOCALID_PLAYER, MoveDrifblimEventsRight)
    applymovement(2, MoveDrifblimEventsRight)
    applymovement(4, MoveDrifblimEventsRight)
    applymovement(LOCALID_CAMERA, moves(walk_slow_right * 20))
    fadescreen(FADE_FROM_BLACK)
    fadenewbgm(MUS_CYCLING)
    delay(480)
    callnative(ForceFadeOutBGM)
    fadescreenspeed(FADE_TO_BLACK, 4)
    waitmovement(0)
    warpsilentnofadeout(MAP_ROUTE3, 84, 11)
}

script MoveDrifballoonRightToLeft{
    clearflag(FLAG_DONT_FADE)
    setflag(FLAG_DONT_DESPAWN_OBJECTS)
    special(SpawnCameraObject)
    addobject(1)
    addobject(3)
    setobjectxy(LOCALID_PLAYER, 63, 10)
    applymovement(LOCALID_PLAYER, MoveDrifblimEventsLeft)
    applymovement(1, MoveDrifblimEventsLeft)
    applymovement(3, MoveDrifblimEventsLeft)
    applymovement(LOCALID_CAMERA, moves(walk_slow_left * 10))
    fadescreen(FADE_FROM_BLACK)
    fadenewbgm(MUS_CYCLING)
    savebgm(MUS_CYCLING)
    waitmovementall

    special(RemoveCameraObject)
    playmoncry(SPECIES_PIDGEOT, CRY_MODE_NORMAL)
    delay(8)
    applymovement(LOCALID_PLAYER, moves(walk_in_place_fast_left))
    waitmovement(0)
    waitmoncry
    delay(16)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    setwildbattle(SPECIES_PIDGEOT, 40)
    setflag(FLAG_SKY_BATTLE)
    setvar(VAR_SKY_BATTLE, 1)
    special(TrySkyBattle)
    doscriptedbattle

    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    special(SpawnCameraObject)
    delay(8)
    applymovement(LOCALID_PLAYER, MoveDrifblimEventsLeft2)
    applymovement(1, MoveDrifblimEventsLeft2)
    applymovement(3, MoveDrifblimEventsLeft2)
    applymovement(LOCALID_CAMERA, moves(walk_slow_left * 10))
    delay(240)
    callnative(ForceFadeOutBGM)
    fadescreenspeed(FADE_TO_BLACK, 4)
    waitmovement(0)
    warpsilentnofadeout(MAP_ROUTE2, 72, 17)
}

movement MoveDrifblimEventsRight{
    lock_facing_direction
    lock_anim
    walk_right * 40
    unlock_anim
    unlock_facing_direction
}

movement MoveDrifblimEventsLeft{
    lock_facing_direction
    lock_anim
    walk_left * 20
    unlock_anim
    unlock_facing_direction
}

movement MoveDrifblimEventsLeft2{
    lock_facing_direction
    lock_anim
    walk_left * 20
    unlock_anim
    unlock_facing_direction
}