mapscripts Nes_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_TEMP_0, 0: ActivateNesCutscene
    ]
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[
        VAR_TEMP_0, 0 {
            hideplayer
        }
    ]
}

const VAR_X = VAR_0x8001
const VAR_Y = VAR_0x8002
const TEXT_START_Y = 196
const TEXT_END_Y = TEXT_START_Y + 1
const TEXT_DEST_Y = 264
const RAILING_START_Y = 253
const WINDOW_START_Y = 251
const DEFAULT_DELAY = 8
const EMPTY_SPACE_Y = 235

script Nes_InterruptCutscene{
    special(DisableCutsceneSkip)
    getplayerxy(VAR_X, VAR_Y)
    subvar(VAR_X, 7)
    subvar(VAR_Y, 5)
    drawtiles(MAP_NES, 0, 12, 14, 23, VAR_X, VAR_Y)
    removeobjectbyflag(FLAG_TEMP_1)
    special(StopMovementScript)
    applymovement(LOCALID_PLAYER, moves(face_down))
    waitmovement(LOCALID_PLAYER)
    getplayerxy(VAR_X, VAR_Y)
    playbgm(MUS_MMTITLE2, TRUE)
    subvar(VAR_X, 7)
    subvar(VAR_Y, 5)
    special(SetScenePal3)
    drawtiles(MAP_NES, 0, 169, 14, 180, VAR_X, VAR_Y)
    special(DrawWholeMapView)
    removeobjectbyflag(FLAG_TEMP_1)
    addvar(VAR_X, 12)
    addvar(VAR_Y, 7)
    addobject(LOCALID_MEGAMAN)
    setobjectxy(LOCALID_MEGAMAN, VAR_X, VAR_Y)
    releaseall
    special(CreateRooftopSprites) // Necessary so the later removal doesn't remove player
Nes_Intermission:
    delay(10)
    special(ClearRooftopSprites)
    waitstartpress
    playbgm(MUS_DUMMY, TRUE)
    applymovement(LOCALID_MEGAMAN, moves(nurse_joy_bow, slide_up * 5 delay_16 * 12))
    delay(44)
    playse(SE_WARP_IN)
    subvar(VAR_X, 12)
    subvar(VAR_Y, 7)
    waitmovement(LOCALID_MEGAMAN)
    delay(10)
    drawtiles(MAP_NES, 0, 0, 14, 11, VAR_X, VAR_Y)
    removeobjectbyflag(FLAG_TEMP_1)
    delay(60)
    special(ClearAnims)
    warpsilent(MAP_PLAYER_HOUSE2F, 1)
    waitstate
}

script Nes_InterruptCutscene2{
    releaseall
    getplayerxy(VAR_X, VAR_Y)
    subvar(VAR_X, 7)
    subvar(VAR_Y, 5)
    drawtiles(MAP_NES, 0, 169, 14, 180, VAR_X, VAR_Y)
    addvar(VAR_X, 12)
    addvar(VAR_Y, 7)
    goto(Nes_Intermission)
}

script ActivateNesCutscene{
    // Copyright screen
    special(SetSceneDark)
    special(LoadTextColor0)
    drawtiles (MAP_NES, 1, 211, 14, 217, 0, 258)
    delay(20)
    special(LoadTextColor1)
    delay(DEFAULT_DELAY)
    special(LoadTextColor2)
    delay(DEFAULT_DELAY)
    special(LoadTextColor3)
    delay(320)
    special(LoadTextColor2)
    delay(DEFAULT_DELAY)
    special(LoadTextColor1)
    delay(DEFAULT_DELAY)
    special(LoadTextColor0)
    // Load in the city scenery
    delay(DEFAULT_DELAY)
    drawtiles (MAP_NES, 0, 267, 14, 303, 0, 231)
    delay(DEFAULT_DELAY)
    special(SetScenePal1)
    turnobject(LOCALID_WINDOW1, DIR_NORTH)
    turnobject(LOCALID_WINDOW2, DIR_NORTH)
    turnobject(LOCALID_WINDOW3, DIR_NORTH)
    turnobject(LOCALID_WINDOW4, DIR_NORTH)
    turnobject(LOCALID_RAILING1, DIR_NORTH)
    delay(DEFAULT_DELAY)
    special(SetScenePal2)
    turnobject(LOCALID_WINDOW1, DIR_WEST)
    turnobject(LOCALID_WINDOW2, DIR_WEST)
    turnobject(LOCALID_WINDOW3, DIR_WEST)
    turnobject(LOCALID_WINDOW4, DIR_WEST)
    turnobject(LOCALID_RAILING1, DIR_WEST)
    delay(DEFAULT_DELAY)
    special(SetScenePal3)
    turnobject(LOCALID_WINDOW1, DIR_EAST)
    turnobject(LOCALID_WINDOW2, DIR_EAST)
    turnobject(LOCALID_WINDOW3, DIR_EAST)
    turnobject(LOCALID_WINDOW4, DIR_EAST)
    turnobject(LOCALID_RAILING1, DIR_EAST)
    playbgm(MUS_MMTITLE1, TRUE)
    // Text 1
    special(LoadTextColor0)
    delay(DEFAULT_DELAY)
    drawtiles(MAP_NES, 0, TEXT_START_Y, 14, TEXT_END_Y, 0, TEXT_DEST_Y)
    call(BaseTextDelay)
    // Text 2
    delay(DEFAULT_DELAY)
    drawtiles(MAP_NES, 0, TEXT_START_Y + 3, 14, TEXT_END_Y + 3, 0, TEXT_DEST_Y)
    call(BaseTextDelay)
    // Text 3
    delay(DEFAULT_DELAY)
    drawtiles(MAP_NES, 0, TEXT_START_Y + 6, 14, TEXT_END_Y + 6, 0, TEXT_DEST_Y)
    call(BaseTextDelay)
    // Text 4
    delay(DEFAULT_DELAY)
    drawtiles(MAP_NES, 0, TEXT_START_Y + 9, 14, TEXT_END_Y + 9, 0, TEXT_DEST_Y)
    call(BaseTextDelay)
    // Text 5
    delay(DEFAULT_DELAY)
    drawtiles(MAP_NES, 0, TEXT_START_Y + 12, 14, TEXT_END_Y + 12, 0, TEXT_DEST_Y)
    call(BaseTextDelay)
    delay(DEFAULT_DELAY)
    // Start panning up
    applymovement(LOCALID_PLAYER, moves(walk_slow_up * 23, delay_16 * 6))
    applymovement(LOCALID_WINDOW1, MoveNesObjects)
    applymovement(LOCALID_WINDOW2, MoveNesObjects)
    applymovement(LOCALID_WINDOW3, MoveNesObjects)
    applymovement(LOCALID_WINDOW4, MoveNesObjects)
    applymovement(LOCALID_RAILING1, MoveNesObjects)
    applymovement(LOCALID_RAILING2, MoveNesObjects)
    delay(16)
    applymovement(LOCALID_WINDOW5, MoveNesObjects)
    applymovement(LOCALID_WINDOW6, MoveNesObjects)
    delay(16)
    applymovement(LOCALID_RAILING3, MoveNesObjects2)
    applymovement(LOCALID_RAILING4, MoveNesObjects2)
    delay(16)
    applymovement(LOCALID_WINDOW7, MoveNesObjects)
    applymovement(LOCALID_WINDOW8, MoveNesObjects)
    delay(48)
    setobjectxy(LOCALID_RAILING1, 8, RAILING_START_Y)
    setobjectxy(LOCALID_WINDOW1, 11, WINDOW_START_Y)
    setobjectxy(LOCALID_WINDOW2, 14, WINDOW_START_Y)
    delay(32)
    setobjectxy(LOCALID_RAILING2, 8, RAILING_START_Y - 2)
    setobjectxy(LOCALID_WINDOW3, 11, WINDOW_START_Y - 2)
    setobjectxy(LOCALID_WINDOW4, 14, WINDOW_START_Y - 2)
    delay(32)
    setobjectxy(LOCALID_RAILING3, 8, RAILING_START_Y - 4)
    setobjectxy(LOCALID_WINDOW5, 11, WINDOW_START_Y - 4)
    setobjectxy(LOCALID_WINDOW6, 14, WINDOW_START_Y - 4)
    delay(32)
    setobjectxy(LOCALID_RAILING4, 8, RAILING_START_Y - 6)
    setobjectxy(LOCALID_WINDOW7, 11, WINDOW_START_Y - 6)
    setobjectxy(LOCALID_WINDOW8, 14, WINDOW_START_Y - 6)
    delay(48)
    setobjectxy(LOCALID_RAILING1, 8, RAILING_START_Y - 7)
    setobjectxy(LOCALID_WINDOW1, 11, WINDOW_START_Y - 7)
    setobjectxy(LOCALID_WINDOW2, 14, WINDOW_START_Y - 7)
    delay(32)
    setobjectxy(LOCALID_RAILING2, 8, RAILING_START_Y - 9)
    setobjectxy(LOCALID_WINDOW3, 11, WINDOW_START_Y - 9)
    setobjectxy(LOCALID_WINDOW4, 14, WINDOW_START_Y - 9)
    delay(48)
    setobjectxy(LOCALID_RAILING3, 8, RAILING_START_Y - 10)
    setobjectxy(LOCALID_WINDOW5, 11, WINDOW_START_Y - 10)
    setobjectxy(LOCALID_WINDOW6, 14, WINDOW_START_Y - 10)
    delay(48)
    setobjectxy(LOCALID_RAILING4, 8, RAILING_START_Y - 11)
    setobjectxy(LOCALID_WINDOW7, 11, WINDOW_START_Y - 11)
    setobjectxy(LOCALID_WINDOW8, 14, WINDOW_START_Y - 11)
    delay(48)
    setobjectxy(LOCALID_RAILING1, 8, RAILING_START_Y - 12)
    setobjectxy(LOCALID_WINDOW1, 11, WINDOW_START_Y - 12)
    setobjectxy(LOCALID_WINDOW2, 14, WINDOW_START_Y - 12)
    delay(32)
    setobjectxy(LOCALID_RAILING2, 8, RAILING_START_Y - 14)
    delay(16)
    setobjectxy(LOCALID_WINDOW3, 11, WINDOW_START_Y - 13)
    setobjectxy(LOCALID_WINDOW4, 14, WINDOW_START_Y - 13)
    delay(32)
    setobjectxy(LOCALID_RAILING3, 8, RAILING_START_Y - 15)
    setobjectxy(LOCALID_WINDOW5, 11, WINDOW_START_Y - 15)
    setobjectxy(LOCALID_WINDOW6, 14, WINDOW_START_Y - 15)
    delay(32)
    setobjectxy(LOCALID_RAILING4, 8, RAILING_START_Y - 17)
    setobjectxy(LOCALID_WINDOW7, 11, WINDOW_START_Y - 17)
    setobjectxy(LOCALID_WINDOW8, 14, WINDOW_START_Y - 17)
    delay(32)
    setobjectxy(LOCALID_RAILING1, 8, RAILING_START_Y - 19)
    special(DisableCutsceneSkip)
    delay(32)
    special(CreateRooftopSprites)
    applymovement(LOCALID_MEGAMAN, moves(lock_facing_direction, delay_16, walk_down * 6, walk_in_place_down * 5, walk_in_place_faster_down, unlock_facing_direction))
    removeobject(LOCALID_WINDOW1)
    removeobject(LOCALID_WINDOW2)
    delay(16)
    removeobject(LOCALID_RAILING2)
    removeobject(LOCALID_WINDOW3)
    removeobject(LOCALID_WINDOW4)
    drawtiles(MAP_NES, 9, 0, 14, 0, 9, EMPTY_SPACE_Y - 1)
    drawtiles(MAP_NES, 9, 0, 14, 0, 9, EMPTY_SPACE_Y - 2)
    drawtiles(MAP_NES, 9, 0, 14, 0, 9, EMPTY_SPACE_Y)
    delay(16)
    drawtiles(MAP_NES, 9, 0, 14, 0, 9, EMPTY_SPACE_Y + 1)
    removeobject(LOCALID_RAILING3)
    delay(16)
    drawtiles(MAP_NES, 9, 0, 14, 0, 9, EMPTY_SPACE_Y + 2)
    delay(16)
    drawtiles(MAP_NES, 9, 0, 14, 0, 9, EMPTY_SPACE_Y + 3)
    delay(16)
    drawtiles(MAP_NES, 9, 0, 14, 0, 9, EMPTY_SPACE_Y + 4)
    waitmovement(LOCALID_PLAYER)
    goto(Nes_InterruptCutscene2)
}

movement MoveNesObjects{
    lock_anim
    walk_down * 48
}

movement MoveNesObjects2{
    lock_anim
    walk_fast_down * 2
    walk_down * 46
}

script BaseTextDelay{
    delay(DEFAULT_DELAY)
    special(LoadTextColor1)
    delay(DEFAULT_DELAY)
    special(LoadTextColor2)
    delay(DEFAULT_DELAY)
    special(LoadTextColor3)
    delay(235)
    special(LoadTextColor2)
    delay(DEFAULT_DELAY)
    special(LoadTextColor1)
    delay(DEFAULT_DELAY)
    special(LoadTextColor0)
    return
}