script LegendaryInstitute2F_ReassemblyUnit{
    if(flag(FLAG_UNLOCKED_REASSEMBLY_UNIT)){
        lock
        waitse
        playse(SE_PC_ON)
        waitse
        msgbox(ReassemblyUnitActivated)
        goto(ReassemblyUnit_MainScript)
    }
    else{
        msgbox(ReassemblyUnitInert, MSGBOX_SIGN)
    }
}

text HaveEnoughCellsAndCores{
    "(WIP)"
}
text NotEnoughCellsAndCores{
    "(WIP)"
}
text ReassemblyUnitInert{
    "(WIP)"
}

script ReassemblyUnit_MainScript{
    message(DoWhatWithReassemblyUnit)
    waitmessage
    dynmultichoice(23, 0, FALSE, 4, 0, 0, "Assembly", "Separation", "Core Moves", "Turn off")
    switch(var(VAR_RESULT)){
    case 0:
        goto(ReassemblyUnit_Assembly)
    case 1:
        goto(ReassemblyUnit_Separation)
    case 2:
        goto(ReassemblyUnit_CoreMoves)
    case 3:
        goto(ReassemblyUnit_TurnOff)
    case MULTI_B_PRESSED:
        goto(ReassemblyUnit_TurnOff)
    }
}
text ReassemblyUnitActivated{
    "(WIP)"
}
text DoWhatWithReassemblyUnit{
    "(WIP)"
}

script ReassemblyUnit_Assembly{
    if(flag(FLAG_ZYGARDE10_ASSEMBLED)
    || flag(FLAG_ZYGARDE50_ASSEMBLED)){
        msgbox(OnlyOneZygarde)
        goto(ReassemblyUnit_MainScript)
    }
    else{
        message(AssembleWhichZygarde)
        waitmessage
        dynmultichoice(23, 0, FALSE, 4, 0, 0, "10% Forme", "50% Forme", "Cancel")
        switch(var(VAR_RESULT)){
        case 0:
            goto(ReassemblyUnit_Assemble10Forme)
        case 1:
            goto(ReassemblyUnit_Assemble50Forme)
        case 2:
            goto(ReassemblyUnit_MainScript)
        case MULTI_B_PRESSED:
            goto(ReassemblyUnit_MainScript)
        }
    }
}
script ReassemblyUnit_Assemble10Forme{
    msgbox(AttemptingToAssemble10Forme)
    setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_ZYGARDE_10)
    givemon(SPECIES_ZYGARDE_10, 40, ITEM_NONE, ITEM_STRANGE_BALL, NATURE_HARDY, 0, 0, 0, 0, 0, 0, 0, 0, 15, 15, 15, 15, 15, 15, MOVE_DIG, MOVE_BIND, MOVE_LANDS_WRATH, MOVE_SANDSTORM, FALSE, 0, 0)
    call(GiveMon_Script)
    setflag(FLAG_ZYGARDE10_ASSEMBLED)
    if(var(VAR_ZYGARDE_PROGRESS) == 0){
        setvar(VAR_ZYGARDE_PROGRESS, 1)
    }
    subvar(VAR_ZYGARDE_CELLS, 10)
    subvar(VAR_ZYGARDE_CORES, 1)
    release
}
script ReassemblyUnit_Assemble50Forme{
    if(var(VAR_ZYGARDE_CELLS) < 50
    && var(VAR_ZYGARDE_CORES) < 3){
        buffernumberstring(STR_VAR_1, VAR_ZYGARDE_CELLS)
        buffernumberstring(STR_VAR_2, VAR_ZYGARDE_CORES)
        msgbox(NotEnoughCellsAndCoresInCube)
        goto(ReassemblyUnit_MainScript)
    }
    msgbox(AttemptingToAssemble50Forme)
    setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_ZYGARDE_50)
    givemon(SPECIES_ZYGARDE_50, 40, ITEM_NONE, ITEM_STRANGE_BALL, NATURE_HARDY, 0, 0, 0, 0, 0, 0, 0, 0, 15, 15, 15, 15, 15, 15, MOVE_DIG, MOVE_BIND, MOVE_LANDS_WRATH, MOVE_SANDSTORM, FALSE, 0, 0)
    call(GiveMon_Script)
    if(var(VAR_ZYGARDE_PROGRESS) < 3){
        setvar(VAR_ZYGARDE_PROGRESS, 3)
    }
    setflag(FLAG_ZYGARDE50_ASSEMBLED)
    subvar(VAR_ZYGARDE_CELLS, 50)
    subvar(VAR_ZYGARDE_CORES, 3)
}


script ReassemblyUnit_Separation{
    if(!flag(FLAG_ZYGARDE10_ASSEMBLED)
    && !flag(FLAG_ZYGARDE50_ASSEMBLED)){
        msgbox(NoZygardeCurrentlyAssembled)
        goto(ReassemblyUnit_MainScript)
    }
    checkpartymon(SPECIES_ZYGARDE_10, 0)
    if(var(VAR_RESULT) == FALSE){
        checkpartymon(SPECIES_ZYGARDE_50, 0)
        if(var(VAR_RESULT) == FALSE){
            msgbox(NoZygardeDetectedInParty)
            goto(ReassemblyUnit_MainScript)
        }
    }
    specialvar(VAR_RESULT, CountPartyNonEggMons)
    if(var(VAR_RESULT) == 1){
        msgbox(ZygardeOnlyMonInParty)
        goto(ReassemblyUnit_MainScript)
    }
	msgbox(ChooseZygardeForSeparation)
	fadescreen(FADE_TO_BLACK)
	special(ChoosePartyMon)
	waitstate
    if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN){
        msgbox(SeparationAborted)
        goto(ReassemblyUnit_MainScript)
    }
	specialvar(VAR_RESULT, CountPartyAliveNonEggMons_IgnoreVar0x8004Slot)
    if(var(VAR_RESULT) == 0){
        msgbox(ZygardeOnlyAliveMon)
        goto(ReassemblyUnit_MainScript)
    }
	specialvar(VAR_0x8005, GetSelectedMonNicknameAndSpecies)
    msgbox(ZygardeRevertedBackToCellsAndCores)
    if(var(VAR_0x8005) == SPECIES_ZYGARDE_10){
        addvar(VAR_ZYGARDE_CELLS, 10)
        addvar(VAR_ZYGARDE_CORES, 1)
        clearflag(FLAG_ZYGARDE10_ASSEMBLED)
    }
    elif(var(VAR_0x8005) == SPECIES_ZYGARDE_50){
        addvar(VAR_ZYGARDE_CELLS, 50)
        addvar(VAR_ZYGARDE_CORES, 3)
        clearflag(FLAG_ZYGARDE50_ASSEMBLED)
    }
    special(SeparateZygarde) //StoreSelectedPokemonInDaycare
    callnative(UpdateFollowingPokemon)
    goto(ReassemblyUnit_MainScript)
}
script ReassemblyUnit_CoreMoves{
    if(flag(FLAG_ZYGARDE_CORE_1)){
        dynmultipush("Extreme Speed", VAR_TEMP_1)
        addvar(VAR_TEMP_1, 1)
    }
    if(flag(FLAG_ZYGARDE_CORE_2)){
        dynmultipush("Dragon Dance", VAR_TEMP_1)
        addvar(VAR_TEMP_1, 1)
    }
    if(flag(FLAG_ZYGARDE_CORE_3)){
        dynmultipush("Core Enforcer", VAR_TEMP_1)
        addvar(VAR_TEMP_1, 1)
    }
    if(flag(FLAG_ZYGARDE_CORE_4)){
        dynmultipush("Thousand Arrows", VAR_TEMP_1)
        addvar(VAR_TEMP_1, 1)
    }
    if(flag(FLAG_ZYGARDE_CORE_5)){
        dynmultipush("Thousand Waves", VAR_TEMP_1)
        addvar(VAR_TEMP_1, 1)
    }
    dynmultipush("Cancel", VAR_TEMP_1)
    message(TeachZygardeWhichMove)
    waitmessage
    dynmultistack(23, 0, FALSE, VAR_TEMP_1, FALSE, 0, 0)
    switch(var(VAR_RESULT)){
        case 0:
            if(flag(FLAG_ZYGARDE_CORE_1)){setvar(VAR_0x8005, MOVE_EXTREME_SPEED)}
            elif(flag(FLAG_ZYGARDE_CORE_2)){setvar(VAR_0x8005, MOVE_DRAGON_DANCE)}
            elif(flag(FLAG_ZYGARDE_CORE_3)){setvar(VAR_0x8005, MOVE_CORE_ENFORCER)}
            elif(flag(FLAG_ZYGARDE_CORE_4)){setvar(VAR_0x8005, MOVE_THOUSAND_ARROWS)}
            elif(flag(FLAG_ZYGARDE_CORE_5)){setvar(VAR_0x8005, MOVE_THOUSAND_WAVES)}
            goto(ZygardeTeachCoreMove)
        case 1:
            if(flag(FLAG_ZYGARDE_CORE_2)){setvar(VAR_0x8005, MOVE_DRAGON_DANCE)}
            elif(flag(FLAG_ZYGARDE_CORE_3)){setvar(VAR_0x8005, MOVE_CORE_ENFORCER)}
            elif(flag(FLAG_ZYGARDE_CORE_4)){setvar(VAR_0x8005, MOVE_THOUSAND_ARROWS)}
            elif(flag(FLAG_ZYGARDE_CORE_5)){setvar(VAR_0x8005, MOVE_THOUSAND_WAVES)}
            goto(ZygardeTeachCoreMove)
        case 2:
            if(flag(FLAG_ZYGARDE_CORE_3)){setvar(VAR_0x8005, MOVE_CORE_ENFORCER)}
            elif(flag(FLAG_ZYGARDE_CORE_4)){setvar(VAR_0x8005, MOVE_THOUSAND_ARROWS)}
            elif(flag(FLAG_ZYGARDE_CORE_5)){setvar(VAR_0x8005, MOVE_THOUSAND_WAVES)}
            goto(ZygardeTeachCoreMove)
        case 3:
            if(flag(FLAG_ZYGARDE_CORE_4)){setvar(VAR_0x8005, MOVE_THOUSAND_ARROWS)}
            elif(flag(FLAG_ZYGARDE_CORE_5)){setvar(VAR_0x8005, MOVE_THOUSAND_WAVES)}
            goto(ZygardeTeachCoreMove)
        case 4:
            if(flag(FLAG_ZYGARDE_CORE_5)){setvar(VAR_0x8005, MOVE_THOUSAND_WAVES)}
            goto(ZygardeTeachCoreMove)
        case 5:
        case MULTI_B_PRESSED:
            goto(ReassemblyUnit_MainScript)
    }
}

script ZygardeTeachCoreMove{
    call(MoveTutor_EventScript_OpenPartyMenu)
    if(var(VAR_RESULT) == 0){
        msgbox(ZygardeMoveAborted)
    }
	goto(ReassemblyUnit_MainScript)
}

script ReassemblyUnit_TurnOff{
    waitse
    playse(SE_PC_OFF)
    release
}
