const PROF = 1

mapscripts Route119_WeatherInstitute_2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        if(checkitem(ITEM_ZYGARDE_CUBE) == FALSE){
            setvar(VAR_TEMP_0, 1)
        }
        else{
            setobjectxyperm(PROF, 2, 4)
            setobjectmovementtype(PROF, MOVEMENT_TYPE_FACE_LEFT)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_TEMP_0, 1: ZygardeCubeEvent
    ]
}

script ZygardeCubeEvent{
    delay(32)
    playse(SE_PIN)
    turnobject(PROF, DIR_NORTH)
    applymovement(PROF, ExclamationMark)
    waitmovement(0)
    delay(48)
    applymovement(PROF, Walk2Up)
    waitmovement(0)
    delay(8)
    msgbox(CanIHaveThePapers)
    msgbox(PlayerHandsPapersToScientist)
    removeitem(ITEM_RESEARCH_PAPERS)
    msgbox(ScientistDireNews)
    closemessage
    applymovement(PROF, LabScientistMove)
    applymovement(OBJ_EVENT_ID_PLAYER, LabPlayerMove)
    waitmovement(PROF)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    delay(8)
    msgbox(TakeZygardeCube)
    giveitem(ITEM_ZYGARDE_CUBE)
    call(ReleaseZygardeCellsCores)
    msgbox(ExplainZygardeCube)
    closemessage
    applymovement(PROF, moves(walk_right, walk_in_place_fast_left))
    waitmovement(0)
    setobjectxyperm(PROF, 2, 4)
    setobjectmovementtype(PROF, MOVEMENT_TYPE_FACE_LEFT)
    setvar(VAR_TEMP_0, 0)
    release
}

text CanIHaveThePapers{
    "(WIP)"
}
text PlayerHandsPapersToScientist{
    "(WIP)"
}
text ScientistDireNews{
    "(WIP)"
}
text TakeZygardeCube{
    "(WIP)"
}
text ExplainZygardeCube{
    "(WIP)"
}
movement LabScientistMove{
    walk_down * 3
    walk_left * 12
    walk_up * 2
    walk_in_place_fast_down
}
movement LabPlayerMove{
    walk_down * 4
    walk_left * 12
    walk_up
}

script LegendaryInstitute2F_Man{
    msgbox(LegendaryInstitute2F_Man_Text, MSGBOX_NPC)
    turnobject(3, DIR_WEST)
}
script LegendaryInstitute2F_Woman{
    msgbox(LegendaryInstitute2F_Woman_Text, MSGBOX_NPC)
    turnobject(2, DIR_WEST)
}
text LegendaryInstitute2F_Man_Text{
    "Have you ever heard of the Pokémon\n"
    "Latias and Latios?\p"
    "It is said that they once roamed\n"
    "across Sinko, until one day they\l"
    "simply disappeared.\p"
    "Nobody knows for sure what\n"
    "happened to them."
}
text LegendaryInstitute2F_Woman_Text{
    "(WIP)"
}
text TenZygardeCreated{
    "(WIP)"
}
text FiftyZygardeCreated{
    "(WIP)"
}
script LegendaryInstitute2F_MainScientist{
    if(var(VAR_ZYGARDE_PROGRESS) == 1){
        msgbox(TenZygardeCreated, MSGBOX_NPC)
        setvar(VAR_ZYGARDE_PROGRESS, 2)
        end
    }
    if(var(VAR_ZYGARDE_PROGRESS) == 3){
        msgbox(FiftyZygardeCreated, MSGBOX_NPC)
        setvar(VAR_ZYGARDE_PROGRESS, 4)
        end
    }
    if(flag(FLAG_UNLOCKED_REASSEMBLY_UNIT)){
        lock
        faceplayer
        goto(MainScientist_ExplainFeatures)
    }
    else{
        if(var(VAR_ZYGARDE_CELLS) >= 10
        && var(VAR_ZYGARDE_CORES) >= 1){
            msgbox(HaveEnoughCellsAndCores)
            setflag(FLAG_UNLOCKED_REASSEMBLY_UNIT)
        }
        else{
            if(var(VAR_ZYGARDE_CELLS) == 0){
                bufferstring(STR_VAR_1, "no")
            }
            else{
                buffernumberstring(STR_VAR_1, VAR_ZYGARDE_CELLS)
            }
            if(var(VAR_ZYGARDE_CORES) == 0){
                bufferstring(STR_VAR_2, "no")
            }
            else{
                buffernumberstring(STR_VAR_2, VAR_ZYGARDE_CORES)
            }
            msgbox(NotEnoughCellsAndCores, MSGBOX_NPC)
        }
    }
}
script MainScientist_ExplainFeatures{
    message(WhichFeatureToExplain)
    waitmessage
    dynmultichoice(23, 0, FALSE, 4, 0, 0, "Assembly", "Separation", "Core Moves", "Cancel")
    switch(var(VAR_RESULT)){
    case 0:
        goto(Explain_Assembly)
    case 1:
        goto(Explain_Separation)
    case 2:
        goto(Explain_CoreMoves)
    case 3:
        goto(ExplainFeatures_Goodbye)
    case MULTI_B_PRESSED:
        goto(ExplainFeatures_Goodbye)
    }
}
script Explain_Assembly{
    msgbox(Explain_Assembly_Text)
    goto(MainScientist_ExplainFeatures)
}
script Explain_Separation{
    msgbox(Explain_Separation_Text)
    goto(MainScientist_ExplainFeatures)
}
script Explain_CoreMoves{
    msgbox(Explain_CoreMoves_Text)
    goto(MainScientist_ExplainFeatures)
}
script ExplainFeatures_Goodbye{
    msgbox(ExplainFeatures_Goodbye_Text)
    release
}
