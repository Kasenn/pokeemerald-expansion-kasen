const PROF = 1

mapscripts Route119_WeatherInstitute_2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        if(checkitem(ITEM_ZYGARDE_CUBE) == FALSE){
            setvar(VAR_TEMP_0, 1)
        }
        else{
            setobjectxyperm(PROF, 2, 4)
            setobjectmovementtype(PROF, MOVEMENT_TYPE_FACE_LEFT)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_TEMP_0, 1: ZygardeCubeEvent
    ]
}

script ZygardeCubeEvent{
    delay(32)
    playse(SE_PIN)
    turnobject(PROF, DIR_NORTH)
    applymovement(PROF, ExclamationMark)
    waitmovement(0)
    delay(48)
    applymovement(PROF, Walk2Up)
    waitmovement(0)
    delay(8)
    msgbox(CanIHaveThePapers)
    msgbox(PlayerHandsPapersToScientist)
    removeitem(ITEM_RESEARCH_PAPERS)
    msgbox(ScientistDireNews)
    msgbox(ScientistDireNews2)
    closemessage
    delay(10)
    applymovement(PROF, LabScientistMove)
    applymovement(OBJ_EVENT_ID_PLAYER, LabPlayerMove)
    waitmovement(PROF)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    delay(8)
    msgbox(TakeZygardeCube)
    giveitem(ITEM_ZYGARDE_CUBE)
    call(ReleaseZygardeCellsCores)
    msgbox(ExplainZygardeCube)
    closemessage
    applymovement(PROF, moves(walk_right, walk_in_place_fast_left))
    waitmovement(0)
    setobjectxyperm(PROF, 2, 4)
    setobjectmovementtype(PROF, MOVEMENT_TYPE_FACE_LEFT)
    setvar(VAR_TEMP_0, 0)
    release
}

text CanIHaveThePapers{
    "Ah, it's you!\p"
    "Were you able to recover\n"
    "our research papers?"
}
text PlayerHandsPapersToScientist{
    "{PLAYER} hands the research papers\n"
    "to the scientist."
}
text ScientistDireNews{
    "Splendid!\n"
    "Now let's see here…\p"
    "It looks like Team Rocket may have\n"
    "kept some of the papers, but most of\l"
    "the material should be here."
}
text ScientistDireNews2{
    "Now, for the reason they stole our\n"
    "research to begin with…\p"
    "We fear that Team Rocket may be\n"
    "looking for an ancient Pokémon\l"
    "called Yveltal.\p"
    "Yveltal is said to be sleeping in\n"
    "its hidden nest, and if awoken,\l"
    "could spread devastation across\l"
    "the entire world.\p"
    "If Team Rocket were to get their\n"
    "hands on Yveltal and control it,\l"
    "the consequences would be dire.\p"
    "We must find where Yveltal rests\n"
    "before Team Rocket does!\p"
    "In the meantime, there is something\n"
    "I need to show you.\p"
    "Please follow me."
}
text TakeZygardeCube{
    "This is a Zygarde Reassembly Unit.\p"
    "It's a machine capable of\n"
    "reassembling Zygarde, a legendary\l"
    "Pokémon believed to be the\l"
    "antithesis of Yveltal.\p"
    "However, before we can fire up\n"
    "the machine, we're going to need\l"
    "your help."
}
text ExplainZygardeCube{
    "In order for the machine to work,\n"
    "it requires Zygarde Cells and Cores.\p"
    "Normally these Cells and Cores are\n"
    "almost impossible to come by, but\l"
    "that Zygarde Cube emits a frequency\l"
    "that should draw them out of hiding.\p"
    "Use the Zygarde Cube to collect at\n"
    "least ten Cells and one Core,\l"
    "bring them back here, and let's see\l"
    "if we can't get this thing running!"
}
movement LabScientistMove{
    walk_down * 3
    walk_left * 12
    walk_up * 2
    walk_in_place_fast_down
}
movement LabPlayerMove{
    walk_down * 4
    walk_left * 12
    walk_up
}

script LegendaryInstitute2F_Man{
    msgbox(LegendaryInstitute2F_Man_Text, MSGBOX_NPC)
    turnobject(3, DIR_WEST)
}
script LegendaryInstitute2F_Woman{
    msgbox(LegendaryInstitute2F_Woman_Text, MSGBOX_NPC)
    turnobject(2, DIR_WEST)
}
text LegendaryInstitute2F_Man_Text{
    "Have you ever heard of the Pokémon\n"
    "Latias and Latios?\p"
    "It is said that they once roamed\n"
    "across Sinko, until one day they\l"
    "simply disappeared.\p"
    "Nobody knows for sure what\n"
    "happened to them."
}
text LegendaryInstitute2F_Woman_Text{
    "Nobody knows for certain where\n"
    "Zygarde originates from.\p"
    "Some say it's the nature's will\n"
    "concentrating into a single being\l"
    "meant to protect the world from\l"
    "calamity, while some suspect it\l"
    "might be a man-made Pokémon,\l"
    "like Porygon."
}
text TenZygardeCreated{
    "You've managed to assemble\n"
    "a 10% Forme Zygarde?\p"
    "That's great!\p"
    "However, I believe we can\n"
    "push it even further.\p"
    "If you can find a total of 50 Cells\n"
    "and 3 Cores, we may be able to\l"
    "unlock its original Forme!"
}
text FiftyZygardeCreated{
    "You've managed to assemble\n"
    "the 50% Forme Zygarde?\p"
    "Astounding!\p"
    "I never thought I would get to\n"
    "see it in its complete Forme!\p"
    "However, there is something that\n"
    "has been bothering me.\p"
    "As far as our research shows, this\n"
    "should be Zygarde's final Forme,\l"
    "and yet, there have been a few\l"
    "reports of people still spotting\l"
    "Zygarde Cells out in the wild.\p"
    "What could this mean?"
}
script LegendaryInstitute2F_MainScientist{
    if(var(VAR_ZYGARDE_PROGRESS) == 1){
        msgbox(TenZygardeCreated, MSGBOX_NPC)
        setvar(VAR_ZYGARDE_PROGRESS, 2)
        end
    }
    if(var(VAR_ZYGARDE_PROGRESS) == 3){
        msgbox(FiftyZygardeCreated, MSGBOX_NPC)
        setvar(VAR_ZYGARDE_PROGRESS, 4)
        end
    }
    if(flag(FLAG_UNLOCKED_REASSEMBLY_UNIT)){
        lock
        faceplayer
        goto(MainScientist_ExplainFeatures)
    }
    else{
        if(var(VAR_ZYGARDE_CELLS) >= 10
        && var(VAR_ZYGARDE_CORES) >= 1){
            msgbox(HaveEnoughCellsAndCores)
            msgbox(HaveEnoughCellsAndCores2)
            setflag(FLAG_UNLOCKED_REASSEMBLY_UNIT)
        }
        else{
            if(var(VAR_ZYGARDE_CELLS) == 0){
                bufferstring(STR_VAR_1, "no")
            }
            else{
                buffernumberstring(STR_VAR_1, VAR_ZYGARDE_CELLS)
            }
            if(var(VAR_ZYGARDE_CORES) == 0){
                bufferstring(STR_VAR_2, "no")
            }
            else{
                buffernumberstring(STR_VAR_2, VAR_ZYGARDE_CORES)
            }

            if(var(VAR_ZYGARDE_CELLS) == 1 && var(VAR_ZYGARDE_CORES) == 1){
                msgbox(NotEnoughCellAndCore, MSGBOX_NPC)
            }
            elif(var(VAR_ZYGARDE_CELLS) == 1){
                msgbox(NotEnoughCellAndCores, MSGBOX_NPC)
            }
            elif(var(VAR_ZYGARDE_CORES) == 1){
                msgbox(NotEnoughCellsAndCore, MSGBOX_NPC)
            }
            else{
                msgbox(NotEnoughCellsAndCores, MSGBOX_NPC)
            }
        }
    }
}
script MainScientist_ExplainFeatures{
    message(WhichFeatureToExplain)
    waitmessage
    dynmultichoice(23, 0, FALSE, 4, 0, 0, "Assembly", "Separation", "Core Moves", "Cancel")
    switch(var(VAR_RESULT)){
    case 0:
        goto(Explain_Assembly)
    case 1:
        goto(Explain_Separation)
    case 2:
        goto(Explain_CoreMoves)
    case 3:
        goto(ExplainFeatures_Goodbye)
    case MULTI_B_PRESSED:
        goto(ExplainFeatures_Goodbye)
    }
}
script Explain_Assembly{
    msgbox(Explain_Assembly_Text)
    goto(MainScientist_ExplainFeatures)
}
script Explain_Separation{
    msgbox(Explain_Separation_Text)
    goto(MainScientist_ExplainFeatures)
}
script Explain_CoreMoves{
    msgbox(Explain_CoreMoves_Text)
    goto(MainScientist_ExplainFeatures)
}
script ExplainFeatures_Goodbye{
    msgbox(ExplainFeatures_Goodbye_Text)
    release
}
text WhichFeatureToExplain{
    "Is there a function you\n"
    "would like me to explain?"
}
text Explain_Assembly_Text{
    "Assembly is the process of gathering\n"
    "Cells and Cores and assembling them\l"
    "to the shape, or Forme, of Zygarde.\p"
    "There are two known Formes:\n"
    "10% Forme and 50% Forme.\p"
    "10% Forme requires 10 Cells and\n"
    "1 Core to create, while the 50% Forme\l"
    "requires 50 Cells and 3 Cores.\p"
    "Do note that 50% Forme is so large\n"
    "that we can't really let you let it\l"
    "out of its ball when indoors."
}
text Explain_Separation_Text{
    "Separation is the process of\n"
    "disassembling Zygarde back to\l"
    "its original Cells and Cores.\p"
    "When a Zygarde is separated,\n"
    "it will lose any experience it\l"
    "has gained, be it moves or any\l"
    "other form of experience.\p"
    "Do note that assembling the Zygarde\n"
    "to another Forme does not necessitate\l"
    "the use of the separation process.\p"
    "An existing Zygarde can be made to\n"
    "assume another Forme through the\l"
    "assembly process."
}
text Explain_CoreMoves_Text{
    "Zygarde Cores contain knowledge about\n"
    "certain moves, and when the Cores are\l"
    "synced with the Reassembly Unit,\l"
    "the Core Moves program will be able to\l"
    "teach those moves to Zygarde.\p"
    "The moves available in the Core Moves\n"
    "program will depend on the Cores you\l"
    "have managed to find.\p"
    "Do note that there may be some moves\n"
    "that only the 50% Forme can learn."
}
text ExplainFeatures_Goodbye_Text{
    "Let me know if there's any\n"
    "function you need explained."
}

script LegendaryInstitute2F_ReassemblyUnit{
    if(flag(FLAG_UNLOCKED_REASSEMBLY_UNIT)){
        lock
        waitse
        playse(SE_PC_ON)
        waitse
        msgbox(ReassemblyUnitActivated)
        goto(ReassemblyUnit_MainScript)
    }
    else{
        msgbox(ReassemblyUnitInert, MSGBOX_SIGN)
    }
}

text HaveEnoughCellsAndCores{
    "Have you collected enough\n"
    "Cells and Cores?\p"
    "Let's see…\p"
    "Unbelievable!\p"
    "I never thought I'd see the day we\n"
    "get to activate this Reassembly Unit!"
}
text HaveEnoughCellsAndCores2{
    "Now, remember when I promised that we\n"
    "would make it worth your while if you\l"
    "recovered our research papers?\p"
    "Well, seeing how brave and tenacious\n"
    "you have been through this ordeal,\l"
    "we believe you to be the perfect\l"
    "trainer for the Zygarde we are\l"
    "about to create!\p"
    "When you're ready, go ahead and access\n"
    "the console in front of the unit.\p"
    "If you need more information regarding\n"
    "the functions of the machine,\l"
    "just let me know!"
}
text NotEnoughCellsAndCores{
    "In order to get the Reassembly Unit\n"
    "running, we need at least 10 Cells and\l"
    "1 Core.\p"
    "So far you have collected {STR_VAR_1} Cells\n"
    "and {STR_VAR_2} Cores."
}
text NotEnoughCellAndCores{
    "In order to get the Reassembly Unit\n"
    "running, we need at least 10 Cells and\l"
    "1 Core.\p"
    "So far you have collected {STR_VAR_1} Cell\n"
    "and {STR_VAR_2} Cores."
}
text NotEnoughCellsAndCore{
    "In order to get the Reassembly Unit\n"
    "running, we need at least 10 Cells and\l"
    "1 Core.\p"
    "So far you have collected {STR_VAR_1} Cells\n"
    "and {STR_VAR_2} Core."
}
text NotEnoughCellAndCore{
    "In order to get the Reassembly Unit\n"
    "running, we need at least 10 Cells and\l"
    "1 Core.\p"
    "So far you have collected {STR_VAR_1} Cell\n"
    "and {STR_VAR_2} Core."
}
text ReassemblyUnitInert{
    "The Reassembly Unit seems to be\n"
    "offline."
}

script ReassemblyUnit_MainScript{
    message(DoWhatWithReassemblyUnit)
    waitmessage
    dynmultichoice(23, 0, FALSE, 4, 0, 0, "Assembly", "Separation", "Core Moves", "Turn off")
    switch(var(VAR_RESULT)){
    case 0:
        goto(ReassemblyUnit_Assembly)
    case 1:
        goto(ReassemblyUnit_Separation)
    case 2:
        goto(ReassemblyUnit_CoreMoves)
    case 3:
        goto(ReassemblyUnit_TurnOff)
    case MULTI_B_PRESSED:
        goto(ReassemblyUnit_TurnOff)
    }
}
text ReassemblyUnitActivated{
    "Reassembly Unit activated."
}
text DoWhatWithReassemblyUnit{
    "Do what with the Reassembly Unit?"
}

script ReassemblyUnit_Assembly{
    message(AssembleWhichZygarde)
    waitmessage
    dynmultichoice(23, 0, FALSE, 4, 0, 0, "10% Forme", "50% Forme", "Cancel")
    switch(var(VAR_RESULT)){
    case 0:
        goto(ReassemblyUnit_Assemble10Forme)
    case 1:
        goto(ReassemblyUnit_Assemble50Forme)
    case 2:
        goto(ReassemblyUnit_MainScript)
    case MULTI_B_PRESSED:
        goto(ReassemblyUnit_MainScript)
    }
}
script ReassemblyUnit_Assemble10Forme{
    if(flag(FLAG_ZYGARDE10_ASSEMBLED)){
        msgbox(OnlyOneZygarde)
        goto(ReassemblyUnit_MainScript)
    }
    if(flag(FLAG_ZYGARDE50_ASSEMBLED)){
        checkpartymon(SPECIES_ZYGARDE_50, 0)
        if(var(VAR_RESULT) == FALSE){
            msgbox(NoZygardeDetectedInParty_Assembly)
            goto(ReassemblyUnit_MainScript)
        }
        msgbox(ChooseZygardeForAssembly)
	    special(ChoosePartyMon)
	    waitstate
        if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN){
            msgbox(AssemblyAborted)
            goto(ReassemblyUnit_MainScript)
        }
	    specialvar(VAR_0x8005, GetSelectedMonNicknameAndSpecies)
        if(var(VAR_0x8005) != SPECIES_ZYGARDE_50){
            msgbox(SpeciesNotZygarde)
            goto(ReassemblyUnit_MainScript)
        }
        addvar(VAR_ZYGARDE_CELLS, 40)
        addvar(VAR_ZYGARDE_CORES, 2)
        clearflag(FLAG_ZYGARDE50_ASSEMBLED)
        setflag(FLAG_ZYGARDE10_ASSEMBLED)
        special(ConvertZygarde) //StoreSelectedPokemonInDaycare
        callnative(UpdateFollowingPokemon)
        msgbox(AttemptingToAssemble10Forme)
        goto(ReassemblyUnit_MainScript)
    }
    message(AttemptingToAssemble10Forme)
    waitmessage
    closemessage
    setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_ZYGARDE_10)
    givemon(SPECIES_ZYGARDE_10, 40, ITEM_NONE, ITEM_STRANGE_BALL, NATURE_HARDY, 0, 0, 0, 0, 0, 0, 0, 0, 15, 15, 15, 15, 15, 15, MOVE_DIG, MOVE_BIND, MOVE_LANDS_WRATH, MOVE_SANDSTORM, FALSE, 0, 0)
    call(GiveMon_Script)
    setflag(FLAG_ZYGARDE10_ASSEMBLED)
    if(var(VAR_ZYGARDE_PROGRESS) == 0){
        setvar(VAR_ZYGARDE_PROGRESS, 1)
    }
    subvar(VAR_ZYGARDE_CELLS, 10)
    subvar(VAR_ZYGARDE_CORES, 1)
    release
}
script ReassemblyUnit_Assemble50Forme{
    if(flag(FLAG_ZYGARDE50_ASSEMBLED)){
        msgbox(OnlyOneZygarde)
        goto(ReassemblyUnit_MainScript)
    }
    if(flag(FLAG_ZYGARDE10_ASSEMBLED)){
        if(var(VAR_ZYGARDE_CELLS) < 40
        && var(VAR_ZYGARDE_CORES) < 2){
            buffernumberstring(STR_VAR_1, VAR_ZYGARDE_CELLS)
            buffernumberstring(STR_VAR_2, VAR_ZYGARDE_CORES)
            msgbox(NotEnoughCellsAndCoresInCube)
            goto(ReassemblyUnit_MainScript)
        }
        checkpartymon(SPECIES_ZYGARDE_10, 0)
        if(var(VAR_RESULT) == FALSE){
            msgbox(NoZygardeDetectedInParty_Assembly)
            goto(ReassemblyUnit_MainScript)
        }
        msgbox(ChooseZygardeForAssembly)
	    special(ChoosePartyMon)
	    waitstate
        if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN){
            msgbox(AssemblyAborted)
            goto(ReassemblyUnit_MainScript)
        }
	    specialvar(VAR_0x8005, GetSelectedMonNicknameAndSpecies)
        if(var(VAR_0x8005) != SPECIES_ZYGARDE_10){
            msgbox(SpeciesNotZygarde)
            goto(ReassemblyUnit_MainScript)
        }
        subvar(VAR_ZYGARDE_CELLS, 40)
        subvar(VAR_ZYGARDE_CORES, 2)
        clearflag(FLAG_ZYGARDE10_ASSEMBLED)
        setflag(FLAG_ZYGARDE50_ASSEMBLED)
        special(ConvertZygarde) //StoreSelectedPokemonInDaycare
        callnative(UpdateFollowingPokemon)
        msgbox(AttemptingToAssemble50Forme)
        goto(ReassemblyUnit_MainScript)
    }
    if(var(VAR_ZYGARDE_CELLS) < 50
    && var(VAR_ZYGARDE_CORES) < 3){
        buffernumberstring(STR_VAR_1, VAR_ZYGARDE_CELLS)
        buffernumberstring(STR_VAR_2, VAR_ZYGARDE_CORES)
        msgbox(NotEnoughCellsAndCoresInCube)
        goto(ReassemblyUnit_MainScript)
    }
    message(AttemptingToAssemble50Forme)
    waitmessage
    closemessage
    setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_ZYGARDE_50)
    givemon(SPECIES_ZYGARDE_50, 40, ITEM_NONE, ITEM_STRANGE_BALL, NATURE_HARDY, 0, 0, 0, 0, 0, 0, 0, 0, 15, 15, 15, 15, 15, 15, MOVE_DIG, MOVE_BIND, MOVE_LANDS_WRATH, MOVE_SANDSTORM, FALSE, 0, 0)
    call(GiveMon_Script)
    if(var(VAR_ZYGARDE_PROGRESS) < 3){
        setvar(VAR_ZYGARDE_PROGRESS, 3)
    }
    setflag(FLAG_ZYGARDE50_ASSEMBLED)
    subvar(VAR_ZYGARDE_CELLS, 50)
    subvar(VAR_ZYGARDE_CORES, 3)
}


script ReassemblyUnit_Separation{
    if(!flag(FLAG_ZYGARDE10_ASSEMBLED)
    && !flag(FLAG_ZYGARDE50_ASSEMBLED)){
        msgbox(NoZygardeCurrentlyAssembled)
        goto(ReassemblyUnit_MainScript)
    }
    checkpartymon(SPECIES_ZYGARDE_10, 0)
    if(var(VAR_RESULT) == FALSE){
        checkpartymon(SPECIES_ZYGARDE_50, 0)
        if(var(VAR_RESULT) == FALSE){
            msgbox(NoZygardeDetectedInParty)
            goto(ReassemblyUnit_MainScript)
        }
    }
    specialvar(VAR_RESULT, CountPartyNonEggMons)
    if(var(VAR_RESULT) == 1){
        msgbox(ZygardeOnlyMonInParty)
        goto(ReassemblyUnit_MainScript)
    }
	msgbox(ChooseZygardeForSeparation)
	special(ChoosePartyMon)
	waitstate
    if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN){
        msgbox(SeparationAborted)
        goto(ReassemblyUnit_MainScript)
    }
	specialvar(VAR_RESULT, CountPartyAliveNonEggMons_IgnoreVar0x8004Slot)
    if(var(VAR_RESULT) == 0){
        msgbox(ZygardeOnlyAliveMon)
        goto(ReassemblyUnit_MainScript)
    }
	specialvar(VAR_0x8005, GetSelectedMonNicknameAndSpecies)
    if(var(VAR_0x8005) == SPECIES_ZYGARDE_10){
        addvar(VAR_ZYGARDE_CELLS, 10)
        addvar(VAR_ZYGARDE_CORES, 1)
        clearflag(FLAG_ZYGARDE10_ASSEMBLED)
    }
    elif(var(VAR_0x8005) == SPECIES_ZYGARDE_50){
        addvar(VAR_ZYGARDE_CELLS, 50)
        addvar(VAR_ZYGARDE_CORES, 3)
        clearflag(FLAG_ZYGARDE50_ASSEMBLED)
    }
    else{
        msgbox(SpeciesNotZygarde)
        goto(ReassemblyUnit_MainScript)
    }
    special(SeparateZygarde) //StoreSelectedPokemonInDaycare
    callnative(UpdateFollowingPokemon)
    message(ZygardeRevertedBackToCellsAndCores)
    waitmessage
    msgbox(SeparatedSuccessfully)
    goto(ReassemblyUnit_MainScript)
}
script ReassemblyUnit_CoreMoves{
    if(!flag(FLAG_ZYGARDE10_ASSEMBLED)
    && !flag(FLAG_ZYGARDE50_ASSEMBLED)){
        msgbox(NoZygardeCurrentlyAssembled)
        goto(ReassemblyUnit_MainScript)
    }
    if(flag(FLAG_ZYGARDE_CORE_1)){
        dynmultipush("Extreme Speed", 0)
    }
    if(flag(FLAG_ZYGARDE_CORE_2)){
        dynmultipush("Dragon Dance", 1)
    }
    if(flag(FLAG_ZYGARDE_CORE_3)){
        dynmultipush("Core Enforcer", 2)
    }
    if(flag(FLAG_ZYGARDE_CORE_4)){
        dynmultipush("Thousand Arrows", 3)
    }
    if(flag(FLAG_ZYGARDE_CORE_5)){
        dynmultipush("Thousand Waves", 4)
    }
    dynmultipush("Cancel", 5)
    message(TeachZygardeWhichMove)
    waitmessage
    dynmultistack(23, 0, FALSE, 6, FALSE, 0, 0)
    switch(var(VAR_RESULT)){
        case 0:
            setvar(VAR_0x8005, MOVE_EXTREME_SPEED_ZYG)
            goto(ZygardeTeachCoreMove)
        case 1:
            setvar(VAR_0x8005, MOVE_DRAGON_DANCE_ZYG)
            goto(ZygardeTeachCoreMove)
        case 2:
            setvar(VAR_0x8005, MOVE_CORE_ENFORCER)
            goto(ZygardeTeachCoreMove)
        case 3:
            setvar(VAR_0x8005, MOVE_THOUSAND_ARROWS)
            goto(ZygardeTeachCoreMove)
        case 4:
            setvar(VAR_0x8005, MOVE_THOUSAND_WAVES)
            goto(ZygardeTeachCoreMove)
        case 5:
        case MULTI_B_PRESSED:
            msgbox(ZygardeMoveAborted)
            goto(ReassemblyUnit_MainScript)
    }
}
script ZygardeTeachCoreMove{
    msgbox(SelectZygardeToTeachMove)
    call(MoveTutor_EventScript_OpenPartyMenu)
    if(var(VAR_RESULT) == 0){
        msgbox(ZygardeMoveAborted)
    }
	goto(ReassemblyUnit_MainScript)
}

script ReassemblyUnit_TurnOff{
    waitse
    playse(SE_PC_OFF)
    release
}
