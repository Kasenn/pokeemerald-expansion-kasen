mapscripts NewRoute101_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        if(!flag(FLAG_SYS_POKEDEX_GET)){
            setflag(FLAG_TEMP_1)
            setweather(WEATHER_RAIN)
            doweather
        }
        else{
            resetweather
        }
    }
}

script Route1_Youngster{
	trainerbattle_single(TRAINER_R1_YOUNGSTER, Route1_Text_YoungsterIntro, Route1_Text_YoungsterDefeated)
	msgbox(Route1_Text_YoungsterPostBattle, MSGBOX_AUTOCLOSE)
	end
}
text Route1_Text_YoungsterIntro{
    "Have you spotted any rare Pokémon?"
}
text Route1_Text_YoungsterDefeated{
    "I need to catch more Pokémon…"
}
text Route1_Text_YoungsterPostBattle{
    "I'm looking for a Pichu.\pMy friend told me he saw one\non this route the other day."
}

script Route1_Tuber{
	trainerbattle_single(TRAINER_R1_TUBER, Route1_Text_TuberIntro, Route1_Text_TuberDefeated)
	msgbox(Route1_Text_TuberPostBattle, MSGBOX_AUTOCLOSE)
	end
}
text Route1_Text_TuberIntro{
    "I put my Pokémon on the treadmill\nto make it the fastest in the world!"
}
text Route1_Text_TuberDefeated{
    "I guess you need more\nthan just speed…"
}
text Route1_Text_TuberPostBattle{
    "I will train my Piplup so hard\nthat it can punch through a wall!"
}

script Route1_BugCatcher{
	trainerbattle_single(TRAINER_R1_BUG_CATCHER, Route1_Text_BugCatcherIntro, Route1_Text_BugCatcherDefeated)
	msgbox(Route1_Text_BugCatcherPostBattle, MSGBOX_AUTOCLOSE)
	end
}
text Route1_Text_BugCatcherIntro{
    "I'm going to become the strongest\nbug type trainer ever!"
}
text Route1_Text_BugCatcherDefeated{
    "Looks like I still\nhave some ways to go…"
}
text Route1_Text_BugCatcherPostBattle{
    "I haven't seen a single\nbug type Pokémon here.\lI may need to try another spot."
}
script Route1_Fisher{
	trainerbattle_single(TRAINER_R1_FISHER, Route1_Text_FisherIntro, Route1_Text_FisherDefeated)
	msgbox(Route1_Text_FisherPostBattle, MSGBOX_AUTOCLOSE)
	end
}
text Route1_Text_FisherIntro{
    "I like fishing but\nI like Pokémon battles just as much!"
}
text Route1_Text_FisherDefeated{
    "I like to battle, but that doesn't\nmean I'm good at it…"
}
text Route1_Text_FisherPostBattle{
    "Wait till I catch a Gyarados!"
}

script Route1_Lass{
    if(!flag(FLAG_SYS_POKEDEX_GET)){
        msgbox(Route1_NoTrainers, MSGBOX_NPC)
    }
    else{
        msgbox(Route1_Trainers, MSGBOX_NPC)
    }
}
text Route1_Trainers{
    "Looks like all the people came back\n"
    "as soon as the rain stopped.\p"
    "These people look like some pretty\n"
    "serious trainers."
}
text Route1_NoTrainers{
    "Normally this place is chock-full\n"
    "of trainers.\p"
    "I guess people don't want to\n"
    "train in the rain."
}


script Route1_CoolTrainer{
    if(defeated(TRAINER_R1_COOLTRAINER)){
        msgbox("That was a fine battle.", MSGBOX_NPC)
    }
    elif(!defeated(TRAINER_R1_YOUNGSTER)
      || !defeated(TRAINER_R1_FISHER)
      || !defeated(TRAINER_R1_BUG_CATCHER)
      || !defeated(TRAINER_R1_TUBER)){
        msgbox("I'm looking for strong trainers.\nOnly the best of the best will suffice.", MSGBOX_NPC)
    }
    else{
        goto(Route1_CoolTrainerEligible)
    }
}

script Route1_CoolTrainerEligible{
    lock
    faceplayer
    if(!flag(FLAG_TEMP_2)){
        msgbox(Route1_CoolTrainer_Intro, MSGBOX_YESNO)
    }
    else{
        msgbox(Route1_CoolTrainer_Intro_Short, MSGBOX_YESNO)
    }
    if(var(VAR_RESULT) == YES){
        msgbox("Let's do this!")
        trainerbattle_no_intro(TRAINER_R1_COOLTRAINER, Route1_Text_CoolTrainerDefeated)
        goto(Route1_CoolTrainerPostBattle)
    }
    else{
        setflag(FLAG_TEMP_2)
        msgbox("I see…\pWell, let me know if you change\nyour mind.\lI'll be here.", MSGBOX_NPC)
    }
}

text Route1_CoolTrainer_Intro{
    "I see you've defeated all\n"
    "the other trainers in this area.\p"
    "That means you are a very\n"
    "strong trainer.\p"
    "Would you be interested in\n"
    "a Pokémon Battle?\p"
    "I warn you, I'm no pushover."
}
text Route1_CoolTrainer_Intro_Short{
    "Are you ready for a duel?"
}

text Route1_Text_CoolTrainerDefeated{
    "Truly a magnificent battle!"
}

script Route1_CoolTrainerPostBattle{
    msgbox(Route1_CoolTrainerReward)
	giveitem(ITEM_EXP_SHARE)
    msgbox(WW_CoolTrainerExplainReward)
    addbp(10)
    call(BpReward)
    release
}

script BpReward{
    playfanfare(MUS_OBTAIN_B_POINTS)
    message("Earned {STR_VAR_1} BP!")
    waitfanfare
    waitmessage
    closemessage
    if(!flag(FLAG_INTRO_TO_BP)){
        msgbox(ExplainBP)
        setflag(FLAG_INTRO_TO_BP)
    }
    return
}

text Route1_CoolTrainerReward{
    "It's rare to meet someone so strong.\nHere, I want you to have this."
}