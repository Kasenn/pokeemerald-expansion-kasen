mapscripts OldaleTown_House2_MapScripts{}

script NotMyNectar{
    lock
    safefollow
    turnobject(1, DIR_NORTH)
    delay(10)
    msgbox(NotMyNectar_Text, MSGBOX_NPC)
    waitmessage
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Walk1Down)
    waitmovement(0)
    delay(30)
    release
    end
}

script NectarManiac{
    if(!flag(FLAG_ORICORIO_SHOWN_TO_MANIAC)){
        lock
        faceplayer
	    msgbox(NectarManiac_Text)
        specialvar(VAR_RESULT, CheckOricorio)
        if(var(VAR_RESULT) == TRUE){
            safefollow
            playse(SE_PIN)
            applymovement(1, Common_Movement_ExclamationMark)
            waitmovement(0)
            delay(48)
            msgbox(NectarManiac_OricorioFound, MSGBOX_NPC)
            setflag(FLAG_ORICORIO_SHOWN_TO_MANIAC)
            release
            if(flag(FLAG_Q01_PRIMROSE_ORICORIO_START)){
                completequest(FLAG_Q01_PRIMROSE_ORICORIO_COMPLETE)
                special(ShowJournalPopupRemove)
            }
            end
        }
        else{
            msgbox(DrewQuickSketch)
            message(DrewQuickSketch2)
            waitmessage
            delay(20)
            showmonpic(SPECIES_SPRIGATITO, 10, 3)
            waitbuttonpress
            hidemonpic
            msgbox(NeverSaidWasAnArtist)
            release
            if(!flag(FLAG_Q01_PRIMROSE_ORICORIO_START)){
                startquest(FLAG_Q01_PRIMROSE_ORICORIO_START)
                special(ShowJournalPopupAdd)
            }
            end
        }
    }
    msgbox(NectarManiac_GoRightIn, MSGBOX_NPC)
    end
}

text NectarManiac_OricorioFound{
    "Oh? I can see you've caught one\nof those wretched birds!\pThis means you are someone I can trust\nnot to mess up my beautiful garden!\pPlease, enjoy its peace and\ntranquility to the fullest."
}

text NectarManiac_GoRightIn{
    "Enjoy the peace and tranquility\nof my beautiful garden."
}

text NeverSaidWasAnArtist{
    "… … … What?\p"
    "Never said I was an artist, did I?"
}

text DrewQuickSketch{
    "I was able to sketch one of the\n"
    "culprits before they had a chance\l"
    "to flee the scene."
}
text DrewQuickSketch2{
    "Here it is."
}

text NectarManiac_Text{
    "I planted a bunch of expensive flowers\n"
    "in my backyard to attract some rare\l"
    "bug type Pokémon, but instead all\l"
    "I get are these stupid birds.\p"
    "If you could show me one of these\n"
    "birds imprisoned inside a Poké Ball,\l"
    "I might let you access my backyard."
}

text NotMyNectar_Text{
    "Excuse me, but did I give you\na permission to enter my backyard?\pYou'll probably just end up trampling\nmy precious flowers."
}
