mapscripts CoralgroveCity_MapScripts{
    MAP_SCRIPT_ON_TRANSITION{
        setflag(FLAG_VISITED_CORALGROVE_CITY)
        setflag(FLAG_TEMP_1)
    }
}

script CoralHideGhost2{
    removeobject(11)
    clearflag(FLAG_TEMP_2)
    release
}

script Coralgrove_HauntedHouse{
    if(!flag(FLAG_0x267_CG_HIDEGHOST)){
        setflag(FLAG_TEMP_2)
    }
    msgbox("The door is nailed shut.\nLooks like nobody lives here.", MSGBOX_SIGN)
}

script CoralShowGhost{
    clearflag(FLAG_TEMP_1)
    addobject(11)
    release
}

script CoralHideGhost{
    lock
    fadeoutbgm(0)
    delay(60)
    msgbox("No, you're not the one…", MSGBOX_AUTOCLOSE)
    fadescreenswapbuffers(FADE_TO_WHITE)
    setflag(FLAG_0x267_CG_HIDEGHOST)
    clearflag(FLAG_TEMP_2)
    hideobjectat(11, MAP_CORALGROVE_CITY)
    delay(30)
    fadescreenswapbuffers(FADE_FROM_WHITE)
    delay(90)
    fadeinbgm(0)
    delay(60)
    removeobject(11)
    release
}

script Coralgrove_MAN_3{
    msgbox("To the south lies Primrose Town.\pIf you want to go anywhere else,\nyou must take the elevator to\lthe north to access the harbor area.", MSGBOX_NPC)
}

script Coralgrove_GENTLEMAN{
    if(flag(FLAG_CORALGROVE_CUTSCENE)){
        msgbox(Coralgrove_DroppedSomething, MSGBOX_NPC)
    }
    else{
        msgbox(Coralgrove_GENTLEMAN_Text, MSGBOX_NPC)
    }
    turnobject(12, DIR_NORTH)
}
text Coralgrove_GENTLEMAN_Text{
    "Do you ever look far into the horizon\n"
    "and let your worries fade away?"
}
text Coralgrove_DroppedSomething{
    "Did you see that?\p"
    "I think that Pidgeot dropped\n"
    "something in the ocean."
}

script Coralgrove_LeftBirds{
    setvar(VAR_TEMP_3, 1)
    goto(Coralgrove_BirdEvent)
}
script Coralgrove_RightBirds{
    setvar(VAR_TEMP_3, 2)
    goto(Coralgrove_BirdEvent)
}

script Coralgrove_BirdEvent{
    lock
    safefollow
    special(SpawnCameraObject)
    waitmove(OBJ_EVENT_ID_CAMERA, Walk3Up)
    if(var(VAR_TEMP_3) == 1){
        waitmove(14, BirdFlyFromWest)
        playmoncry(SPECIES_PIDGEOT, CRY_MODE_NORMAL)
        waitmove(14, BirdFlyFromWest)
    }
    else{
        waitmove(13, BirdFlyFromEast)
        playmoncry(SPECIES_PIDGEOT, CRY_MODE_NORMAL)
        waitmove(13, BirdFlyFromEast)
    }
    waitmove(OBJ_EVENT_ID_CAMERA, Walk3Down)
    special(RemoveCameraObject)
    delay(30)
    removeobject(13)
    removeobject(14)
    setflag(FLAG_CORALGROVE_CUTSCENE)
    clearflag(FLAG_OBTAINED_PIDGEOTITE)
    release
    end
}
movement BirdFlyFromWest{
    walk_right * 10
}
movement BirdFlyFromEast{
    walk_left * 10
}

script Coralgrove_MartMan{
    msgbox("Hello and welcome!\nThis is the Battle Shop.\pHere you can purchase useful\ncombat items and consumables.\pInstead of regular currency, everything\nin our shop is purchasable with\lBattle Points, or BP, instead!", MSGBOX_NPC)
}

script CoralGrove_NINJA_BOY{
    msgbox("I swear I saw this ghost girl flying\nabout but none of the adults believe me!", MSGBOX_NPC)
}

script CoralGrove_OLD_WOMAN{
    lock
    msgbox("Such pretty flowers…", MSGBOX_AUTOCLOSE)
}

script Coralgrove_Old_Woman2{
    msgbox(Coralgrove_Old_Woman2_Text, MSGBOX_NPC)
}
text Coralgrove_Old_Woman2_Text{
    "Coralgrove is built on a massive\n"
    "cliff that overlooks the ocean.\p"
    "In olden days, in order to get down\n"
    "to ocean level, people used to climb\l"
    "precarious stairs carved into the\l"
    "cliff face.\p"
    "Nowadays we just use the elevator."
}

script CoralGrove_OLD_MAN{
    msgbox("My wife often gets mesmerized\nby flowers.\pI don't really care about flowers\nbut better not let her catch on…", MSGBOX_NPC)
}

script Coralgrove_LASS{
    msgbox("Can you even call this place a city?\pThere's the Trainers' School and\nthe Pokémon Gym but apart from those\lthere's very little to do here.", MSGBOX_NPC)
}

script Coralgrove_HIKER{
    msgbox(Coral_Hiker_Text, MSGBOX_NPC)
}

text Coral_Hiker_Text{
    "There was a landslide between\n"
    "Coralgrove City and Primrose Town.\p"
    "There's some rocks here and there but\n"
    "most of it has already been cleared."
}

script Coralgrove_Children{
    msgbox("We're on recess!", MSGBOX_NPC)
}

script Coralgrove_school{
    msgbox("Pokémon Trainers' School", MSGBOX_SIGN)
}

script Coralgrove_Lifthouse{
    msgbox("Elevator access to harbor area", MSGBOX_SIGN)
}

script CoralSign{
    msgbox("CORALGROVE CITY\n“Home of many aspiring trainers.”", MSGBOX_SIGN)
}

script CoralGrove_EventScript_GymSign{
