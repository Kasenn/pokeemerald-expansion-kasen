mapscripts FrosthearthCity_PokeCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        setrespawn(HEAL_LOCATION_FROSTFIRE_CITY)
    }
}

script Frosthearth_PokeCenter_Woman{
    msgbox(Frosthearth_PokeCenter_Woman_Text, MSGBOX_NPC)
}
script Frosthearth_PokeCenter_Man{
    msgbox(Frosthearth_PokeCenter_Man_Text, MSGBOX_NPC)
}

text Frosthearth_PokeCenter_Woman_Text{
    "I brought my newly-hatched Pokémon\n"
    "to train here, and the speed at which\l"
    "it grew is astounding!"
}
text Frosthearth_PokeCenter_Man_Text{
    "As convenient as Pokémon Centers\n"
    "are as a place of healing,\l"
    "they just can't beat the feeling\l"
    "you get from taking a dip in a\l"
    "hot spring."
}

script Frosthearth_Mart_Man{
    if(var(VAR_SPHERES_FOUND) >= 4){
        msgbox(Frosthearth_Mart_Man_Legendary, MSGBOX_NPC)
    }
    else{
        msgbox(Frosthearth_Mart_Man_Text, MSGBOX_NPC)
    }
}
script Frosthearth_Mart_Lass{
    msgbox(Frosthearth_Mart_Lass_Text, MSGBOX_NPC)
}

text Frosthearth_Mart_Man_Legendary{
    "On my way here, I saw this majestic\n"
    "looking Pokémon leaping over the\l"
    "trees and the mountains.\p"
    "I think I saw it heading towards\n"
    "the huge mountain just north of\l"
    "Route 18."
}
text Frosthearth_Mart_Man_Text{
    "I swear I've never seen a single\n"
    "store selling Ethers.\p"
    "Where do they come from?\p"
    "How come they're so hard to\n"
    "come by?"
}
text Frosthearth_Mart_Lass_Text{
    "My Pokémon has been working\n"
    "extra hard, so I'm rewarding it by\l"
    "letting it pick any treat it wants."
}

script Frosthearth_Mart_Bounsweet{
    lock
	faceplayer
	waitse
	playmoncry(SPECIES_BOUNSWEET, CRY_MODE_NORMAL)
	msgbox("Bounsweet: Beleleen!")
	waitmoncry
	release
	end
}

script FrosthearthPokeCenter_EventScript_Nurse{
	setvar(VAR_0x800B, 3)
	call(Common_EventScript_PkmnCenterNurse)
	waitmessage
	waitbuttonpress
	release
	end
}

script FrosthearthPokeCenter_Lanette{
    lock
	faceplayer
	msgbox(FrosthearthPokeCenter_Lanette_Text)
	playfanfare(MUS_OBTAIN_TMHM)
    message(CanNowUseIVChecker)
    waitmessage
    waitfanfare
    delay(30)
    msgbox(FrosthearthPokeCenter_Lanette_ExplainIVFunction)
    msgbox(FrosthearthPokeCenter_Lanette_Goodbye)
    closemessage
    applymovement(8, moves(delay_16 * 2, walk_down * 3, walk_left * 3, walk_down * 4, delay_8))
    applymovement(LOCALID_PLAYER, moves(lock_facing_direction, walk_down, unlock_facing_direction, face_left, lock_facing_direction, walk_right, unlock_facing_direction))
    waitmovement(8)
    playse(SE_SLIDING_DOOR)
    removeobject(8)
    setflag(FLAG_SYS_PC_LANETTE)
    release
}
text FrosthearthPokeCenter_Lanette_Text{
    "Oh, hello.\n"
	"You are?\p"
	"Okay, your name's {PLAYER}.\n"
	"I can see that you're a trainer.\p"
	"So that means you use the Pokémon\n"
	"Storage System I developed.\p"
	"How I arrived at that conclusion is\n"
	"a simple deductive process.\p"
	"You spoke to me because you wanted\n"
	"to access something on this PC.\p"
	"Oh, I'm sorry. I'm Lanette.\p"
    "I'm the one behind the Pokémon Storage\n"
    "System you've come to learn and love,\l"
    "and I've just finished updating this\l"
    "machine with my latest update!"
}
text CanNowUseIVChecker{
    "The Judge function has been added\n"
    "to your PC boxes!"
}
text FrosthearthPokeCenter_Lanette_ExplainIVFunction{
    "When accessing your PC boxes,\n"
    "you can now use the Judge function\l"
    "and analyze a chosen Pokémon to see\l"
    "its biggest strengths and weaknesses.\p"
    "To access the Judge function, simply\n"
    "select a Pokémon, and choose “Judge”.\p"
    "You can also access the Judge\n"
    "function by pressing the L Button\l"
    "when using the normal Button Mode."
}
text FrosthearthPokeCenter_Lanette_Goodbye{
    "Anyway, I should be heading out now.\n"
    "I've still got lots of PCs to update!\p"
    "Honestly, I'm glad to meet you--it's\n"
	"great you're using the Storage System.\p"
	"If you're ever visiting Valorwatch City,\n"
    "drop by and say hello!"
}