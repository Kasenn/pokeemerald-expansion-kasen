const X = VAR_TEMP_3
const Y = VAR_TEMP_4
const OBJ_RUFFLET = 25

mapscripts FrostfireCity_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        setflag(FLAG_VISITED_FROSTFIRE)
        switch(var(VAR_FROSTHEARTH_RUFFLET)){
            case 2:
                setobjectxyperm(OBJ_RUFFLET, 37, 11)
            case 3:
                setobjectxyperm(OBJ_RUFFLET, 47, 29)
            case 4:
                setobjectxyperm(OBJ_RUFFLET, 39, 41)
            case 5:
                setobjectxyperm(OBJ_RUFFLET, 7, 27)
            case 6:
                setobjectxyperm(OBJ_RUFFLET, 10, 43)
        }
        if(var(VAR_FROSTHEARTH_RUFFLET) == 0 || var(VAR_FROSTHEARTH_RUFFLET) == 10){
            setflag(FLAG_TEMP_2)
        }
        switch(var(VAR_FROSTHEARTH_HARD_ROCK)){
            case 0:
                setflag(FLAG_TEMP_1)
            case 1:
                setobjectxyperm(28, 42, 40)
            case 2:
                setobjectxyperm(28, 46, 40)
            case 3:
                setflag(FLAG_TEMP_1)
        }
    }
}

