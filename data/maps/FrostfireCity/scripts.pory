script Frosthearth_Swimmer{
    if(var(VAR_FROSTHEARTH_HARD_ROCK) == 0){
        lock
        msgbox(RestingOnSomethingHard)
        closemessage
        getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
        addobject(28)
        playse(SE_FALL)
        safefollow
        if(var(VAR_TEMP_0) == 45){  //throw rock left
            applymovement(28, moves(walk_fast_left * 2))
            setvar(VAR_FROSTHEARTH_HARD_ROCK, 1)
        }
        else{   //throw rock right
            applymovement(28, moves(walk_fast_right * 2))
            setvar(VAR_FROSTHEARTH_HARD_ROCK, 2)
        }
        waitmovement(0)
        waitse
        delay(30)
        msgbox(NowThatsBetter)
        release
        end
    }
    else{
        msgbox(FeelingMuchBetter, MSGBOX_SIGN)
        end
    }
}

text RestingOnSomethingHard{
    "Ow ow ow!\p"
    "I think I'm resting on a stone\n"
    "or something."
}
text NowThatsBetter{
    "Much better!"
}
text FeelingMuchBetter{
    "Ahh…\p"
    "Feeling much better now that\n"
    "the stone is gone."
}

script Frosthearth_HardRock{
    if(checkitemspace(ITEM_HARD_STONE) == TRUE){
        setvar(VAR_FROSTHEARTH_HARD_ROCK, 3)
    }
    finditem(ITEM_HARD_STONE)
}

script Frosthearth_Boy2{
    if(var(VAR_FROSTHEARTH_RUFFLET) == 0){
        setvar(VAR_FROSTHEARTH_RUFFLET, 1)
        clearflag(FLAG_TEMP_2)
        msgbox(MissingRuffletStart, MSGBOX_NPC)
        end
    }
    elif(var(VAR_FROSTHEARTH_RUFFLET) < 6){
        msgbox(PleaseFindRufflet, MSGBOX_NPC)
        end
    }
    elif(var(VAR_FROSTHEARTH_RUFFLET) == 6){
        lock
        faceplayer
        msgbox(FindRuffletReward)
        giveitem(ITEM_HEART_SCALE)
        if(var(VAR_RESULT) == FALSE){
            goto(ZeBagIsFull)
        }
        setvar(VAR_FROSTHEARTH_RUFFLET, 10)
        release
        end
    }
    else{
        msgbox(ThankYouForFindingRufflet, MSGBOX_NPC)
    }
}
text MissingRuffletStart{
    "Have you seen a Rufflet\n"
    "wandering around the city?\p"
    "My pet Rufflet got spooked by\n"
    "something, fled, and now I can\l"
    "no longer find it."
}
text PleaseFindRufflet{
    "If you spot a lost looking Rufflet,\n"
    "try and catch it, okay?"
}
text FindRuffletReward{
    "My Rufflet came running back to me\n"
    "just before you arrived!\p"
    "Thank you for helping me get it back!\p"
    "I'm not sure how else to thank you,\n"
    "so I hope this will suffice."
}
text ThankYouForFindingRufflet{
    "Thank you for guiding my Rufflet\n"
    "back to me!"
}

script Frosthearth_Rufflet{
    lock
	faceplayer
	waitse
    safefollow
	playmoncry(SPECIES_RUFFLET, CRY_MODE_NORMAL)
	waitmoncry
    if(var(VAR_FROSTHEARTH_RUFFLET) >= 6){
        release
        end
    }
    delay(30)
    addvar(VAR_FROSTHEARTH_RUFFLET, 1)
    getplayerxy(X, Y)
    switch(var(VAR_FROSTHEARTH_RUFFLET)){
        case 2:
            if(var(X) == 12){
                applymovement(OBJ_RUFFLET, moves(walk_fast_down * 2, walk_fast_right * 3, walk_fast_down, walk_fast_right, walk_fast_down * 4))
            }
            else{
                applymovement(OBJ_RUFFLET, moves(walk_fast_right * 2, walk_fast_down * 2, walk_fast_right * 2, walk_fast_down * 5))
            }
            waitmovement(0)
            setobjectxy(OBJ_RUFFLET, 37, 11)
            setobjectxyperm(OBJ_RUFFLET, 37, 11)
        case 3:
            if(var(X) == 37){
                applymovement(OBJ_RUFFLET, moves(walk_fast_right * 8, walk_fast_down * 6))
            }
            else{
                applymovement(OBJ_RUFFLET, moves(walk_fast_down * 7))
            }
            waitmovement(0)
            setobjectxy(OBJ_RUFFLET, 47, 29)
            setobjectxyperm(OBJ_RUFFLET, 47, 29)
        case 4:
            if(var(X) == 46){
                applymovement(OBJ_RUFFLET, moves(walk_fast_right * 3, walk_fast_up * 6))
            }
            else{
                applymovement(OBJ_RUFFLET, moves(walk_fast_left * 5, walk_diag_southwest * 2, walk_fast_left))
            }
            waitmovement(0)
            setobjectxy(OBJ_RUFFLET, 39, 41)
            setobjectxyperm(OBJ_RUFFLET, 39, 41)
        case 5:
            if(var(X) == 38){
                applymovement(OBJ_RUFFLET, moves(walk_fast_up * 2, walk_fast_left * 11))
            }
            else{
                applymovement(OBJ_RUFFLET, moves(walk_fast_left * 2, walk_fast_up * 2, walk_fast_left * 7))
            }
            waitmovement(0)
            setobjectxy(OBJ_RUFFLET, 7, 27)
            setobjectxyperm(OBJ_RUFFLET, 7, 27)
        case 6:
            if(var(X) == 8){
                applymovement(OBJ_RUFFLET, moves(walk_fast_left, walk_fast_down * 3, walk_fast_right * 3, walk_fast_down * 6))
            }
            else{
                applymovement(OBJ_RUFFLET, moves(walk_fast_right * 2, walk_fast_down * 7))
            }
            waitmovement(0)
            setobjectxy(OBJ_RUFFLET, 10, 43)
            setobjectxyperm(OBJ_RUFFLET, 10, 43)
    }
    delay(48)
	release
	end
}