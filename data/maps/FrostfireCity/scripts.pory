text FrostHearth_Sign1_Text{
    "Frosthearth City Pokémon Gym\n"
	"Leaders: Blaine & Pryce"
}
text FrostHearth_Sign2_Text{
    "Hearth Motel\n"
    "“Home is where the hearth is.”"
}
text FrostHearth_Sign3_Text{
    "Frosthearth Harbor"
}
text FrostHearth_Sign4_Text{
    "Frosthearth City Pokémon Fan Club"
}
text FrostHearth_Sign5_Text{
    "The Pokémon World Tournament"
}
text FrostHearth_Sign6_Text{
    "Mr. Hyper's Hyper Training School\n"
    "“Train your Pokémon like a pro!”"
}
text FrostHearth_Sign7_Text{
    "FROSTHEARTH CITY\n"
	"“The capitol of the north.”"
}

script Frosthearth_GymUnavailable{
	msgbox(Frosthearth_GymUnavailable_Text, MSGBOX_NPC)
    setflag(FLAG_FIND_PRYCE_QUEST)
}
text Frosthearth_GymUnavailable_Text{
	"I'm sorry, but we can't currently\n"
	"accept new challengers.\p"
	"The Gym Leader went to explore\n"
    "the Frigid Frontier, and has yet\l"
    "to return."
}

