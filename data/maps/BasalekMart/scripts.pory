script BasalekMart_Triathlete{
    msgbox(BasalekMart_Triathlete_Text, MSGBOX_NPC)
    turnobject(4, DIR_NORTH)
}
text BasalekMart_Triathlete_Text{
    "The route up north is often hit with\n"
    "some extreme weather conditions.\p"
    "If you're heading that way,\n"
    "I recommend stocking up first."
}
script BasalekMart_Man{
    msgbox(BasalekMart_Man_Text, MSGBOX_NPC)
}
text BasalekMart_Man_Text{
    "This mart seems to be stocked to the\n"
    "brim with drinks.\p"
    "That's fine and all, but I was really\n"
    "hoping to find some potions."
}
script BasalekMart_Rival{
    lock
    faceplayer
    if(flag(FLAG_RIVAL_MET_IN_BASALEK_MART)){
        if(checkplayergender == MALE){
            msgbox(BasalekMartMay_ReadyToBattleNow, MSGBOX_YESNO)
            goto(BasalekMart_MayBattle)
        }
        else{
            msgbox(BasalekMartBrendan_ReadyToBattleNow, MSGBOX_YESNO)
            goto(BasalekMart_BrendanBattle)
        }
    }
    setflag(FLAG_RIVAL_MET_IN_BASALEK_MART)
    if(checkplayergender == MALE){
        msgbox(BasalekMartMay_GettingReadyToHeadOut, MSGBOX_YESNO)
        goto(BasalekMart_MayBattle)
    }
    else{
        msgbox(BasalekMartBrendan_GettingReadyToHeadOut, MSGBOX_YESNO)
        goto(BasalekMart_BrendanBattle)
    }
}
script BasalekMart_MayBattle{
    if(var(VAR_RESULT) == FALSE){
    msgbox(BasalekMartMay_WantToPrepare, MSGBOX_AUTOCLOSE)
    end
    }
    msgbox(BasalekMartMay_LetsGoFightOutside, MSGBOX_AUTOCLOSE)
    warp(MAP_BASALUFF_TOWN, 23, 16)
    waitstate
}
script BasalekMart_BrendanBattle{
    if(var(VAR_RESULT) == FALSE){
        msgbox(BasalekMartBrendan_WantToPrepare, MSGBOX_AUTOCLOSE)
        end
    }
    msgbox(BasalekMartBrendan_LetsGoFightOutside, MSGBOX_AUTOCLOSE)
    warp(MAP_BASALUFF_TOWN, 23, 16)
    waitstate
}

text BasalekMartMay_GettingReadyToHeadOut{
    "{RIVAL}: Oh, hi {PLAYER}!\n"
    "Long time no see!\p"
    "I honestly don't know how people can\n"
    "even live in this humid atmosphere.\p"
    "I had to turn back on Route 17\n"
    "just to get myself some extra drinks\l"
    "for the journey.\p"
    "Anyways, enough about me.\p"
    "How about we have ourselves\n"
    "a Pokémon battle?\p"
    "I'm curious to see if you've mastered\n"
    "using the Mega Evolution technique."
}
text BasalekMartMay_WantToPrepare{
    "I get it.\n"
    "You want some time to prepare.\p"
    "There's a PC in the far corner\n"
    "of the Mart.\p"
    "And if you need to get your\n"
    "Pokémon healed, just go take\l"
    "a dip in the hot spring outside.\p"
    "I'll be waiting for you here!"
}
text BasalekMartMay_LetsGoFightOutside{
    "Alright!\p"
    "Come, let's go battle outside\n"
    "so we don't disturb the store\l"
    "with our battling."
}
text BasalekMartBrendan_GettingReadyToHeadOut{
    "{RIVAL}: Oh, hey {PLAYER}!\n"
    "It's been a while, huh?\p"
    "I was on my way to Route 17, but\n"
    "the weather was so unbearably humid\l"
    "that I just had to turn back and\l"
    "get myself some extra drinks for\l"
    "the journey.\p"
    "Anyway, enough about me.\p"
    "How about we have ourselves\n"
    "a Pokémon battle?\p"
    "I'm curious to see if you've mastered\n"
    "using the Mega Evolution technique."
}
text BasalekMartBrendan_WantToPrepare{
    "I get it.\n"
    "You want some time to prepare.\p"
    "There's a PC in the far corner\n"
    "of the Mart.\p"
    "And if you need to get your\n"
    "Pokémon healed, just give them\l"
    "a relaxing bath in the hot spring\l"
    "outside.\p"
    "I'll be waiting for you here."
}
text BasalekMartBrendan_LetsGoFightOutside{
    "Okay!\p"
    "But first, let's head outside.\p"
    "We don't want to disturb the store\n"
    "with our battle."
}
text BasalekMartMay_ReadyToBattleNow{
    "{RIVAL}: You're back!\p"
    "Are you ready to battle now?"
}
text BasalekMartBrendan_ReadyToBattleNow{
    "{RIVAL}: Welcome back.\p"
    "Are you ready to battle now?"
}