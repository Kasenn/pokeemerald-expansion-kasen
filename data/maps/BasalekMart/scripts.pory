mapscripts BasalekMart_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        call(Common_EventScript_SetupRivalGfxId)
        if(flag(FLAG_RIVAL_MET_IN_BASALEK)){
            setflag(FLAG_TEMP_1)
        }
    }
}

script BasalekMart_Clerk{
    lock
	faceplayer
	message(gText_HowMayIServeYou)
	waitmessage
    if(flag(FLAG_BADGE08_GET)){
        pokemart(BasalekMart_8Badges)
    }
    elif(flag(FLAG_BADGE07_GET)){
        pokemart(BasalekMart_7Badges)
    }
    elif(flag(FLAG_BADGE06_GET)){
        pokemart(BasalekMart_7Badges)
    }
    elif(flag(FLAG_BADGE05_GET)){
        pokemart(BasalekMart_4Badges)
    }
    msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
	release
	end
}

