const LOCALID_NURSE = 1

mapscripts OldaleTown_PokemonCenter_1F_MapScripts{
    MAP_SCRIPT_ON_TRANSITION{
        setrespawn(HEAL_LOCATION_PRIMROSE_TOWN)
    }
}

script PokemonCenter_Nurse{
	copyvar(VAR_0x800B, VAR_LAST_TALKED)
	call(Common_EventScript_PkmnCenterNurse)
	waitmessage
	waitbuttonpress
	release
	end
}

script OldaleTown_PokemonCenter_1F_EventScript_Gentleman{
	msgbox(OldaleTown_PokemonCenter_1F_Text_TrainersCanUsePC, MSGBOX_NPC)
}

script OldaleTown_PokemonCenter_1F_EventScript_Boy{
	msgbox(OldaleTown_PokemonCenter_1F_Text_PokemonCentersAreGreat, MSGBOX_NPC)
}

script OldaleTown_PokemonCenter_1F_EventScript_Girl{
	msgbox(OldaleTown_PokemonCenter_1F_Text_WirelessClubNotAvailable, MSGBOX_NPC)
}

script OldaleTown_PokemonCenter_1F_EventScript_Teala{
	msgbox(OldaleTown_PokemonCenter_1F_Text_Train, MSGBOX_NPC)
}

text OldaleTown_PokemonCenter_1F_Text_TrainersCanUsePC{
	"Thanks to the advances in science,\n"
	"TMs have become much more durable.\p"
	"Trainers no longer have to fear their\n"
	"TMs breaking and can use\l"
	"them as many times as they want."
}

text OldaleTown_PokemonCenter_1F_Text_PokemonCentersAreGreat{
	"Pokémon Centers are great!\p"
	"You can use their services as much\n"
	"as you like, and it's all for free.\l"
	"You never have to worry!"
}

text OldaleTown_PokemonCenter_1F_Text_WirelessClubNotAvailable{
	"The Pokémon Training Club on\n"
	"the second floor was built recently.\p"
	"But they say they're still making\n"
	"adjustments."
}

text OldaleTown_PokemonCenter_1F_Text_Train{
	"I'm sorry, but the Pokémon Training\n"
	"Club is not quite ready yet.\p"
	"Please come back later."
}

