}

script Route18_Tr5_RangerF {
    trainerbattle_single(TRAINER_R18_TR5_RANGER_F, R18Tr5_Intro, R18Tr5_Lose)
    msgbox(R18Tr5_PostBattle, MSGBOX_AUTOCLOSE)
    end
}
text R18Tr5_Intro {
    "I'll have a battle with you using\n"
    "my freshly caught Pokémon!"
}
text R18Tr5_Lose {
    "I had no idea how my Pokémon\n"
    "would fight. I mean, I caught them\l"
