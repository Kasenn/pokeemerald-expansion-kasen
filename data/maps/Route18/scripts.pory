mapscripts Route18_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        cleartrainerflag(TRAINER_R18_TR8_BREEDER_M)
        if(var(VAR_SPHERES_FOUND) >= 4){
            setflag(FLAG_TEMP_1)
        }
    }
}

script Route18_Tr1_Hiker1 {
    trainerbattle_single(TRAINER_R18_TR1_HIKER1, R18Tr1_Intro, R18Tr1_Lose)
    msgbox(R18Tr1_PostBattle, MSGBOX_AUTOCLOSE)
    end
}
text R18Tr1_Intro {
    "My legs are solid from pounding up\n"
    "and down the mountains.\p"
    "They're not going to buckle easily,\n"
    "friend!"
}
text R18Tr1_Lose {
    "Ouch! My legs cramped up!"
}
text R18Tr1_PostBattle {
    "Try hiking, and I mean really\n"
    "pounding, on these mountain trails\l"
    "with a heavy pack weighing dozens of\l"
    "pounds.\p"
    "That, my friend, will get your body\n"
    "into serious shape."
}

script Route18_Tr2_RangerM {
    trainerbattle_single(TRAINER_R18_TR2_RANGER_M, R18Tr2_Intro, R18Tr2_Lose)
    msgbox(R18Tr2_PostBattle, MSGBOX_AUTOCLOSE)
    end
}
text R18Tr2_Intro {
    "I can see the plea in my\n"
    "Pokémon's eyes.\p"
    "To fight! And to win!"
}
text R18Tr2_Lose {
    "The eyes of your Pokémon\n"
    "are glimmering with strength!"
}
text R18Tr2_PostBattle {
    "I can see the plea in my\n"
    "Pokémon's eyes.\p"
    "They're saying,\n"
    "“Get back up! I'm OK!”\p"
    "Yep! I can understand my Pokémon's"
    "feelings by looking into their eyes."
}

