}
text R18Tr5_PostBattle {
    "I may have just caught them, but\n"
    "I'll raise them to be strong!\l"
    "Our time together has just begun!"
}

script Route18_Tr6_Scientist {
    trainerbattle_single(TRAINER_R18_TR6_SCIENTIST, R18Tr6_Intro, R18Tr6_Lose)
    msgbox(R18Tr6_PostBattle, MSGBOX_AUTOCLOSE)
    end
}
text R18Tr6_Intro {
    "I've got a Pokémon that I simply\n"
    "must test on someone!"
}
text R18Tr6_Lose {
    "Results inconclusive."
}
text R18Tr6_PostBattle {
    "Nobody knows how these lava pools\n"
    "are able to keep going in this\l"
    "freezing weather.\p"
    "Some suspect that the the lava is\n"
    "somehow being generated by a Pokémon."
}

script Route18_Tr7_Pokemaniac {
    trainerbattle_single(TRAINER_R18_TR7_POKEMANIAC, R18Tr7_Intro, R18Tr7_Lose)
    msgbox(R18Tr7_PostBattle, MSGBOX_AUTOCLOSE)
    end
}
text R18Tr7_Intro {
    "I'll obliterate any trainer that\n"
    "crosses my path!"
}
text R18Tr7_Lose {
    "Mommy!"
}
text R18Tr7_PostBattle {
    "…What?\n"
    "Why are you looking at me like that?"
}

script Route18_Tr8_BreederM {
    trainerbattle_single(TRAINER_R18_TR8_BREEDER_M, R18Tr8_Intro, R18Tr8_Lose, SetR18BreederFlag)
    msgbox(R18Tr8_PostBattle, MSGBOX_AUTOCLOSE)
    end
}
script SetR18BreederFlag{
    setflag(FLAG_R18_BREEDER_DEFEATED)
    release
    end
}
text R18Tr8_Intro {
    "We've just got to do what we can!"
}
text R18Tr8_Lose {
    "I feel like I understood what I\n"
    "could do and what I couldn't."
}
text R18Tr8_PostBattle {
    "I'll try to increase the things I can\n"
    "do and challenge you again!"
}

script Route18_Tr9_AceTrainerM {
    if(defeated(TRAINER_R18_TR9_ACE_TRAINER_M)){
        goto(R18_Ace_PostBattle)
    }
    elif(defeated(TRAINER_R18_TR1_HIKER1)
      && defeated(TRAINER_R18_TR2_RANGER_M)
      && defeated(TRAINER_R18_TR3_KINDLER)
      && defeated(TRAINER_R18_TR4_HIKER2)
      && defeated(TRAINER_R18_TR5_RANGER_F)
      && defeated(TRAINER_R18_TR6_SCIENTIST)
      && defeated(TRAINER_R18_TR7_POKEMANIAC)
      && flag(FLAG_R18_BREEDER_DEFEATED))
    {
        goto(R18_Ace_EligibleForBattle)
    }
    else{
        msgbox(R18_Ace_NotEligible, MSGBOX_NPC)
        end
    }
}
script R18_Ace_EligibleForBattle{
    lock
    faceplayer
    if(!flag(FLAG_TEMP_5)){
        setflag(FLAG_TEMP_5)
        msgbox(R18_Ace_ReadyForBattle, MSGBOX_YESNO)
    }
    else{
        msgbox(R18_Ace_ReadyForBattleShort, MSGBOX_YESNO)
    }
    if(var(VAR_RESULT) == TRUE){
        msgbox(R18_Ace_BeginBattle, MSGBOX_DEFAULT)
        trainerbattle_no_intro(TRAINER_R18_TR9_ACE_TRAINER_M, R18_Ace_Lose)
        goto(R18_Ace_PostBattle)
    }
    msgbox(R18_Ace_DeclineBattle, MSGBOX_NPC)
    end
}

script R18_Ace_PostBattle{
    lock
    faceplayer
    if(flag(FLAG_OBTAINED_LOADED_DICE)){
        msgbox(R18_Ace_PostBattle_Text, MSGBOX_NPC)
        end
    }
    msgbox(R18_Ace_Reward, MSGBOX_DEFAULT)
    if(checkitemspace(ITEM_LOADED_DICE) == FALSE){
        goto(ZeBagIsFull)
    }
    giveitem(ITEM_LOADED_DICE)
    waitfanfare
    msgbox(R18_Ace_ExplainReward)
    setflag(FLAG_OBTAINED_LOADED_DICE)
    setvar(VAR_0x8004, 30)
    call(RewardBP)
    release
    end
}

text R18_Ace_NotEligible{
    "Think you have what it takes to\n"
    "challenge me?\p"
    "My Pokémon are ice cold.\p"
    "You better get warmed up by beating\n"
    "all the other trainers here first."
}
text R18_Ace_ReadyForBattle{
    "I've seen you fighting the other\n"
    "trainers around here.\p"
    "With all that warm-up out of the way,\n"
    "you want to test your limits against\l"
    "an ice cold team like mine?"
}
text R18_Ace_ReadyForBattleShort{
    "Changed your mind, eh?"
}
text R18_Ace_BeginBattle{
    "Good.\n"
    "Prepare for a bone-chilling battle!"
}
text R18_Ace_DeclineBattle{
    "Heh, thought so."
}
text R18_Ace_PostBattle_Text{
    "I expect to hear only\n"
    "great things about you."
}
text R18_Ace_Reward{
    "I'm not going to try and make\n"
    "excuses for why I lost.\p"
    "This was all really a matter\p"
    "of skill.\p"
    "Here, maybe you can put this thing\n"
    "to a better use than I ever could."
}
text R18_Ace_ExplainReward{
    "Give those loaded dice to a Pokémon\n"
    "to hold, and any multistrike move\l"
    "they use is guaranteed to hit\l"
    "the maximum number of times.\p"
    "Also, I want you to have these."
}
text R18_Ace_Lose{
    "Amazing display of skill.\n"
    "I completely froze there!"
}