}
text R18Tr3_PostBattle {
    "A well-trained Pokémon can\n"
    "easily take on an entire team of\l"
    "untrained rabble.\p"
    "Your Pokémon are exceptionally\n"
    "trained."
}

script Route18_Tr4_Hiker2 {
    trainerbattle_single(TRAINER_R18_TR4_HIKER2, R18Tr4_Intro, R18Tr4_Lose)
