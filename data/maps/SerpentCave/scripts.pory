script CameraShake{
    setvar(VAR_0x8004, 1)  // vertical pan
    setvar(VAR_0x8005, 1)  // horizontal pan
    setvar(VAR_0x8006, 14)  // num shakes
    setvar(VAR_0x8007, 6)  // shake delay
    special(ShakeCamera)
    return
}
script CameraShakeFaster{
    setvar(VAR_0x8004, 1)  // vertical pan
    setvar(VAR_0x8005, 1)  // horizontal pan
    setvar(VAR_0x8006, 8)  // num shakes
    setvar(VAR_0x8007, 5)  // shake delay
    special(ShakeCamera)
    return
}
text IrisIntroText{
    "Oh, hi there!\p"
    "Are you here looking for treasure?\p"
    "My name's Iris, and you are…?\p"
    "{PLAYER}… Well, listen up,\n"
    "{PLAYER}.\p"
    "I found these caverns first,\n"
    "which means all the treasure here\l"
    "belongs to me!\p"
    "With the help of my trusty steed,\n"
    "I bet I can grab up everything\l"
    "before you can even blink!\p"
    "Let's go, Aggron!"
}
script IrisGoodbye{
    delay(24)
    switch(var(CAVE_ENTRANCE)){
        case 0:
        case 2:
            turnobject(31, DIR_NORTH)
        default:
            turnobject(31, DIR_SOUTH)
    }
    playse(SE_PIN)
    applymovement(31, ExclamationMark)
    waitmovement(0)
    delay(48)
    switch(var(CAVE_ENTRANCE)){
        case 0:
        case 2:
            applymovement(31, Walk1Up)
        case 1:
            applymovement(31, Walk3Down)
        case 3:
            applymovement(31, Walk2Down)
        case 4:
            applymovement(31, Walk2Down)
    }
    waitmovement(0)
    delay(10)
    msgbox(IrisIntroText)
    closemessage
    delay(5)
    switch(var(CAVE_ENTRANCE)){
        case 2:
            turnobject(31, DIR_EAST)
    }
    delay(48)
    addobject(32)
    addobject(33)
    removeobject(31)
    delay(60)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    switch(var(CAVE_ENTRANCE)){
        case 0:
            goto(IrisLeavesEntrance1)
        case 1:
            goto(IrisLeavesEntrance2)
        case 2:
            goto(IrisLeavesEntrance3)
        case 3:
            goto(IrisLeavesEntrance4)
        case 4:
            goto(IrisLeavesEntrance5)
    }
}

movement IrisLeavesOnAggron1{
    walk_in_place_fast_up * 6
    walk_down
    walk_right * 2
    walk_down
