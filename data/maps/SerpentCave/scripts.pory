script SerpentCave_MoveFirstBoulder{
    lock
    call(PushABoulder)
    call(DoBoulderOneRoll)
    waitmovement(0)
    removeobject(1)
    removeobject(6)
    removeobject(7)
    clearflag(RAPID_1)
    addobject(2)
    addobject(3)
    addobject(4)
    addobject(5)
    if(var(VAR_SERPENTCAVE_WATER_LEVEL) == 3){
        playse(SE_M_DIVE)
        waitse
    }
    else{
        call(CameraShake)
        waitstate
    }
    setflag(FLAG_SERPENTCAVE_BOULDER_1)
    addvar(VAR_SERPENTCAVE_WATER_LEVEL, 1)
    release}
script SerpentCave_MoveSecondBoulder{
    call(PushABoulder)
    call(DoBoulderTwoRoll)

    waitmovement(0)
    delay(8)
    if(var(VAR_SERPENTCAVE_WATER_LEVEL) == 3){
        playse(SE_M_DIVE)
        waitse
    }
    else{
        call(CameraShake)
        waitstate
    }
    removeobject(8)
    removeobject(9)
    removeobject(10)
    clearflag(RAPID_2)
    addobject(12)
    addobject(13)
    addobject(14)
    addobject(15)
    addobject(16)
    setflag(FLAG_SERPENTCAVE_BOULDER_2)
    addvar(VAR_SERPENTCAVE_WATER_LEVEL, 1)
    release}
