script FollowerStayPutLatios{
    faceplayer
    bufferlivemonnickname(0)
    getfollowerxy(X, Y)
    if(flag(FLAG_FOLLOWER_STAYS_PUT)){
        msgbox(FollowerStayPut_Follow, MSGBOX_YESNO)
        if(var(VAR_RESULT) == TRUE){
            setvar(VAR_MON_ON_SWITCH_X, 0)
            clearflag(FLAG_FOLLOWER_STAYS_PUT)
            setmetatile(X, Y, METATILE_LatiIsles_LatiasIsland_SwitchDown, FALSE)
            msgbox(FollowerStayPut_Follow2)
        }
        else{
            msgbox(FollowerStayPut_Text2)
            turnobject(OBJ_EVENT_ID_FOLLOWER, DIR_SOUTH)
        }
    }
    else{
        msgbox(FollowerStayPut_Text, MSGBOX_YESNO)
        if(var(VAR_RESULT) == TRUE)
        {
            if(var(X) == SWITCH_1_X && var(Y) == SWITCH_1_Y){
                setvar(VAR_MON_ON_SWITCH_X, 1)
            }
            elif(var(X) == SWITCH_2_X && var(Y) == SWITCH_2_Y){
                setvar(VAR_MON_ON_SWITCH_X, 2)
            }
            elif(var(X) == SWITCH_3_X && var(Y) == SWITCH_3_Y){
                setvar(VAR_MON_ON_SWITCH_X, 3)
            }
            elif(var(X) == SWITCH_4_X && var(Y) == SWITCH_4_Y){
                setvar(VAR_MON_ON_SWITCH_X, 4)
            }
            elif(var(X) == SWITCH_5_X && var(Y) == SWITCH_5_Y){
                setvar(VAR_MON_ON_SWITCH_X, 5)
            }
            elif(var(X) == SWITCH_6_X && var(Y) == SWITCH_6_Y){
                setvar(VAR_MON_ON_SWITCH_X, 6)
            }
            setflag(FLAG_FOLLOWER_STAYS_PUT)
            setmetatile(X, Y, METATILE_LatiIsles_LatiasIsland_SwitchDown, TRUE)
            turnobject(OBJ_EVENT_ID_FOLLOWER, DIR_SOUTH)
            msgbox(FollowerStayPut_Text2)
        }
    }
    release
}

script LatiosIsland_CallBackMon1{
    if(var(VAR_MON_ON_SWITCH_X) == 1){
        playse(SE_SELECT)
        msgbox(LatiasIsland_CallBackMon1_Text, MSGBOX_YESNO)
        if(var(VAR_RESULT) == TRUE){
            getobjectxy(LOCALID_LATIOSISLAND_ROCK_1)
            if((var(ROCK_X) == 11 || var(ROCK_X) == 12) && var(ROCK_Y) == 49){
                msgbox(ShouldMoveRockFirst)
                release
                end
            }
            waitmove(OBJ_EVENT_ID_FOLLOWER, moves(enter_pokeball set_invisible))
            callnative(RemoveFollowingPokemon)
            clearflag(FLAG_FOLLOWER_STAYS_PUT)
            setvar(VAR_MON_ON_SWITCH_X, 0)
            setvar(SWITCH_1, 0)
            setmetatile(WALL_1_PART_1_X, WALL_1_PART_1_Y, METATILE_LatiIsles_LI_BarrierUp, TRUE)
            setmetatile(WALL_1_PART_2_X, WALL_1_PART_2_Y, METATILE_LatiIsles_LI_BarrierUp, TRUE)
            setmetatile(WALL_1_PART_3_X, WALL_1_PART_3_Y, METATILE_LatiIsles_LI_BarrierUp, TRUE)
            setmetatile(WALL_1_PART_4_X, WALL_1_PART_4_Y, METATILE_LatiIsles_LI_BarrierUp, TRUE)
            setmetatile(SWITCH_1_X, SWITCH_1_Y, METATILE_LatiIsles_LatiasIsland_SwitchUp, FALSE)
            playse(SE_M_STRENGTH)
            special(DrawWholeMapView)
            callnative(UpdateFollowingPokemon)
        }
    }
    release
}

text ShouldMoveRockFirst{
    "Should probably move the boulder\n"
    "first before moving the Pokémon…"
}

