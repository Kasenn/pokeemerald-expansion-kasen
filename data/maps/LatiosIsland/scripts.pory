text LatiosIsland_ReturnToRoute23_Text{
    "Send out Latios and return\n"
    "back to Route 23?"
}

script LatiosIsland_ReturnToRoute23{
    msgbox(LatiosIsland_ReturnToRoute23_Text, MSGBOX_YESNO)
    if(var(VAR_RESULT) == FALSE){
        release
        end
    }
    closemessage
    checkpartymon(SPECIES_LATIOS, FALSE)
    bufferpartymonnick(STR_VAR_1, VAR_0x8000)
    if(var(VAR_0x800A) == TRUE){
        setvar(LATI_BODY, LOCALID_LATIOSISLAND_LATIOS_SHINY)
        setvar(LATI_HEAD, LOCALID_LATIOSISLAND_LATIOS_SHINY_HEAD)
    }
    else{
        setvar(LATI_BODY, LOCALID_LATIOSISLAND_LATIOS)
        setvar(LATI_HEAD, LOCALID_LATIOSISLAND_LATIOS_HEAD)
    }
    setflag(FLAG_OVERRIDE_FOLLOWER_DIRECTION)
    setvar(VAR_FACING, DIR_SOUTH)
    waitmove(LOCALID_LATIOSISLAND_LATIBALL, moves(set_visible, delay_1 * 3, lati_ball))
    showobjectat(LATI_BODY, MAP_LATIOS_ISLAND)
    showobjectat(LATI_HEAD, MAP_LATIOS_ISLAND)
    removeobject(LOCALID_LATIOSISLAND_LATIBALL)
    delay(16)
    addobject(LOCALID_FAKE_PLAYER)
    setobjectsubpriority(LOCALID_FAKE_PLAYER, MAP_LATIOS_ISLAND, 0)
    hideobjectat(LOCALID_PLAYER, MAP_LATIOS_ISLAND)
    setobjectsubpriority(LATI_HEAD, MAP_LATIOS_ISLAND, 0)
    waitmove(LOCALID_FAKE_PLAYER, moves(jump_2_down, lock_anim))
    call(SetSittingPlayerModel)
    removeobject(LOCALID_FAKE_PLAYER)
    setobjectxyperm(LOCALID_FAKE_PLAYER, 17, 74)
    addobject(LOCALID_FAKE_PLAYER)
    setobjectsubpriority(LOCALID_FAKE_PLAYER, MAP_LATIOS_ISLAND, 1)
    delay(16)
    applymovement(LATI_BODY, PlayerAndLatiasLeave)
    applymovement(LATI_HEAD, PlayerAndLatiasLeave)
    applymovement(LOCALID_FAKE_PLAYER, moves(lock_anim, walk_slow_down, walk_down * 2, walk_faster_down * 4))
    waitmovement(0)
    clearflag(FLAG_STOP_GROUND_EFFECTS)
    clearflag(FLAG_OVERRIDE_FOLLOWER_DIRECTION)
    setvar(VAR_0x8004, 4)
    callnative(LatisWarp)
    special(LatiRide)
    waitstate
}