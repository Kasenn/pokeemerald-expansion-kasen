script LatiosIsland_CallBackMon3 {
    if (var(VAR_MON_ON_SWITCH_X) == 3) {
        playse(SE_SELECT)
        msgbox(LatiasIsland_CallBackMon1_Text, MSGBOX_YESNO)
        if (var(VAR_RESULT) == TRUE) {
            waitmove(OBJ_EVENT_ID_FOLLOWER, moves(enter_pokeball set_invisible))
            callnative(RemoveFollowingPokemon)
            clearflag(FLAG_FOLLOWER_STAYS_PUT)
            setvar(VAR_MON_ON_SWITCH_X, 0)
            setvar(SWITCH_3, 0)
            setmetatile(WALL_3_PART_1_X, WALL_3_PART_1_Y, METATILE_LatiIsles_LI_BarrierUp, TRUE)
            setmetatile(WALL_3_PART_2_X, WALL_3_PART_2_Y, METATILE_LatiIsles_LI_BarrierUp, TRUE)
            setmetatile(SWITCH_3_X, SWITCH_3_Y, METATILE_LatiIsles_LatiasIsland_SwitchUp, FALSE)
            playse(SE_M_STRENGTH)
            special(DrawWholeMapView)
            callnative(UpdateFollowingPokemon)
        }
    }
    release
}

script LatiosIsland_CallBackMon4 {
    if (var(VAR_MON_ON_SWITCH_X) == 4) {
        playse(SE_SELECT)
        msgbox(LatiasIsland_CallBackMon1_Text, MSGBOX_YESNO)
