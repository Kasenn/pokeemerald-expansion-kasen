const SWITCH_1 = VAR_TEMP_1
const SWITCH_2 = VAR_TEMP_2
const SWITCH_3 = VAR_TEMP_3
const SWITCH_4 = VAR_TEMP_4
const SWITCH_5 = VAR_TEMP_5
const SWITCH_6 = VAR_TEMP_6

const X = VAR_TEMP_7
const Y = VAR_TEMP_8
const ROCK_X = VAR_0x8001
const ROCK_Y = VAR_0x8002

const SPECIES = VAR_TEMP_9
const LATI_BODY = VAR_TEMP_A
const LATI_HEAD = VAR_TEMP_B

const FLAG_PLAYER = FLAG_TEMP_8
const FLAG_PUZZLE1_SWITCH_1 = FLAG_TEMP_1
const FLAG_PUZZLE2_SWITCH_1 = FLAG_TEMP_A

const SWITCH_1_X = 9
const SWITCH_1_Y = 48
const WALL_1_PART_1_X = 11
const WALL_1_PART_1_Y = 49
const WALL_1_PART_2_X = 12
const WALL_1_PART_2_Y = 49
const WALL_1_PART_3_X = 11
const WALL_1_PART_3_Y = 35
const WALL_1_PART_4_X = 12
const WALL_1_PART_4_Y = 35

const SWITCH_2_X = 18
const SWITCH_2_Y = 48
const WALL_2_PART_1_X = 19
const WALL_2_PART_1_Y = 51
const WALL_2_PART_2_X = 19
const WALL_2_PART_2_Y = 52

const SWITCH_3_X = 20
const SWITCH_3_Y = 30
const WALL_3_PART_1_X = 19
const WALL_3_PART_1_Y = 33
const WALL_3_PART_2_X = 19
const WALL_3_PART_2_Y = 34

const SWITCH_4_X = 37
const SWITCH_4_Y = 28
const WALL_4_PART_1_X = 40
const WALL_4_PART_1_Y = 29
const WALL_4_PART_2_X = 41
const WALL_4_PART_2_Y = 29

const SWITCH_5_X = 41
const SWITCH_5_Y = 25
const WALL_5_PART_1_X = 37
const WALL_5_PART_1_Y = 26
const WALL_5_PART_2_X = 38
const WALL_5_PART_2_Y = 26

const SWITCH_6_X = 37
const SWITCH_6_Y = 22
const WALL_6_PART_1_X = 40
const WALL_6_PART_1_Y = 23
const WALL_6_PART_2_X = 41
const WALL_6_PART_2_Y = 23


mapscripts LatiosIsland_MapScripts {
    MAP_SCRIPT_ON_RESUME{
        setstepcallback(STEP_CB_LATIOSISLAND)
    }
    MAP_SCRIPT_ON_TRANSITION{
        setvar(VAR_SHINY_MULTIPLIER, 8)
        setflag(FLAG_PERMA_DAY)
        setflag(FLAG_PLAYER)
        call(Amberock_SetPlayerModel)
        clearflag(FLAG_FOLLOWER_STAYS_PUT)
        if(flag(FLAG_LATIOSISLE_PUZZLE1_SOLVED)){
            setvar(SWITCH_1, 100)
            setobjectxyperm(LOCALID_LATIOSISLAND_ROCK_1, SWITCH_1_X, SWITCH_1_Y)
        }
        if(flag(FLAG_LATIOSISLE_PUZZLE2_SOLVED)){
            setvar(SWITCH_4, 100)
            setobjectxyperm(LOCALID_LATIOSISLAND_ROCK_2, SWITCH_4_X, SWITCH_4_Y)
        }
    }
    MAP_SCRIPT_ON_LOAD{
        if(var(SWITCH_1) != 100){
            setmetatile(WALL_1_PART_1_X, WALL_1_PART_1_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
            setmetatile(WALL_1_PART_2_X, WALL_1_PART_2_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
            setmetatile(WALL_1_PART_3_X, WALL_1_PART_3_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
            setmetatile(WALL_1_PART_4_X, WALL_1_PART_4_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
        }
        if(var(SWITCH_2) != 100){
            setmetatile(WALL_2_PART_1_X, WALL_2_PART_1_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
            setmetatile(WALL_2_PART_2_X, WALL_2_PART_2_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
        }
        if(var(SWITCH_3) != 100){
            setmetatile(WALL_3_PART_1_X, WALL_3_PART_1_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
            setmetatile(WALL_3_PART_2_X, WALL_3_PART_2_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
        }
        if(var(SWITCH_4) != 100){
            setmetatile(WALL_4_PART_1_X, WALL_4_PART_1_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
            setmetatile(WALL_4_PART_2_X, WALL_4_PART_2_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
        }
        if(var(SWITCH_5) != 100){
            setmetatile(WALL_5_PART_1_X, WALL_5_PART_1_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
            setmetatile(WALL_5_PART_2_X, WALL_5_PART_2_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
        }
        if(var(SWITCH_6) != 100){
            setmetatile(WALL_6_PART_1_X, WALL_6_PART_1_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
            setmetatile(WALL_6_PART_2_X, WALL_6_PART_2_Y, METATILE_LatiIsles_LI_BarrierUp, 1)
        }
        switch(var(VAR_MON_ON_SWITCH_X)){
            case 1:
                setmetatile(WALL_1_PART_1_X, WALL_1_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setmetatile(WALL_1_PART_2_X, WALL_1_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setmetatile(WALL_1_PART_3_X, WALL_1_PART_3_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setmetatile(WALL_1_PART_4_X, WALL_1_PART_4_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setvar(SWITCH_1, 100)
            case 2:
                setmetatile(WALL_2_PART_1_X, WALL_2_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setmetatile(WALL_2_PART_2_X, WALL_2_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setvar(SWITCH_2, 100)
            case 3:
                setmetatile(WALL_3_PART_1_X, WALL_3_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setmetatile(WALL_3_PART_2_X, WALL_3_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setvar(SWITCH_3, 100)
            case 4:
                setmetatile(WALL_4_PART_1_X, WALL_4_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setmetatile(WALL_4_PART_2_X, WALL_4_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setvar(SWITCH_4, 100)
            case 5:
                setmetatile(WALL_5_PART_1_X, WALL_5_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setmetatile(WALL_5_PART_2_X, WALL_5_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setvar(SWITCH_5, 100)
            case 6:
                setmetatile(WALL_6_PART_1_X, WALL_6_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setmetatile(WALL_6_PART_2_X, WALL_6_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
                setvar(SWITCH_6, 100)
        }
        if(var(SWITCH_1) == 100){
            setmetatile(WALL_1_PART_1_X, WALL_1_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
            setmetatile(WALL_1_PART_2_X, WALL_1_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
            setmetatile(WALL_1_PART_3_X, WALL_1_PART_3_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
            setmetatile(WALL_1_PART_4_X, WALL_1_PART_4_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
        }
        if(var(SWITCH_2) == 100){
            setmetatile(WALL_2_PART_1_X, WALL_2_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
            setmetatile(WALL_2_PART_2_X, WALL_2_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
        }
        if(var(SWITCH_3) == 100){
            setmetatile(WALL_3_PART_1_X, WALL_3_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
            setmetatile(WALL_3_PART_2_X, WALL_3_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
        }
        if(var(SWITCH_4) == 100){
            setmetatile(WALL_4_PART_1_X, WALL_4_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
            setmetatile(WALL_4_PART_2_X, WALL_4_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
        }
        if(var(SWITCH_5) == 100){
            setmetatile(WALL_5_PART_1_X, WALL_5_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
            setmetatile(WALL_5_PART_2_X, WALL_5_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
        }
        if(var(SWITCH_6) == 100){
            setmetatile(WALL_6_PART_1_X, WALL_6_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
            setmetatile(WALL_6_PART_2_X, WALL_6_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
        }
    }
}

script LatiosIsland_Switch1{
    if(var(SWITCH_1) == 100){
        release
        end
    }
    getobjectxy(VAR_BOULDER_ID)
    if(var(ROCK_X) == SWITCH_1_X && var(ROCK_Y) == SWITCH_1_Y){
        copyobjectxytoperm(VAR_BOULDER_ID)
        setflag(FLAG_LATIOSISLE_PUZZLE1_SOLVED)
    }
    setmetatile(WALL_1_PART_1_X, WALL_1_PART_1_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
    setmetatile(WALL_1_PART_2_X, WALL_1_PART_2_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
    setmetatile(WALL_1_PART_3_X, WALL_1_PART_3_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
    setmetatile(WALL_1_PART_4_X, WALL_1_PART_4_Y, METATILE_LatiIsles_LI_BarrierDown, 0)
    setmetatile(SWITCH_1_X, SWITCH_1_Y, METATILE_LatiIsles_LatiasIsland_SwitchDown, FALSE)
	playse(SE_M_STRENGTH)
	special(DrawWholeMapView)
	waitse
	setvar(SWITCH_1, 100)
	release
}
