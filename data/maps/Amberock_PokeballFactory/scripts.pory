script Amberock_Factory_MainRocket{
    lock
    delay(15)
    playse(SE_PIN)
    switch(var(VAR_ROCKET_DIR)){
        case DIR_NORTH:
            turnobject(VAR_ROCKET_ID, DIR_NORTH)
        case DIR_WEST:
            turnobject(VAR_ROCKET_ID, DIR_WEST)
        case DIR_EAST:
            turnobject(VAR_ROCKET_ID, DIR_EAST)
        case DIR_SOUTH:
            turnobject(VAR_ROCKET_ID, DIR_SOUTH)
    }
    // turnobject(VAR_ROCKET_ID, VAR_ROCKET_DIR)
    applymovement(VAR_ROCKET_ID, ExclamationMark)
    waitmovement(0)
    delay(60)
    msgbox(GetBackToWork)
    closemessage
    switch(var(VAR_WARP_ID)){
        case 2:
            warpsilent(MAP_AMBEROCK_POKEBALL_FACTORY, 2)
        case 4:
            warpsilent(MAP_AMBEROCK_POKEBALL_FACTORY, 4)
        case 5:
            warpsilent(MAP_AMBEROCK_POKEBALL_FACTORY, 5)
        case 6:
            warpsilent(MAP_AMBEROCK_POKEBALL_FACTORY, 6)
        case 7:
            warpsilent(MAP_AMBEROCK_POKEBALL_FACTORY, 7)
        case 8:
            warpsilent(MAP_AMBEROCK_POKEBALL_FACTORY, 8)
    }
    // warpsilent(MAP_AMBEROCK_POKEBALL_FACTORY, VAR_WARP_ID)
    waitstate
}
text GetBackToWork{
    "Where do you think you're going?\n"
    "Get back to work!"
}

script FactoryEmployee_Basement{
    msgbox(FactoryEmployee_Basement_Text, MSGBOX_SIGN)
}
text FactoryEmployee_Basement_Text{
    "These look to be employees\n"
    "of the factory.\p"
    "They seem unharmed."
}

script TooCloseToProton{
    setvar(VAR_ROCKET_ID, 4)
    setvar(VAR_ROCKET_DIR, DIR_EAST)
    setvar(VAR_WARP_ID, 2)
    goto(Amberock_Factory_MainRocket)
}

script Factory_KrokorokPetrelCutScene{
    lock
    delay(15)
    addobject(PETREL_OBJ)
    applymovement(PETREL_OBJ, moves(delay_16 * 3 walk_down walk_in_place_fast_right))
    waitmovement(0)
    delay(16)
    msgbox(Petrel_MoveItGuys)
    turnobject(38, DIR_WEST)
    msgbox(Sorry_Petrel)
    closemessage
    delay(16)
    applymovement(PETREL_OBJ, moves(walk_up set_invisible))
    applymovement(37, Factory_RocketGuardLeaves2)
    applymovement(38, Factory_RocketGuardLeaves)
    waitmovement(0)
    removeobject(PETREL_OBJ)
    removeobject(37)
    removeobject(38)
    delay(16)
    msgbox(ThatsPetrel)
    msgbox(AfterPapers)
    release
    setvar(VAR_AMBEROCK_STORY, STORY_AMBEROCK_FOUND_PETREL)
}

movement Factory_RocketGuardLeaves{
    delay_16
    walk_left * 4
    walk_up
    delay_4
    set_invisible
}
movement Factory_RocketGuardLeaves2{
    delay_16
    walk_left * 5
    walk_up
    delay_4
    set_invisible
}

text Petrel_MoveItGuys{
    "???: Hey, you two knuckleheads!\p"
    "Come with me to the office and see\n"
    "if you can figure out what these\l"
    "fancy research papers say!"
}
text Sorry_Petrel{
    "Yes boss!\n"
    "Right away, boss!"
}
text ThatsPetrel{
    "Clay: That's Petrel,\n"
    "one of the Rocket Executives.\p"
    "He stands above grunts, but I doubt\n"
    "he's the mastermind of this operation.\p"
    "Let's keep looking."
}
text AfterPapers{
    "You're here because you were tasked\n"
    "with retrieving those papers?\p"
    "Don't worry, you can get them\n"
    "once we're done.\l"
    "I doubt they're going anywhere."
}

script Amberock_Factory_Generator{
    if(flag(FLAG_DISGUISED_AS_KROKOROK)){
        if(var(VAR_AMBEROCK_STORY) >= STORY_AMBEROCK_FOUND_GIOVANNI){
            if(msgbox(OrderKrokorokDestroy, MSGBOX_YESNO) == TRUE){
                msgbox(KrokorokBeginsRampage)
                closemessage
                fadescreen(FADE_TO_BLACK)
                msgbox(KrokorokDestroysGenerator)
                closemessage
                clearflag(FLAG_DISGUISED_AS_KROKOROK)
                setflag(FLAG_SYS_B_DASH)
                setvar(VAR_AMBEROCK_STORY, STORY_AMBEROCK_CUT_ELECTRICITY)
                warpsilentnofadeout(MAP_AMBEROCK_TOWN, 30, 21)
                waitstate
            }
            release
            end
        }
        else{
            msgbox(CompleteClaysObjective, MSGBOX_SIGN)
        }
    }
    else{
        msgbox(BustedGenerator, MSGBOX_SIGN)
    }
}

script MsgFromClay{
    msgbox(MsgFromClay_Text, MSGBOX_SIGN)
    setflag(FLAG_MSG_FROM_CLAY)
    release
}
text MsgFromClay_Text{
    "Clay: Oh, while we're here,\n"
    "you may wanna grab any items\l"
    "you see lying around.\p"
    "It's better we confiscate everything\n"
    "now, rather than letting Team Rocket\l"
    "simply take them with 'em."
}

text OrderKrokorokDestroy{
    "Order the Krokorok to disable\n"
    "the generator?"
}
text KrokorokBeginsRampage{
    "The Krokorok starts gnawing\n"
    "on the cables…"
}
text KrokorokDestroysGenerator{
    "The entire facility goes dark, and\n"
    "Krokorok returns back to the group."
}
text CompleteClaysObjective{
    "Volkner: This is the main\n"
    "generator of the facility.\p"
    "We can command the Krokorok to gnaw\n"
    "on some cables to cause a blackout,\l"
    "but first, we should finish the other\l"
    "objectives."
}
text BustedGenerator{
    "(UNUSED)its a busted gen"
}

script Amberock_Crate{
    msgbox(Amberock_Crate_Text, MSGBOX_SIGN)
}
text Amberock_Crate_Text{
    "It's a light enough crate the\n"
    "Krokorok can push around with ease."
}

script KrokBall1{
    setvar(VAR_TEMP_4, ITEM_MAX_ELIXIR)
    goto(KrokBallMain)
}
script KrokBall2{
    setvar(VAR_TEMP_4, ITEM_X_ATTACK)
    goto(KrokBallMain)
}
script KrokBall3{
    setvar(VAR_TEMP_4, ITEM_HYPER_POTION)
    goto(KrokBallMain)
}
script KrokBallMain{
    lock
	waitse
    playfanfare(MUS_OBTAIN_ITEM)
	removeobject(VAR_LAST_TALKED)
    bufferitemname(STR_VAR_2, VAR_TEMP_4)
    message(KrokorokFoundItem)
	delay(10)
	waitfanfare
	waitmessage
	msgbox(KrokorokCarriesItem)
	release
    end
}

text KrokorokFoundItem{
    "The Krokorok found one {STR_VAR_2}!"
}
text KrokorokCarriesItem{
    "The Krokorok is carrying the\n"
    "{STR_VAR_2} in its hands for now."
}