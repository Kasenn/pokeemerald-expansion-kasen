const X = VAR_0x8001
const Y = VAR_0x8002
const MAIN_BOULDER = 35
const VAR_ROCKET_ID = VAR_TEMP_1
const VAR_ROCKET_DIR = VAR_TEMP_2
const VAR_WARP_ID = VAR_TEMP_3
const FLAG_GUARD_ROCKETS = FLAG_TEMP_1
const FLAG_PETREL = FLAG_TEMP_2
const PETREL_OBJ = 39

mapscripts Amberock_PokeballFactory_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        if(flag(FLAG_DISGUISED_AS_KROKOROK)){
            setflag(FLAG_TEMP_HIDE_FOLLOWER)
            setflag(FLAG_SYS_USE_STRENGTH)
            setflag(FLAG_PETREL)
        }
        if(var(VAR_AMBEROCK_STORY) >= STORY_AMBEROCK_FOUND_PETREL){
            setflag(FLAG_GUARD_ROCKETS)
        }
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[
        VAR_TEMP_3, 0: SetPlayerKrokorokModel
    ]
    MAP_SCRIPT_ON_FRAME_TABLE[
        VAR_BOULDER_ID, MAIN_BOULDER: Factory_DoBoulderCheck
    ]
}

script Factory_DoBoulderCheck{
    getobjectxy(MAIN_BOULDER)
    if(var(Y) != 32){
        setvar(VAR_BOULDER_ID, 0)
    }
    else{
        safefollow
        if(var(X) == 20){
            applymovement(MAIN_BOULDER, moves(walk_fast_left * 9))
        }
        else{
            applymovement(MAIN_BOULDER, moves(walk_fast_left * 10))
        }
        waitmovement(0)
        playse(SE_M_STRENGTH)
        setobjectxy(MAIN_BOULDER, 11, 32)
        setobjectxyperm(MAIN_BOULDER, 11, 32)
        setvar(VAR_BOULDER_ID, 0)
    }
    release
}

script Factory_BusyKrokorok{
    msgbox(Factory_BusyKrokorok_Text)
    release
}
text Factory_BusyKrokorok_Text{
    "The Krokorok seems busy scavenging\n"
    "through the boxes."
}

