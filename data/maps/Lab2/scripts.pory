const BALL_ROWLET = FLAG_TEMP_1
const BALL_TORCHIC = FLAG_TEMP_2
const BALL_PIPLUP = FLAG_TEMP_3
const FOLLOWER_TRIGGER = FLAG_TEMP_4
const ALTERNATIVE_DIRECTION = FLAG_TEMP_5
const STARTER = VAR_TEMP_3

mapscripts Lab2_MapScripts{ 
    MAP_SCRIPT_ON_TRANSITION{
        // Handle ball visibility
        if(var(VAR_PEARLWOOD_TOWN_STATE) >= STORY_PEARLWOOD_RIVAL_FOUGHT_IN_MEADOW){
            setflag(BALL_ROWLET)
            setflag(BALL_TORCHIC)
            setflag(BALL_PIPLUP)
        }
        elif(flag(FLAG_SYS_POKEMON_GET)){
            switch(var(VAR_STARTER_MON)){
            case SPECIES_ROWLET:
                setflag(BALL_ROWLET)
            case SPECIES_TORCHIC:
                setflag(BALL_TORCHIC)
            case SPECIES_PIPLUP:
                setflag(BALL_PIPLUP)
            }
        }
        // Handle rival appearance and visibility
        if(var(VAR_PEARLWOOD_TOWN_STATE) != STORY_PEARLWOOD_RIVAL_FOUGHT_IN_MEADOW
        || var(VAR_PEARLWOOD_TOWN_STATE) != STORY_PEARLWOOD_MEGA_RING_OBTAINED){
            setflag(FLAG_HIDE_LAB_RIVAL)
        }
        else{
            call(SetupRivalGfxId)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_RECEIVED_RUNNING_SHOES:       Lab_Intro
        VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_MET_RIVAL:                    Lab_Intro
        VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_RIVAL_FOUGHT_IN_MEADOW:       Lab_DexGet
        VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_MEGA_RING_OBTAINED:           Lab_GetMegaStone
    ]
}

script Lab_Intro{
    waitmove(0xFF, Walk6Up)
    lockall
    msgbox(Lab_Intro_Speech, MSGBOX_AUTOCLOSE)
    delay(20)
    turnobject(LOCALID_LAB_BIRCH, DIR_EAST)
    delay(20)
    msgbox(Lab_Intro_Speech2, MSGBOX_AUTOCLOSE)
    setvar(VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_PROF_INTRO)
    release
}

script Lab_Ball_Rowlet{
    setvar(STARTER, SPECIES_ROWLET)
    goto(Lab_BallMain)
}
script Lab_Ball_Torchic{
    setvar(STARTER, SPECIES_TORCHIC)
    goto(Lab_BallMain)
}
script Lab_Ball_Piplup{
    setvar(STARTER, SPECIES_PIPLUP)
    goto(Lab_BallMain)
}
script Lab_BallMain{
    if(flag(FLAG_SYS_POKEMON_GET)){
        msgbox("You already received a Pokémon.", MSGBOX_SIGN)
        end
    }
    lock
    waitse
    playmoncry(STARTER, CRY_MODE_NORMAL)
    defaultmonpic(STARTER)
    waitmoncry
    bufferspeciesname(STR_VAR_1, STARTER)
    if(msgbox("Do you want to choose {STR_VAR_1}?", MSGBOX_YESNO) == FALSE){
        hidemonpic
        msgbox(Lab_NotChosen, MSGBOX_AUTOCLOSE)
        end
    }
    givemon(STARTER, 5)
    playfanfare(MUS_OBTAIN_ITEM)
    message("{PLAYER} received the {STR_VAR_1}!")
    waitmessage
    waitfanfare
    removeobject(VAR_LAST_TALKED)
    switch(var(STARTER)){
        case SPECIES_ROWLET:
            setvar(VAR_STARTER_MON, SPECIES_ROWLET)
        case SPECIES_TORCHIC:
            setvar(VAR_STARTER_MON, SPECIES_TORCHIC)
        case SPECIES_PIPLUP:
            setvar(VAR_STARTER_MON, SPECIES_PIPLUP)
    }
    setflag(FLAG_SYS_POKEMON_GET)
    setflag(FLAG_HEAL_AFTER_BATTLE)     // Janky way to make sure the player can't access the follower party menu too early
    setflag(FOLLOWER_TRIGGER)
    setvar(VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_PKMN_OBTAINED)
    msgbox("Do you want to give a nickname\nto your new Pokémon?", MSGBOX_YESNO)
    hidemonpic
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
    callnative(UpdateFollowingPokemon)
    release
}

script Lab_NoLeave{
    lock
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}You haven't chosen a Pokémon yet!", MSGBOX_AUTOCLOSE)
    waitmove(OBJ_EVENT_ID_PLAYER, Walk1Up)
    release
}

script Lab_FollowerEvent2{
    setflag(ALTERNATIVE_DIRECTION)
    goto(Lab_FollowerEvent)
}

script Lab_FollowerEvent{
    safefollow
    unlockfollowermovement
    lock
    playse(SE_PIN)
    if(flag(ALTERNATIVE_DIRECTION)){
        turnobject(LOCALID_LAB_BIRCH, DIR_NORTH)
    }
    else{
        turnobject(LOCALID_LAB_BIRCH, DIR_EAST)
    }
    waitmove(LOCALID_LAB_BIRCH, ExclamationMark)
    delay(48)
    msgbox(BirchSurprised)
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}You can use the party menu to set\na preferred Pokémon, withdraw your\lcurrent one, or let another one out.", MSGBOX_AUTOCLOSE)
    clearflag(FOLLOWER_TRIGGER)
    clearflag(FLAG_HEAL_AFTER_BATTLE)
}

script Lab_DexGet{
    safefollow
    waitmove(OBJ_EVENT_ID_PLAYER, Walk6Up)
    unlockfollowermovement
    lock
    if(checkplayergender == MALE){
        msgbox(Lab_DexTalkMayA)
        msgbox(Lab_DexTalkMayB)
        msgbox(Lab_DexTalkMayC)
        msgbox(Lab_DexTalkMayD)
        msgbox(Lab_DexTalkMayE)
        msgbox(Lab_DexTalkMayF)
        msgbox(Lab_DexTalkMayG)
        msgbox(Lab_DexTalkMayH, MSGBOX_AUTOCLOSE)
    }
    if(var(VAR_RESULT) == FEMALE){
        msgbox(Lab_DexTalkBrendanA)
        msgbox(Lab_DexTalkBrendanB)
        msgbox(Lab_DexTalkBrendanC)
        msgbox(Lab_DexTalkBrendanD)
        msgbox(Lab_DexTalkBrendanE)
        msgbox(Lab_DexTalkBrendanF)
        msgbox(Lab_DexTalkBrendanG)
        msgbox(Lab_DexTalkBrendanH, MSGBOX_AUTOCLOSE)
    }
    playfanfare(MUS_OBTAIN_TMHM)
    message("Obtained the Pokédex!")
    waitmessage
    waitfanfare
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_EAST)
    turnobject(LOCALID_LAB_RIVAL, DIR_WEST)
    msgbox("{RIVAL}: Here, you can have\nthese as well.")
    giveitem(ITEM_POKE_BALL, 5)
    msgbox("{RIVAL}: Now you can start catching\nyour own Pokémon and we can see which\lof us can fill our Pokédex faster!")
    if(checkplayergender == MALE){
        msgbox("Last one out the door is a rotten egg!", MSGBOX_AUTOCLOSE)
    }
    else{
        msgbox("Come on, let's go catch some Pokémon!", MSGBOX_AUTOCLOSE)
    }
    applymovement(OBJ_EVENT_ID_FOLLOWER, LabFaceDown)
	applymovement(OBJ_EVENT_ID_PLAYER, LabFaceDown)
	applymovement(LOCALID_LAB_RIVAL, Lab_Movement_RivalExit1)
	waitmovement(0)
    delay(60)
	removeobject(LOCALID_LAB_RIVAL)
	savebgm(MUS_DUMMY)
    turnobject(OBJ_EVENT_ID_FOLLOWER, DIR_NORTH)
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)
	fadedefaultbgm
    delay(25)
    msgbox("Prof. Birch: Sigh…\pSometimes I wonder\nwhere {RIVAL} gets all that energy…", MSGBOX_AUTOCLOSE)
    special(SetUnlockedPokedexFlags)
    setflag(FLAG_SYS_POKEDEX_GET)
    setvar(VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_DEX_OBTAINED)
}

script Lab_GetMegaStone{
    safefollow
    applymovement(OBJ_EVENT_ID_PLAYER, Walk6Up)
    waitmovement(0)
    if(flag(FLAG_HIDE_LAB_RIVAL)){
        msgbox(LabMegaStonesWithoutRival)
    }
    else{
        msgbox(LabMegaStones)
    }
    closemessage
    if(flag(FLAG_CORALGROVE_TRADE_COMPLETED)){
        playse(SE_PIN)
        applymovement(LOCALID_LAB_BIRCH, Common_Movement_QuestionMark)
        waitmovement(0)
        delay(30)
        msgbox(TradedAwayStarter, MSGBOX_AUTOCLOSE)
        closemessage
    }
    switch(var(VAR_STARTER_MON)){
        case SPECIES_ROWLET:
            giveitem(ITEM_DECIDUEITE)
        case SPECIES_TORCHIC:
            giveitem(ITEM_BLAZIKENITE)
        case SPECIES_PIPLUP:
            giveitem(ITEM_EMPOLEONITE)
    }
    if(flag(FLAG_RECEIVED_CAPSULE)){
        setvar(VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_MEGA_EVENT_COMPLETED)
    }
    else{
        setvar(VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_MEGA_STONE_OBTAINED)
    }
    if(!flag(FLAG_HIDE_LAB_RIVAL)){
        closemessage
        delay(24)
        waitmove(LOCALID_LAB_BIRCH, ProfBackAndForth)
        applymovement(LOCALID_LAB_RIVAL, Common_Movement_WalkInPlaceFasterLeft)
        waitmove(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
        if(checkplayergender == MALE){
            msgbox(GonnaTakeMyLeave_May)
        }
        else{
            msgbox(GonnaTakeMyLeave_Brendan)
        }
        waitmove(LOCALID_LAB_RIVAL, Common_Movement_WalkInPlaceFasterUp)
        msgbox(ThanksDadBirch, MSGBOX_AUTOCLOSE)
        applymovement(LOCALID_LAB_RIVAL, Walk7Down)
        applymovement(OBJ_EVENT_ID_PLAYER, TurnPlayer)
        waitmovement(LOCALID_LAB_RIVAL)
        removeobject(LOCALID_LAB_RIVAL)
    }
    if(flag(FLAG_Q33_PROF_BIRCH_MEGASTONE_START)){
        completequest(FLAG_Q33_PROF_BIRCH_MEGASTONE_COMPLETE)
        special(ShowJournalPopupRemove)
    }
    release
}

script Lab_Birch{
    switch(var(VAR_PEARLWOOD_TOWN_STATE)){
        case STORY_PEARLWOOD_PROF_INTRO:
            msgbox(PickABall, MSGBOX_NPC)
        case STORY_PEARLWOOD_PKMN_OBTAINED:
        case STORY_PEARLWOOD_BROTHER_FOUGHT:
        case STORY_PEARLWOOD_GIVEN_GOODBYE_TO_MOM:
        case STORY_PEARLWOOD_RIVAL_FOUGHT_IN_MEADOW:
            msgbox(TakeCareOfPokemon, MSGBOX_NPC)
        case STORY_PEARLWOOD_GET_MEGA_STONE_LATER:
            call(Lab_GetMegaStoneLater)
        case STORY_PEARLWOOD_MEGA_STONE_OBTAINED:
            msgbox(YourFatherIsInTown, MSGBOX_NPC)
            if(!flag(FLAG_Q34_DADS_HOME_START)){
                startquest(FLAG_Q34_DADS_HOME_START)
                special(ShowJournalPopupAdd)
            }
        case STORY_PEARLWOOD_MEGA_EVENT_COMPLETED:
        case STORY_PEARLWOOD_DEX_OBTAINED:
        case STORY_PEARLWOOD_MEGA_RING_OBTAINED:
            call(ProfBirch_EventScript_RatePokedexOrRegister)
    }
    release
}

script Lab_GetMegaStoneLater{
    lock
    faceplayer
    msgbox(HeresYourStoneNow)
    switch(var(VAR_STARTER_MON)){
        case SPECIES_ROWLET:
            giveitem(ITEM_DECIDUEITE)
        case SPECIES_TORCHIC:
            giveitem(ITEM_BLAZIKENITE)
        case SPECIES_PIPLUP:
            giveitem(ITEM_EMPOLEONITE)
    }
    if(flag(FLAG_RECEIVED_CAPSULE)){
        setvar(VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_MEGA_EVENT_COMPLETED)
    }
    else{
        setvar(VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_MEGA_STONE_OBTAINED)
    }
}

movement SpawnFollower{
    set_visible
    exit_pokeball
}
movement Lab_Movement_RivalExit1{
	player_run_down * 3
	player_run_left * 1
    player_run_down * 5
}
movement LabFaceDown{
	delay_16
	walk_in_place_faster_down
}
movement ProfBackAndForth{
    walk_right
    walk_in_place_faster_down
    delay_16 * 6
    walk_left
    walk_in_place_faster_down
    step_end
}
movement TurnPlayer{
    walk_in_place_faster_right
    walk_in_place_faster_down
}

text Lab_Intro_Speech{
    "Prof. Birch: Hello!\n"
    "You must be {PLAYER}!\p"
    "As you may know, it is customary in\n"
    "this town for every young person to\l"
    "be given their very first Pokémon.\p"
    "Some people use this opportunity to\n"
    "go on a journey of self-discovery\l"
    "while some are content with\l"
    "where they are now.\p"
    "What you do with your Pokémon is\n"
    "your decision."
}

text Lab_Intro_Speech2{
    "Over there on the table lies three\n"
    "Poké Balls. Each of them stores\l"
    "some very rare Pokémon.\p"
    "You may now go and choose one of\n"
    "them as your own.\p"
    "You may only choose one so make\n"
    "sure you decide carefully!"
}
text BirchSurprised{
    "Prof. Birch: Oh my!\p"
    "I knew these little fellas were\n"
    "energetic, but I never expected one\l"
    "to bust out of its ball like that!\p"
    "Now that you two are partners,\n"
    "I'm sure it will go back inside\l"
    "its ball if you simply ask it nicely."
}
text Lab_NotChosen{
    "Take your time."
}
text Lab_DexTalkMayA{
    "Prof. Birch: {RIVAL}, {PLAYER},\n"
    "is there something you need?"
}
text Lab_DexTalkMayB{
    "{RIVAL}: Oh boy, is there…\p"
    "You gave {PLAYER} a Pokémon but\n"
    "never gave him a Pokédex, dad!\p"
    "How do you expect him to become\n"
    "a great trainer without one?!"
}
text Lab_DexTalkMayC{
    "Prof. Birch: Oh, it must've\n"
    "slipped my mind…"
}
text Lab_DexTalkMayD{
    "{RIVAL}: Slipped your mind?!\n"
    "You're a Pokémon professor!\p"
    "Surely you realize that giving one to\n"
    "{PLAYER} helps your research as well?"
}
text Lab_DexTalkMayE{
    "Prof. Birch: I know, I know.\n"
    "I'll get {PLAYER} one right away.\p"
    "Now, let's see…\p"
    "… … … …\p"
    "Ah, darn it.\p"
    "Looks like I don't have any extra\n"
    "lying around at this time…"
}
text Lab_DexTalkMayF{
    "{RIVAL}: Well we can't have {PLAYER}\n"
    "leaving empty-handed, now can we?!"
}
text Lab_DexTalkMayG{
    "Prof. Birch: Here, {PLAYER},\n"
    "you can have mine.\l"
    "I'll order myself a new one."
}
text Lab_DexTalkMayH{
    "{RIVAL}: Yay! Thanks, dad!"
}

text Lab_DexTalkBrendanA{
    "Prof. Birch: {RIVAL}, {PLAYER},\n"
    "is there something you need?"
}
text Lab_DexTalkBrendanB{
    "{RIVAL}: As a matter of fact, there is.\n"
    "You never gave {PLAYER} a Pokédex!\p"
    "How do you expect her to become\n"
    "a great trainer without one?"
}
text Lab_DexTalkBrendanC{
    "Prof. Birch: Oh, it must've\n"
    "slipped my mind…"
}
text Lab_DexTalkBrendanD{
    "{RIVAL}: Slipped your mind?\n"
    "Aren't you a Pokémon professor?\p"
    "Surely giving one to {PLAYER}\n"
    "helps your research as well."
}
text Lab_DexTalkBrendanE{
    "Prof. Birch: I know, I know.\n"
    "I'll get {PLAYER} one right away.\p"
    "Now, let's see…\p"
    "… … … …\p"
    "Ah, darn it.\p"
    "Looks like I don't have any extra\n"
    "lying around at this time…"
}
text Lab_DexTalkBrendanF{
    "{RIVAL}: Well we can't have {PLAYER}\n"
    "leaving empty-handed, now can we?"
}
text Lab_DexTalkBrendanG{
    "Prof. Birch: Yes, I know. {PLAYER},\n"
    "you can have mine.\l"
    "I'll order myself a new one."
}
text Lab_DexTalkBrendanH{
    "{RIVAL}: You're the best, dad!"
}
text LabMegaStones{
    "Prof. Birch: {RIVAL}, {PLAYER},\n"
    "what a pleasant surprise.\l"
    "I was hoping to see you two soon.\p"
    "Thanks to a colleague of mine, I have\n"
    "been able to do a lot of research on\l"
    "a phenomena called “Mega Evolution.”\p"
    "Not much is known about it here in\n"
    "Sinko, but thanks to Professor\l"
    "Sycamore of Kalos, I have been\l"
    "able to greatly further my research.\p"
    "This is where you two come in.\p"
    "One day, I happened upon a mysterious\n"
    "set of stones. I believe these stones\l"
    "to be Mega Stones, special evolution\l"
    "stones capable of triggering a Mega\l"
    "Evolution within certain Pokémon.\p"
    "I would like you two to test out my\n"
    "theory, and see if your Pokémon are\l"
    "able to somehow interact with these\l"
    "Mega Stones.\p"
    "I want you both to have a stone that\n"
    "I believe is related to the Pokémon\l"
    "I have given you."
}
text LabMegaStonesWithoutRival{
    "Prof. Birch: Oh, hello, {PLAYER}.\n"
    "what a pleasant surprise.\p"
    "I must say, I was expecting to see\n"
    "you here a bit earlier, but I digress.\p"
    "Thanks to a colleague of mine, I have\n"
    "been able to do a lot of research on\l"
    "a phenomena called “Mega Evolution.”\p"
    "Not much is known about it here in\n"
    "Sinko, but thanks to Professor\l"
    "Sycamore of Kalos, I have been\l"
    "able to greatly further my research.\p"
    "This is where you and {RIVAL} come in.\p"
    "One day, I happened upon a mysterious\n"
    "set of stones. I believe these stones\l"
    "to be Mega Stones, special evolution\l"
    "stones capable of triggering a Mega\l"
    "Evolution within certain Pokémon.\p"
    "I would like you to test out my\n"
    "theory, and see if your Pokémon is\l"
    "able to somehow interact with one of\l"
    "these Mega Stones.\p"
    "I already gave {RIVAL} a stone, and\n"
    "I want you to also have a stone that\n"
    "I believe is related to the Pokémon\l"
    "I have given you."
}
text TradedAwayStarter{
    "Prof. Birch: Oh, you haven't traded my\n"
    "magnanimous gift away, have you?\p"
    "Don't worry, I'm just kidding.\p"
    "I can still give you the stone that's\n"
    "associated with the Pokémon I gave you,\l"
    "but you'll have to figure out where to\l"
    "get the stone for the Pokémon you\l"
    "currently have by yourself.\p"
    "Maybe you could try checking with the\n"
    "person who traded you it originally?\p"
    "In any case, here you go."
}
text GonnaTakeMyLeave_May{
    "{RIVAL}: I can't wait to see this\n"
    "thing in action!\p"
    "You better train your Pokémon to use\n"
    "the stone, {PLAYER}!\p"
    "I don't want to hear you whining that\n"
    "you lost because you didn't know how\l"
    "to use Mega Evolution!"
}
text GonnaTakeMyLeave_Brendan{
    "{RIVAL}: I can't wait to see this\n"
    "thing in action!\p"
    "I hope you train your Pokémon to get\n"
    "the most out of that stone, {PLAYER}.\p"
    "I don't want to hear any complaints\n"
    "about how you lost because you didn't\l"
    "know how to Mega Evolve your Pokémon."
}
text ThanksDadBirch{
    "{RIVAL}: Thanks dad! I'm going to go\n"
    "and give this thing a try right away!"
}

text PickABall{
    "Prof. Birch: Go on, pick one of the\n"
    "balls from the table."
}
text TakeCareOfPokemon{
    "Prof. Birch: I hope you take\n"
    "good care of your new companion."
}
text YourFatherIsInTown{
    "Prof. Birch: Oh, I almost forgot!\n"
    "Your father is currently in town.\p"
    "I know he's a busy man. You may want\n"
    "to dash on home before he leaves."
}
text HeresYourStoneNow{
    "Prof. Birch: I hope you've made enough\n"
    "space in your bag to hold this stone."
}