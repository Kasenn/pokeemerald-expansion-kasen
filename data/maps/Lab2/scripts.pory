    "{RIVAL}: I can't wait to see this\n"
    "thing in action!\p"
    "You better train your Pokémon to use\n"
    "the stone, {PLAYER}!\p"
    "I don't want to hear you whining that\n"
    "you lost because you didn't know how\l"
    "to use Mega Evolution!"
}
text GonnaGoAhead_Brendan{
    "{RIVAL}: I can't wait to see this\n"
    "thing in action!\p"
    "Make sure you grab yours before you\n"
    "leave, {PLAYER}.\p"
    "I don't want to hear any complaints\n"
    "about how you lost because you didn't\l"
    "know how to Mega Evolve your Pokémon."
}
text GonnaTakeMyLeave_Brendan{
    "{RIVAL}: I can't wait to see this\n"
    "thing in action!\p"
    "I hope you train your Pokémon to get\n"
    "the most out of that stone, {PLAYER}.\p"
    "I don't want to hear any complaints\n"
    "about how you lost because you didn't\l"
    "know how to Mega Evolve your Pokémon."
}
text ThanksDadBirch{
    "{RIVAL}: Thanks dad! I'm going to go\n"
    "and give this thing a try right away!"
}

text PickABall{
    "Prof. Birch: Go on, pick one of the\n"
    "balls from the table."
}
text TakeCareOfPokemon{
    "Prof. Birch: I hope you take\n"
    "good care of your new companion."
}
text YourFatherIsInTown{
    "Prof. Birch: Oh, I almost forgot!\n"
    "Your father is currently in town.\p"
    "I know he's a busy man. You may want\n"
    "to dash on home before he leaves."
}
text HeresYourStoneNow{
    "Prof. Birch: I hope you've made enough\n"
    "space in your bag to hold this stone."
}
text ComeGetYourStoneLaterShort{
    "No, looks like your bag is still full.\p"
    "You will need to make some room in your\n"
    "bag before I can give this to you."
}

script Lab2_Birch{
    if(var(VAR_PEARLWOOD_TOWN_STATE) == STORY_PEARLWOOD_PROF_INTRO){
        msgbox(PickABall, MSGBOX_NPC)
    }
    elif(var(VAR_PEARLWOOD_TOWN_STATE) <= STORY_PEARLWOOD_DEX_OBTAINED){
        msgbox(TakeCareOfPokemon, MSGBOX_NPC)
    }
    elif(var(VAR_PEARLWOOD_TOWN_STATE) == STORY_PEARLWOOD_MEGA_STONE_OBTAINED){
        msgbox(YourFatherIsInTown, MSGBOX_NPC)
    }
    elif((var(VAR_PEARLWOOD_TOWN_STATE) == STORY_PEARLWOOD_GET_MEGA_STONE_LATER)){
        lock
        faceplayer
        msgbox(HeresYourStoneNow)
        if(checkitemspace(ITEM_DECIDUEITE) == FALSE){
            msgbox(ComeGetYourStoneLaterShort, MSGBOX_NPC)
            end
        }
        else{
            switch(var(VAR_STARTER_MON)){
                case 0:
                    giveitem(ITEM_DECIDUEITE)
                case 1:
                    giveitem(ITEM_BLAZIKENITE)
                case 2:
                    giveitem(ITEM_EMPOLEONITE)
            }
            waitse
            setvar(VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_MEGA_STONE_OBTAINED)
            if(var(VAR_PEARLWOOD_TOWN_STATE) == STORY_PEARLWOOD_MEGA_STONE_OBTAINED
            && flag(FLAG_RECEIVED_CAPSULE)){
                setvar(VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_MEGA_EVENT_COMPLETED)
            }
        }
    }
    else{
        call(ProfBirch_EventScript_RatePokedexOrRegister)
    }
    release
    end
}

script Lab2_Ball1{
    setvar(VAR_TEMP_3, SPECIES_ROWLET)
    goto(Lab_BallMain)
}
script Lab2_Ball2{
    setvar(VAR_TEMP_3, SPECIES_TORCHIC)
    goto(Lab_BallMain)
}
script Lab2_Ball3{
    setvar(VAR_TEMP_3, SPECIES_PIPLUP)
    goto(Lab_BallMain)
}
script Lab_BallMain{
    if(flag(FLAG_SYS_POKEMON_GET)){
        msgbox("You already received a Pokémon.", MSGBOX_SIGN)
        end
    }
    lock
    waitse
    playmoncry(VAR_TEMP_3, CRY_MODE_NORMAL)
    showmonpic(VAR_TEMP_3, 10, 3)
    waitmoncry
    bufferspeciesname(STR_VAR_1, VAR_TEMP_3)
    msgbox("Do you want to choose {STR_VAR_1}?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == FALSE){
        hidemonpic
        msgbox(Lab2_NotChosen)
        release
        end
    }
    givemon(VAR_TEMP_3, 5)
    playfanfare(MUS_OBTAIN_ITEM)
    message("{PLAYER} received the {STR_VAR_1}!")
    waitmessage
    waitfanfare
    setobjectxy(VAR_LAST_TALKED, 20, 0)
    setobjectxyperm(VAR_LAST_TALKED, 20, 0)
    applymovement(VAR_LAST_TALKED, Walk1Up)
    switch(var(VAR_TEMP_3)){
        case SPECIES_ROWLET:
            setvar(VAR_STARTER_MON, 0)
        case SPECIES_TORCHIC:
            setvar(VAR_STARTER_MON, 1)
        case SPECIES_PIPLUP:
            setvar(VAR_STARTER_MON, 2)
    }
    setflag(FLAG_SYS_POKEMON_GET)
    setflag(FLAG_HEAL_AFTER_BATTLE)
    setvar(VAR_TEMP_5, 1)
    setvar(VAR_PEARLWOOD_TOWN_STATE, STORY_PEARLWOOD_PKMN_OBTAINED)
    msgbox("Do you want to give a nickname\nto your new Pokémon?", MSGBOX_YESNO)
    hidemonpic
    if(var(VAR_RESULT) == YES){
        call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
    }
    callnative(UpdateFollowingPokemon)
    release
}
script Lab_FollowerEvent2{
    setflag(FLAG_TEMP_10)
    goto(Lab_FollowerEvent)
}
script Lab_FollowerEvent{
    safefollow
    unlockfollowermovement
    lockall
    playse(SE_PIN)
    if(flag(FLAG_TEMP_10)){
        turnobject(PROF, DIR_NORTH)
    }
    else{
        turnobject(PROF, DIR_EAST)
    }
    applymovement(PROF, ExclamationMark)
    waitmovement(0)
    delay(48)
    msgbox(BirchSurprised)
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}You can use the party menu to set\na preferred Pokémon, withdraw your\lcurrent one, or let another one out.")
    setvar(VAR_TEMP_5, 0)
    clearflag(FLAG_HEAL_AFTER_BATTLE)
    release
}
text BirchSurprised{
    "Prof. Birch: Oh my!\p"
    "I knew these little fellas were\n"
    "energetic, but I never expected one\l"
    "to bust out of its ball like that!\p"
    "Now that you two are partners,\n"
    "I'm sure it will go back inside\l"
    "its ball if you simply ask it nicely."
}

text Lab2_NotChosen{
    "Take your time."
}
script Lab2_NoLeave{
    lock
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}You haven't chosen a Pokémon yet!")
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Walk1Up)
    waitmovement(0)
    release
}

movement SpawnFollower{
    set_visible
    exit_pokeball
}
movement Lab2_Movement_RivalExit1{
	player_run_down * 3
	player_run_left * 1
    player_run_down * 5
}
movement Lab2FaceDown{
	delay_16
	walk_in_place_faster_down
}
movement ProfBackAndForth{
    walk_right
    walk_in_place_faster_down
    delay_16 * 6
    walk_left
    walk_in_place_faster_down
    step_end
}
movement RivalLeavesLab{
    walk_down * 7
}
movement TurnPlayer{
    walk_in_place_faster_right
    walk_in_place_faster_down
}
