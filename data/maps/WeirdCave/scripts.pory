mapscripts WeirdCave_MapScripts{
    MAP_SCRIPT_ON_LOAD: WeirdCaveHideDoor
    MAP_SCRIPT_ON_TRANSITION: SetRockVar
}
script WeirdCaveHideDoor{
    if(!flag(FLAG_WEIRDCAVESOLVED)){
        setmetatile(6, 5, 0x219, TRUE)
        setmetatile(7, 5, 0x219, TRUE)
        setmetatile(8, 5, 0x219, TRUE)
        setmetatile(6, 6, 0x219, TRUE)
        setmetatile(7, 6, 0x219, TRUE)
        setmetatile(8, 6, 0x219, TRUE)
    }
    switch(var(VAR_WEIRDCAVEROCKFORMATION))
    {
        case 0:
            setmetatile(5, 14, 0x211, FALSE)
            setmetatile(9, 8, 0x211, FALSE)
            setmetatile(5, 11, 0x211, FALSE)
            setmetatile(9, 14, 0x211, FALSE)
            setmetatile(5, 8, 0x211, FALSE)
            setmetatile(9, 11, 0x211, FALSE)
        case 1:
            setmetatile(5, 14, 0x211, FALSE)
        case 2:
            setmetatile(5, 11, 0x211, FALSE)
        case 3:
            setmetatile(9, 8, 0x211, FALSE)
        case 4:
            setmetatile(5, 8, 0x211, FALSE)
        case 5:
            setmetatile(9, 11, 0x211, FALSE)
        case 6:
            setmetatile(9, 14, 0x211, FALSE)
    }
    end
}
script SetRockVar{
    if(!flag(FLAG_WEIRDCAVESOLVED)){
        addvar(VAR_WEIRDCAVEROCKFORMATION, 1)
        if(var(VAR_WEIRDCAVEROCKFORMATION) == 7){
            setvar(VAR_WEIRDCAVEROCKFORMATION, 0)
        }
    }
    else{
        setvar(VAR_WEIRDCAVEROCKFORMATION, 10)
    }
}
script WeirdCaveTrigger1{
    if(var(VAR_TEMP_0) != 0){
        setvar(VAR_TEMP_0, 100)
    }
    else{
        setvar(VAR_TEMP_0, 1)
    }
    release
}
script WeirdCaveTrigger2{
    if(var(VAR_TEMP_0) != 1){
        setvar(VAR_TEMP_0, 100)
    }
    else{
        setvar(VAR_TEMP_0, 2)
    }
    release
}
script WeirdCaveTrigger3{
    if(var(VAR_TEMP_0) != 2){
        setvar(VAR_TEMP_0, 100)
    }
    else{
        setvar(VAR_TEMP_0, 3)
    }
    release
}
script WeirdCaveTrigger4{
    if(var(VAR_TEMP_0) != 3){
        setvar(VAR_TEMP_0, 100)
    }
    else{
        setvar(VAR_TEMP_0, 4)
    }
    release
}
script WeirdCaveTrigger5{
    if(var(VAR_TEMP_0) != 4){
        setvar(VAR_TEMP_0, 100)
    }
    else{
        setvar(VAR_TEMP_0, 5)
    }
    release
}
script WeirdCaveTrigger6{
    if(var(VAR_TEMP_0) != 5){
        setvar(VAR_TEMP_0, 100)
    }
    else{
        lock
        setflag(FLAG_WEIRDCAVESOLVED)
        setmetatile(6, 5, 0x20B, TRUE)
        setmetatile(7, 5, 0x20C, TRUE)
        setmetatile(8, 5, 0x20D, TRUE)
        setmetatile(6, 6, 0x213, TRUE)
        setmetatile(7, 6, 0x214, FALSE)
        setmetatile(8, 6, 0x215, TRUE)
        special(DrawWholeMapView)
        fadeoutbgm(0)
        delay(30)
        setvar(VAR_0x8004, 1)  // vertical pan
        setvar(VAR_0x8005, 1)  // horizontal pan
        setvar(VAR_0x8006, 8)  // num shakes
        setvar(VAR_0x8007, 5)  // shake delay
        special(ShakeCamera)
        waitstate
        delay(60)
        playse(SE_SWITCH)
        waitse
        delay(90)
        fadeinbgm(0)
        delay(30)
        release

    }
    release
}