    "How is the egg doing?\p"
    "… … …\p"
    "It hatched already?\n"
    "That's great to hear.\l"
    "I knew I chose a caring trainer."
}


script BasalekTown_RivalTrigger1{
    setvar(VAR_TEMP_2, 1)
    goto(BasalekTown_RivalScript)
}
script BasalekTown_RivalTrigger2{
    setvar(VAR_TEMP_2, 2)
    goto(BasalekTown_RivalScript)
}
script BasalekTown_RivalTrigger3{
    setvar(VAR_TEMP_2, 3)
    goto(BasalekTown_RivalScript)
}

script BasalekTown_RivalScript{
    lock
    safefollow
    getfollowerxy(X, Y)
    if(var(X) != 0){
        unlockfollowermovement
    }
	delay(5)
    opendoor(20, 15)
    waitdooranim
    addobject(OBJ_RIVAL)
    setobjectxy(OBJ_RIVAL, 20, 15)
    turnobject(OBJ_RIVAL, DIR_SOUTH)
    delay(16)
    applymovement(OBJ_RIVAL, Walk1Down)
    waitmovement(0)
    closedoor(20, 15)
    waitdooranim
    switch(var(VAR_TEMP_2)){
        case 1:
            applymovement(OBJ_RIVAL, moves(walk_right * 4, walk_up * 3, walk_in_place_fast_left))
            delay(48)
            applymovement(0xFF, moves(walk_in_place_fast_down))
            applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_down))
            unlockfollowermovement
            delay(64)
            applymovement(0xFF, moves(walk_in_place_fast_right))
            applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_right))
            unlockfollowermovement
        case 2:
            applymovement(OBJ_RIVAL, moves(walk_right * 5, walk_up * 3, walk_in_place_fast_left))
            delay(64)
            applymovement(0xFF, moves(walk_in_place_fast_down))
            applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_down))
            unlockfollowermovement
            delay(64)
            applymovement(0xFF, moves(walk_in_place_fast_right))
            applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_right))
            unlockfollowermovement
        case 3:
            applymovement(OBJ_RIVAL, moves(walk_right * 4, walk_up * 3, walk_in_place_fast_right))
            delay(64)
            applymovement(0xFF, moves(walk_in_place_fast_down))
            applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_down))
            unlockfollowermovement
            delay(48)
            applymovement(0xFF, moves(walk_in_place_fast_left))
            applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_left))
            unlockfollowermovement
    }
    waitmovement(OBJ_RIVAL)
    waitmovement(0xFF)
    delay(24)
    if(checkplayergender == MALE){
        if(flag(FLAG_RIVAL_MET_IN_BASALEK_MART)){ // bailing on rival
            if(flag(FLAG_RIVAL_HARBOR_ANGRY)){ // bailed 2nd time
                msgbox(BasaluffTown_May_2Bails)
            }
            else{ // bailed 1st time
                msgbox(BasaluffTown_May_1Bail)
            }
        }
        else{ // was not trying to bail
            msgbox(BasaluffTown_May_NoBails)
        }
        trainerbattle_no_intro(TRAINER_MAY_BASALEK_TOWN, BasalekMay_LostText)
        release
        if(flag(FLAG_SPECIAL_USED_MEGA_EVO_IN_BATTLE)){
            msgbox(BasaluffMay_PostBattle)
            msgbox(BasaluffMay_Goodbye)
        }
        else{
            msgbox(BasaluffMay_NoMegaPostBattle)
            msgbox(BasaluffMay_Goodbye2)
        }
    }
    else{
        if(flag(FLAG_RIVAL_MET_IN_BASALEK_MART)){ // bailing on rival
            if(flag(FLAG_RIVAL_HARBOR_ANGRY)){ // bailed 2nd time
                msgbox(BasaluffTown_Brendan_2Bails)
            }
            else{ // bailed 1st time
                msgbox(BasaluffTown_Brendan_1Bail)
            }
        }
        else{ // was not trying to bail
            msgbox(BasaluffTown_Brendan_NoBails)
        }
        trainerbattle_no_intro(TRAINER_BRENDAN_BASALEK_TOWN, BasalekBrendan_LostText)
        release
        if(flag(FLAG_SPECIAL_USED_MEGA_EVO_IN_BATTLE)){
            msgbox(BasaluffBrendan_PostBattle)
        }
        else{
            msgbox(BasaluffBrendan_NoMegaPostBattle)
        }
        msgbox(BasaluffBrendan_Goodbye)
    }
    closemessage
    safefollow
    switch(var(VAR_TEMP_2)){
        case 1:
            applymovement(OBJ_RIVAL, moves(walk_up, walk_right, walk_up, walk_right, walk_up, walk_right * 5))
        case 2:
            applymovement(OBJ_RIVAL, moves(walk_up, walk_right, walk_up, walk_right, walk_up, walk_right * 6))
        case 3:
            applymovement(OBJ_RIVAL, moves(walk_up, walk_right, walk_up, walk_right, walk_up, walk_right * 7))
            applymovement(0xFF, moves(delay_16 * 3, walk_in_place_fast_up, delay_16 * 4, walk_in_place_fast_right))
    }
    waitmovement(OBJ_RIVAL)
    waitmovement(0xFF)
    setflag(FLAG_RIVAL_MET_IN_BASALEK)
    removeobject(OBJ_RIVAL)
    release
}

movement TurnPlayerAndFollowerRight{
    delay_16 * 2
    walk_in_place_fast_right
}

text BasaluffTown_Brendan_NoBails{
    "{RIVAL}: Oh, hey {PLAYER}!\n"
    "It's been a while, huh?\p"
    "I was on my way to Route 17, but\n"
    "the weather was so unbearably humid\l"
    "that I just had to turn back and\l"
    "get myself some extra drinks for\l"
    "the journey.\p"
    "Anyway, enough about me.\p"
    "How about we have ourselves\n"
    "a Pokémon battle?\p"
    "I'm curious to see if you've mastered\n"
    "using the Mega Evolution technique."
}
text BasaluffTown_Brendan_1Bail{
    "{RIVAL}: You weren't trying to\n"
    "make a break for it while I was\l"
    "patiently waiting inside the Mart,\l"
    "were you?\p"
    "Well, I hope you're prepared,\n"
    "because here I come!"
}
text BasaluffTown_Brendan_2Bails{
    "{RIVAL}: I had a feeling you might\n"
    "be walking out on me, just like you did\l"
    "back at the Coralgrove Harbor.\p"
    "Well, you're not fooling me again.\n"
    "Get ready, because here I come!"
}
text BasaluffTown_May_NoBails{
    "{RIVAL}: Oh, hi {PLAYER}!\n"
    "Long time no see!\p"
    "I was on my way to Route 17,\n"
    "but  had to turn back just to\l"
    "get myself some extra drinks for\l"
    "the journey.\p"
    "I honestly don't know how people can\n"
    "even live in this humid atmosphere.\p"
    "Anyways, enough about me.\p"
    "How about we have ourselves\n"
    "a Pokémon battle?\p"
    "I'm curious to see if you've mastered\n"
    "using the Mega Evolution technique."
}
text BasaluffTown_May_1Bail{
    "{RIVAL}: You weren't trying to\n"
    "bail on me while I patiently waited\l"
    "for you inside the Mart?\p"
    "Well, I hope you've prepared yourself,\n"
    "because here I come!"
}
text BasaluffTown_May_2Bails{
    "{RIVAL}: Aha!\n"
    "I knew you'd try to bail on me!\p"
    "I'm not going to let you fool me\n"
    "like you fooled me back at the\l"
    "Coralgrove Harbor!\p"
    "Get ready, because here I come!"
}

script BasalekTown_LevelChecker{
    if(flag(FLAG_DAILY_BASALEK_CHECKER)){
        msgbox(BasalekTown_LevelChecker_ComeAgain, MSGBOX_NPC)
        end
    }
    lock
    faceplayer
    buffernumberstring(STR_VAR_1, VAR_BASALEK_LEVEL_CHECK)
    msgbox(BasalekTown_LevelChecker_NoMatch, MSGBOX_AUTOCLOSE)
    matchpartylevel(VAR_BASALEK_LEVEL_CHECK)
    if(var(VAR_RESULT) == FALSE){
        if(!flag(FLAG_Q37_BASALEK_LEVELMON_START)){
            startquest(FLAG_Q37_BASALEK_LEVELMON_START)
            special(ShowJournalPopupAdd)
        }
        end
    }
    msgbox(BasalekTown_LevelChecker_YesMatch)
    switch(var(VAR_BASALEK_LEVEL_REWARD)){
        case 0:
            giveitem(ITEM_MUSCLE_BAND)
        case 1:
            giveitem(ITEM_BINDING_BAND)
        case 2:
            giveitem(ITEM_FOCUS_BAND)
        case 3:
            giveitem(ITEM_CHOICE_BAND)
    }
    if(var(VAR_RESULT) == FALSE){
        goto(ZeBagIsFull)
    }
    setflag(FLAG_DAILY_BASALEK_CHECKER)
    addvar(VAR_BASALEK_LEVEL_REWARD, 1)
    if(var(VAR_BASALEK_LEVEL_REWARD) == 4){
        setvar(VAR_BASALEK_LEVEL_CHECK, 0)
    }
    msgbox(BasalekTown_LevelChecker_ComeAgain)
    if(flag(FLAG_Q37_BASALEK_LEVELMON_START) && !flag(FLAG_Q37_BASALEK_LEVELMON_COMPLETE)){
        completequest(FLAG_Q37_BASALEK_LEVELMON_COMPLETE)
        special(ShowJournalPopupRemove)
    }
    release
}

text BasalekTown_LevelChecker_NoMatch{
    "…I saw it!\n"
    "Today's number is {STR_VAR_1}!\p"
    "Show me a Pokémon that's Lv. {STR_VAR_1}.\n"
    "If you can, I'll reward you."
}
text BasalekTown_LevelChecker_YesMatch{
    "…Oh, now, hunh?!\p"
    "I see you have a Pokémon\n"
    "that is Lv. {STR_VAR_1}.\p"
    "Well, I'll be! How remarkable!\p"
    "I'll thank you for that visual treat\n"
