const X = VAR_TEMP_3
const Y = VAR_TEMP_4
const RIVAL_TRIGGER = VAR_TEMP_5
const OBJ_RIVAL = 10

mapscripts BasaluffTown_MapScripts{
    MAP_SCRIPT_ON_TRANSITION{
        setflag(FLAG_VISITED_BASALEK)
        call(SetupRivalGfxId)
        getplayerxy(X, Y)
        if(var(X) == 23 && var(Y) == 16){
            setvar(RIVAL_TRIGGER, 1)
        }
        if(var(RIVAL_TRIGGER) == 1){
            setobjectxyperm(OBJ_RIVAL, 24, 16)
            setobjectmovementtype(OBJ_RIVAL, MOVEMENT_TYPE_FACE_LEFT)
        }
        setvar(VAR_HOUR_OVERRIDE, 12)
    }
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[
        RIVAL_TRIGGER, 1{
            turnobject(0xFF, DIR_EAST)
        }
    ]
    MAP_SCRIPT_ON_FRAME_TABLE[
        RIVAL_TRIGGER, 1: BasaluffAutomaticRivalFight
    ]
}

script BasaluffAutomaticRivalFight{
    delay(30)
    setvar(RIVAL_TRIGGER, 0)
    if(checkplayergender == MALE){
        msgbox(BasaluffMay_LetsStart)
        trainerbattle_no_intro(TRAINER_MAY_BASALEK_TOWN, BasalekMay_LostText)
        if(flag(FLAG_SPECIAL_USED_MEGA_EVO_IN_BATTLE)){
            msgbox(BasaluffMay_PostBattle)
            msgbox(BasaluffMay_Goodbye)
        }
        else{
            msgbox(BasaluffMay_NoMegaPostBattle)
            msgbox(BasaluffMay_Goodbye2)
        }
    }
    else{
        msgbox(BasaluffBrendan_LetsStart)
        trainerbattle_no_intro(TRAINER_BRENDAN_BASALEK_TOWN, BasalekBrendan_LostText)
        if(flag(FLAG_SPECIAL_USED_MEGA_EVO_IN_BATTLE)){
            msgbox(BasaluffBrendan_PostBattle)
        }
        else{
            msgbox(BasaluffBrendan_NoMegaPostBattle)
        }
        msgbox(BasaluffBrendan_Goodbye)
    }
    closemessage
    safefollow
    applymovement(OBJ_RIVAL, moves(walk_up * 4, walk_right, walk_up, walk_right, walk_up, walk_right * 2))
    waitmovement(0)
    setflag(FLAG_RIVAL_MET_IN_BASALEK)
    removeobject(OBJ_RIVAL)
    release
}
text BasaluffMay_LetsStart{
    "{RIVAL}: Alright, this should be\n"
    "enough space for us to battle.\p"
    "Let's go!"
}
text BasalekMay_LostText{
    "Wow!\n"
	"{PLAYER}, you're strong!\p"
	"I was worried that you might be\n"
	"falling behind in your training."
}
text BasaluffMay_PostBattle{
    "{RIVAL}: Oh wow,\n"
    "That was a great battle!\p"
    "It's nice to see you put that Mega\n"
    "Ring into good use.\p"
    "Even if Korrina had only given me\n"
    "a ring, I'm not sure I could've\l"
    "still beaten you!"
}
text BasaluffMay_NoMegaPostBattle{
    "{RIVAL}: That was a great battle, but\n"
    "I must say, I'm a bit disappointed…\p"
    "We got these great gifts from\n"
    "my dad and Korrina, and you're\l"
    "just letting them collect dust.\p"
    "Or maybe, was it because I was so\n"
    "weak that you didn't see the need\l"
    "to use them in the first place…"
}
text BasaluffMay_Goodbye{
    "Anyways, I'm guessing you're\n"
    "heading to Frosthearth City to\l"
    "challenge the Pokémon Gym there?\p"
    "I'm heading that way as well,\n"
    "so maybe we'll meet again soon!\p"
    "Well, anyway, see you!"
}
text BasaluffMay_Goodbye2{
    "A-Anyways, I'm guessing you're\n"
    "heading to Frosthearth City to\l"
    "challenge the Pokémon Gym there?\p"
    "I'm heading that way as well,\n"
    "so maybe we'll meet again soon!\p"
    "Well, anyway, see you…"
}
text BasaluffBrendan_LetsStart{
    "{RIVAL}: Okay, this should be\n"
    "enough space for us to battle.\p"
    "Let's do this!"
}
text BasalekBrendan_LostText{
    "Hmm…\n"
	"I see you've been training hard.\p"
	"That stings a bit--I had a head start\n"
	"on you as a trainer…"
}
text BasaluffBrendan_PostBattle{
    "{RIVAL}: That was a great battle!\p"
    "It's nice to see you put that Mega\n"
    "Ring into good use.\p"
    "I'm not sure if I could've beaten\n"
    "you even if you did not have it."
}
text BasaluffBrendan_NoMegaPostBattle{
    "{RIVAL}: That was a great battle!\p"
    "Though I must admit,\n"
    "I'm a bit disappointed…\p"
    "We got this cool stuff from\n"
    "my dad and Korrina, so I was\l"
    "kind of expecting to see you\l"
    "use them in battle.\p"
    "Or perhaps, I was so weak that you\n"
    "didn't even see the need to use them\l"
