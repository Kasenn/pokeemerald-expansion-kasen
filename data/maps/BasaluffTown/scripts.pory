script BasalekTown_EggWoman{
	lock
	faceplayer
    checkdexmon(SPECIES_EEVEE)
    if(var(VAR_RESULT) == TRUE && !flag(FLAG_EEVEE_EGG_SHOWN)){
        setflag(FLAG_EEVEE_EGG_SHOWN)
        msgbox(BasalekTown_EggHatched, MSGBOX_AUTOCLOSE)
        end
    }
    if(flag(FLAG_RECEIVED_LAVARIDGE_EGG)){
        msgbox(BasalekTown_Text_EverySoOftenEggFoundAtDayCare, MSGBOX_AUTOCLOSE)
	    end
    }
    if(msgbox(BasalekTown_Text_HaveEggWillYouTakeIt, MSGBOX_YESNO) == FALSE){
        msgbox(BasalekTown_Text_AsYouWishThen, MSGBOX_AUTOCLOSE)
	    end
    }
	getpartysize
    if(var(VAR_RESULT) == PARTY_SIZE){
        msgbox(BasalekTown_Text_NoRoomForThisEgg, MSGBOX_AUTOCLOSE)
	    end
    }
	msgbox(BasalekTown_Text_HopeYoullWalkPlentyWithEgg)
	setflag(FLAG_RECEIVED_LAVARIDGE_EGG)
	playfanfare(MUS_OBTAIN_ITEM)
	message(BasalekTown_Text_ReceivedTheEgg)
	waitfanfare
	giveegg(SPECIES_EEVEE)
	release
}

text BasalekTown_Text_HaveEggWillYouTakeIt{
    "I recently found my Pokémon carrying\n"
    "this egg.\p"
    "In the past I would have been ecstatic,\n"
    "but I don't think I'm capable of taking\l"
    "care of any more Pokémon anymore.\p"
    "I saw your battle with your friend,\n"
    "and I must say, I'm very impressed.\p"
    "You seem like the type of person who\n"
    "takes good care of their Pokémon.\p"
	"What say you?\n"
	"Would you like to care for this egg?"
}

text BasalekTown_Text_HopeYoullWalkPlentyWithEgg{
	"Thank you!\n"
    "It warms my heart, knowing it will have\l"
    "someone caring for it."
}

text BasalekTown_Text_ReceivedTheEgg{
	"{PLAYER} received the Pokémon egg."
}
text BasalekTown_Text_NoRoomForThisEgg{
	"Oh? You've too many Pokémon.\n"
	"There's no room for this egg…"
}
text BasalekTown_Text_AsYouWishThen{
	"As you wish, then…\p"
	"If you have a change of heart about\n"
	"hatching this egg, I will be here."
}
text BasalekTown_Text_EverySoOftenEggFoundAtDayCare{
	"Every so often, an egg will be found at\n"
	"the Pokémon Day Care.\p"
	"Or at least that's how the rumor goes."
}
text BasalekTown_EggHatched{
    "How is the egg doing?\p"
    "… … …\p"
    "It hatched already?\n"
    "That's great to hear.\l"
    "I knew I chose a caring trainer."
}


script BasalekTown_RivalTrigger1{
    setvar(VAR_TEMP_2, 1)
    goto(BasalekTown_RivalScript)
}
script BasalekTown_RivalTrigger2{
    setvar(VAR_TEMP_2, 2)
    goto(BasalekTown_RivalScript)
}
script BasalekTown_RivalTrigger3{
    setvar(VAR_TEMP_2, 3)
    goto(BasalekTown_RivalScript)
}

script BasalekTown_RivalScript{
    lock
    safefollow
    getfollowerxy(X, Y)
    if(var(X) != 0){
        unlockfollowermovement
    }
	delay(5)
    opendoor(20, 15)
    waitdooranim
    addobject(OBJ_RIVAL)
    setobjectxy(OBJ_RIVAL, 20, 15)
    turnobject(OBJ_RIVAL, DIR_SOUTH)
    delay(16)
    applymovement(OBJ_RIVAL, Walk1Down)
    waitmovement(0)
    closedoor(20, 15)
    waitdooranim
    switch(var(VAR_TEMP_2)){
        case 1:
            applymovement(OBJ_RIVAL, moves(walk_right * 4, walk_up * 3, walk_in_place_fast_left))
            delay(48)
            applymovement(0xFF, moves(walk_in_place_fast_down))
            applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_down))
            unlockfollowermovement
            delay(64)
            applymovement(0xFF, moves(walk_in_place_fast_right))
            applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_right))
            unlockfollowermovement
        case 2:
            applymovement(OBJ_RIVAL, moves(walk_right * 5, walk_up * 3, walk_in_place_fast_left))
            delay(64)
            applymovement(0xFF, moves(walk_in_place_fast_down))
            applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_down))
            unlockfollowermovement
            delay(64)
            applymovement(0xFF, moves(walk_in_place_fast_right))
            applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_right))
            unlockfollowermovement
        case 3:
            applymovement(OBJ_RIVAL, moves(walk_right * 4, walk_up * 3, walk_in_place_fast_right))
            delay(64)
            applymovement(0xFF, moves(walk_in_place_fast_down))
            applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_down))
            unlockfollowermovement
            delay(48)
            applymovement(0xFF, moves(walk_in_place_fast_left))
            applymovement(OBJ_EVENT_ID_FOLLOWER, moves(walk_in_place_fast_left))
            unlockfollowermovement
    }
    waitmovement(OBJ_RIVAL)
    waitmovement(0xFF)
    delay(24)
    if(checkplayergender == MALE){
        if(flag(FLAG_RIVAL_MET_IN_BASALEK_MART)){ // bailing on rival
            if(flag(FLAG_RIVAL_HARBOR_ANGRY)){ // bailed 2nd time
                msgbox(BasaluffTown_May_2Bails)
            }
            else{ // bailed 1st time
                msgbox(BasaluffTown_May_1Bail)
            }
        }
        else{ // was not trying to bail
            msgbox(BasaluffTown_May_NoBails)
        }
        switch(var(VAR_STARTER_MON)){
            case 0:
                trainerbattle_no_intro(TRAINER_BASALEK_MAY_ROWLET, BasalekMay_LostText)
            case 1:
                trainerbattle_no_intro(TRAINER_BASALEK_MAY_TORCHIC, BasalekMay_LostText)
            case 2:
                trainerbattle_no_intro(TRAINER_BASALEK_MAY_PIPLUP, BasalekMay_LostText)
        }
        if(flag(FLAG_SPECIAL_USED_MEGA_EVO_IN_BATTLE)){
            msgbox(BasaluffMay_PostBattle)
        }
        else{
            msgbox(BasaluffMay_NoMegaPostBattle)
        }
    }
    else{
        if(flag(FLAG_RIVAL_MET_IN_BASALEK_MART)){ // bailing on rival
            if(flag(FLAG_RIVAL_HARBOR_ANGRY)){ // bailed 2nd time
                msgbox(BasaluffTown_Brendan_2Bails)
            }
            else{ // bailed 1st time
                msgbox(BasaluffTown_Brendan_1Bail)
            }
        }
        else{ // was not trying to bail
            msgbox(BasaluffTown_Brendan_NoBails)
        }
        switch(var(VAR_STARTER_MON)){
            case 0:
                trainerbattle_no_intro(TRAINER_BASALEK_BRENDAN_ROWLET, BasalekBrendan_LostText)
            case 1:
                trainerbattle_no_intro(TRAINER_BASALEK_BRENDAN_TORCHIC, BasalekBrendan_LostText)
            case 2:
                trainerbattle_no_intro(TRAINER_BASALEK_BRENDAN_PIPLUP, BasalekBrendan_LostText)
        }
        if(flag(FLAG_SPECIAL_USED_MEGA_EVO_IN_BATTLE)){
            msgbox(BasaluffBrendan_PostBattle)
        }
        else{
            msgbox(BasaluffBrendan_NoMegaPostBattle)
        }
    }
    closemessage
    safefollow
    switch(var(VAR_TEMP_2)){
        case 1:
            applymovement(OBJ_RIVAL, moves(walk_up, walk_right, walk_up, walk_right, walk_up, walk_right * 5))
        case 2:
            applymovement(OBJ_RIVAL, moves(walk_up, walk_right, walk_up, walk_right, walk_up, walk_right * 6))
        case 3:
            applymovement(OBJ_RIVAL, moves(walk_up, walk_right, walk_up, walk_right, walk_up, walk_right * 7))
            applymovement(0xFF, moves(delay_16 * 3, walk_in_place_fast_up, delay_16 * 4, walk_in_place_fast_right))
    }
    waitmovement(OBJ_RIVAL)
    waitmovement(0xFF)
    setflag(FLAG_RIVAL_MET_IN_BASALEK)
    removeobject(OBJ_RIVAL)
    release
}

movement TurnPlayerAndFollowerRight{
    delay_16 * 2
    walk_in_place_fast_right
}

