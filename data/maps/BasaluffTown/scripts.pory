script BasalekTown_LevelChecker{
    if(flag(FLAG_DAILY_BASALEK_CHECKER)){
        msgbox(BasalekTown_LevelChecker_ComeAgain, MSGBOX_NPC)
        end
    }
    lock
    faceplayer
    buffernumberstring(STR_VAR_1, VAR_BASALEK_LEVEL_CHECK)
    msgbox(BasalekTown_LevelChecker_NoMatch, MSGBOX_AUTOCLOSE)
    matchpartylevel(VAR_BASALEK_LEVEL_CHECK)
    if(var(VAR_RESULT) == FALSE){
        end
    }
    msgbox(BasalekTown_LevelChecker_YesMatch)
    switch(var(VAR_BASALEK_LEVEL_REWARD)){
        case 0:
            giveitem(ITEM_MUSCLE_BAND)
        case 1:
            giveitem(ITEM_BINDING_BAND)
        case 2:
            giveitem(ITEM_FOCUS_BAND)
        case 3:
            giveitem(ITEM_CHOICE_BAND)
    }
    if(var(VAR_RESULT) == FALSE){
        goto(ZeBagIsFull)
    }
    setflag(FLAG_DAILY_BASALEK_CHECKER)
    addvar(VAR_BASALEK_LEVEL_REWARD, 1)
    if(var(VAR_BASALEK_LEVEL_REWARD) == 4){
        setvar(VAR_BASALEK_LEVEL_CHECK, 0)
    }
    msgbox(BasalekTown_LevelChecker_ComeAgain)
    release
}

text BasalekTown_LevelChecker_NoMatch{
    "…I saw it!\n"
    "Today's number is {STR_VAR_1}!\p"
    "Show me a Pokémon that's Lv. {STR_VAR_1}.\n"
    "If you can, I'll reward you."
}
text BasalekTown_LevelChecker_YesMatch{
    "…Oh, now, hunh?!\p"
    "I see you have a Pokémon\n"
    "that is Lv. {STR_VAR_1}.\p"
    "Well, I'll be! How remarkable!\p"
    "I'll thank you for that visual treat\n"
    "with this."
}
text BasalekTown_LevelChecker_ComeAgain{
    "Come back another day for\n"
    "another showcase!"
}

script BasalekHouse1_Woman{
    lock
    faceplayer
    msgbox(BasalekHouse1_Woman_Text)
    if(flag(FLAG_BASALEK_WOMAN_LEMONADE)){
        release
        end
    }
    giveitem(ITEM_FRESH_WATER)
    if(var(VAR_RESULT) == FALSE){
        release
        end
    }
    setflag(FLAG_BASALEK_WOMAN_LEMONADE)
    release
}
