mapscripts SerpentCaveMain_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        if(var(VAR_SERPENTCAVE_STORY) >= STORY_SERPENTCAVE_OBTAINED_MEGA_STONE){
            setflag(FLAG_TEMP_1)
        }
    }
}

script SerpentCave_Iris{
    lock
    faceplayer
    if(defeated(TRAINER_CASUAL_IRIS)){
        goto(IrisAfterBattle)
    }
    if(var(VAR_SERPENTCAVE_STORY) == STORY_SERPENTCAVE_IRIS_CHALLENGED){
        if(msgbox(Iris_TryAgain, MSGBOX_YESNO) == FALSE){
            msgbox(Iris_PrepareFirst, MSGBOX_NPC)
            end
        }
    }
    else{
        if(msgbox(FightForTreasure, MSGBOX_YESNO) == FALSE){
            msgbox(Iris_PrepareFirst, MSGBOX_NPC)
            setvar(VAR_SERPENTCAVE_STORY, STORY_SERPENTCAVE_IRIS_CHALLENGED)
            end
        }
    }
    msgbox(IrisLetsGo)
    trainerbattle_no_intro(TRAINER_CASUAL_IRIS, SerpentCaveIris_Lose)
    setvar(VAR_SERPENTCAVE_STORY, STORY_SERPENTCAVE_IRIS_DEFEATED)
    goto(IrisAfterBattle)
}

script IrisAfterBattle{
    if(flag(FLAG_TEMP_2)){
        msgbox(Iris_GiveRewardShort)
    }
    elif(flag(FLAG_SPECIAL_USED_MEGA_EVO_IN_BATTLE)){
        msgbox(Iris_GiveRewardAfterMegaEvo)
    }
    else{
        msgbox(Iris_GiveReward)
    }
    giveitem(ITEM_GARCHOMPITE)
    if(var(VAR_RESULT) == FALSE){
        setflag(FLAG_TEMP_2)
        goto(ZeBagIsFull)
    }
    msgbox(IrisLeaves)
    closemessage
    setvar(VAR_SERPENTCAVE_STORY, STORY_SERPENTCAVE_OBTAINED_MEGA_STONE)
    safefollow
    switch(var(VAR_FACING)){
        case DIR_SOUTH:
        case DIR_WEST:
        case DIR_EAST:
            applymovement(1, Walk7Down)
        case DIR_NORTH:
            getfollowerxy(VAR_TEMP_0, VAR_TEMP_1)
            if(var(VAR_TEMP_0) == 13){
                applymovement(1, moves(
                    walk_right
                    walk_down * 3
                    walk_left
                    walk_down * 5
                ))
            }
            else{
                applymovement(1, moves(
                    walk_left
                    walk_down * 3
                    walk_right
                    walk_down * 5
                ))
            }
    }
    waitmovement(1)
    removeobject(1)
    delay(15)
    release
}

text Iris_TryAgain{
    "You're back!\p"
    "Well, are you ready to battle?"
}
text Iris_PrepareFirst{
    "I get it, you need to strategize\n"
    "first."
}
text FightForTreasure{
    "Iris: Oho, managed to catch up,\n"
    "did we?\p"
    "By the way, do you happen to know\n"
    "anything about the cave flooding?\p"
    "Thanks to that, all the cool stuff\n"
    "at the bottom of the cave got swept\l"
    "away by the tide!\p"
    "All that's left is this crummy\n"
    "little cave with this weird shining\l"
    "stone I found.\p"
    "You look like you want it.\p"
    "If you can beat me in a Pokémon\n"
    "battle, I might just give it to you.\p"
    "How about it?"
}
text SerpentCaveIris_Lose{
    "This can't be! You must've\n"
    "cheated somehow!"
}
text Iris_GiveRewardShort{
    "A promise is a promise.\n"
    "Here's your prize."
}
text Iris_GiveRewardAfterMegaEvo{
    "Oh wow!\p"
    "How did your Pokémon evolve like that\n"
    "during the battle?\p"
    "Mega Evolution?\n"
    "Triggered by a Mega Stone?\p"
    "Hey, do you think by any chance this\n"
    "stone is a Mega Stone?\p"
    "Now I kinda don't wanna give it away…\p"
    "But, a promise is a promise…"
}
text Iris_GiveReward{
    "Oh wow!\p"
    "I have to admit, you're way stronger\n"
    "than I expected!\p"
    "That was fun!\p"
    "I'd kinda grown to like the look of\n"
    "this stone, but I did promise it to\l"
    "you if you won.\p"
    "A promise is a promise."
}
text IrisLeaves{
    "Well, it was a fun experience to\n"
    "battle with you, {PLAYER}, but\l"
    "seeing how the cave kinda got\l"
    "flooded, I don't see much point\l"
    "loitering around here anymore.\p"
    "Think I'm gonna head home now.\p"
    "I hope we get to battle again\n"
    "some day!"
}

text IrisLetsGo{
    "Yay!\n"
    "I knew you'd be up for it!\p"
    "What're we waiting for?\n"
    "Let's go!"
}