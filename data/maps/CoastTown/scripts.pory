    msgbox("No time to talk,\nI'm practicing for a triathlon.\pRunning in sand is tough but I'm sure\nit improves my running technique.", MSGBOX_NPC)
    closemessage
    end
}

script CoastTown_Swimmer{
    msgbox("Eek!\pSomething wriggly just touched my leg!", MSGBOX_NPC)
}

script AzureTide_MysteryWoman{
    if(defeated(TRAINER_AZURETIDE_CELEBI_TR1)){
        msgbox(AzureTide_MysteryWoman_AfterBattleGossip, MSGBOX_NPC)
        end
    }
    lock
    if(flag(FLAG_TEMP_3)){
        faceplayer
        msgbox(AzureTide_MysteryWoman_TextShort, MSGBOX_YESNO)
    }
    else{
        msgbox(AzureTide_MysteryWoman_Text, MSGBOX_DEFAULT)
        faceplayer
        msgbox(AzureTide_MysteryWoman_Text2, MSGBOX_YESNO)
    }
    if(var(VAR_RESULT) == FALSE){
        msgbox(AzureTide_MysteryWoman_Decline, MSGBOX_NPC)
        setflag(FLAG_TEMP_3)
        turnobject(7, DIR_WEST)
        end
    }
    else{
        call(CountGymBadges)
        switch(var(VAR_RESULT)){
            case 0:
            case 1:
                msgbox(AzureTide_MysteryWoman_1Badges, MSGBOX_NPC)
                turnobject(7, DIR_WEST)
                if(!flag(FLAG_Q03_AZURETIDE_OLD_WOMAN_START)){
                    startquest(FLAG_Q03_AZURETIDE_OLD_WOMAN_START)
                    special(ShowJournalPopupAdd)
                }
                end
            case 2:
                msgbox(AzureTide_MysteryWoman_2Badges, MSGBOX_NPC)
                turnobject(7, DIR_WEST)
                if(!flag(FLAG_Q03_AZURETIDE_OLD_WOMAN_START)){
                    startquest(FLAG_Q03_AZURETIDE_OLD_WOMAN_START)
                    special(ShowJournalPopupAdd)
                }
                end
            case 3:
                msgbox(AzureTide_MysteryWoman_3Badges, MSGBOX_NPC)
                turnobject(7, DIR_WEST)
                if(!flag(FLAG_Q03_AZURETIDE_OLD_WOMAN_START)){
                    startquest(FLAG_Q03_AZURETIDE_OLD_WOMAN_START)
                    special(ShowJournalPopupAdd)
                }
                end
            case 4:
            case 5:
                msgbox(AzureTide_MysteryWoman_Get6Badges, MSGBOX_NPC)
                turnobject(7, DIR_WEST)
                if(!flag(FLAG_Q03_AZURETIDE_OLD_WOMAN_START)){
                    startquest(FLAG_Q03_AZURETIDE_OLD_WOMAN_START)
                    special(ShowJournalPopupAdd)
                }
                end
            case 6:
            case 7:
            case 8:
                goto(AzureTide_MysteryWoman_Battle)
        }
    }
    end
}
text AzureTide_MysteryWoman_Text{
    "How many years has it been since\n"
    "we last visited It?\p"
    "I bet those old geezers completely\n"
    "forgot It!\p"
    "… … … …"
}
text AzureTide_MysteryWoman_Text2{
    "Oh!\p"
    "Don't surprise the elderly by\n"
    "sneaking up on them like that!\p"
    "Wait… You are a trainer, yes?\p"
    "And you just arrived from\n"
    "Coralgrove Archipelago?\l"
    "I wonder…\l"
    "You!\l"
    "Yes, you!\p"
    "Would you care for a little bout?\n"
    "I'm very much interested to see\l"
    "how you battle."
}
text AzureTide_MysteryWoman_Decline{
    "Hmph…\p"
    "Well, I won't force you if you\n"
    "don't feel like it."
}
text AzureTide_MysteryWoman_TextShort{
    "You're back. Care for\n"
    "a little bout?"
}
text AzureTide_MysteryWoman_Get6Badges{
    "I know you're probably curious to see\n"
    "just how strong of a trainer I am.\p"
    "However, to even stand a chance\n"
    "against me, I'd say you need\l"
    "around 6 badges!"
}
text AzureTide_MysteryWoman_3Badges{
    "Actually, I think we may have to\n"
    "postpone the battle.\p"
    "You only have 3 Gym Badges and\n"
    "I'm a pretty strong trainer.\p"
    "Get a couple more and then\n"
    "get back to me."
}
text AzureTide_MysteryWoman_2Badges{
    "Now that I think about it,\n"
    "you're still probably a rookie.\p"
    "Why, I bet you don't have more\n"
    "than 2 Gym Badges.\p"
    "Tell you what, get a few more\n"
    "Badges and then come back to me."
}
text AzureTide_MysteryWoman_1Badges{
    "Hm… Now that I think about it,\n"
    "since you just came from Coralgrove,\l"
    "you probably only have a single\l"
    "Gym Badge.\p"
    "I'm a pretty strong trainer so you\n"
    "should work on getting more Badges\l"
    "before taking on my challenge."
}

script Azuretide_HoneyTree{
    lock
    if(!flag(FLAG_AZURETIDE_HONEY)){
        msgbox("It's a peculiar looking tree.", MSGBOX_DEFAULT)
        waitmessage
        closemessage
        release
        end
    }
    checkitem(ITEM_HONEY, 1)
    if(var(VAR_RESULT) == TRUE)
    {
        msgbox(HoneyTree_YesHoney, MSGBOX_YESNO)
        if(var(VAR_RESULT) == TRUE){
            msgbox(HoneyUsedOnTree, MSGBOX_DEFAULT)
            waitmessage
            closemessage
            removeitem(ITEM_HONEY, 1)
            random(10)
            if(var(VAR_RESULT) == 0){
                setwildbattle(SPECIES_VENONAT, 7)
            }
            if(var(VAR_RESULT) == 1){
                setwildbattle(SPECIES_VENONAT, 7)
            }
            if(var(VAR_RESULT) == 2){
                setwildbattle(SPECIES_VENONAT, 8)
            }
            if(var(VAR_RESULT) == 3){
                setwildbattle(SPECIES_SKWOVET, 7)
            }
            if(var(VAR_RESULT) == 4){
                setwildbattle(SPECIES_SKWOVET, 7)
            }
            if(var(VAR_RESULT) == 5){
                setwildbattle(SPECIES_SKWOVET, 8)
            }
            if(var(VAR_RESULT) == 6){
                setwildbattle(SPECIES_SKWOVET, 8)
            }
            if(var(VAR_RESULT) == 7){
                setwildbattle(SPECIES_APPLIN, 7)
            }
            if(var(VAR_RESULT) == 8){
                setwildbattle(SPECIES_APPLIN, 8)
            }
            if(var(VAR_RESULT) == 9){
                setwildbattle(SPECIES_MUNCHLAX, 8)
            }
            setflag(FLAG_CHANCE_TO_HIDDEN_ABILITY)
            dowildbattle
            release
            end
        }
        else{
            waitmessage
            closemessage
            release
            end
        }
    }
    else{
        msgbox(HoneyTree_NoHoney, MSGBOX_SIGN)
        waitmessage
        closemessage
        release
        end
    }
}

text HoneyUsedOnTree{
    "You slather some honey on the tree…\p"
    "…\p"
    "…\p"
    "The honey lured in a wild Pokémon!"
}

text HoneyTree_NoHoney{
    "It's a honey tree."
}

text HoneyTree_YesHoney{
    "It's a honey tree. Would you\n"
    "like to slather some honey on it?"
}

script Azuretide_Ampharos{
    lock
    faceplayer
    waitse
	playmoncry(SPECIES_AMPHAROS, CRY_MODE_NORMAL)
	waitmoncry
    msgbox(AmphyPoints, MSGBOX_YESNO)
    if(var(VAR_RESULT) == FALSE){
        release
        end
    }
    setvar(VAR_RANCH_AMPHAROS, 1)
    warp(MAP_ROUTE3, 78, 12)
    waitstate
    end
}

text AmphyPoints{
    "The Ampharos seems to be pointing\n"
    "towards the ranch and gesturing you\l"
    "to follow.\p"
    "Follow the Pokémon?"
}

script Azuretide_Grotto_Entrance{
    lock
    msgbox(GoInsideGrotto, MSGBOX_YESNO)
    if(var(VAR_RESULT) == FALSE){
        release
        end
    }
    warp(MAP_AZURETIDE_GROTTO, 6, 19)
    waitstate
    release
}

script AzureTide_MysteryWoman_Battle{
    checkpartylevel(55)
    if(var(VAR_RESULT) == FALSE){
        msgbox(AzureTide_AbsolutelyCertain, MSGBOX_YESNO)
    }
    if(var(VAR_RESULT) == FALSE){
        msgbox(AzureTide_MysteryWoman_Decline, MSGBOX_NPC)
        setflag(FLAG_TEMP_3)
        turnobject(7, DIR_WEST)
        end
    }
    msgbox(AzureTide_MysteryWoman_Battle_Intro)
    trainerbattle_no_intro(TRAINER_AZURETIDE_CELEBI_TR1, AzureTide_MysteryWoman_Battle_Lose)
    msgbox(AzureTide_MysteryWoman_PostBattle)
    giveitem(ITEM_DISC_FRAGMENT)
    if(checkitem(ITEM_DISC_FRAGMENT, 2) == TRUE){
        msgbox(AzureTide_ExplainFragmentShort)
    }
    else{
        msgbox(AzureTide_ExplainFragment)
    }
    release
    if(flag(FLAG_Q03_AZURETIDE_OLD_WOMAN_START)){
        completequest(FLAG_Q03_AZURETIDE_OLD_WOMAN_COMPLETE)
        special(ShowJournalPopupRemove)
    }
    end
}

text AzureTide_MysteryWoman_Battle_Intro{
    "Very well then.\p"
    "Prepare yourself,\n"
    "for I won't hold back!"
}
text AzureTide_MysteryWoman_Battle_Lose{
    "Ah, truly a worthy opponent!"
}
text AzureTide_MysteryWoman_PostBattle{
    "You young people really are\n"
    "something else, huh.\p"
    "You've managed to reach a level beyond\n"
    "mine in just a fraction of the time.\p"
    "…Oh!\p"
    "Speaking of fractions, I just\n"
    "remembered something.\p"
    "Here, take this."
}
text AzureTide_ExplainFragment{
    "It may look like junk now,\n"
    "but trust me, that thing\l"
    "is a key to something important.\p"
    "Before it can be used however,\n"
    "you will need to find other fragments\l"
    "like it.\p"
    "My old friends should have hopefully\n"
    "kept their fragments safe.\p"
    "I don't know where they\n"
    "currently reside, but I remember\l"
    "one of them mentioning about\l"
    "moving somewhere warm.\p"
    "There should be four fragments.\p"
    "Once you have collected them all,\n"
    "come back to me and I'll see if\l"
    "I can piece the fragments together."
}
text AzureTide_MysteryWoman_AfterBattleGossip{
    "There should be four fragments.\p"
    "Once you have collected them all,\n"
    "come back to me and I'll see if\l"
    "I can piece the fragments together.\p"
    "My old friends should have hopefully\n"
    "kept their fragments safe.\p"
    "I don't know where they\n"
    "currently reside, but I remember\l"
    "one of them mentioning about\l"
    "moving somewhere warm."
}
text AzureTide_AbsolutelyCertain{
    "Are you absolutely certain you want\n"
    "to challenge me? I'm pretty strong."
}

text AzureTide_ExplainFragmentShort{
    "There should be four fragments.\p"
    "Once you have collected them all,\n"
    "come back to me and I'll see if\l"
    "I can piece the fragments together.\p"
    "My old friends should have hopefully\n"
    "kept their fragments safe.\p"
    "I don't know where they\n"
    "currently reside, but I remember\l"
    "one of them mentioning about\l"
    "moving somewhere warm."
}