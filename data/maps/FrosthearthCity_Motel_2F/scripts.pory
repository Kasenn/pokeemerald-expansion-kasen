mapscripts FrosthearthCity_Motel_2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        setflag(FLAG_TEMP_1)
        setflag(FLAG_TEMP_2)
        setflag(FLAG_TEMP_3)
        setflag(FLAG_TEMP_4)
        switch(var(VAR_MOTEL_CUSTOMERS)){
            case 1:
                clearflag(FLAG_TEMP_1)
            case 2:
                clearflag(FLAG_TEMP_2)
            case 3:
                clearflag(FLAG_TEMP_3)
            case 4:
                clearflag(FLAG_TEMP_4)
        }
    }
}

script Frosthearth_MotelGuest1_OldMan{
    msgbox(Frosthearth_MotelGuest1_OldMan_Text, MSGBOX_NPC)
}
script Frosthearth_MotelGuest1_Man{
    msgbox(Frosthearth_MotelGuest1_Man_Text, MSGBOX_NPC)
}
script Frosthearth_MotelGuest1_Woman{
    msgbox(Frosthearth_MotelGuest1_Woman_Text, MSGBOX_NPC)
}
script Frosthearth_MotelGuest1_Hiker{
    msgbox(Frosthearth_MotelGuest1_Hiker_Text, MSGBOX_NPC)
}
script Frosthearth_MotelGuest1_Twin{
    msgbox(Frosthearth_MotelGuest1_Twin_Text, MSGBOX_NPC)
}
text Frosthearth_MotelGuest1_OldMan_Text{
    "Where's the soup?!"
}
text Frosthearth_MotelGuest1_Man_Text{
    "It's surprisingly hard to find any\n"
    "lodging in this city.\p"
    "We had to book our reservation\n"
    "weeks in advance."
}
text Frosthearth_MotelGuest1_Woman_Text{
    "Are you a tourist as well?\p"
    "Trainer or not, you should\n"
    "definitely check out the\l"
    "Pokémon World Tournament!"
}
text Frosthearth_MotelGuest1_Hiker_Text{
    "Once we're done eating, we'll be\n"
    "heading to the wilderness to see if\l"
    "we can find any interesting Pokémon."
}
text Frosthearth_MotelGuest1_Twin_Text{
    "I hope daddy can get me a Spheal!\n"
    "They're so cute!"
}
script Frosthearth_MotelGuest2_Mother{
    msgbox(Frosthearth_MotelGuest2_Mother_Text, MSGBOX_NPC)
}
script Frosthearth_MotelGuest2_Father{
    msgbox(Frosthearth_MotelGuest2_Father_Text, MSGBOX_NPC)
}
script Frosthearth_MotelGuest2_Son{
    msgbox(Frosthearth_MotelGuest2_Son_Text, MSGBOX_NPC)
}
script Frosthearth_MotelGuest2_Daughter{
    msgbox(Frosthearth_MotelGuest2_Daughter_Text, MSGBOX_NPC)
}
text Frosthearth_MotelGuest2_Mother_Text{
    "I can't wait to explore the city.\p"
    "I just hope our dinner will be\n"
    "ready soon."
}
text Frosthearth_MotelGuest2_Father_Text{
    "Frosthearth seems like the ultimate\n"
    "tourist spot.\p"
    "Whatever your interests are, there's\n"
    "bound to be something for you here."
}
text Frosthearth_MotelGuest2_Son_Text{
    "I can't wait to take part in the\n"
    "Pokémon World Tournament!"
}
text Frosthearth_MotelGuest2_Daughter_Text{
    "I can't decide what I want to do.\p"
    "Relaxing in the hot pool sounds nice,\n"
    "but I also want to go out there and\l"
    "see what exotic Pokémon I can find!"
}
