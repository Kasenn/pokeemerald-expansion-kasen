text Frosthearth_MotelGuest4_AceTrainerF_Text{
    "I'm so proud of our Pokémon!"
}
text Frosthearth_MotelGuest4_AceTrainerM_Text{
    "We scored a big victory at the\n"
    "Pokémon World Tournament,\l"
    "so we're celebrating with our Pokémon!"
}
script Frosthearth_MotelGuest4_Linoone{
    lock
	faceplayer
	waitse
	playmoncry(SPECIES_LINOONE, CRY_MODE_NORMAL)
	msgbox("Linoone: Gumomoh?")
	waitmoncry
	release
	end
}
