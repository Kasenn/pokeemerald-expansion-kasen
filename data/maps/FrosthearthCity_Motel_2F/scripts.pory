    msgbox(Frosthearth_MotelGuest3_Sailor4_Text, MSGBOX_NPC)
}
script Frosthearth_MotelGuest3_Sailor5{
    msgbox(Frosthearth_MotelGuest3_Sailor5_Text, MSGBOX_NPC)
}
script Frosthearth_MotelGuest3_Sailor6{
    msgbox(Frosthearth_MotelGuest3_Sailor6_Text, MSGBOX_NPC)
}
script Frosthearth_MotelGuest3_Sailor7{
    msgbox(Frosthearth_MotelGuest3_Sailor7_Text, MSGBOX_NPC)
}
text Frosthearth_MotelGuest3_Sailor1_Text{
    "Sailing is hard work.\p"
    "Us sailors need to take a break\n"
    "every now and then, too!"
}
text Frosthearth_MotelGuest3_Sailor2_Text{
    "We only just stepped off the boat,\n"
    "but I'm already starting to miss it…"
}
text Frosthearth_MotelGuest3_Sailor3_Text{
    "Boy, the chef sure is taking his\n"
    "sweet time.\p"
    "I hope the food is worth the wait."
}
text Frosthearth_MotelGuest3_Sailor4_Text{
    "Have you ever been to Skyloch\n"
    "Village?\p"
    "I swear I once saw a golden Magikarp\n"
    "swimming in the lake there!"
}
text Frosthearth_MotelGuest3_Sailor5_Text{
    "Very few ships travel to Frosthearth\n"
    "City due to the freezing conditions.\p"
    "You don't want to miss your ride,\n"
    "or you might be stuck waiting here\l"
    "for a long time."
}
text Frosthearth_MotelGuest3_Sailor6_Text{
    "I'm hungry…\p"
    "Maybe I ought to grab a snack\n"
    "from the Mart."
}
text Frosthearth_MotelGuest3_Sailor7_Text{
    "Some sailors have reported seeing an\n"
    "unregistered vessel sailing the seas.\p"
    "Attempts have been made to contact\n"
    "the ship, but they never answer\l"
    "when hailed, and generally seem to\l"
    "keep their distance from everyone."
}
